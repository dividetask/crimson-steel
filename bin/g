#!/usr/bin/env bash
set -e

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"
if [[ -z "$REPO_ROOT" ]]; then
  echo "Error: not inside a git repository" >&2
  exit 1
fi

BRANCHES_FILE="$REPO_ROOT/.branches.local"
if [[ ! -f "$BRANCHES_FILE" ]]; then
  echo "Error: $BRANCHES_FILE not found" >&2
  exit 1
fi

# Load non-empty, non-comment lines into an array
mapfile -t G_BRANCHES < <(grep -vE '^\s*(#|$)' "$BRANCHES_FILE")

# Parse args: one branch selector plus an optional --no-run/-n flag (any order)
run_ruby=1
cmd=""
for arg in "$@"; do
  case "$arg" in
    -n|--no-run) run_ruby=0 ;;
    *)
      if [[ -z "$cmd" ]]; then
        cmd="$arg"
      else
        echo "Error: unexpected argument '$arg'" >&2
        exit 1
      fi
      ;;
  esac
done
cmd="${cmd:-?}"

# List branches
if [[ "$cmd" == "?" ]]; then
  echo "Available branches:"
  echo "  m: main"
  echo "  p: PRODUCTION"
  for i in "${!G_BRANCHES[@]}"; do
    echo "  $i: ${G_BRANCHES[$i]}"
  done
  exit 0
fi

# Resolve target branch
case "$cmd" in
  m) branch="main" ;;
  p) branch="PRODUCTION" ;;
  *) branch="${G_BRANCHES[$cmd]:-}" ;;
esac

if [[ -z "$branch" ]]; then
  echo "Error: no branch at index '$cmd'. Run 'bin/g ?' to list." >&2
  exit 1
fi

# Guard against losing uncommitted work
if ! git diff-index --quiet HEAD -- 2>/dev/null; then
  echo "Warning: uncommitted changes will be discarded by 'git restore .'"
  read -r -p "Proceed? [y/N] " confirm
  [[ "$confirm" =~ ^[yY]$ ]] || exit 1
fi

git restore .
git checkout "$branch"
git pull

if [[ "$run_ruby" -eq 1 ]]; then
  ruby app.rb
fi
