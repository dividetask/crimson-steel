# Crimson Steel — skills.
# Schema:
#   skills:
#     <skill_key>:
#       attribute   one of str/dex/con/int/wis/cha.
#       description short, human-readable summary.
#       set         optional, default false. Marks a *skill set*.
#                   Convention: key ends in `_`; children share the
#                   parent's attribute and are spelled
#                   `<set>_<specialty>` (e.g. craft_smith). Characters
#                   take ranks only in children — class skill `craft_`
#                   allows any `craft_<specialty>` to advance. Children
#                   need not be listed here.
#       mandatory   optional, default false. Every character advances
#                   it automatically (don't list under chosen skills).
# Each class lists its class/opposed skills in advancement.yaml; the
# character chooses, per class, which to advance.

# Every creature gains a minimum number of skills based on an attribute
# (default Intelligence): floor(attribute / attribute_divisor).
minimum_skills_trained:
  attribute: int
  attribute_divisor: 4

# Skill Roll math. Skill Prowess = Skill Ranks + floor(Effective Attribute /
# attribute_contribution_divisor). Passed to dice resolution's
# compute_check_details for Dice Count, Competency Bonus, Starting Value.
skill_prowess:
  attribute_contribution_divisor: 2

# Adjustments folded into the Competency Bonus / Penalty before it
# leaves the proficiency module:
#
#   competency = floor(prowess / Dice Count Range)
#              + competency_bonus_base
#              + (untrained_competency_modifier when skill ranks == 0)
#
# A trained character with average prowess takes a -1 penalty by
# default; a fully untrained character takes -2. Tune to taste.
competency_bonus_base: -1
untrained_competency_modifier: -1

# Versatile Performance. Maps a Perform Skill Set Member key (after
# `perform_`) to two ordinary Skills it can substitute for. With the
# `versatile_performance` ability, a `skill_details` lookup for either
# listed Skill returns max(requested prowess, chosen performance prowess),
# keeping the requested skill's name.
versatile_performance:
  ability_name: versatile_performance
  performances:
    act:        [deception, disguise]
    comedy:     [deception, intimidate]
    dance:      [acrobatics, athletics]
    keyboard:   [persuasion, intimidate]
    oratory:    [persuasion, sense_motive]
    percussion: [animal_handling, intimidate]
    sing:       [deception, sense_motive]
    string:     [deception, persuasion]
    wind:       [persuasion, animal_handling]

skills:
  # Strength
  athletics:
    attribute: str
    description: Climbing, jumping, swimming, and other feats of raw physical exertion.

  # Dexterity
  acrobatics:
    attribute: dex
    description: Balancing, tumbling, and moving through difficult terrain without losing footing.
  escape_artist:
    attribute: dex
    description: Slipping bonds, grapples, and tight enclosures.
  larceny:
    attribute: dex
    description: Picking pockets, opening locks, and disabling traps.
  martial:
    attribute: dex
    mandatory: true
    description: General combat training.
  ride:
    attribute: dex
    description: Controlling a mount, especially under stress or in combat.
  sleight_of_hand:
    attribute: dex
    description: Subtle hand-work — palming objects, planting items, and similar trickery.
  stealth:
    attribute: dex
    description: Moving and hiding without being noticed.

  # Intelligence
  appraisal:
    attribute: int
    description: Estimating an object's worth, ease of resale, and magical aura.
  arcana:
    attribute: int
    description: Knowledge of magical traditions and the casting skill for arcane spells.
  craft_:
    attribute: int
    set: true
    description: Producing goods of a particular trade.
  dungeoneering:
    attribute: int
    description: Knowledge of underground hazards, aberrations, and subterranean navigation.
  game_:
    attribute: int
    set: true
    description: Skill at a particular game of strategy or chance.
  history:
    attribute: int
    description: Knowledge of past events, civilizations, and notable figures.
  investigation:
    attribute: int
    description: Searching for clues and reasoning out what they mean.
  linguistics:
    attribute: int
    description: Languages, ciphers, and detecting forgeries.
  nobility:
    attribute: int
    description: Knowledge of heraldry, courtly etiquette, and the politics of ruling houses.
  planes:
    attribute: int
    description: Knowledge of the outer planes, their inhabitants, and travel between them.
  restricted_magic:
    attribute: int
    description: The casting skill for restricted magical traditions.
  religion:
    attribute: int
    description: Knowledge of deities, holy sites, and religious rites.

  # Wisdom
  healing:
    attribute: wis
    description: Tending wounds and casting divine healing magic.
  nature:
    attribute: wis
    description: Wilderness lore, animal husbandry, and survival in the outdoors.
  perception:
    attribute: wis
    description: Noticing fine details with any of the senses, including hidden creatures and auras.
  profession_:
    attribute: wis
    set: true
    description: Earning a living from a particular trade.
  sense_motive:
    attribute: wis
    description: Reading intent, spotting deception, and gauging mood.

  # Charisma
  animal_handling:
    attribute: cha
    description: Calming, training, and directing animals.
  deception:
    attribute: cha
    description: Lying convincingly, bluffing, and otherwise misleading on purpose.
  disguise:
    attribute: cha
    description: Altering appearance to pose as someone else.
  intimidate:
    attribute: cha
    description: Coercing through threat, force of personality, or open menace.
  perform_:
    attribute: cha
    set: true
    description: A particular performance art.
  persuasion:
    attribute: cha
    description: Earnest argument, negotiation, and inspiring trust.
  evocation:
    attribute: cha
    description: Innate magical casting and skill in activating magical devices.
