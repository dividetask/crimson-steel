# Crimson Steel — advancement rules and class definitions.
#
# Setup:
#   1. Copy this file to `data/advancement.yaml`
#      (the data/ directory is gitignored, so each campaign keeps
#      its own tuning).
#   2. Adjust the values below to match the campaign.
#   3. Restart the server.
#
# This file is the single source of truth consulted by the
# Advancement class. It owns:
#   * Default tier advancement
#   * Tier attribute increases
#   * Class definitions (skills, saves, abilities, etc) 
#

# ─── Tier rules ──────────────────────────────────────────────
#
# Each tier grants two attribute-score adjustments:
#
#   * a flat bonus applied to every attribute, and
#   * a focused bonus applied to a small number of attributes the
#     player picks at each tier-up.
#
# Both bonuses are per-tier increments — the character's
# cumulative bonus at tier T is the sum of the first T entries.
# The lists are indexed from tier 1 (index 0). With the defaults
# below a character at tier 3 has +3 to every attribute (1+1+1)
# plus +2 to each of the attributes they picked at tier 2 and the
# attributes they picked at tier 3 (focused tier-1 bonus is 0
# because the tier-1 starting score already bakes that in).

# Per-tier flat bonus to every attribute.
attribute_bonus_per_tier: [1, 1, 1, 1, 1]

# Per-tier focused bonus applied to each attribute the player
# picks at that tier-up.
focused_attribute_bonus_per_tier: [0, 2, 2, 2, 2]

# Number of attributes the player picks at each tier-up.
focused_attribute_count: 2

# ─── Tier advancement ────────────────────────────────────────
#
# Total class levels needed to reach tiers 1 through 5, keyed by
# character tag. The `tags` list on a character (default
# `[player_character]`) selects which lists to use; if more than
# one tag matches, the highest tier wins. Descriptive tags
# without an entry here don't contribute. If a character sets
# `tier:` explicitly that value wins over the auto-computed one.

tier_advancement:
  player_character: [1, 4, 8, 16, 32]
  boss:             [1, 4, 8, 16, 32]
  noble:            [0, 2, 6, 14, 18]
  common:           [0, 8, 12, 20, 40]

# ─── Hit points and mana ─────────────────────────────────────
#
# max_hit_points = floor(tier * attribute(hp_attribute) / hp_divisor)
# max_mana       = floor(tier * attribute(mana_attribute) / mana_divisor)
#
# Tier 0 yields 0 for both. Calculated by Advancement and
# exposed through Character.

hp_attribute:   con
hp_divisor:     1
mana_attribute: int
mana_divisor:   2

# ─── Class definitions ───────────────────────────────────────
#
# Schema:
#   classes:
#     <class_key>:
#       name             optional human-readable class name. The
#                        class key is used as a fallback wherever
#                        the name is displayed.
#       parent_class     optional. Marks the class as an archetype
#                        of the named class. The character's
#                        levels in the archetype also count toward
#                        the parent class's abilities and grant
#                        the parent's class skills.
#                        A character cannot hold levels in both an
#                        archetype and its parent class — once an
#                        archetype is taken, all of the character's
#                        previous parent-class levels are
#                        reclassified as the archetype. The
#                        archetype's mana_per_level applies to
#                        every reclassified level (the
#                        "retroactive mana grant" rule).
#       min_parent_level optional, used with parent_class. The
#                        documented prerequisite level in the
#                        parent class to take this archetype.
#       mana_per_level   integer, default 0. Each level in this
#                        class adds this much to the character's
#                        max mana. Standard values:
#                        - 1 for fighter/barbarian/rogue/ranger
#                        - 2 for bard/arcane_trickster
#                        - 4 for cleric/druid/wizard
#                        Archetypes carry their own value rather
#                        than inheriting from parent_class —
#                        this is what makes the retroactive mana
#                        grant work when a character takes an
#                        archetype.
#       saves            list of attribute keys (str/dex/con/int/
#                        wis/cha). The class specializes in these
#                        saving throws — they advance faster than
#                        the rest.
#       bonus_skills     optional integer. How many skills the
#                        character may train beyond the minimum
#                        granted by their key attribute. Not
#                        currently enforced.
#       class_skills     optional, list of skills that advance
#                        faster. If the field is omitted entirely
#                        then every skill not listed in
#                        non_class_skills or opposed_skills is
#                        treated as a class skill.
#       non_class_skills optional, list of skills that advance at
#                        the average rate.
#       opposed_skills   optional, list of skills the class
#                        advances slower.
#       abilities        ordered list defining which abilities the
#                        class grants and the level threshold for
#                        each. Two entry shapes are allowed:
#
#                        * Ability entry — has a `name`. Inherits
#                          the rolling `min_level` from any
#                          preceding context entry. Every other
#                          field (notably `scales_with_level`) is
#                          per-entry only — set it on the ability
#                          itself.
#                        * Context entry — no `name`. Sets the
#                          rolling `min_level` that applies to
#                          every following ability entry until
#                          the next context entry. No other field
#                          is sticky.
#
#                        Recognized ability keys:
#                          name              required on ability
#                                            entries.
#                          min_level         class level required
#                                            (default 1).
#                          scales_with_level if true, the
#                                            ability's effective
#                                            level is the sum of
#                                            class levels across
#                                            every class that
#                                            grants it.
#

classes:
  barbarian:
    mana_per_level: 1
    saves: [str, con]
    bonus_skills: 2
    class_skills:
      - animal_handling
      - athletics
      - craft_
      - healing
      - intimidate
      - martial
      - nature
      - perception
    abilities:
      - name: rage
        scales_with_level: true
      - name: fast_movement
      - name: reckless_attacks
        scales_with_level: true
      - min_level: 2
      - name: uncanny_dodge
      - name: primal_tenacity
      - name: combat_feat
      - min_level: 3
      - name: mindless_rage
      - min_level: 5
      - name: improved_uncanny_dodge

  bard:
    name: Bard
    mana_per_level: 2
    saves: [dex, cha]
    bonus_skills: 3
    non_class_skills:
      - arcana
      - restricted_magic
    abilities:
      - name: magical_performance
        scales_with_level: true
      - name: bardic_spellcasting
      - name: bardic_inspiration
      - min_level: 2
      - name: jack_of_all_trades
      - name: better_lucky_than_good
      - name: performance_feat
      - name: versatile_performance
        description: |
          Allows the prowess of a performance skill to be used instead of the
          prowess of linked skills. Each of the following performances has two
          linked skills: Act, Comedy, Dance, Keyboard Instruments, Oratory,
          Percussion, Sing, String, and Wind. Each time this ability is gained
          you must choose one type of performance that can be used with this
          ability.
      - min_level: 3
      - name: silver_tongue
      - name: unsettling_words
      - min_level: 5
      - name: competent_performer
      - min_level: 6
      - name: versatile_performance
      - min_level: 10
      - name: versatile_performance
      - min_level: 14
      - name: versatile_performance
      - min_level: 20
      - name: versatile_performance

  cleric:
    name: Cleric
    mana_per_level: 4
    saves: [wis, cha]
    bonus_skills: 2
    class_skills:
      - appraisal
      - arcana
      - craft_
      - healing
      - history
      - linguistics
      - nobility
      - persuasion
      - planes
      - profession_
      - restricted_magic
      - religion
      - sense_motive
    abilities:
      - name: see_injury
        scales_with_level: true
      - name: improved_healing
        scales_with_level: true
      - name: combat_healing
      - name: domain
        scales_with_level: true
      - min_level: 2
      - name: channel_divinity
      - name: turn_undead
      - name: casting_feat
      - min_level: 5
      - name: destroy_undead

  druid:
    name: Druid
    mana_per_level: 4
    saves: [int, wis]
    bonus_skills: 2
    class_skills:
      - acrobatics
      - athletics
      - craft_
      - escape_artist
      - intimidate
      - investigation
      - perception
      - profession_
      - sense_motive
      - stealth
    abilities: []

  fighter:
    name: Fighter
    mana_per_level: 1
    saves: [str, con]
    bonus_skills: 2
    class_skills:
      - acrobatics
      - animal_handling
      - athletics
      - history
      - intimidate
      - martial
      - nature
      - perception
    abilities:
      - name: weapon_training
        scales_with_level: true
      - name: armor_training
        scales_with_level: true

  ranger:
    name: Ranger
    mana_per_level: 1
    bonus_skills: 3
    saves: [str, dex]
    class_skills: []
    abilities: []

  rogue:
    mana_per_level: 1
    saves: [dex, int]
    bonus_skills: 4
    class_skills:
      - acrobatics
      - appraisal
      - athletics
      - craft_
      - deception
      - disguise
      - dungeoneering
      - escape_artist
      - intimidate
      - investigation
      - larceny
      - linguistics
      - perception
      - perform_
      - persuasion
      - profession_
      - sense_motive
      - sleight_of_hand
      - stealth
      - evocation
    abilities:
      - name: trapfinding
        scales_with_level: true
      - name: sneak_attack
        scales_with_level: true
      - name: thieves_cant
      - min_level: 2
      - name: danger_sense
      - min_level: 5
      - name: uncanny_dodge

  arcane_trickster:
    parent_class: rogue
    mana_per_level: 2
    min_parent_level: 3
    saves: [dex, int]
    class_skills:
      - arcana
    opposed_skills: []
    abilities:
      - min_level: 3
      - name: combat_trickery
      - name: mage_legerdemain

  wizard:
    mana_per_level: 4
    saves: [int, wis]
    class_skills: []
    opposed_skills:
      - martial
    abilities: []
