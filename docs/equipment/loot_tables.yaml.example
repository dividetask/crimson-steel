# Loot Tables (example)
#
# Weighted, rollable definitions of what items a creature, chest, or
# shop carries. Other modules (creature templates, scene scripts, the
# Equipment class's shop refresh) roll against these tables by id.
#
# Copy to `loot_tables.yaml` and edit for your campaign.
#
# See `equipment_glossary.md` for vocabulary (Loot Table, Roll Row,
# Option List, Dice Expression, Inline Magical Row) and
# `equipment_pseudocode.md` for the roll algorithms
# (ROLL_LOOT_TABLE, ROLL_ROW, ROLL_WEIGHTED, RESOLVE_ITEM_SPEC).
#
# ---------------------------------------------------------------------
# Multi-file loading
#
# The loader reads `loot_tables.yaml` first, then every file matching
# `loot_tables-*.yaml` in the same directory. All tables and option
# lists merge into one registry; duplicate IDs across files are an
# error. Tables added at runtime (via ADD_LOOT_TABLE) persist back to
# `loot_tables.yaml`.
#
# ---------------------------------------------------------------------
# Row shapes
#
# Each entry under a table's `rolls:` list takes one of four shapes:
#
# 1. Guaranteed — always drops.
#      - slot: <label>
#        item:
#          item: <name>       # key in equipment_config.yaml
#          quantity: <number or dice expression>
#          # ...any identity fields...
#
# 2. Independent Chance — drops with probability `chance` ∈ [0, 1].
#      - slot: <label>
#        chance: 0.5
#        item:
#          item: <name>
#
# 3. Weighted Choice — picks exactly one option by cumulative
#    probability. If sum(chance) < 1, the remainder means "nothing."
#    `options` may be an inline list OR the name of an Option List.
#      - slot: <label>
#        options:
#          - chance: 0.3
#            item: {item: <name>}
#          - chance: 0.2
#            item: {item: <other>}
#          # remainder 0.5 = nothing
#
#      - slot: <label>
#        options: tier_one_magical_melee   # pull from option_lists
#
# 4. Gated Weighted Choice — first roll `chance` to decide whether to
#    enter the table at all; on success, do a Weighted Choice.
#      - slot: <label>
#        chance: 0.1                       # 10% chance to drop anything
#        options: [...]                    # weighted choice inside
#
# ---------------------------------------------------------------------
# Dice expressions
#
# Any `quantity` field may be a dice expression string like
# "2d6 + 3". NdM dice terms, integer constants, and +/- joiners are
# supported. Evaluation is per-roll, so two guards rolled from the
# same table can produce different gold totals.
#
# ---------------------------------------------------------------------
# Currency and gems in loot tables
#
# Gold (and Silver, Copper) appear as ordinary item stacks with
# `item: Gold` (or Silver / Copper) and a numeric or dice-expression
# quantity. There is no separate `gold:` field on a table.
#
# Gems are item stacks with `item: Gem`, `value_in_gold: <number>`,
# and an optional `name`.
#
# ---------------------------------------------------------------------
# Inline magical rows
#
# Any row's `item` may specify a magical-item constraint instead of
# a literal stack. The constraint is rolled through
# GENERATE_MAGICAL_ITEM at roll time; exactly one property is applied
# per generated item.
#
#     item:
#       magical:
#         category: melee                 # or ranged, ammo, all_armor, all_body
#         tier: [1, 2]                    # list of allowed tiers
#         tier_weights: {1: 3, 2: 1}      # optional; uniform if absent
#         properties_weighted:
#           Elemental: 3
#           Subdual: 1
#         items_weighted:                 # optional; uniform over
#           Long sword: 2                 # eligible items if absent
#           Mace: 1
#
# ---------------------------------------------------------------------
# Option lists and recursion
#
# `option_lists:` holds named, reusable Weighted Choice lists. Any row
# with `options: "<list_name>"` pulls its options from here. An option
# whose body is `{chance, from: "<other_list>"}` recurses into another
# option list when picked — useful for cross-tier overflow (e.g., 5%
# of a tier-1 roll actually grabs from tier-2).

loot_tables:

  # --- Town guards --------------------------------------------------
  #
  # Standard city watch loadout. Weapon and armor are picked
  # weighted; mundane gold pouch is guaranteed.

  town_guard_equipment:
    rolls:

      - slot: weapon
        options:
          - chance: 0.40
            item: {item: Short sword}
          - chance: 0.30
            item: {item: Spear}
          - chance: 0.20
            item: {item: Mace}
          - chance: 0.10
            item: {item: Hatchet}

      - slot: armor
        options:
          - chance: 0.60
            item: {item: Chain shirt}
          - chance: 0.30
            item: {item: Leather armor}
          # 10% nothing

      - slot: shield
        chance: 0.40
        item: {item: Light wooden shield}

      - slot: purse
        item:
          item: Gold
          quantity: "2d6 + 5"

  # --- Bandits ------------------------------------------------------
  #
  # Less uniform than guards. Weapons span the cheap end; armor is a
  # coin flip; a rare bandit has a stolen magical trinket.

  bandit_equipment:
    rolls:

      - slot: weapon
        options:
          - chance: 0.25
            item: {item: Dagger}
          - chance: 0.20
            item: {item: Short sword}
          - chance: 0.20
            item: {item: Hatchet}
          - chance: 0.15
            item: {item: Shortbow}
          - chance: 0.10
            item: {item: Rapier}
          # 10% nothing

      - slot: armor
        chance: 0.50
        item: {item: Leather armor}

      # Archers carry a small bundle of arrows. Gated: 30% chance the
      # bandit is an archer, then weighted over bundle sizes.
      - slot: ammo
        chance: 0.30
        options:
          - chance: 0.60
            item: {item: Arrow, quantity: "1d10 + 5"}
          - chance: 0.40
            item: {item: Arrow, quantity: "2d10 + 10"}

      - slot: purse
        item:
          item: Gold
          quantity: "1d6 + 1"

      # 5% of bandits have a stolen magical trinket — either a weapon
      # or a piece of armor.
      - slot: trinket
        chance: 0.05
        options:
          - chance: 0.50
            item:
              magical:
                category: melee
                tier: [1]
                properties_weighted:
                  Elemental: 3
                  Subdual: 1
                  Emotional: 1
          - chance: 0.50
            item:
              magical:
                category: all_body
                tier: [1]
                properties_weighted:
                  Fortification: 2
                  Spell Storing 1: 1

  # --- Dragon hoard -------------------------------------------------
  #
  # A large, magic-dense cache. Big pile of gold, several gems, a
  # guaranteed magical weapon, and an independent chance of magical
  # armor. Uses an option list for the gem value distribution.

  dragon_hoard:
    rolls:

      - slot: gold
        item:
          item: Gold
          quantity: "4d100 + 500"

      - slot: silver
        item:
          item: Silver
          quantity: "5d100"

      # A fistful of gems, rolled from a shared distribution. Each
      # of these three rolls is independent — the dragon is likely
      # to hoard more than one gem.
      - slot: gem_1
        options: dragon_hoard_gems
      - slot: gem_2
        options: dragon_hoard_gems
      - slot: gem_3
        chance: 0.60
        options: dragon_hoard_gems

      - slot: weapon
        item:
          magical:
            category: melee
            tier: [2, 3]
            tier_weights: {2: 3, 3: 1}
            properties_weighted:
              Elemental: 3
              Vicious: 2
              Necrotic: 2
              Radiant: 1
            items_weighted:
              Great sword: 3
              Great Axe: 2
              Long sword: 2
              Halberd: 1

      - slot: armor
        chance: 0.50
        item:
          magical:
            category: all_body
            tier: [2]
            properties_weighted:
              Fortification: 3
              Spell Storing 2: 1
              Elemental Resistance: 2

      - slot: ammo
        chance: 0.40
        item:
          magical:
            category: ammo
            tier: [1, 2]
            tier_weights: {1: 3, 2: 1}
            properties_weighted:
              Elemental: 4
              Subdual: 1
              Radiant: 1

  # --- Shop stock templates ----------------------------------------
  #
  # These tables are referenced from `shops.yaml.example` as the
  # initial stock for specific shops and the per-day stock for
  # generic shops. Quantities use dice expressions so each refresh
  # produces a slightly different mix.

  blacksmith_stock:
    rolls:
      - slot: long_swords
        chance: 0.80
        item: {item: Long sword, quantity: "1d3"}
      - slot: hatchets
        item: {item: Hatchet, quantity: "1d4 + 2"}
      - slot: spears
        item: {item: Spear, quantity: "1d6 + 2"}
      - slot: maces
        chance: 0.70
        item: {item: Mace, quantity: "1d4 + 1"}
      - slot: daggers
        item: {item: Dagger, quantity: "1d6"}
      - slot: leather_armor
        chance: 0.80
        item: {item: Leather armor, quantity: "1d3"}
      - slot: chain_shirts
        chance: 0.50
        item: {item: Chain shirt, quantity: "1d2"}
      - slot: shields
        item: {item: Light wooden shield, quantity: "1d4"}
      - slot: arrows
        item: {item: Arrow, quantity: "2d10 + 20"}
      - slot: bolts
        chance: 0.50
        item: {item: Bolt, quantity: "1d10 + 10"}
      - slot: refresh_gold
        item: {item: Gold, quantity: "3d20 + 100"}

  alchemist_stock:
    rolls:
      # Potion entries elided until the Potion category lands.
      - slot: refresh_gold
        item: {item: Gold, quantity: "2d20 + 50"}
      - slot: gems
        chance: 0.40
        item:
          item: Gem
          name: Quartz
          value_in_gold: 50
          quantity: "1d4"

  random_market_stall_stock:
    rolls:
      - slot: weapon
        chance: 0.50
        options:
          - chance: 0.40
            item: {item: Dagger, quantity: "1d3"}
          - chance: 0.30
            item: {item: Hatchet}
          - chance: 0.30
            item: {item: Short sword}
      - slot: armor
        chance: 0.30
        item: {item: Leather armor}
      - slot: arrows
        chance: 0.50
        item: {item: Arrow, quantity: "1d20 + 5"}
      - slot: gold
        item: {item: Gold, quantity: "2d10 + 10"}

  traveling_peddler_stock:
    rolls:
      - slot: trinket
        options:
          - chance: 0.20
            item: {item: Dagger}
          - chance: 0.20
            item: {item: Throwing dart, quantity: "1d4 + 1"}
          - chance: 0.20
            item: {item: Shuriken, quantity: "1d6"}
          - chance: 0.10
            item:
              item: Gem
              name: Polished Pebble
              value_in_gold: 10
              quantity: "1d4"
          # 30% nothing
      - slot: rare_find
        chance: 0.05
        item:
          magical:
            category: melee
            tier: [1]
            properties_weighted:
              Subdual: 2
              Emotional: 1
      - slot: gold
        item: {item: Gold, quantity: "1d10 + 5"}

# ---------------------------------------------------------------------
# Option lists
# ---------------------------------------------------------------------
#
# Named, reusable Weighted Choice lists. Rows reference them by name
# via `options: <list_name>`.

option_lists:

  # Gem-value distribution used by the dragon hoard. Small chance of
  # overflow into the larger-value list.
  dragon_hoard_gems:
    - chance: 0.30
      item:
        item: Gem
        name: Amber
        value_in_gold: 100
    - chance: 0.25
      item:
        item: Gem
        name: Moonstone
        value_in_gold: 250
    - chance: 0.20
      item:
        item: Gem
        name: Emerald
        value_in_gold: 500
    - chance: 0.15
      item:
        item: Gem
        name: Ruby
        value_in_gold: 1000
    # 10% overflow into the rarer list — recursion via `from:`.
    - chance: 0.10
      from: dragon_hoard_rare_gems
    # (sum is 1.0 — no "nothing" remainder.)

  dragon_hoard_rare_gems:
    - chance: 0.50
      item:
        item: Gem
        name: Sapphire
        value_in_gold: 2500
    - chance: 0.30
      item:
        item: Gem
        name: Black Opal
        value_in_gold: 5000
    - chance: 0.20
      item:
        item: Gem
        name: Star Diamond
        value_in_gold: 10000

  # Example reusable pool of tier-1 magical melee drops. Any table
  # that wants "a random tier-1 magical melee weapon" can reference
  # this list instead of duplicating the weights.
  tier_one_magical_melee:
    - chance: 0.50
      item:
        magical:
          category: melee
          tier: [1]
          properties_weighted:
            Elemental: 3
            Subdual: 1
    - chance: 0.30
      item:
        magical:
          category: melee
          tier: [1]
          properties_weighted:
            Emotional: 1
            Radiant: 1
    # 20% nothing — the loot bag sometimes comes up empty.
