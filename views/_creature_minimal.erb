<%
  # Creature Minimal Stub — docs/common/ui/creatures_minimal_stub.md
  #
  # Locals:
  #   demo            — required. Sample data; see lib/status/sample_creatures.rb.
  #   toggle_target   — optional. The route the toggle button posts to.
  #                     When omitted the toggle is rendered as a no-op label.
  #   chrome          — optional boolean (default true). When false suppress
  #                     the outer card framing.
  chrome_on     = defined?(chrome)        ? chrome        : true
  toggle_href   = defined?(toggle_target) ? toggle_target : nil

  h  = demo[:header]
  v  = demo[:vitals]
  it = demo[:items]

  attr_order = %i[str dex con int wis cha]
  attr_label = { str: 'STR', dex: 'DEX', con: 'CON', int: 'INT', wis: 'WIS', cha: 'CHA' }

  # Per-Attribute Check / Save (and untrained-Skill) Dice Cap + Bonus
  # for the click/hover popup. attributes_table is ordered to match
  # attr_order, so we pair them positionally — robust whether or not
  # the row carries an explicit :key.
  attr_rows = Array(demo[:attributes_table])
  attr_info = {}
  attr_order.each_with_index { |a, i| attr_info[a] = attr_rows[i] if attr_rows[i] }

  # Render bonus/penalty tokens ({ amount:, conditional: }) inline: green
  # for a bonus, red for a penalty, a leading "*" for a conditional one.
  mod_tokens = lambda do |tokens|
    Array(tokens).filter_map do |t|
      amt = t[:amount].to_i
      next if amt.zero?
      cls  = amt.negative? ? 'cs-mod-penalty' : 'cs-mod-bonus'
      star = t[:conditional] ? '*' : ''
      %(<span class="#{cls}">#{star}#{format('%+d', amt)}</span>)
    end.join
  end
%>

<article class="cs-card cs-minimal tier-<%= h[:tier] %><%= ' cs-bare' unless chrome_on %>" data-creature-id="<%= demo[:id] %>">

  <header class="cs-header">
    <h2 class="cs-name"><%= h[:name] %></h2>
    <% if h[:player] %>
      <span class="cs-player">Player: <strong><%= h[:player] %></strong></span>
    <% end %>
  </header>
  <div class="cs-subtitle"><em><%= h[:summary] %><% unless h[:hide_tier] %>, Tier <span class="cs-tier-num"><%= h[:tier] %></span><% end %></em></div>

  <section class="cs-vitals-block">
    <div class="cs-attr-grid">
      <% attr_order.each do |a| %>
        <%
          info   = attr_info[a]
          label  = info ? info[:attr] : attr_label[a]
          abonus = (demo[:attribute_bonuses] || {})[a].to_i
          # Grid shows the intrinsic Attribute (Effective minus the item
          # bonus) so the green "+X" reads as an addition on top.
          aval   = demo[:attributes][a].to_i - abonus
        %>
        <div class="cs-attr-cell<%= ' cs-attr-has-pop' if info %>"<% if info %> tabindex="0" role="button" aria-label="<%= label %> checks and saves"<% end %>>
          <span class="cs-attr-key"><%= attr_label[a] %></span>
          <span class="cs-attr-value"><%= aval %><%= mod_tokens.call([{ amount: abonus }]) %></span>
          <% if info %>
            <div class="cs-attr-pop" role="tooltip">
              <div class="cs-attr-pop-title"><%= label %></div>
              <table class="cs-attr-pop-table">
                <thead><tr><th></th><th class="cs-num">Ranks</th><th class="cs-num">Dice</th><th class="cs-num">Bonus</th></tr></thead>
                <tbody>
                  <tr>
                    <th>Check</th>
                    <td class="cs-num"><%= info[:check][:ranks] || 0 %></td>
                    <td class="cs-num"><%= info[:check][:dice] %>d</td>
                    <td class="cs-num"><%= sprintf('%+d', info[:check][:bonus]) %></td>
                  </tr>
                  <tr>
                    <th>Save</th>
                    <td class="cs-num"><%= info[:save][:ranks] || 0 %></td>
                    <td class="cs-num"><%= info[:save][:dice] %>d</td>
                    <td class="cs-num cs-nowrap"><%= sprintf('%+d', info[:save][:bonus]) %><%= mod_tokens.call(info[:save][:tokens]) %></td>
                  </tr>
                  <% if info[:untrained] %>
                    <tr>
                      <th>Untrained</th>
                      <td class="cs-num"><%= info[:untrained][:ranks] || 0 %></td>
                      <td class="cs-num"><%= info[:untrained][:dice] %>d</td>
                      <td class="cs-num"><%= sprintf('%+d', info[:untrained][:bonus]) %></td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
    <div class="cs-hp-mana">
      <div class="cs-hp-line"><span class="cs-hp-label">HP</span> <%= v[:hp][:current] %>/<%= v[:hp][:max] %></div>
      <div class="cs-mana-line">
        <span class="cs-mana-label">Mana</span> <%= v[:mana][:current] %>/<%= v[:mana][:max] %>,
        <span class="cs-tox">Toxicity <%= v[:toxicity][:current] %>/<%= v[:toxicity][:threshold] %></span>
      </div>
    </div>
    <%
      drb  = (v[:defense_breakdown] || {})[:damage_reduction]
      resb = (v[:defense_breakdown] || {})[:damage_resilience]
    %>
    <div class="cs-defense">
      <div class="cs-def-line"><span class="cs-def-label">Damage Reduction</span> <span class="cs-def-value cs-nowrap"><%= drb ? drb[:base] : v[:damage_reduction] %><%= mod_tokens.call(drb[:tokens]) if drb %></span></div>
      <div class="cs-def-line"><span class="cs-def-label">Damage Resilience</span> <span class="cs-def-value cs-nowrap"><%= resb ? resb[:base] : v[:damage_resilience] %><%= mod_tokens.call(resb[:tokens]) if resb %></span></div>
    </div>
  </section>

  <section class="cs-ips-row">
    <div class="cs-ips-cell"><strong>Initiative</strong> <%= demo[:initiative][:dice_count] %></div>
    <div class="cs-ips-cell"><strong>Perception</strong> <%= sprintf('%+d', demo[:perception][:bonus]) %></div>
    <div class="cs-ips-cell"><strong>Speed</strong> <%= demo[:speed] %></div>
  </section>

  <%
    items_have_content = it[:equipped].any? || it[:consumable].any? || it[:other].any?
    right_has_content  = items_have_content || demo[:spells].any? || demo[:rituals].any?
  %>

  <div class="cs-minimal-body<%= ' cs-no-right' unless right_has_content %>">
    <div class="cs-col cs-col-left">
      <section class="cs-section cs-actions">
        <h3 class="cs-section-h">Actions</h3>
        <table class="cs-action-table">
          <thead>
            <tr><th>Name</th><th class="cs-num">Spd</th><th class="cs-num">Roll</th><th class="cs-num">Bonus</th><th class="cs-num">Dmg</th><th>Notes</th></tr>
          </thead>
          <tbody>
            <% demo[:actions].each do |act| %>
              <tr>
                <td><%= act[:name] %></td>
                <td class="cs-num"><%= act[:speed] %></td>
                <td class="cs-num"><%= act[:roll] %></td>
                <td class="cs-num"><%= sprintf('%+d', act[:attack_bonus]) %></td>
                <td class="cs-num"><%= act[:dmg_bonus] ? sprintf('%+d', act[:dmg_bonus]) : '&mdash;' %></td>
                <td><%= act[:notes] %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </section>

      <% if demo[:skills].any? %>
        <section class="cs-section cs-skills-min">
          <h3 class="cs-section-h">Skills</h3>
          <table class="cs-skills-table">
            <thead><tr><th>Name</th><th class="cs-num">Ranks</th><th class="cs-num">Dice</th><th class="cs-num">Bonus</th></tr></thead>
            <tbody>
              <% demo[:skills].each do |s| %>
                <tr>
                  <td><%= s[:name] %></td>
                  <td class="cs-num"><%= s[:ranks] %></td>
                  <td class="cs-num"><%= s[:dice] %>d</td>
                  <td class="cs-num"><%= sprintf('%+d', s[:bonus]) %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </section>
      <% end %>
    </div>

    <% if right_has_content %>
      <div class="cs-col cs-col-right">
        <% if demo[:spells].any? %>
          <section class="cs-section cs-spells-min">
            <h3 class="cs-section-h">Spells</h3>
            <% demo[:spells].each do |grp| %>
              <div class="cs-spell-line">
                <em class="cs-tier-label tier-<%= grp[:tier] %>">Tier <%= grp[:tier] %>.</em>
                <%= grp[:names].join(', ') %>
              </div>
            <% end %>
          </section>
        <% end %>

        <% if demo[:rituals].any? %>
          <section class="cs-section cs-rituals-min">
            <h3 class="cs-section-h">Rituals</h3>
            <% demo[:rituals].each do |grp| %>
              <div class="cs-spell-line">
                <em class="cs-tier-label tier-<%= grp[:tier] %>">Tier <%= grp[:tier] %>.</em>
                <%= grp[:names].join(', ') %>
              </div>
            <% end %>
          </section>
        <% end %>

        <% if items_have_content %>
          <section class="cs-section cs-items-min">
            <h3 class="cs-section-h">Items</h3>
            <% if it[:equipped].any? %>
              <div class="cs-item-line"><em>Equipped.</em> <%= it[:equipped].map { |i| i[:name] }.join(', ') %></div>
            <% end %>
            <% if it[:consumable].any? %>
              <div class="cs-item-line"><em>Consumable.</em>
                <%= it[:consumable].map { |i| i[:quantity].to_i > 1 ? "(#{i[:quantity]}) #{i[:name]}" : i[:name] }.join(', ') %>
              </div>
            <% end %>
            <% if it[:other].any? %>
              <div class="cs-item-line"><em>Other.</em>
                <%= it[:other].map { |i| i[:quantity].to_i > 1 ? "#{i[:name]} (#{i[:quantity]})" : i[:name] }.join(', ') %>
              </div>
            <% end %>
          </section>
        <% end %>
      </div>
    <% end %>
  </div>

  <%
    abilities_have_content        = demo[:abilities].any?
    item_descriptions_have_content = demo[:item_descriptions].any?
    lower_row_has_content          = abilities_have_content || item_descriptions_have_content
    lower_one_sided                = abilities_have_content ^ item_descriptions_have_content
  %>

  <% if lower_row_has_content %>
    <div class="cs-minimal-body cs-minimal-lower<%= ' cs-one-sided' if lower_one_sided %>">
      <% if abilities_have_content %>
        <div class="cs-col cs-col-left">
          <section class="cs-section cs-abilities-min">
            <h3 class="cs-section-h">Abilities</h3>
            <% demo[:abilities].each do |ab| %>
              <details class="cs-ability-row">
                <summary><em><%= ab[:name] %></em></summary>
                <div class="cs-ability-body"><%= ab[:description] %></div>
              </details>
            <% end %>
          </section>
        </div>
      <% end %>
      <% if item_descriptions_have_content %>
        <div class="cs-col cs-col-right">
          <section class="cs-section cs-item-desc">
            <h3 class="cs-section-h">Item Descriptions</h3>
            <% demo[:item_descriptions].each do |idesc| %>
              <div class="cs-item-desc-row"><em><%= idesc[:name] %>.</em> <%= idesc[:description] %></div>
            <% end %>
          </section>
        </div>
      <% end %>
    </div>
  <% end %>

  <div class="cs-toggle">
    <% if toggle_href %>
      <a class="cs-toggle-btn" href="<%= toggle_href %>">Show full sheet</a>
    <% else %>
      <span class="cs-toggle-btn cs-toggle-static">Show full sheet</span>
    <% end %>
  </div>
</article>
