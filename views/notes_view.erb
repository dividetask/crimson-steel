  <h1>Notes & Characters</h1>
  
    <div class="section">
      <h2>DM Notes</h2>
      <% @notes.select { |n| n['owner_id'] == 0 && n['type'] != 'character' }.each do |note| %>
        <% if @is_dm or note['public'] %>
          <div class="note-item">
            <p><%= h(note['note']) %></p>
            <% if @is_dm and note['public'] %>
              <small style="color: #666;">(Public)</small>
            <% end %>
          </div>
        <% end %>
      <% end %>
      
    <% if @is_dm %>
      <form class="notes-form" method="post" action="/add_note_entry">
        <input type="hidden" name="owner_id" value="0">
        <input type="hidden" name="type" value="note">
        <label>New DM Note:</label>
        <textarea name="note" rows="3" required></textarea>
        <label>
          <input type="checkbox" name="public" value="true"> Make Public
        </label>
        <button type="submit">Add DM Note</button>
      </form>
    <% end %>
  </div>
  
  <div class="section">
    <h2>Characters of Interest</h2>
    <div class="character-list">
      <% @notes.select { |n| n['type'] == 'character' && (@is_dm || n['public']) }.each do |char| %>
        <div class="character-card">
          <div class="character-name tier-<%= char['tier'] && char['tier'] >= 0 ? char['tier'] : 'unknown' %>">
            <%= h(char['title']) %>
            <% if char['tier'] && char['tier'] >= 0 %>
              <span style="font-size: 14px; color: #666;">(Tier <%= char['tier'] %>)</span>
            <% elsif char['tier'] && char['tier'] == -1 %>
              <span style="font-size: 14px; color: #666;">(Tier ?)</span>
            <% end %>
          </div>
          <p><%= h(char['note']) %></p>
        </div>
      <% end %>
    </div>
    
    <% if @is_dm %>
      <form class="notes-form" method="post" action="/add_note_entry">
        <input type="hidden" name="owner_id" value="0">
        <input type="hidden" name="type" value="character">
        <h3>Add New Character</h3>
        <label>Character Name:</label>
        <input type="text" name="title" required>
        
        <div class="form-row">
          <div>
            <label>Tier:</label>
            <select name="tier">
              <option value="-1">Unknown</option>
              <option value="0">0 - Red</option>
              <option value="1">1 - Orange</option>
              <option value="2">2 - Yellow</option>
              <option value="3">3 - Green</option>
              <option value="4">4 - Blue</option>
            </select>
          </div>
          <div>
            <label>
              <input type="checkbox" name="public" value="true" checked> Visible to Players
            </label>
          </div>
        </div>
        
        <label>Description/Notes:</label>
        <textarea name="note" rows="3" required></textarea>
        <button type="submit">Add Character</button>
      </form>
    <% end %>
  </div>
  
  <% player_character = @characters.find { |c| c['id'] == @viewer_id } %>
  <% if player_character %>
    <div class="section">
      <h2><%= player_character['name'] %>'s Notes</h2>
      <% @notes.select { |n| n['owner_id'] == @viewer_id }.each do |note| %>
        <div class="note-item">
          <p><%= h(note['note']) %></p>
        </div>
      <% end %>
      
      <form class="notes-form" method="post" action="/add_note_entry">
        <input type="hidden" name="owner_id" value="<%= @viewer_id %>">
        <input type="hidden" name="type" value="note">
        <input type="hidden" name="public" value="false">
        <label>Add Note:</label>
        <textarea name="note" rows="3" required></textarea>
        <button type="submit">Add Note</button>
      </form>
    </div>
  <% end %>
