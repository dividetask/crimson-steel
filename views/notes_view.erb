  <h1>Notes & Characters</h1>

  <% max_chapter = @notes.map { |n| n['chapter'] }.compact.max || 1 %>
  <%
    chapter_names = {}
    @notes.select { |n| n['type'] == 'chapter_title' }.each do |n|
      chapter_names[n['chapter']] = n['title'] if n['chapter']
    end
  %>
  <div class="chapter-filter">
    <label>Chapter:</label>
    <a href="/notes/<%= @viewer_id %>" class="chapter-btn <%= 'active' if @current_chapter.nil? %>">All</a>
    <% (1..max_chapter).each do |ch| %>
      <a href="/notes/<%= @viewer_id %>?chapter=<%= ch %>" class="chapter-btn <%= 'active' if @current_chapter == ch %>"><%= chapter_names[ch] || "Chapter #{ch}" %></a>
    <% end %>
  </div>

  <%
    filtered_notes = @notes.reject { |n| n['draft'] }
    if @current_chapter
      filtered_notes = filtered_notes.select { |n|
        n['chapter'].nil? || n['chapter'] == @current_chapter || (n['active'] && n['chapter'] < @current_chapter)
      }
    end
  %>

    <div class="section">
      <h2>DM Notes</h2>
      <% filtered_notes.select { |n| n['owner_id'] == 0 && n['type'] != 'character' && n['type'] != 'chapter_title' }.each do |note| %>
        <% if @is_dm or note['public'] %>
          <div class="note-item">
            <% if note['title'] %>
              <strong><%= h(note['title']) %></strong>
            <% end %>
            <% note_lines = h(note['note']).split("\n").length %>
            <p class="note-text<%= ' collapsed' if note_lines > 3 %>"><%= h(note['note']).gsub("\n", "<br>") %></p>
            <% if note_lines > 3 %>
              <button class="note-toggle" onclick="toggleNote(this)">Show more</button>
            <% end %>
            <% if @is_dm %>
              <small style="color: #666;">
                <%= note['public'] ? '(Public)' : '(DM Only)' %>
                <%= "Ch.#{note['chapter']}" if note['chapter'] %>
                <%= '(Active)' if note['active'] %>
              </small>
            <% end %>
          </div>
        <% end %>
      <% end %>

    <% if @is_dm %>
      <form class="notes-form" method="post" action="/add_note_entry">
        <input type="hidden" name="owner_id" value="0">
        <input type="hidden" name="type" value="note">
        <label>New DM Note:</label>
        <input type="text" name="title" placeholder="Title (optional)">
        <textarea name="note" rows="3" required></textarea>
        <div class="form-row">
          <div>
            <label>Chapter:</label>
            <input type="number" name="chapter" min="1" value="<%= max_chapter %>" style="width: 60px;">
          </div>
          <div>
            <label>
              <input type="checkbox" name="public" value="true"> Make Public
            </label>
          </div>
          <div>
            <label>
              <input type="checkbox" name="active" value="true"> Active
            </label>
          </div>
        </div>
        <button type="submit">Add DM Note</button>
      </form>

      <form class="notes-form" method="post" action="/add_note_entry" style="margin-top: 10px;">
        <input type="hidden" name="owner_id" value="0">
        <input type="hidden" name="type" value="chapter_title">
        <input type="hidden" name="public" value="true">
        <input type="hidden" name="note" value="">
        <h3>Set Chapter Name</h3>
        <div class="form-row">
          <div>
            <label>Chapter:</label>
            <input type="number" name="chapter" min="1" value="<%= max_chapter %>" style="width: 60px;">
          </div>
          <div>
            <label>Name:</label>
            <input type="text" name="title" required>
          </div>
        </div>
        <button type="submit">Set Name</button>
      </form>
    <% end %>
  </div>

  <div class="section">
    <h2>Characters of Interest</h2>
    <div class="character-list">
      <% filtered_notes.select { |n| n['type'] == 'character' && (@is_dm || n['public']) }.each do |char| %>
        <div class="character-card">
          <% if char['image_path'] && !char['image_path'].to_s.empty? %>
            <img src="<%= h(char['image_path']) %>" alt="<%= h(char['title']) %>" class="character-card-img zoomable">
          <% end %>
          <div class="character-name tier-<%= char['tier'] && char['tier'] >= 0 ? char['tier'] : 'unknown' %>">
            <%= h(char['title']) %>
            <% if char['tier'] && char['tier'] >= 0 %>
              <span style="font-size: 14px; color: #666;">(Tier <%= char['tier'] %>)</span>
            <% elsif char['tier'] && char['tier'] == -1 %>
              <span style="font-size: 14px; color: #666;">(Tier ?)</span>
            <% end %>
          </div>
          <p><%= h(char['note']) %></p>
          <% if @is_dm %>
            <small style="color: #666;">
              <%= char['public'] ? '(Public)' : '(DM Only)' %>
              <%= "Ch.#{char['chapter']}" if char['chapter'] %>
              <%= '(Active)' if char['active'] %>
              · <%= char['in_scene'] ? 'In scene' : 'Not in scene' %>
              · <% svt = Array(char['scene_visible_to']) %>
              <%= svt.any? ? "Players see in scene (#{svt.length})" : 'Hidden from players in scene' %>
            </small>
            <div class="character-card-actions">
              <form method="post" action="/notes/character/toggle_in_scene" style="display:inline;">
                <input type="hidden" name="id" value="<%= h(char['id']) %>">
                <button type="submit"><%= char['in_scene'] ? 'Remove from scene' : 'Add to scene' %></button>
              </form>
              <form method="post" action="/notes/character/toggle_scene_visible" style="display:inline;">
                <input type="hidden" name="id" value="<%= h(char['id']) %>">
                <button type="submit"><%= svt.any? ? 'Hide from all players in scene' : 'Show to all players in scene' %></button>
              </form>
              <form method="post" action="/notes/character/toggle_public" style="display:inline;">
                <input type="hidden" name="id" value="<%= h(char['id']) %>">
                <button type="submit"><%= char['public'] ? 'Make DM-only on notes' : 'Make public on notes' %></button>
              </form>
              <form method="post" action="/notes/character/image" enctype="multipart/form-data" class="character-card-img-form">
                <input type="hidden" name="id" value="<%= h(char['id']) %>">
                <input type="file" name="image" accept="image/*" required>
                <button type="submit"><%= char['image_path'] ? 'Replace image' : 'Attach image' %></button>
              </form>
              <% if char['image_path'] %>
                <form method="post" action="/notes/character/image/clear" style="display:inline;">
                  <input type="hidden" name="id" value="<%= h(char['id']) %>">
                  <button type="submit">Remove image</button>
                </form>
              <% end %>
              <form method="post" action="/notes/character/delete" style="display:inline;">
                <input type="hidden" name="id" value="<%= h(char['id']) %>">
                <button type="submit" class="danger" onclick="return confirm('Delete this character?');">Delete</button>
              </form>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>

    <% if @is_dm %>
      <form class="notes-form" method="post" action="/add_note_entry">
        <input type="hidden" name="owner_id" value="0">
        <input type="hidden" name="type" value="character">
        <h3>Add New Character</h3>
        <label>Character Name:</label>
        <input type="text" name="title" required>

        <div class="form-row">
          <div>
            <label>Tier:</label>
            <select name="tier">
              <option value="-1">Unknown</option>
              <option value="0">0 - Red</option>
              <option value="1">1 - Orange</option>
              <option value="2">2 - Yellow</option>
              <option value="3">3 - Green</option>
              <option value="4">4 - Blue</option>
            </select>
          </div>
          <div>
            <label>Chapter:</label>
            <input type="number" name="chapter" min="1" value="<%= max_chapter %>" style="width: 60px;">
          </div>
          <div>
            <label>
              <input type="checkbox" name="public" value="true" checked> Visible to Players
            </label>
          </div>
          <div>
            <label>
              <input type="checkbox" name="active" value="true" checked> Active
            </label>
          </div>
        </div>

        <label>Description/Notes:</label>
        <textarea name="note" rows="3" required></textarea>
        <button type="submit">Add Character</button>
      </form>
    <% end %>
  </div>

  <% image_notes = filtered_notes.select { |n| n['type'] == 'image' && (@is_dm || n['public']) } %>
  <% if image_notes.any? %>
    <div class="section">
      <h2>Scene Images</h2>
      <div class="note-image-grid">
        <% image_notes.each do |img| %>
          <figure class="note-image-item">
            <img src="<%= h(img['image_path']) %>" alt="<%= h(img['title']) %>" class="note-image zoomable">
            <% if img['title'] && !img['title'].to_s.empty? %>
              <figcaption><%= h(img['title']) %></figcaption>
            <% end %>
            <% if @is_dm %>
              <small style="color:#666;">
                <%= img['public'] ? '(Public)' : '(DM Only)' %>
                <%= "Ch.#{img['chapter']}" if img['chapter'] %>
              </small>
            <% end %>
          </figure>
        <% end %>
      </div>
    </div>
  <% end %>

  <% player_character = @characters.find { |c| c['id'] == @viewer_id } %>
  <% if player_character %>
    <div class="section">
      <h2><%= player_character['name'] %>'s Notes</h2>
      <% filtered_notes.select { |n| n['owner_id'] == @viewer_id }.each do |note| %>
        <div class="note-item">
          <% if note['title'] %>
            <strong><%= h(note['title']) %></strong>
          <% end %>
          <% note_lines = h(note['note']).split("\n").length %>
          <p class="note-text<%= ' collapsed' if note_lines > 3 %>"><%= h(note['note']).gsub("\n", "<br>") %></p>
          <% if note_lines > 3 %>
            <button class="note-toggle" onclick="toggleNote(this)">Show more</button>
          <% end %>
        </div>
      <% end %>

      <form class="notes-form" method="post" action="/add_note_entry">
        <input type="hidden" name="owner_id" value="<%= @viewer_id %>">
        <input type="hidden" name="type" value="note">
        <input type="hidden" name="public" value="false">
        <label>Add Note:</label>
        <input type="text" name="title" placeholder="Title (optional)">
        <textarea name="note" rows="3" required></textarea>
        <button type="submit">Add Note</button>
      </form>
    </div>
  <% end %>
