<!DOCTYPE html>
<html>
<head>
  <title>Notes</title>
  <style>
    body { font-family: Arial, sans-serif; max-width: 1000px; margin: 20px auto; padding: 20px; }
    .section { margin-bottom: 30px; border: 1px solid #ccc; padding: 15px; }
    .section h2 { margin-top: 0; border-bottom: 2px solid #333; padding-bottom: 10px; }
    
    .character-list { display: grid; gap: 15px; }
    .character-card { border: 1px solid #ddd; padding: 10px; border-radius: 5px; }
    .character-name { font-size: 18px; font-weight: bold; margin-bottom: 5px; }
    .tier-0 { color: #d32f2f; } /* red */
    .tier-1 { color: #f57c00; } /* orange */
    .tier-2 { color: #fbc02d; } /* yellow */
    .tier-3 { color: #388e3c; } /* green */
    .tier-4 { color: #1976d2; } /* blue */
    
    .note-item { margin-bottom: 10px; padding: 10px; background: #f5f5f5; border-radius: 5px; }
    .note-item p { margin: 0; }
    
    form { display: grid; gap: 10px; margin-top: 15px; padding: 15px; background: #e3f2fd; border-radius: 5px; }
    label { font-weight: bold; }
    input, textarea, select { padding: 8px; font-size: 14px; width: 100%; box-sizing: border-box; }
    button { padding: 10px; background: #4CAF50; color: white; border: none; cursor: pointer; font-size: 16px; }
    button:hover { background: #45a049; }
    .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  </style>
</head>
<body>
  <h1>Notes & Characters</h1>
  
    <div class="section">
      <h2>DM Notes</h2>
      <% @notes.select { |n| n['owner_id'] == 0 && n['type'] != 'character' }.each do |note| %>
        <% if @is_dm or note['public'] %>
          <div class="note-item">
            <p><%= note['note'] %></p>
            <% if @is_dm and note['public'] %>
              <small style="color: #666;">(Public)</small>
            <% end %>
          </div>
        <% end %>
      <% end %>
      
    <% if @is_dm %>
      <form method="post" action="/add_note_entry">
        <input type="hidden" name="owner_id" value="0">
        <input type="hidden" name="type" value="note">
        <label>New DM Note:</label>
        <textarea name="note" rows="3" required></textarea>
        <label>
          <input type="checkbox" name="public" value="true"> Make Public
        </label>
        <button type="submit">Add DM Note</button>
      </form>
    <% end %>
  </div>
  
  <div class="section">
    <h2>Characters of Interest</h2>
    <div class="character-list">
      <% @notes.select { |n| n['type'] == 'character' && (@is_dm || n['public']) }.each do |char| %>
        <div class="character-card">
          <div class="character-name tier-<%= char['tier'] || 0 %>">
            <%= char['title'] %>
            <% if char['tier'] %>
              <span style="font-size: 14px; color: #666;">(Tier <%= char['tier'] %>)</span>
            <% end %>
          </div>
          <p><%= char['note'] %></p>
        </div>
      <% end %>
    </div>
    
    <% if @is_dm %>
      <form method="post" action="/add_note_entry">
        <input type="hidden" name="owner_id" value="0">
        <input type="hidden" name="type" value="character">
        <h3>Add New Character</h3>
        <label>Character Name:</label>
        <input type="text" name="title" required>
        
        <div class="form-row">
          <div>
            <label>Tier:</label>
            <select name="tier">
              <option value="0">0 - Red</option>
              <option value="1">1 - Orange</option>
              <option value="2">2 - Yellow</option>
              <option value="3">3 - Green</option>
              <option value="4">4 - Blue</option>
            </select>
          </div>
          <div>
            <label>
              <input type="checkbox" name="public" value="true" checked> Visible to Players
            </label>
          </div>
        </div>
        
        <label>Description/Notes:</label>
        <textarea name="note" rows="3" required></textarea>
        <button type="submit">Add Character</button>
      </form>
    <% end %>
  </div>
  
  <% player_character = @characters.find { |c| c['id'] == @viewer_id } %>
  <% if player_character %>
    <div class="section">
      <h2><%= player_character['name'] %>'s Notes</h2>
      <% @notes.select { |n| n['owner_id'] == @viewer_id }.each do |note| %>
        <div class="note-item">
          <p><%= note['note'] %></p>
        </div>
      <% end %>
      
      <form method="post" action="/add_note_entry">
        <input type="hidden" name="owner_id" value="<%= @viewer_id %>">
        <input type="hidden" name="type" value="note">
        <input type="hidden" name="public" value="false">
        <label>Add Note:</label>
        <textarea name="note" rows="3" required></textarea>
        <button type="submit">Add Note</button>
      </form>
    </div>
  <% end %>
  
  <p><a href="/character/0">Back to Characters</a></p>
</body>
</html>
