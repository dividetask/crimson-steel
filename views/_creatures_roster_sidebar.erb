<%
  # Creatures Roster Sidebar Stub —
  # docs/common/ui/creatures_roster_sidebar_stub.md
  #
  # Locals:
  #   roster        — required. { players:, npcs:, enemies:,
  #                   templates:, encounter_tables: }. Creature rows
  #                   carry { id, name, copy_count, sheet_index };
  #                   Player rows additionally carry { active }.
  #                   Encounter rows carry { table_id, name }.
  #   current_index — optional. The sheet_index currently being shown.
  #   detail        — optional. 'minimal' or 'full' (default minimal);
  #                   passed through on the row's href.
  current_index = defined?(current_index) ? current_index : nil
  detail_mode   = defined?(detail)        ? detail        : 'minimal'
%>

<aside class="cs-roster-sidebar">
  <details class="cs-roster-group" data-group-key="players">
    <summary class="cs-roster-summary">Players</summary>
    <% players = roster[:players] || [] %>
    <% if players.empty? %>
      <div class="cs-roster-empty">—</div>
    <% else %>
      <ul class="cs-roster-list">
        <% players.each do |row| %>
          <%
            active = row[:active] != false # default true
          %>
          <li class="cs-roster-row cs-roster-player<%= ' cs-roster-current' if current_index && row[:sheet_index] == current_index %><%= ' cs-player-absent' unless active %>"
              data-creature-id="<%= row[:id] %>">
            <button type="button"
                    class="cs-roster-btn cs-player-toggle <%= active ? 'cs-player-active' : 'cs-player-absent' %>"
                    aria-pressed="<%= active %>"
                    title="<%= active ? 'Mark absent' : 'Mark active' %>">
              <%= active ? 'Active' : 'Absent' %>
            </button>
            <a class="cs-roster-name" href="/character-sheets?i=<%= row[:sheet_index] %>&detail=<%= detail_mode %>"><%= row[:name] %></a>
          </li>
        <% end %>
      </ul>
    <% end %>
  </details>

  <% [
       { key: :npcs,      label: 'NPCs',               open: false },
       { key: :enemies,   label: 'Enemies',            open: true  },
       { key: :templates, label: 'Creature Templates', open: true  }
     ].each do |g| %>
    <details class="cs-roster-group" <%= 'open' if g[:open] %> data-group-key="<%= g[:key] %>">
      <summary class="cs-roster-summary"><%= g[:label] %></summary>
      <% rows = roster[g[:key]] || [] %>
      <% if rows.empty? %>
        <div class="cs-roster-empty">—</div>
      <% else %>
        <ul class="cs-roster-list">
          <% rows.each do |row| %>
            <li class="cs-roster-row<%= ' cs-roster-current' if current_index && row[:sheet_index] == current_index %>">
              <button type="button" class="cs-roster-btn cs-roster-add" title="Add to combat" aria-label="Add to combat" disabled>+</button>
              <a class="cs-roster-name" href="/character-sheets?i=<%= row[:sheet_index] %>&detail=<%= detail_mode %>"><%= row[:name] %></a>
              <% if row[:copy_count].to_i > 0 %>
                <span class="cs-roster-count"><%= row[:copy_count] %></span>
              <% end %>
              <button type="button" class="cs-roster-btn cs-roster-remove" title="Remove from combat" aria-label="Remove from combat" disabled>&minus;</button>
            </li>
          <% end %>
        </ul>
      <% end %>
    </details>
  <% end %>

  <details class="cs-roster-group" open data-group-key="encounter_tables">
    <summary class="cs-roster-summary">Encounter Tables</summary>
    <% encs = roster[:encounter_tables] || [] %>
    <% if encs.empty? %>
      <div class="cs-roster-empty">—</div>
    <% else %>
      <ul class="cs-roster-list">
        <% encs.each do |row| %>
          <li class="cs-roster-row cs-roster-encounter">
            <a class="cs-roster-name cs-encounter-link"
               href="/character-sheets?encounter_template=<%= row[:table_id] %>&i=<%= current_index || 0 %>&detail=<%= detail_mode %>"
               data-table-id="<%= row[:table_id] %>"><%= row[:name] %></a>
            <button type="button"
                    class="cs-roster-btn cs-roster-roll cs-encounter-roll-btn"
                    data-table-id="<%= row[:table_id] %>"
                    data-table-name="<%= row[:name] %>"
                    title="Roll encounter"
                    aria-label="Roll encounter">Roll</button>
          </li>
        <% end %>
      </ul>
    <% end %>
  </details>
</aside>
