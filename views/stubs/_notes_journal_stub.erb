<div class="notes-journal-stub" data-stub-id="<%= stub_id %>" data-dm-view="<%= dm_view ? '1' : '0' %>">
<% if entries.empty? %>
  <p class="notes-empty">No journal entries yet.</p>
<% else %>
  <ul class="notes-journal-list">
    <% entries.each do |e| %>
      <li class="notes-journal-item" data-note-id="<%= h e['id'] %>">
        <% if e['title'] %><div class="notes-journal-title"><%= h e['title'] %></div><% end %>
        <div class="notes-journal-body"><%= h(e['note']).gsub("\n", '<br>') %></div>
        <div class="notes-journal-meta">
          <% if e['chapter']         %><span class="notes-meta-chip">Ch. <%= h e['chapter'] %></span><% end %>
          <% if e['public'] == false %><span class="notes-meta-chip notes-meta-private">DM only</span><% end %>
          <% if e['active']          %><span class="notes-meta-chip notes-meta-active">Active</span><% end %>
        </div>
        <% if editable %>
          <details class="notes-journal-edit">
            <summary>Edit</summary>
            <form method="post" action="/notes/journal/update" class="notes-journal-form">
              <input type="hidden" name="id" value="<%= h e['id'] %>">
              <label>Title <input type="text" name="title" value="<%= h e['title'] %>"></label>
              <label>Chapter <input type="number" name="chapter" min="1" value="<%= h e['chapter'] %>"></label>
              <label>Note
                <textarea name="note" rows="4"><%= h e['note'] %></textarea>
              </label>
              <label class="notes-journal-flag">
                <input type="checkbox" name="public" value="1" <%= 'checked' if e['public'] %>>
                <input type="hidden" name="public_set" value="1">
                Public
              </label>
              <label class="notes-journal-flag">
                <input type="checkbox" name="active" value="1" <%= 'checked' if e['active'] %>>
                <input type="hidden" name="active_set" value="1">
                Active
              </label>
              <div class="notes-journal-actions">
                <button type="submit">Save</button>
              </div>
            </form>
            <form method="post" action="/notes/journal/delete" class="notes-journal-delete-form"
                  onsubmit="return confirm('Delete this note?');">
              <input type="hidden" name="id" value="<%= h e['id'] %>">
              <button type="submit" class="notes-journal-delete-btn">Delete</button>
            </form>
          </details>
        <% end %>
      </li>
    <% end %>
  </ul>
<% end %>
</div>
