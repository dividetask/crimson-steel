<div class="melee-attack-stub" data-stub-id="<%= stub_id %>">
  <div class="melee-attack-title"><%= h(title) %></div>
  <div class="melee-attack-attacker">
    <strong><%= h(attacker['name']) %></strong>
    &mdash; <%= h(attacker['skill']['name']) %>
    (bonus +<%= attacker['skill']['bonus'].to_i %>,
     dice <%= attacker['skill']['dice'].to_i %>,
     ranks <%= attacker['skill']['ranks'].to_i %>)
  </div>

  <div class="melee-attack-steps" id="melee-steps-<%= stub_id %>"></div>
</div>
<script>
(function() {
  window.meleeAttackConfigs = window.meleeAttackConfigs || {};
  window.meleeAttackConfigs[<%= stub_id.to_json %>] = {
    stubId:        <%= stub_id.to_json %>,
    attacker:      <%= attacker.to_json %>,
    targets:       <%= targets.to_json %>,
    allyReactions: <%= ally_reactions.to_json %>,
    luckSources:   <%= luck_sources.to_json %>,
    dieSize:       <%= die_size.to_i %>,
    baseTn:        <%= base_tn.to_i %>
  };
  if (window.meleeAttackInit) window.meleeAttackInit(<%= stub_id.to_json %>);
})();
</script>
