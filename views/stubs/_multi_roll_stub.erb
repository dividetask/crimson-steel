<div class="multi-roll-stub" data-stub-id="<%= stub_id %>">
  <div class="multi-roll-head">
    <span class="multi-roll-title"><%= h(title) %></span>
    <button type="button" class="multi-roll-roll-all"
            onclick="multiRollRollAll('<%= stub_id %>')">Roll All</button>
    <button type="button" class="multi-roll-confirm"
            onclick="multiRollConfirm('<%= stub_id %>')">Confirm All</button>
  </div>
  <table class="multi-roll-table">
    <thead>
      <tr>
        <th>Check</th>
        <th>Roll</th>
        <th>Dice</th>
        <th>Result</th>
      </tr>
    </thead>
    <tbody>
      <% rolls.each do |r| %>
        <%
          row_id = "#{stub_id}-#{r[:key] || r['key']}"
          label  = r[:label] || r['label']
          dice   = (r[:dice_count] || r['dice_count']).to_i
          tn     = (r[:tn] || r['tn']).to_i
          start  = (r[:starting_value] || r['starting_value']).to_i
          luck   = (r[:luck_amount] || r['luck_amount']).to_i
          unset  = (r[:unsettling_amount] || r['unsettling_amount']).to_i
          luck_label  = r[:luck_label]  || r['luck_label']  || 'Bardic'
          unset_label = r[:unsettling_label] || r['unsettling_label'] || 'Unsettling'
        %>
        <tr data-row-id="<%= row_id %>">
          <td class="multi-roll-name">
            <strong><%= h(label) %></strong>
            <div class="multi-roll-meta"><%= dice %> dice @ TN <%= tn %><%= start != 0 ? " (start #{start})" : '' %></div>
          </td>
          <td class="multi-roll-controls">
            <button type="button" class="multi-roll-row-roll"
                    onclick="multiRollRow('<%= stub_id %>', '<%= h(row_id) %>')">Roll</button>
            <% if luck > 0 %>
              <button type="button" class="multi-roll-row-luck multi-roll-row-bardic" disabled
                      onclick="multiRollReroll('<%= stub_id %>', '<%= h(row_id) %>', <%= luck %>)">+<%= luck %> <%= h(luck_label) %></button>
            <% end %>
            <% if unset > 0 %>
              <button type="button" class="multi-roll-row-luck multi-roll-row-unsettling" disabled
                      onclick="multiRollReroll('<%= stub_id %>', '<%= h(row_id) %>', <%= -unset %>)">-<%= unset %> <%= h(unset_label) %></button>
            <% end %>
          </td>
          <td class="multi-roll-dice" id="multi-roll-dice-<%= h(row_id) %>"></td>
          <td class="multi-roll-result" id="multi-roll-result-<%= h(row_id) %>">&mdash;</td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
<script>
(function() {
  window.multiRollConfigs = window.multiRollConfigs || {};
  window.multiRollConfigs[<%= stub_id.to_json %>] = {
    stubId: <%= stub_id.to_json %>,
    rows: <%= rolls.map { |r|
                {
                  key:               r[:key]               || r['key'],
                  rowId:             "#{stub_id}-#{r[:key] || r['key']}",
                  label:             r[:label]             || r['label'],
                  diceCount:         (r[:dice_count]       || r['dice_count']).to_i,
                  tn:                (r[:tn]               || r['tn']).to_i,
                  startingValue:     (r[:starting_value]   || r['starting_value']).to_i,
                  luckAmount:        (r[:luck_amount]      || r['luck_amount']).to_i,
                  unsettlingAmount:  (r[:unsettling_amount] || r['unsettling_amount']).to_i,
                  token:             nil,
                  successes:         nil,
                  criticals:         nil
                }
              }.to_json %>
  };
})();
</script>
