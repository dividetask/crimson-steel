<div class="notes-map-stub" data-stub-id="<%= stub_id %>" data-dm-view="<%= dm_view ? '1' : '0' %>">
<% if entries.empty? %>
  <p class="notes-empty">No maps yet.</p>
<% else %>
  <% entries.each do |e|
       map_id    = e['id']
       base_w_sq = e['width_squares']  || 8
       base_h_sq = e['height_squares'] || 5
       settings  = scene_state ? scene_state.map_settings_for(map_id, base_label: e['label'], base_w: base_w_sq, base_h: base_h_sq) :
                                 { 'label' => e['label'].to_s, 'w' => base_w_sq, 'h' => base_h_sq }
       sq        = NotesState::SQUARE_PX
       width     = settings['w'] * sq
       height    = settings['h'] * sq
       label     = settings['label']

       base    = e['objects'] || []
       objects = scene_state ? scene_state.objects_for(map_id, base) : base
       arrows  = scene_state ? scene_state.arrows_for(map_id)        : []
       shapes  = scene_state ? scene_state.shapes_for(map_id)        : []
       by_id   = objects.each_with_object({}) { |o, h| h[o['id']] = o }
  %>
    <figure class="notes-map-card"
            data-map-id="<%= h map_id %>"
            data-can-draw="<%= can_draw ? '1' : '0' %>"
            data-base-w="<%= width %>"
            data-base-h="<%= height %>">
      <% unless label.to_s.empty? %>
        <figcaption class="notes-map-label"><%= h label %></figcaption>
      <% end %>

      <div class="notes-map-workspace">
        <% if interactive
             can_use_arrows = dm_view || can_draw %>
          <div class="notes-map-toolbar">
            <button type="button" class="notes-map-tool-btn" data-tool="view"
                    title="View (drag to pan, double-click to zoom in, right-click to zoom out)">&#9776;</button>

            <% if can_use_arrows %>
              <button type="button" class="notes-map-tool-btn notes-map-arrow-tool-btn"
                      data-tool="arrow" data-arrow-type="attack"
                      style="--arrow-color:#c62828"
                      title="Attack arrow">&#10142;</button>
              <button type="button" class="notes-map-tool-btn notes-map-arrow-tool-btn"
                      data-tool="arrow" data-arrow-type="move-hurry"
                      style="--arrow-color:#ef6c00"
                      title="Move arrow (hurry)">&#10142;</button>
              <button type="button" class="notes-map-tool-btn notes-map-arrow-tool-btn"
                      data-tool="arrow" data-arrow-type="move-sneak"
                      style="--arrow-color:#6a1b9a"
                      title="Move arrow (sneak)">&#10142;</button>
              <button type="button" class="notes-map-tool-btn notes-map-arrow-tool-btn"
                      data-tool="arrow" data-arrow-type="move-carefully"
                      style="--arrow-color:#2e7d32"
                      title="Move arrow (carefully)">&#10142;</button>
            <% end %>

            <% if dm_view %>
              <button type="button" class="notes-map-tool-btn" data-tool="move"      title="Move tokens / icons">&#10021;</button>
              <button type="button" class="notes-map-tool-btn" data-tool="delete"    title="Delete (click an item)">&#9986;</button>
              <button type="button" class="notes-map-tool-btn notes-map-shape-tool-btn"
                      data-tool="add-shape"
                      title="Add shape (hold to pick)">&#9645;</button>
              <button type="button" class="notes-map-tool-btn" data-tool="add-icon"  title="Add icon">&#9733;</button>
              <button type="button" class="notes-map-tool-btn" data-tool="add-image" title="Add image token">&#x1F5BC;</button>
            <% end %>

            <hr>
            <button type="button" class="notes-map-zoom-btn" data-zoom="in"    title="Zoom in">+</button>
            <button type="button" class="notes-map-zoom-btn" data-zoom="reset" title="Reset zoom">&#9874;</button>
            <button type="button" class="notes-map-zoom-btn" data-zoom="out"   title="Zoom out">&minus;</button>
          </div>
        <% end %>

        <div class="notes-map-frame">
          <svg viewBox="0 0 <%= width %> <%= height %>" preserveAspectRatio="xMidYMid meet"
               xmlns="http://www.w3.org/2000/svg" class="notes-map-svg"
               data-interactive="<%= interactive ? '1' : '0' %>"
               data-tool="view"
               data-map-w="<%= width %>" data-map-h="<%= height %>">
            <defs>
              <% NOTES_MAP_ARROW_TYPES.each do |t|
                   style = NOTES_MAP_ARROW_STYLES[t] %>
                <marker id="arrowhead-<%= map_id %>-<%= t %>" viewBox="0 0 10 10"
                        refX="8" refY="5" markerWidth="6" markerHeight="6"
                        orient="auto-start-reverse">
                  <path d="M 0 0 L 10 5 L 0 10 z" fill="<%= style[:color] %>"/>
                </marker>
              <% end %>
            </defs>

            <%# Background — pale grid sized in 50-px squares. %>
            <rect width="<%= width %>" height="<%= height %>" fill="#eef1e8"/>
            <g stroke="#c5cdb4" stroke-width="1">
              <% (1...settings['w']).each do |i| %>
                <line x1="<%= i*sq %>" y1="0" x2="<%= i*sq %>" y2="<%= height %>"/>
              <% end %>
              <% (1...settings['h']).each do |j| %>
                <line x1="0" y1="<%= j*sq %>" x2="<%= width %>" y2="<%= j*sq %>"/>
              <% end %>
            </g>

            <%# DM-placed shapes. %>
            <% shapes.each do |s| %>
              <g class="notes-map-shape notes-map-shape-<%= h s['kind'] %>"
                 data-shape-id="<%= h s['id'] %>"
                 transform="translate(<%= s['x'] %>,<%= s['y'] %>)">
                <% if s['kind'] == 'rect' %>
                  <rect x="<%= -s['w']/2 %>" y="<%= -s['h']/2 %>"
                        width="<%= s['w'] %>" height="<%= s['h'] %>"
                        fill="<%= h s['fill'] %>" stroke="<%= h s['stroke'] %>" stroke-width="1.5"/>
                <% elsif s['kind'] == 'ellipse' %>
                  <ellipse rx="<%= s['rx'] %>" ry="<%= s['ry'] %>"
                           fill="<%= h s['fill'] %>" stroke="<%= h s['stroke'] %>" stroke-width="1.5"/>
                <% end %>
              </g>
            <% end %>

            <%# Emoji icons (DM-placed). Rendered as <text> with
                font-size = icon size. Each icon is centered on its
                (x, y); SVG text dominant-baseline gives consistent
                vertical centering across browsers. %>
            <% icons = scene_state ? scene_state.icons_for(map_id) : [] %>
            <% icons.each do |i| %>
              <text class="notes-map-icon"
                    data-icon-id="<%= h i['id'] %>"
                    x="<%= i['x'] %>" y="<%= i['y'] %>"
                    text-anchor="middle" dominant-baseline="central"
                    font-size="<%= i['size'] %>"><%= h i['glyph'] %></text>
            <% end %>

            <%# Image tokens (DM-placed). Each is one square wide
                by default; we wrap the <image> in a <g transform>
                with the inner image offset by -size/2 so dragging
                via translate() works the same as for objects and
                shapes. %>
            <% map_images = scene_state ? scene_state.map_images_for(map_id) : [] %>
            <% map_images.each do |mi|
                 sz = mi['size'] || sq %>
              <g class="notes-map-image"
                 data-image-id="<%= h mi['id'] %>"
                 transform="translate(<%= mi['x'] %>,<%= mi['y'] %>)">
                <image href="<%= h mi['src'] %>"
                       x="<%= -sz/2.0 %>" y="<%= -sz/2.0 %>"
                       width="<%= sz %>" height="<%= sz %>"
                       preserveAspectRatio="xMidYMid slice"/>
              </g>
            <% end %>

            <%# Arrows beneath objects. %>
            <% arrows.each do |a|
                 style = NOTES_MAP_ARROW_STYLES[a['type']]
                 next unless style
                 from_xy = NotesState.resolve_endpoint(a, 'from', by_id)
                 to_xy   = NotesState.resolve_endpoint(a, 'to',   by_id)
                 next unless from_xy && to_xy
                 own = current_user && a['device_id'] == current_user.device_id
                 can_remove = interactive && (dm_view || own)
                 mid_x = (from_xy[0] + to_xy[0]) / 2.0
                 mid_y = (from_xy[1] + to_xy[1]) / 2.0 %>
              <g class="notes-map-arrow-group" data-arrow-id="<%= h a['id'] %>">
                <line class="notes-map-arrow" data-arrow-type="<%= h a['type'] %>"
                      x1="<%= from_xy[0] %>" y1="<%= from_xy[1] %>"
                      x2="<%= to_xy[0]   %>" y2="<%= to_xy[1]   %>"
                      stroke="<%= style[:color] %>" stroke-width="<%= style[:width] %>"
                      <%= "stroke-dasharray=\"#{style[:dash]}\"" if style[:dash] %>
                      marker-end="url(#arrowhead-<%= map_id %>-<%= a['type'] %>)"/>
                <% if can_remove %>
                  <g class="notes-map-arrow-remove"
                     transform="translate(<%= '%.1f' % mid_x %>,<%= '%.1f' % mid_y %>)"
                     data-arrow-id="<%= h a['id'] %>">
                    <circle r="7" fill="#fff" stroke="<%= style[:color] %>" stroke-width="1.5"/>
                    <text x="0" y="3" text-anchor="middle"
                          font-family="Arial,sans-serif" font-size="10"
                          fill="<%= style[:color] %>" pointer-events="none">&#x2715;</text>
                  </g>
                <% end %>
              </g>
            <% end %>

            <%# Objects (tokens) on top — glyph picked per kind. %>
            <% objects.each do |o|
                 fill, stroke, glyph = notes_map_object_style(o['kind']) %>
              <g class="notes-map-object notes-map-object-<%= h o['kind'] %>"
                 data-object-id="<%= h o['id'] %>"
                 data-label="<%= h o['label'] %>"
                 transform="translate(<%= o['x'] %>,<%= o['y'] %>)">
                <% case glyph
                   when :circle %>
                  <circle r="9" fill="<%= fill %>" stroke="<%= stroke %>" stroke-width="1.5"/>
                <% when :rect %>
                  <rect x="-14" y="-10" width="28" height="20"
                        fill="<%= fill %>" stroke="<%= stroke %>" stroke-width="1.5"/>
                <% when :triangle %>
                  <polygon points="0,-11 10,8 -10,8"
                           fill="<%= fill %>" stroke="<%= stroke %>" stroke-width="1.5"/>
                <% when :diamond %>
                  <polygon points="0,-11 11,0 0,11 -11,0"
                           fill="<%= fill %>" stroke="<%= stroke %>" stroke-width="1.5"/>
                <% end %>
                <text x="0" y="-14" text-anchor="middle"
                      font-family="Arial,sans-serif" font-size="9" fill="#333"><%= h o['label'] %></text>
              </g>
            <% end %>
          </svg>
        </div>
      </div>

      <% if e['caption'] %>
        <figcaption class="notes-map-caption">
          <%= h e['caption'] %>
          <% if e['public'] == false %><span class="notes-meta-chip notes-meta-private">DM only</span><% end %>
          <% if e['active']          %><span class="notes-meta-chip notes-meta-active">Active</span><% end %>
        </figcaption>
      <% end %>

      <% if interactive %>
        <div class="notes-map-controls">

          <%# Per-tool inline panels. Hidden by default; the JS un-
              hides whichever matches the active tool. %>

          <%# Arrow tool status line — shown while the arrow tool is
              active. The tool buttons themselves now live in the
              left-hand toolbar (one per arrow type). %>
          <% if dm_view || can_draw %>
            <div class="notes-map-arrow-controls" data-tool="arrow" hidden>
              <span class="notes-map-arrow-status">Click two points (token or empty) to draw an arrow.</span>
            </div>
          <% elsif !dm_view %>
            <div class="notes-map-wait-turn">
              Wait for your turn to draw arrows.
            </div>
          <% end %>

          <% if dm_view %>
            <div class="notes-map-add-shape" data-tool="add-shape" hidden>
              <div class="notes-map-shape-colors">
                <span class="notes-map-shape-color-label">Color:</span>
                <button type="button" class="notes-map-shape-color-btn"
                        data-color="" title="No fill (outline only)">&times;</button>
                <% [
                     ['#3a3a3a', 'Wall'],
                     ['#8a8a8a', 'Stone'],
                     ['#d7c79a', 'Floor'],
                     ['#f0f0f0', 'Web'],
                     ['#ffb74d', 'Hazard'],
                     ['#ef5350', 'Fire / danger'],
                     ['#4fc3f7', 'Water'],
                     ['#81c784', 'Poison / grass'],
                     ['#ba68c8', 'Magic']
                   ].each do |c, name| %>
                  <button type="button" class="notes-map-shape-color-btn"
                          data-color="<%= c %>"
                          style="background:<%= c %>"
                          title="<%= h name %>"></button>
                <% end %>
                <input type="color" class="notes-map-shape-color-custom"
                       title="Custom color">
              </div>
              <span class="notes-map-shape-status">
                Pick a color, then click and drag on the map to draw
                (or click for a default size). Hold the toolbar
                button to switch shape.
              </span>
            </div>

            <div class="notes-map-move-hint" data-tool="move" hidden>
              Drag a token, shape, or icon to reposition. Save to commit.
            </div>

            <div class="notes-map-delete-hint" data-tool="delete" hidden>
              Click an object, shape, or icon to remove it. Save to commit.
              Arrows have their own &#x2715; control.
            </div>

            <div class="notes-map-add-icon" data-tool="add-icon" hidden>
              <% NOTES_MAP_DM_ICONS.each do |group, list| %>
                <div class="notes-map-icon-group">
                  <span class="notes-map-icon-group-label"><%= group.capitalize %>:</span>
                  <% list.each do |glyph, name| %>
                    <button type="button"
                            class="notes-map-icon-btn"
                            data-glyph="<%= h glyph %>"
                            title="<%= h name %>"><%= h glyph %></button>
                  <% end %>
                </div>
              <% end %>
              <div class="notes-map-icon-status">
                Pick an icon, then click on the map. Save to commit.
              </div>
            </div>

            <div class="notes-map-add-image" data-tool="add-image" hidden>
              <% library = notes_map_image_library %>
              <% if library.empty? %>
                <div class="notes-map-image-status">
                  No images in <code>public/images/</code>. Drop .png /
                  .jpg / .webp files there and reload.
                </div>
              <% else %>
                <div class="notes-map-image-group">
                  <% library.each do |fn| %>
                    <button type="button"
                            class="notes-map-image-btn"
                            data-image-src="/images/<%= h fn %>"
                            title="<%= h File.basename(fn, '.*') %>">
                      <img src="/images/<%= h fn %>"
                           alt="<%= h File.basename(fn, '.*') %>">
                    </button>
                  <% end %>
                </div>
                <div class="notes-map-image-status">
                  Pick an image, then click on the map. Save to commit.
                </div>
              <% end %>
            </div>

            <div class="notes-map-tool-hint-row">
              <form method="post" action="/scene/clear_arrows" class="notes-map-clear-form">
                <input type="hidden" name="map_id" value="<%= h map_id %>">
                <button type="submit">Clear arrows</button>
              </form>
            </div>

            <%# Pending-changes bar — JS shows it when ops queue is non-empty. %>
            <div class="notes-map-pending" hidden>
              <span class="notes-map-pending-count">0 pending change(s)</span>
              <button type="button" class="notes-map-save-btn">Save</button>
              <button type="button" class="notes-map-discard-btn">Discard</button>
            </div>

            <details class="notes-map-settings">
              <summary>Map settings</summary>
              <form method="post" action="/scene/update_map" class="notes-map-settings-form">
                <input type="hidden" name="map_id" value="<%= h map_id %>">
                <label>Label
                  <input type="text" name="label" value="<%= h label %>">
                </label>
                <label>Width (squares)
                  <input type="number" name="width_squares"  min="1" max="80" value="<%= h settings['w'] %>">
                </label>
                <label>Height (squares)
                  <input type="number" name="height_squares" min="1" max="80" value="<%= h settings['h'] %>">
                </label>
                <label class="notes-map-flag">
                  <input type="checkbox" name="public" value="1" <%= 'checked' if settings['public'] %>>
                  <input type="hidden" name="public_set" value="1">
                  Visible to players
                </label>
                <label class="notes-map-flag">
                  <input type="checkbox" name="active" value="1" <%= 'checked' if settings['active'] %>>
                  <input type="hidden" name="active_set" value="1">
                  Active (shows on /scene)
                </label>
                <label class="notes-map-flag">
                  <input type="checkbox" name="archived" value="1" <%= 'checked' if settings['archived'] %>>
                  <input type="hidden" name="archived_set" value="1">
                  Archived
                </label>
                <button type="submit">Save</button>
              </form>
            </details>
          <% end %>
        </div>
      <% end %>
    </figure>
  <% end %>
<% end %>
</div>
