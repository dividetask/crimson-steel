<div class="notes-combined-stub" data-stub-id="<%= stub_id %>" data-dm-view="<%= dm_view ? '1' : '0' %>">
<% if items.empty? %>
  <p class="notes-empty">Nothing here yet.</p>
<% else %>
  <% last_chapter = nil %>
  <% items.each do |it| %>
    <% if it[:chapter] != last_chapter %>
      <h3 class="notes-chapter-divider">
        <span class="notes-chapter-divider-num">Chapter <%= h it[:chapter] %></span>
        <% if (title = chapter_titles[it[:chapter]]) %>
          <span class="notes-chapter-divider-title"><%= h title %></span>
        <% end %>
      </h3>
      <% last_chapter = it[:chapter] %>
    <% end %>

    <% e = it[:entry] %>
    <% case it[:kind]
       when 'note' %>
      <article class="notes-card notes-card-note" data-note-id="<%= h e['id'] %>">
        <% if e['title'] && !e['title'].empty? %>
          <div class="notes-card-title"><%= h e['title'] %></div>
        <% end %>
        <%= notes_body_html(e['note']) %>
        <div class="notes-card-meta">
          <% if e['public'] == false %><span class="notes-meta-chip notes-meta-private">DM only</span><% end %>
          <% if e['active']          %><span class="notes-meta-chip notes-meta-active">Active</span><% end %>
        </div>
        <% if editable_journal %>
          <details class="notes-card-edit">
            <summary>Edit</summary>
            <form method="post" action="/notes/journal/update" class="notes-journal-form">
              <input type="hidden" name="id" value="<%= h e['id'] %>">
              <label>Title <input type="text" name="title" value="<%= h e['title'] %>"></label>
              <label>Chapter <input type="number" name="chapter" min="1" value="<%= h e['chapter'] %>"></label>
              <label>Note
                <textarea name="note" rows="4"><%= h e['note'] %></textarea>
              </label>
              <label class="notes-journal-flag">
                <input type="checkbox" name="public" value="1" <%= 'checked' if e['public'] %>>
                <input type="hidden" name="public_set" value="1">
                Public
              </label>
              <label class="notes-journal-flag">
                <input type="checkbox" name="active" value="1" <%= 'checked' if e['active'] %>>
                <input type="hidden" name="active_set" value="1">
                Active
              </label>
              <div class="notes-journal-actions">
                <button type="submit">Save</button>
              </div>
            </form>
            <form method="post" action="/notes/journal/delete" class="notes-journal-delete-form"
                  onsubmit="return confirm('Delete this note?');">
              <input type="hidden" name="id" value="<%= h e['id'] %>">
              <button type="submit" class="notes-journal-delete-btn">Delete</button>
            </form>
          </details>
        <% end %>
      </article>

    <% when 'character' %>
      <article class="notes-card notes-card-character" data-note-id="<%= h e['id'] %>">
        <div class="notes-card-portrait <%= notes_tier_class(e['tier']) %>">
          <span class="notes-card-portrait-placeholder">?</span>
        </div>
        <div class="notes-card-body">
          <div class="notes-card-title notes-card-character-name <%= notes_tier_class(e['tier']) %>">
            <%= h e['title'] %>
            <% if e['tier'] %><span class="notes-tier-badge <%= notes_tier_class(e['tier']) %>">T<%= h e['tier'] %></span><% end %>
          </div>
          <%= notes_body_html(e['note']) %>
          <div class="notes-card-meta">
            <% if e['public'] == false %><span class="notes-meta-chip notes-meta-private">DM only</span><% end %>
            <% if e['active']          %><span class="notes-meta-chip notes-meta-active">Active</span><% end %>
          </div>
        </div>
      </article>

    <% when 'image' %>
      <figure class="notes-card notes-card-image">
        <div class="notes-image-frame">
          <% if e['path'] && !e['path'].to_s.empty? %>
            <a href="<%= h e['path'] %>" target="_blank" rel="noopener">
              <img src="<%= h e['path'] %>" alt="<%= h e['caption'] %>" class="notes-image-img">
            </a>
          <% else %>
            <%= notes_image_placeholder(e['kind']) %>
          <% end %>
        </div>
        <figcaption class="notes-image-caption">
          <%= h e['caption'] %>
          <% if e['public'] == false %><span class="notes-meta-chip notes-meta-private">DM only</span><% end %>
          <% if e['active']          %><span class="notes-meta-chip notes-meta-active">Active</span><% end %>
          <% if editable_images %>
            <form method="post" action="/notes/images/delete" class="notes-image-delete-form"
                  onsubmit="return confirm('Delete this image?');">
              <input type="hidden" name="id" value="<%= h e['id'] %>">
              <button type="submit" class="notes-image-delete-btn">Delete</button>
            </form>
          <% end %>
        </figcaption>
      </figure>
    <% end %>
  <% end %>
<% end %>
</div>
