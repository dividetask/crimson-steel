<%
  temp = dummy[:temporary_hit_points].to_i
  mod  = dummy[:moderate_damage].to_i
  maj  = dummy[:major_damage].to_i
  tox = dummy[:magic_toxicity].to_i
  tox_max = dummy[:magic_toxicity_max].to_i
  conditions = dummy[:conditions] || {}
  bleed_v  = conditions['bleed'].to_i
  poison_v = conditions['poison'].to_i
  weapons = dummy[:shields] + dummy[:weapons]
  has_spells  = dummy[:spell_list]  && dummy[:spell_list].any?  { |t| t && t.any? }
  has_rituals = character.ritual_list.any? { |t| t && t.any? }
  tier_class = character_sheet_tier_class(character.tier)
%>
<div class="char-card">
  <div class="char-card-name-row">
    <div class="char-card-name <%= tier_class %>"><%= h character.name %></div>
    <div class="char-card-player">Player: <strong><%= h character.player %></strong></div>
  </div>
  <div class="char-card-type">
    <%= h character.race.name %> <%= h dummy[:klass] %>,
    <span class="<%= tier_class %>">Tier <%= h character.tier %></span>
  </div>

  <div class="char-card-rule"></div>

  <div class="char-card-top">
    <div class="char-card-attrs">
      <% character_sheet_attribute_short.each do |sym, label| %>
        <% base = character.attribute(sym) %>
        <% dmg  = dummy[:attribute_damage][sym].to_i %>
        <% enh  = dummy[:attribute_enhancement][sym].to_i %>
        <div class="char-card-attr">
          <span class="char-card-attr-label"><%= label %></span>
          <span class="char-card-attr-value">
            <%= base %><% if dmg > 0 %><span class="ability-damage">-<%= dmg %></span><% end %><% if enh > 0 %><span class="enh-note">(+<%= enh %>)</span><% end %>
          </span>
        </div>
      <% end %>
    </div>
    <div class="char-card-vitals">
      <div class="char-card-line">
        <strong>HP</strong> <%= h dummy[:current_hp] %>/<%= h character.max_hit_points %><%
        %><% if temp > 0 %> <span class="hp-temp">+<%= temp %> tmp</span><% end %><%
        %><% if mod  > 0 %> &mdash; <span class="hp-mod">moderate <%= mod %></span><% end %><%
        %><% if maj  > 0 %> &mdash; <span class="hp-major">major <%= maj %></span><% end %>
      </div>
      <div class="char-card-line">
        <strong>Mana</strong> <%= h dummy[:current_mana] %>/<%= h character.max_mana %><%
        %><% if tox_max > 0 || tox > 0 %>, <span class="toxicity">Toxicity <%= tox %>/<%= tox_max %></span><% end %>
      </div>
      <% if bleed_v > 0 || poison_v > 0 %>
        <div class="char-card-line">
          <strong>Conditions</strong>
          <% parts = [] %>
          <% parts << "<span class=\"hp-bleed\">Bleed #{bleed_v}</span>"   if bleed_v  > 0 %>
          <% parts << "<span class=\"hp-poison\">Poison #{poison_v}</span>" if poison_v > 0 %>
          <%= parts.join(', ') %>
        </div>
      <% end %>
    </div>
  </div>

  <div class="char-card-rule"></div>

  <table class="char-card-quickrow">
    <tr>
      <td><strong>Initiative</strong> <%= h dummy[:initiative] %></td>
      <td><strong>Perception</strong> <%= character_sheet_add_plus(dummy[:perception_bonus]) %></td>
      <td><strong>Speed</strong> <%= h character.speed %></td>
    </tr>
  </table>

  <% skills = character_skill_rows(character).sort_by { |s| s['name'] } %>
  <% if weapons.any? %>
    <div class="char-card-rule"></div>
    <div class="char-card-section-title">Actions</div>
    <table class="char-card-actions">
      <tr>
        <th>Name</th>
        <th>Spd</th>
        <th>Roll</th>
        <th>Bonus</th>
        <th>Dmg</th>
        <th>Notes</th>
      </tr>
      <% weapons.each do |w| %>
        <tr>
          <td><%= h w['name'] %></td>
          <td><%= h w['speed'] %><%= h w['arm_speed'] %></td>
          <td><%= h w['dice'] %>d</td>
          <td><%= character_sheet_add_plus(w['attack_bonus']) %></td>
          <td><%= h w['damage'] %></td>
          <td></td>
        </tr>
      <% end %>
      <tr>
        <td>Dodge</td>
        <td>0</td>
        <td><%= h dummy[:bab_dice] %>d</td>
        <td><%= character_sheet_add_plus(dummy[:bab_bonus]) %></td>
        <td>&mdash;</td>
        <td></td>
      </tr>
    </table>
  <% end %>

  <% if skills.any? %>
    <%
      half = (skills.length + 1) / 2
      left_skills  = skills[0, half]
      right_skills = skills[half..] || []
      row_count    = [left_skills.length, right_skills.length].max
    %>
    <div class="char-card-rule"></div>
    <div class="char-card-section-title">Skills</div>
    <table class="char-card-skills">
      <tr>
        <th>Name</th>
        <th>Roll</th>
        <th>Bonus</th>
        <th class="char-card-skills-spacer"></th>
        <th>Name</th>
        <th>Roll</th>
        <th>Bonus</th>
      </tr>
      <% (0...row_count).each do |i| %>
        <% l = left_skills[i] %>
        <% r = right_skills[i] %>
        <tr>
          <td><%= l ? h(character_sheet_ability_label(l['name'])) : '' %></td>
          <td><%= l ? "#{h l['dice']}d" : '' %></td>
          <td><%= l ? character_sheet_add_plus(l['bonus']) : '' %></td>
          <td class="char-card-skills-spacer"></td>
          <td><%= r ? h(character_sheet_ability_label(r['name'])) : '' %></td>
          <td><%= r ? "#{h r['dice']}d" : '' %></td>
          <td><%= r ? character_sheet_add_plus(r['bonus']) : '' %></td>
        </tr>
      <% end %>
    </table>
  <% end %>

  <% if has_spells || has_rituals %>
    <div class="char-card-rule"></div>
    <div class="char-card-two-col">
      <div>
        <div class="char-card-section-title">Spells</div>
        <% if has_spells %>
          <% dummy[:spell_list].each_with_index do |sub, idx| %>
            <% next if sub.nil? || sub.empty? %>
            <p class="char-card-entry"><em class="<%= character_sheet_tier_class(idx) %>">Tier <%= idx %>.</em> <%= sub.map { |s| h(s) }.join(', ') %></p>
          <% end %>
        <% else %>
          <p class="char-card-entry char-card-empty">&mdash;</p>
        <% end %>
      </div>
      <div>
        <div class="char-card-section-title">Rituals</div>
        <% if has_rituals %>
          <% character.ritual_list.each_with_index do |sub, idx| %>
            <% next if sub.nil? || sub.empty? %>
            <p class="char-card-entry"><em class="<%= character_sheet_tier_class(idx) %>">Tier <%= idx %>.</em> <%= sub.map { |s| h(s) }.join(', ') %></p>
          <% end %>
        <% else %>
          <p class="char-card-entry char-card-empty">&mdash;</p>
        <% end %>
      </div>
    </div>
  <% end %>

  <%
    item_lines = []
    item_lines << ['Equipped',   dummy[:equipped].map { |n| h(n) }.join(', ')] if dummy[:equipped].any?
    if dummy[:consumable].any?
      consumable_str = dummy[:consumable].map do |item|
        if item['quantity'] && item['quantity'] > 1
          "(#{h(item['quantity'])}) #{h(item['name'])}"
        else
          h(item['name'])
        end
      end.join(', ')
      item_lines << ['Consumable', consumable_str]
    end
    if dummy[:ammunition].any?
      ammo_str = dummy[:ammunition].map do |item|
        "(#{h(item['quantity'] || 1)}) #{h(item['name'])}"
      end.join(', ')
      item_lines << ['Ammunition', ammo_str]
    end
    item_lines << ['Other', dummy[:other_items].map { |item| h(item['name']) }.join(', ')] if dummy[:other_items].any?

    has_items     = item_lines.any?
    has_abilities = character.abilities.any?
  %>
  <% if has_items || has_abilities %>
    <div class="char-card-rule"></div>
    <div class="char-card-two-col">
      <div>
        <div class="char-card-section-title">Items</div>
        <% if has_items %>
          <% item_lines.each do |label, body| %>
            <p class="char-card-entry"><em><%= label %>.</em> <%= body %></p>
          <% end %>
        <% else %>
          <p class="char-card-entry char-card-empty">&mdash;</p>
        <% end %>
      </div>
      <div>
        <div class="char-card-section-title">Abilities</div>
        <% if character.abilities.any? %>
          <% character.abilities.each do |ability| %>
            <p class="char-card-entry">
              <em><%= h character_sheet_ability_label(ability.name) %><% if ability.scales? %> (<%= ability.level %>)<% end %>.</em>
              <% if ability.description && !ability.description.empty? %>
                <%= h ability.description %>
              <% else %>
                <span class="ability-undescribed">No description yet.</span>
              <% end %>
            </p>
          <% end %>
        <% else %>
          <p class="char-card-entry char-card-empty">&mdash;</p>
        <% end %>
      </div>
    </div>
  <% end %>

  <% if dummy[:defined_items] && dummy[:defined_items].any? %>
    <div class="char-card-rule"></div>
    <div class="char-card-section-title">Item Descriptions</div>
    <% dummy[:defined_items].each do |item| %>
      <p class="char-card-entry">
        <em><%= h(item['name']) %>.</em>
        <%= h(item['description']) %>
      </p>
    <% end %>
  <% end %>
</div>
