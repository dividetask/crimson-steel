<%#
  Equipment Loot Pile Stub — docs/common/ui/equipment_loot_pile_stub.md

  Styled like the Character Sheet Inventory stub: a card grid (icon + name)
  with per-item actions. One <form> drives everything; each action button
  carries the Stack's index and overrides the action via formaction.

  Per card:
    - Sell Pile / Discard flag (a toggle; default Sell Pile). The bottom
      "Loot" button sweeps every Sell-Pile Stack to the Party Sell Pile and
      leaves the Discard ones on the pile.
    - a quantity box (default = full Stack), shared by Claim and Give.
    - Claim (players only) — take that quantity for your own Creature.
    - a combat-creature dropdown + Give — hand that quantity to that Creature.

  Locals:
    pile              — {owner_id, rows:[{ref, name, icon, quantity}]}.
    viewer            — :dm or :player.
    give_options      — [{id, name}] combat participants for the dropdown.
    claim_creature_id — the viewing player's Creature id, or nil for the DM.
%>
<%
  esc       = ->(s) { Rack::Utils.escape_html(s.to_s) }
  owner     = pile[:owner_id]
  can_claim = !claim_creature_id.nil?
  label =
    if (m = owner.to_s.match(/\Aground:map_(\w+)\z/))
      "Map #{m[1]} loot pile"
    else
      owner.to_s.sub(/\Aground:/, '')
    end
%>
<section class="inv loot-pile-stub">
  <h2 class="inv-title"><%= esc.call(label) %></h2>

  <form method="post" action="/encounter/loot_pile/loot" class="loot-form">
    <input type="hidden" name="pile_owner_id" value="<%= esc.call(owner) %>">

    <div class="provision-grid">
      <% pile[:rows].each do |row| %>
        <% i = row[:ref] %>
        <div class="provision-card">
          <div class="provision-pic<%= ' provision-pic-empty' unless row[:icon] %>" title="<%= esc.call(row[:name]) %>">
            <% if row[:icon] %><img src="<%= row[:icon] %>" alt="" loading="lazy"><% end %>
          </div>
          <div class="provision-card-body">
            <div class="provision-card-name loot-name-row">
              <span class="loot-name"><%= row[:quantity] > 1 ? "#{row[:quantity]}× " : '' %><%= esc.call(row[:name]) %></span>
              <label class="loot-flag-btn" title="Toggle Sell Pile / Discard">
                <input type="checkbox" name="flag_<%= i %>" value="discard">
              </label>
            </div>

            <div class="provision-card-actions loot-actions">
              <input type="number" name="qty_<%= i %>" class="inv-qty" value="<%= row[:quantity] %>" min="1" max="<%= row[:quantity] %>">

              <% if can_claim %>
                <button type="submit" formaction="/encounter/loot_pile/claim" name="index" value="<%= i %>" class="ce-btn ce-btn-primary">Claim</button>
              <% end %>

              <% unless give_options.empty? %>
                <select name="give_<%= i %>" class="loot-give-select">
                  <option value="">Give to…</option>
                  <% give_options.each do |c| %>
                    <option value="<%= esc.call(c[:id]) %>"><%= esc.call(c[:name]) %></option>
                  <% end %>
                </select>
                <button type="submit" formaction="/encounter/loot_pile/give" name="index" value="<%= i %>" class="ce-btn">Give</button>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>

    <div class="loot-controls">
      <button type="submit" class="ce-btn ce-btn-primary loot-btn">Loot</button>
      <% if viewer == :dm %>
        <button type="submit" formaction="/encounter/loot_pile/delete" class="ce-btn ce-btn-delete loot-pile-delete"
                data-confirm="Delete this pile and its remaining contents? This cannot be undone.">Delete Pile</button>
      <% end %>
    </div>
  </form>
</section>
