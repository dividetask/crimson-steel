<%#
  Equipment Store Stub — docs/common/ui/equipment_store_stub.md
  The Shop purchase grid: a top banner (buyer's Total Wealth + the
  previous purchase's flash), a Category/Tier filter sidebar, and one
  card per buyable Stack in the Shop's Inventory.

  Locals:
    viewer       — :dm or :player.
    purchasable  — true on the live /store page (Buy posts to the
                   server); false on the Status sample (inert preview).
    total_wealth — buyer's Total Wealth (Equipment Get Total Wealth), or nil.
    buyers       — [{id:, name:}] roster for the buyer selector.
    buyer_id     — currently selected buyer id, or nil.
    shops        — [{id:, name:}] selectable Shops.
    shop_id      — selected Shop id, or nil.
    shop_name    — selected Shop's display name, or nil.
    cards        — [{index:, display_name:, category:, tier:, properties:,
                     description:, unit_price:, available:}].
    categories   — sorted unique Category strings (filter checkboxes).
    tiers        — sorted unique Tier integers (filter checkboxes).
    flash        — {type: 'success'|'error', text:} or nil.
%>
<%
  fmt = ->(n) { n.is_a?(Integer) ? n.to_s : (n == n.to_i ? n.to_i.to_s : format('%.2f', n)) }
%>
<section class="store">
  <header class="store-banner">
    <div class="store-banner-main">
      <h1>Store</h1>
      <% if shop_name %><p class="store-shopname"><%= shop_name %></p><% end %>
    </div>
    <% if total_wealth %>
      <div class="store-banner-wealth">
        <span class="store-wealth-label">Wallet</span>
        <span class="store-wealth-amount"><%= fmt.call(total_wealth) %> gp</span>
      </div>
    <% end %>
  </header>

  <% if flash %>
    <div class="store-flash store-flash-<%= flash[:type] %>"><%= flash[:text] %></div>
  <% end %>

  <form class="store-controls" method="get" action="/store">
    <label class="store-control">
      <span>Shop</span>
      <select name="shop" <%= 'disabled' unless purchasable %> onchange="this.form.submit()">
        <% shops.each do |s| %>
          <option value="<%= s[:id] %>" <%= 'selected' if s[:id] == shop_id %>><%= s[:name] %></option>
        <% end %>
      </select>
    </label>
    <label class="store-control">
      <span>Buyer</span>
      <select name="buyer" <%= 'disabled' unless purchasable %> onchange="this.form.submit()">
        <% buyers.each do |b| %>
          <option value="<%= b[:id] %>" <%= 'selected' if b[:id] == buyer_id %>><%= b[:name] %></option>
        <% end %>
      </select>
    </label>
    <noscript><% if purchasable %><button type="submit" class="ce-btn">View</button><% end %></noscript>
  </form>

  <div class="store-layout">
    <aside class="store-filters">
      <h2>Filters</h2>
      <fieldset class="store-filter-group">
        <legend>Category</legend>
        <% if categories.empty? %><p class="store-filter-empty">—</p><% end %>
        <% categories.each do |c| %>
          <label><input type="checkbox" class="store-filter-cat" value="<%= c %>" checked> <%= c %></label>
        <% end %>
      </fieldset>
      <fieldset class="store-filter-group">
        <legend>Tier</legend>
        <% if tiers.empty? %><p class="store-filter-empty">—</p><% end %>
        <% tiers.each do |t| %>
          <label><input type="checkbox" class="store-filter-tier" value="<%= t %>" checked> <%= t.zero? ? 'Mundane' : "+#{t}" %></label>
        <% end %>
      </fieldset>
    </aside>

    <div class="store-grid">
      <% if cards.empty? %>
        <p class="store-empty">Nothing for sale here right now.</p>
      <% end %>
      <% cards.each do |card| %>
        <article class="store-card" data-category="<%= card[:category] %>" data-tier="<%= card[:tier] %>">
          <div class="store-card-head">
            <h3 class="store-card-name"><%= card[:display_name] %></h3>
            <% if card[:tier].positive? %><span class="store-tier-badge">+<%= card[:tier] %></span><% end %>
          </div>
          <p class="store-card-cat"><%= card[:category] %></p>
          <% unless card[:properties].to_s.empty? %>
            <p class="store-card-props"><%= card[:properties] %></p>
          <% end %>
          <% if card[:description] %>
            <p class="store-card-desc"><%= card[:description] %></p>
          <% end %>
          <div class="store-card-foot">
            <span class="store-card-price"><%= fmt.call(card[:unit_price]) %> gp</span>
            <span class="store-card-stock"><%= card[:available] %> in stock</span>
          </div>
          <% if purchasable %>
            <form class="store-buy" method="post" action="/store/purchase">
              <input type="hidden" name="shop" value="<%= shop_id %>">
              <input type="hidden" name="buyer" value="<%= buyer_id %>">
              <input type="hidden" name="index" value="<%= card[:index] %>">
              <input type="number" name="quantity" class="store-qty" value="1" min="1" max="<%= card[:available] %>">
              <button type="submit" class="ce-btn ce-btn-primary store-buy-btn">Buy</button>
            </form>
          <% else %>
            <div class="store-buy store-buy-disabled">
              <input type="number" class="store-qty" value="1" min="1" disabled>
              <button type="button" class="ce-btn store-buy-btn" disabled>Buy</button>
            </div>
          <% end %>
        </article>
      <% end %>
    </div>
  </div>

  <script>
    (function () {
      var root = document.currentScript.closest('.store');
      if (!root) return;
      function selectedValues(sel) {
        return Array.prototype.map.call(
          root.querySelectorAll(sel + ':checked'), function (el) { return el.value; });
      }
      function apply() {
        var cats  = selectedValues('.store-filter-cat');
        var tiers = selectedValues('.store-filter-tier');
        Array.prototype.forEach.call(root.querySelectorAll('.store-card'), function (card) {
          var okCat  = cats.indexOf(card.getAttribute('data-category')) !== -1;
          var okTier = tiers.indexOf(card.getAttribute('data-tier')) !== -1;
          card.style.display = (okCat && okTier) ? '' : 'none';
        });
      }
      Array.prototype.forEach.call(
        root.querySelectorAll('.store-filter-cat, .store-filter-tier'),
        function (el) { el.addEventListener('change', apply); });
    })();
  </script>
</section>
