<%
  # Creature Full Stub — docs/common/ui/creatures_full_stub.md
  #
  # Locals:
  #   demo            — required. Sample data; see lib/status/sample_creatures.rb.
  #   toggle_target   — optional. Route the toggle button posts to.
  #   prev_target     — optional. Route the previous-arrow links to.
  #   next_target     — optional. Route the next-arrow links to.
  #   page_label      — optional. Pager label, e.g. "1 / 10".
  #   chrome          — optional boolean (default true).
  chrome_on   = defined?(chrome)        ? chrome        : true
  toggle_href = defined?(toggle_target) ? toggle_target : nil
  prev_href   = defined?(prev_target)   ? prev_target   : nil
  next_href   = defined?(next_target)   ? next_target   : nil
  pager_label = defined?(page_label)    ? page_label    : nil

  h  = demo[:header]
  v  = demo[:vitals]
  it = demo[:items]
%>

<article class="cs-card cs-full tier-<%= h[:tier] %><%= ' cs-bare' unless chrome_on %>" data-creature-id="<%= demo[:id] %>">

  <% if prev_href || pager_label || next_href %>
    <div class="cs-pager">
      <% if prev_href %>
        <a class="cs-pager-arrow" href="<%= prev_href %>">&#9664;</a>
      <% else %>
        <span class="cs-pager-arrow cs-pager-disabled">&#9664;</span>
      <% end %>
      <% if pager_label %>
        <span class="cs-pager-label"><%= pager_label %></span>
      <% end %>
      <% if next_href %>
        <a class="cs-pager-arrow" href="<%= next_href %>">&#9654;</a>
      <% else %>
        <span class="cs-pager-arrow cs-pager-disabled">&#9654;</span>
      <% end %>
    </div>
  <% end %>

  <header class="cs-header cs-header-full">
    <h2 class="cs-name"><%= h[:name] %></h2>
    <% if h[:player] %>
      <span class="cs-player">Player: <strong><%= h[:player] %></strong></span>
    <% end %>
  </header>
  <div class="cs-subtitle cs-subtitle-full">
    <em><%= h[:summary] %></em><br>
    <em>Tier <span class="cs-tier-num"><%= h[:tier] %></span>&nbsp;&nbsp;&nbsp;BAB: <%= h[:bab] %></em>
  </div>

  <section class="cs-section cs-vitals-strip">
    <div class="cs-vitals-row">
      <div class="cs-vital"><span class="cs-vital-label">Combat Pool</span><span class="cs-vital-value"><%= v[:combat_pool] %></span></div>
      <div class="cs-vital"><span class="cs-vital-label">Perception</span><span class="cs-vital-value"><%= demo[:perception][:dice] %>d (<%= sprintf('%+d', demo[:perception][:bonus]) %>)</span></div>
      <div class="cs-vital"><span class="cs-vital-label">Initiative</span><span class="cs-vital-value"><%= demo[:initiative][:dice_count] %></span></div>
    </div>
    <div class="cs-vitals-row">
      <div class="cs-vital"><span class="cs-vital-label">Damage Reduction</span><span class="cs-vital-value"><%= v[:damage_reduction] %></span></div>
      <div class="cs-vital"><span class="cs-vital-label">Damage Resilience</span><span class="cs-vital-value"><%= v[:damage_resilience] %></span></div>
      <div class="cs-vital"><span class="cs-vital-label">Speed</span><span class="cs-vital-value"><%= demo[:speed] %></span></div>
    </div>
    <div class="cs-vitals-row">
      <div class="cs-vital"><span class="cs-vital-label">HP</span><span class="cs-vital-value"><%= v[:hp][:current] %>/<%= v[:hp][:max] %></span></div>
      <div class="cs-vital"><span class="cs-vital-label">Mana</span><span class="cs-vital-value"><%= v[:mana][:current] %>/<%= v[:mana][:max] %></span></div>
      <div class="cs-vital"><span class="cs-vital-label">Mana Regen</span><span class="cs-vital-value"><%= v[:mana][:regen] %></span></div>
    </div>
    <div class="cs-vitals-row">
      <div class="cs-vital"><span class="cs-vital-label">Temporary HP</span><span class="cs-vital-value"><%= v[:temp_hp] %></span></div>
      <div class="cs-vital"><span class="cs-vital-label">Moderate Damage</span><span class="cs-vital-value"><%= v[:moderate_damage] %></span></div>
      <div class="cs-vital"><span class="cs-vital-label">Major Damage</span><span class="cs-vital-value"><%= v[:major_damage] %></span></div>
    </div>
  </section>

  <section class="cs-section cs-combat">
    <h3 class="cs-section-h">Combat</h3>
    <table class="cs-combat-table">
      <thead>
        <tr>
          <th>Name</th><th class="cs-num">Speed</th><th class="cs-num">Roll</th><th class="cs-num">Attk / Def Bonus</th>
          <th class="cs-num">Dmg Bonus</th><th class="cs-num">Bleed</th><th class="cs-num">MT</th><th>Notes</th>
        </tr>
      </thead>
      <tbody>
        <% demo[:actions].each do |act| %>
          <tr>
            <td><%= act[:name] %></td>
            <td class="cs-num"><%= act[:speed] %></td>
            <td class="cs-num"><%= act[:roll] %></td>
            <td class="cs-num"><%= sprintf('%+d', act[:attack_bonus]) %></td>
            <td class="cs-num"><%= act[:dmg_bonus] ? sprintf('%+d', act[:dmg_bonus]) : '&mdash;' %></td>
            <td class="cs-num"><%= act[:bleed].nil? ? '&mdash;' : act[:bleed] %></td>
            <td class="cs-num"><%= act[:mt].nil? ? '&mdash;' : act[:mt] %></td>
            <td><%= act[:notes] %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </section>

  <div class="cs-full-body">
    <div class="cs-col cs-col-left">

      <section class="cs-section cs-attributes-full">
        <h3 class="cs-section-h">Attributes</h3>
        <table class="cs-attributes-table">
          <thead>
            <tr><th></th><th class="cs-num">Score</th><th class="cs-num">½</th><th class="cs-num" colspan="2">Check</th><th class="cs-num" colspan="2">Saves</th></tr>
          </thead>
          <tbody>
            <% demo[:attributes_table].each do |r| %>
              <tr>
                <th class="cs-attr-name"><%= r[:attr] %></th>
                <td class="cs-num"><%= r[:score] %></td>
                <td class="cs-num"><%= r[:half] %></td>
                <td class="cs-num"><%= r[:check][:dice] %>d</td>
                <td class="cs-num"><%= sprintf('%+d', r[:check][:bonus]) %></td>
                <td class="cs-num"><%= r[:save][:dice] %>d</td>
                <td class="cs-num"><%= sprintf('%+d', r[:save][:bonus]) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </section>

      <% if demo[:skills].any? %>
        <section class="cs-section cs-skills">
          <h3 class="cs-section-h">Skills</h3>
          <table class="cs-skills-table">
            <thead><tr><th>Name</th><th class="cs-num">Ranks</th><th class="cs-num">Dice</th><th class="cs-num">Bonus</th></tr></thead>
            <tbody>
              <% demo[:skills].each do |s| %>
                <tr>
                  <td><%= s[:name] %></td>
                  <td class="cs-num"><%= s[:ranks] %></td>
                  <td class="cs-num"><%= s[:dice] %>d</td>
                  <td class="cs-num"><%= sprintf('%+d', s[:bonus]) %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </section>
      <% end %>

      <section class="cs-section cs-items-full">
        <h3 class="cs-section-h">Items</h3>
        <% if it[:equipped].any? %>
          <div class="cs-item-line"><em>Equipped:</em> <%= it[:equipped].map { |i| i[:name] }.join(', ') %></div>
        <% end %>
        <% if it[:consumable].any? %>
          <div class="cs-item-line"><em>Consumable:</em>
            <%= it[:consumable].map { |i| i[:quantity].to_i > 1 ? "(#{i[:quantity]}) #{i[:name]}" : i[:name] }.join(', ') %>
          </div>
        <% end %>
        <% if it[:ammunition] && it[:ammunition].any? %>
          <div class="cs-item-line"><em>Ammunition:</em>
            <%= it[:ammunition].map { |i| i[:quantity].to_i > 1 ? "(#{i[:quantity]}) #{i[:name]}" : i[:name] }.join(', ') %>
          </div>
        <% end %>
        <% if it[:other].any? %>
          <div class="cs-item-line"><em>Other:</em>
            <%= it[:other].map { |i| i[:quantity].to_i > 1 ? "#{i[:name]} (#{i[:quantity]})" : i[:name] }.join(', ') %>
          </div>
        <% end %>
      </section>

      <% if demo[:item_descriptions].any? %>
        <section class="cs-section cs-item-desc">
          <h3 class="cs-section-h">Item Descriptions</h3>
          <% demo[:item_descriptions].each do |idesc| %>
            <div class="cs-item-desc-row"><em><%= idesc[:name] %>:</em> <%= idesc[:description] %></div>
          <% end %>
        </section>
      <% end %>

    </div>

    <div class="cs-col cs-col-right">

      <% if demo[:abilities].any? %>
        <section class="cs-section cs-abilities-full">
          <h3 class="cs-section-h">Abilities</h3>
          <% demo[:abilities].each do |ab| %>
            <div class="cs-ability-full">
              <div class="cs-ability-full-name"><em><%= ab[:name] %>:</em></div>
              <div class="cs-ability-full-body"><%= ab[:description] %></div>
            </div>
          <% end %>
        </section>
      <% end %>

      <% if demo[:spells].any? || demo[:rituals].any? || demo[:item_spells].any? %>
        <section class="cs-section cs-spell-list">
          <h3 class="cs-section-h">Spell List</h3>
          <% demo[:spells].each do |grp| %>
            <div class="cs-spell-line"><em class="cs-tier-label tier-<%= grp[:tier] %>"><%= grp[:tier] %>:</em> <%= grp[:names].join(', ') %></div>
          <% end %>

          <% if demo[:rituals].any? %>
            <h4 class="cs-subsection-h">Rituals</h4>
            <% demo[:rituals].each do |grp| %>
              <div class="cs-spell-line"><em class="cs-tier-label tier-<%= grp[:tier] %>"><%= grp[:tier] %>:</em> <%= grp[:names].join(', ') %></div>
            <% end %>
          <% end %>

          <% if demo[:item_spells].any? %>
            <h4 class="cs-subsection-h">Item Spells</h4>
            <% demo[:item_spells].each do |grp| %>
              <div class="cs-spell-line"><em class="cs-tier-label tier-<%= grp[:tier] %>"><%= grp[:tier] %>:</em> <%= grp[:names].join(', ') %></div>
            <% end %>
          <% end %>
        </section>
      <% end %>

    </div>
  </div>

  <% if demo[:notes].any? %>
    <section class="cs-section cs-notes">
      <h3 class="cs-section-h">Notes</h3>
      <% demo[:notes].each do |n| %>
        <div class="cs-note-row"><%= n[:body] %></div>
      <% end %>
    </section>
  <% end %>

  <div class="cs-toggle">
    <% if toggle_href %>
      <a class="cs-toggle-btn" href="<%= toggle_href %>">Show minimal</a>
    <% else %>
      <span class="cs-toggle-btn cs-toggle-static">Show minimal</span>
    <% end %>
  </div>
</article>
