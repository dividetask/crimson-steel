<%#
  Creature Inventory Stub — docs/common/ui/equipment_inventory_stub.md
  Manage one Creature's gear. Keyed to the Creature shown on the sheet
  above; only rendered for a real Creature (never an enemy_template).

  All three sections use the same 3-column card grid. A quantity (when
  > 1) prefixes the item name as "N× Name". Items that cannot be equipped
  (Consumables, Ammunition, Currency, Gems) never show an Equip control.
  A Stack of Quantity > 1 carries a quantity input (default = full Stack)
  that governs Discard / Claim; Equip always acts on a single copy.

  Locals:
    creature_id — the Creature being managed.
    detail      — sheet detail mode, preserved across the action redirect.
    equipped    — [{index, name, icon, category, quantity}].
    inventory   — [{index, name, icon, quantity, equippable, category}].
    sell        — [{index, name, icon, quantity, equippable}].
%>
<%
  # Hidden creature_id / index / detail inputs every action form carries.
  refs = lambda do |row|
    %(<input type="hidden" name="creature_id" value="#{creature_id}">) +
    %(<input type="hidden" name="index" value="#{row[:index]}">) +
    %(<input type="hidden" name="detail" value="#{detail}">)
  end

  qty_input = lambda do |row|
    return '' unless row[:quantity] > 1
    %(<input type="number" name="quantity" class="inv-qty" value="#{row[:quantity]}" min="1" max="#{row[:quantity]}">)
  end

  esc = ->(s) { Rack::Utils.escape_html(s.to_s) }

  # The card's name line. For an inscribable book (row[:rituals] is a
  # list), append a clickable "(N rituals)" that opens a scrollable modal
  # of the inscribed list (mirrors the notes text-modal pattern). The
  # modal content is carried in a hidden source div on the card.
  name_block = lambda do |row|
    qty  = row[:quantity] > 1 ? "#{row[:quantity]}× " : ''
    html = %(<div class="provision-card-name">#{qty}#{esc.call(row[:name])}</div>)
    rituals = row[:rituals]
    if rituals
      n = rituals.size
      label = "#{n} #{n == 1 ? 'ritual' : 'rituals'}"
      items = rituals.empty? ? %(<li class="inv-ritual-empty">No rituals inscribed.</li>)
                             : rituals.map { |r| "<li>#{esc.call(r)}</li>" }.join
      html += %(<button type="button" class="inv-ritual-open" data-ritual-modal="1") +
              %( aria-label="Open ritual list">(#{label})</button>)
      html += %(<div class="inv-ritual-source" hidden>) +
              %(<div class="inv-ritual-modal-title">#{esc.call(row[:name])} — #{label}</div>) +
              %(<ul class="inv-ritual-list">#{items}</ul>) +
              %(</div>)
    end
    html
  end
%>
<section class="inv">
  <h2 class="inv-title">Inventory</h2>

  <%# ---- Equipped ---- %>
  <h3 class="inv-section-title">Equipped</h3>
  <div class="provision-grid">
    <% if equipped.empty? %>
      <p class="inv-empty">Nothing equipped.</p>
    <% end %>
    <% equipped.each do |row| %>
      <div class="provision-card">
        <div class="provision-pic<%= ' provision-pic-empty' unless row[:icon] %>" title="<%= esc.call(row[:name]) %>">
          <% if row[:icon] %><img src="<%= row[:icon] %>" alt="" loading="lazy"><% end %>
        </div>
        <div class="provision-card-body">
          <%= name_block.call(row) %>
          <div class="provision-card-buy">
            <form method="post" action="/inventory/unequip">
              <%= refs.call(row) %>
              <button type="submit" class="ce-btn">Unequip</button>
            </form>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <%# ---- Inventory (unequipped) ---- %>
  <h3 class="inv-section-title">Carried</h3>
  <div class="provision-grid">
    <% if inventory.empty? %>
      <p class="inv-empty">No carried items.</p>
    <% end %>
    <% inventory.each do |row| %>
      <div class="provision-card">
        <div class="provision-pic<%= ' provision-pic-empty' unless row[:icon] %>" title="<%= esc.call(row[:name]) %>">
          <% if row[:icon] %><img src="<%= row[:icon] %>" alt="" loading="lazy"><% end %>
        </div>
        <div class="provision-card-body">
          <%= name_block.call(row) %>
          <div class="provision-card-actions">
            <% if row[:equippable] %>
              <form method="post" action="/inventory/equip" class="inv-action">
                <%= refs.call(row) %>
                <button type="submit" class="ce-btn ce-btn-primary">Equip</button>
              </form>
            <% end %>
            <form method="post" action="/inventory/discard" class="inv-action">
              <%= refs.call(row) %>
              <%= qty_input.call(row) %>
              <button type="submit" class="ce-btn">Discard</button>
            </form>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <%# ---- Sell Pile (shared Party inventory) ---- %>
  <h3 class="inv-section-title">Sell Pile</h3>
  <div class="provision-grid">
    <% if sell.empty? %>
      <p class="inv-empty">The sell pile is empty.</p>
    <% end %>
    <% sell.each do |row| %>
      <div class="provision-card">
        <div class="provision-pic<%= ' provision-pic-empty' unless row[:icon] %>" title="<%= esc.call(row[:name]) %>">
          <% if row[:icon] %><img src="<%= row[:icon] %>" alt="" loading="lazy"><% end %>
        </div>
        <div class="provision-card-body">
          <%= name_block.call(row) %>
          <div class="provision-card-actions">
            <form method="post" action="/inventory/claim" class="inv-action">
              <%= refs.call(row) %>
              <%= qty_input.call(row) %>
              <button type="submit" class="ce-btn">Claim</button>
            </form>
            <% if row[:equippable] %>
              <form method="post" action="/inventory/claim_equip" class="inv-action">
                <%= refs.call(row) %>
                <button type="submit" class="ce-btn ce-btn-primary">Equip</button>
              </form>
            <% end %>
            <%# DM-only: permanently throw the item away (destructive). %>
            <% if dm_view? %>
              <form method="post" action="/inventory/sell_delete" class="inv-action"
                    onsubmit="return confirm('Permanently delete this from the sell pile?');">
                <%= refs.call(row) %>
                <%= qty_input.call(row) %>
                <button type="submit" class="ce-btn ce-btn-delete">Delete</button>
              </form>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</section>
