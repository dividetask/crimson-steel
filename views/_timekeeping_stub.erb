<%#
  Timekeeping Stub. See docs/common/ui/timekeeping_stub.md.

  Locals (all required):
    timestamp — { day_index:, round_of_day: }
%>
<%
  ts          = timestamp.transform_keys(&:to_sym)
  cal         = Timekeeping.calendar_date(ts[:day_index])
  rpd         = Timekeeping.rounds_per_day
  rod         = ts[:round_of_day]
  hh          = Timekeeping.hour_of_day(rod)
  is_day      = hh >= 6 && hh < 18

  raw_time = Timekeeping.time_of_day(rod)
  h_str, m_str, _ = raw_time.split(':')
  time_str = "#{h_str}:#{m_str}"

  if is_day
    # 06:00 -> 0%, 12:00 -> 50%, 18:00 -> 100%
    fraction = (rod.to_f - 0.25 * rpd) / (0.5 * rpd)
  else
    # 18:00 -> 0%, 00:00 -> 50%, 06:00 -> 100%, wrapping at midnight
    fraction = ((rod.to_f - 0.75 * rpd) / (0.5 * rpd)) % 1.0
  end
  fraction = 0.0 if fraction < 0
  fraction = 1.0 if fraction > 1

  angle_rad = fraction * Math::PI

  # The arc spans nearly the full stub height; the cap keeps the
  # icon's top edge from clipping out of the stub at zenith. With
  # the default 130 px stub and a 32 px icon, 85 % leaves about a
  # 4 px gap above the icon at midday.
  arc_max_pct = 85
  icon_bottom_pct = Math.sin(angle_rad) * arc_max_pct
%>
<div class="tk-stub <%= is_day ? 'tk-day' : 'tk-night' %>">
  <div class="tk-sky" aria-hidden="true">
    <div class="tk-horizon"></div>
    <div class="tk-arc"></div>
    <% unless is_day %>
      <% [[45, 14], [55, 22], [68, 8], [78, 18], [88, 26], [94, 12]].each do |x, y| %>
        <span class="tk-star" style="left: <%= x %>%; top: <%= y %>%;"></span>
      <% end %>
    <% end %>
    <div class="tk-icon" style="left: <%= (fraction * 100).round(2) %>%; bottom: <%= icon_bottom_pct.round(2) %>%;">
      <% if is_day %>
        <svg viewBox="0 0 32 32" class="tk-sun"><circle cx="16" cy="16" r="7" fill="#facc15" stroke="#b45309" stroke-width="1"/>
          <% 8.times do |i|
               a = i * Math::PI / 4
               x1 = 16 + Math.cos(a) * 9
               y1 = 16 + Math.sin(a) * 9
               x2 = 16 + Math.cos(a) * 13
               y2 = 16 + Math.sin(a) * 13
          %>
            <line x1="<%= x1.round(2) %>" y1="<%= y1.round(2) %>" x2="<%= x2.round(2) %>" y2="<%= y2.round(2) %>" stroke="#facc15" stroke-width="2" stroke-linecap="round"/>
          <% end %>
        </svg>
      <% else %>
        <svg viewBox="0 0 32 32" class="tk-moon"><circle cx="16" cy="16" r="8" fill="#f3f4f6"/><circle cx="20" cy="13" r="7" fill="#1e3a8a"/></svg>
      <% end %>
    </div>
  </div>

  <div class="tk-date">
    <div class="tk-date-primary"><%= cal[:day_of_month] %> <%= Timekeeping.month_name(cal[:month]) %> <%= cal[:year] %></div>
    <div class="tk-date-secondary"><%= cal[:day_of_week] %></div>
    <div class="tk-date-secondary tk-time"><%= time_str %></div>
  </div>
</div>
