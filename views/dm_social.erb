<script src="/roll.js"></script>

<div class="dm-social-layout">
  <div class="dm-social-sidebar">
    <h3>Lead PC</h3>
    <div class="dm-social-list" id="dm-social-pc-list">
      <% @pcs.each do |pc| %>
        <label class="dm-social-entry">
          <input type="radio" name="dm-social-lead" value="<%= pc['id'] %>" data-role="lead">
          <span><%= pc['name'] %></span>
        </label>
      <% end %>
    </div>

    <h3 style="margin-top: 18px;">DM-NPC</h3>
    <div class="dm-social-list" id="dm-social-npc-list">
      <% @npcs_grouped.each do |group, list| %>
        <div class="dm-social-group">
          <div class="dm-social-group-header"><strong><%= group %></strong></div>
          <% list.each do |npc| %>
            <label class="dm-social-entry">
              <input type="radio" name="dm-social-npc" value="<%= npc['id'] %>" data-role="npc">
              <span><%= npc['name'] %></span>
            </label>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>

  <div class="dm-social-main">
    <div class="dm-social-header">
      <h2>Social Skill Checks</h2>
      <div class="dm-social-current">
        Lead: <strong id="dm-social-lead-name">—</strong>
        &nbsp;&nbsp;
        DM-NPC: <strong id="dm-social-npc-name">—</strong>
      </div>
      <button type="button" class="dm-social-roll-all" onclick="dmSocialRollAll()">Roll All</button>
    </div>

    <table class="dm-social-table" id="dm-social-table">
      <thead>
        <tr>
          <th class="dm-social-skill-col">Check</th>
          <th class="dm-social-npc-col">DM-NPC</th>
          <% @pcs.each do |pc| %>
            <th class="dm-social-pc-col" data-pc-id="<%= pc['id'] %>"><%= pc['name'] %></th>
          <% end %>
          <th class="dm-social-bonus-col" title="Bonus/penalty applied to every PC in this row">PC Bonus</th>
          <th class="dm-social-bonus-col" title="Bonus/penalty applied to the DM-NPC in this row">NPC Bonus</th>
        </tr>
      </thead>
      <tbody>
        <% rows = [
             { key: 'perception',   label: 'Perception',   kind: 'unopposed' },
             { key: 'sense_motive', label: 'Sense Motive', kind: 'opposed_sense' },
             { key: 'deception',    label: 'Deception',    kind: 'opposed_deception' },
             { key: 'persuasion',   label: 'Persuasion',   kind: 'opposed_persuasion' },
             { key: 'wisdom',       label: 'Wisdom',       kind: 'unopposed' },
             { key: 'intelligence', label: 'Intelligence', kind: 'unopposed' }
           ] %>
        <% rows.each do |row| %>
          <tr data-row="<%= row[:key] %>" data-kind="<%= row[:kind] %>">
            <td class="dm-social-skill-name"><%= row[:label] %></td>
            <td class="dm-social-cell" data-cell="npc"></td>
            <% @pcs.each do |pc| %>
              <td class="dm-social-cell" data-cell="pc" data-pc-id="<%= pc['id'] %>"></td>
            <% end %>
            <td class="dm-social-bonus-cell">
              <input type="number" class="dm-social-bonus" data-bonus-side="pc" data-row="<%= row[:key] %>" value="0">
            </td>
            <td class="dm-social-bonus-cell">
              <input type="number" class="dm-social-bonus" data-bonus-side="npc" data-row="<%= row[:key] %>" value="0">
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <p class="dm-social-legend">
      Cells show net successes (10s = +2, 1s = −1). Opposed cells show the
      difference between the cell's character and their opponent.
      Hover any cell to see the dice and TN math; click <strong>Roll All</strong>
      to re-roll the matrix.
    </p>
  </div>
</div>

<script>
(function() {
  // Server-computed dice/bonus for every relevant skill on every
  // PC and selectable DM-NPC. Persuasion_opp is the higher-aptitude
  // of (persuasion, sense_motive) for that character — used when the
  // DM is rolling persuasion and the *opponent* gets to pick which
  // skill to defend with.
  var pcStats = <%= @pcs.to_json %>;
  var npcGrouped = <%= @npcs_grouped.to_json %>;
  var allNpcStats = [].concat.apply([], npcGrouped.map(function(g) { return g[1]; }));

  var BASE_TN = <%= @base_tn %>;
  var TN_MIN  = <%= @tn_min %>;
  var TN_MAX  = <%= @tn_max %>;

  var STORAGE_KEY = 'dmSocial.selection';

  function clamp(n, lo, hi) { return Math.max(lo, Math.min(hi, n)); }
  // tnInfo is the full TN computation kept around for the hover
  // tooltip. raw is pre-clamp so the DM can see when an extreme
  // bonus would have pushed past the 4..9 window.
  function tnInfo(selfSkillBonus, selfRowBonus, oppSkillBonus, oppRowBonus) {
    var raw = BASE_TN
      - (selfSkillBonus || 0)
      - (selfRowBonus   || 0)
      + (oppSkillBonus  || 0)
      + (oppRowBonus    || 0);
    return {
      base: BASE_TN,
      selfSkill: selfSkillBonus || 0,
      selfRow:   selfRowBonus   || 0,
      oppSkill:  oppSkillBonus  || 0,
      oppRow:    oppRowBonus    || 0,
      raw: raw,
      tn: clamp(raw, TN_MIN, TN_MAX)
    };
  }
  // One-shot dice pool. Returns the rolled dice plus the net so the
  // hover tooltip can render the original dice with their per-die
  // breakdown (10 = +2, 1 = -1, otherwise +1 if >= TN, else 0).
  function rollOnce(dice, tn) {
    var r = new Roll(null, null, dice, tn, true);
    r.rollFresh();
    return { dice: r.originalRolls.slice(), tn: tn, count: dice, net: r.finalSuccesses() };
  }

  function findById(list, id) {
    for (var i = 0; i < list.length; i++) if (String(list[i].id) === String(id)) return list[i];
    return null;
  }

  function loadSelection() {
    try {
      var raw = localStorage.getItem(STORAGE_KEY);
      if (!raw) return {};
      return JSON.parse(raw) || {};
    } catch (e) { return {}; }
  }
  function saveSelection(sel) {
    try { localStorage.setItem(STORAGE_KEY, JSON.stringify(sel)); } catch (e) {}
  }

  function currentSelection() {
    var leadEl = document.querySelector('input[name="dm-social-lead"]:checked');
    var npcEl  = document.querySelector('input[name="dm-social-npc"]:checked');
    return {
      lead: leadEl ? leadEl.value : null,
      npc:  npcEl  ? npcEl.value  : null,
      bonuses: collectBonuses()
    };
  }
  function collectBonuses() {
    var out = { pc: {}, npc: {} };
    document.querySelectorAll('.dm-social-bonus').forEach(function(inp) {
      var side = inp.getAttribute('data-bonus-side');
      var row  = inp.getAttribute('data-row');
      var v = parseInt(inp.value, 10);
      out[side][row] = isNaN(v) ? 0 : v;
    });
    return out;
  }

  function applyStoredSelection() {
    var s = loadSelection();
    if (s.lead) {
      var leadInput = document.querySelector('input[name="dm-social-lead"][value="' + s.lead + '"]');
      if (leadInput) leadInput.checked = true;
    }
    if (s.npc) {
      var npcInput = document.querySelector('input[name="dm-social-npc"][value="' + s.npc + '"]');
      if (npcInput) npcInput.checked = true;
    }
    if (s.bonuses) {
      ['pc','npc'].forEach(function(side) {
        var byRow = s.bonuses[side] || {};
        Object.keys(byRow).forEach(function(row) {
          var inp = document.querySelector('.dm-social-bonus[data-bonus-side="' + side + '"][data-row="' + row + '"]');
          if (inp) inp.value = byRow[row];
        });
      });
    }
    refreshHeader();
  }

  function refreshHeader() {
    var sel = currentSelection();
    var lead = findById(pcStats, sel.lead);
    var npc  = findById(allNpcStats, sel.npc);
    document.getElementById('dm-social-lead-name').textContent = lead ? lead.name : '—';
    document.getElementById('dm-social-npc-name').textContent  = npc  ? npc.name  : '—';
  }

  function clearAllCells() {
    document.querySelectorAll('.dm-social-cell').forEach(function(td) {
      td.innerHTML = '';
      td.classList.remove('positive', 'negative', 'zero');
    });
  }

  // Pretty-print a signed integer with an explicit sign.
  function signed(n) { return (n >= 0 ? '+' : '') + n; }

  // Dice-color spans only; the colors already encode each die's
  // contribution (red 1 = fumble, blue 10 = crit, green = success,
  // grey = miss) so adding a per-die +/- value just clutters the
  // tooltip. The aggregate net is shown after the dice.
  function renderDice(rolled, tn) {
    return rolled.map(function(d) { return Roll.colorizeDie(d, tn); }).join(' ');
  }

  // Show the entire TN computation: base, self bonuses (negative
  // because they reduce TN), opponent bonuses (positive because they
  // raise TN), then the clamped result.
  function renderTnLine(info) {
    var pieces = [String(info.base)];
    if (info.selfSkill) pieces.push((info.selfSkill > 0 ? '−' : '+') + Math.abs(info.selfSkill) + ' self skill');
    if (info.selfRow)   pieces.push((info.selfRow   > 0 ? '−' : '+') + Math.abs(info.selfRow)   + ' row bonus');
    if (info.oppSkill)  pieces.push((info.oppSkill  > 0 ? '+' : '−') + Math.abs(info.oppSkill)  + ' opp skill');
    if (info.oppRow)    pieces.push((info.oppRow    > 0 ? '+' : '−') + Math.abs(info.oppRow)    + ' opp row');
    var s = pieces.join(' ');
    var clampNote = (info.raw === info.tn) ? '' :
      ' <span style="color:#ffcc80;">(clamped from ' + info.raw + ')</span>';
    return s + ' = <strong>TN ' + info.tn + '</strong>' + clampNote;
  }

  // Render a single roll subsection ("Self" or "Opponent"). Carries
  // the rolled-vs character's name and the skill they used so the DM
  // can read the matrix without cross-referencing the headers.
  function renderRollBlock(label, who, skillName, roll, tnInfoObj) {
    return '<div style="margin-top:6px;"><strong>' + label + '</strong>: ' +
      who + ' &middot; ' + skillName + ' (' + roll.count + 'd)' +
      '<div style="margin:2px 0 2px 8px;">' + renderTnLine(tnInfoObj) + '</div>' +
      '<div style="margin:2px 0 0 8px;">' + renderDice(roll.dice, roll.tn) +
      ' &nbsp;→&nbsp; net <strong>' + signed(roll.net) + '</strong></div></div>';
  }

  function buildTooltipHtml(breakdown) {
    var rows = [];
    rows.push(renderRollBlock('Self', breakdown.self.who, breakdown.self.skill,
                              breakdown.self.roll, breakdown.self.tnInfo));
    if (breakdown.opp) {
      rows.push(renderRollBlock('Opponent', breakdown.opp.who, breakdown.opp.skill,
                                breakdown.opp.roll, breakdown.opp.tnInfo));
      rows.push('<div style="margin-top:6px;border-top:1px solid #555;padding-top:4px;">' +
        'Result: ' + signed(breakdown.self.roll.net) + ' − ' + signed(breakdown.opp.roll.net) +
        ' = <strong>' + signed(breakdown.self.roll.net - breakdown.opp.roll.net) + '</strong></div>');
    }
    return '<div class="dm-social-tooltip">' + rows.join('') + '</div>';
  }

  // Paint a cell with its display number plus an inline tooltip
  // child that shows the full TN math + dice breakdown on hover.
  function paintCell(td, value, breakdown) {
    var text = signed(value);
    td.classList.remove('positive', 'negative', 'zero');
    if (value > 0) td.classList.add('positive');
    else if (value < 0) td.classList.add('negative');
    else td.classList.add('zero');
    td.innerHTML = '<span class="dm-social-cell-value">' + text + '</span>' +
      buildTooltipHtml(breakdown);
  }

  // Pretty label for a skill key inside the tooltip.
  var SKILL_LABELS = {
    perception: 'Perception', sense_motive: 'Sense Motive',
    deception: 'Deception', persuasion: 'Persuasion',
    wisdom: 'Wisdom', intelligence: 'Intelligence'
  };

  // One unopposed-side breakdown: roll the dice and package up the
  // TN math + dice for the tooltip.
  function rollSide(charStats, skillKey, rowBonus) {
    var stat = charStats[skillKey];
    var info = tnInfo(stat.bonus, rowBonus, 0, 0);
    return {
      who: charStats.name,
      skill: SKILL_LABELS[skillKey] || skillKey,
      tnInfo: info,
      roll: rollOnce(stat.dice, info.tn)
    };
  }
  // One opposed-side breakdown given concrete skill picks for both
  // sides. Used by sense/deception (same skill on both sides) and
  // persuasion (active vs persuasion_opp).
  function rollOpposed(selfChar, selfSkillKey, selfStat, selfRow, oppChar, oppSkillKey, oppStat, oppRow) {
    var info = tnInfo(selfStat.bonus, selfRow, oppStat.bonus, oppRow);
    return {
      who: selfChar.name,
      skill: SKILL_LABELS[selfSkillKey] || selfSkillKey,
      tnInfo: info,
      roll: rollOnce(selfStat.dice, info.tn)
    };
  }

  // Per-row roll. NPC rolls once against the lead PC; each PC rolls
  // against the NPC. Cells display the cell-character's net minus
  // their opponent's net (or just their own net for unopposed).
  function rollRow(rowKey, kind, sel) {
    var lead = findById(pcStats, sel.lead);
    var npc  = findById(allNpcStats, sel.npc);
    var pcBonus  = (sel.bonuses.pc  || {})[rowKey] || 0;
    var npcBonus = (sel.bonuses.npc || {})[rowKey] || 0;

    var npcCell = document.querySelector('tr[data-row="' + rowKey + '"] td[data-cell="npc"]');
    var pcCells = document.querySelectorAll('tr[data-row="' + rowKey + '"] td[data-cell="pc"]');

    if (kind === 'unopposed') {
      // Each character rolls independently. The DM-NPC cell only
      // shows when an NPC is selected; PC cells always show.
      if (npc) {
        var npcSide = rollSide(npc, rowKey, npcBonus);
        paintCell(npcCell, npcSide.roll.net, { self: npcSide });
      }
      pcCells.forEach(function(td) {
        var pc = findById(pcStats, td.getAttribute('data-pc-id'));
        if (!pc) return;
        var pcSide = rollSide(pc, rowKey, pcBonus);
        paintCell(td, pcSide.roll.net, { self: pcSide });
      });
      return;
    }

    if (!lead || !npc) return; // opposed rows need both ends selected

    if (kind === 'opposed_sense' || kind === 'opposed_deception') {
      // Same-skill opposed roll. NPC rolls once vs lead; each PC
      // rolls vs NPC. Each cell prints (self_net - opp_net).
      var skill = (kind === 'opposed_sense') ? 'sense_motive' : 'deception';
      var npcSide  = rollOpposed(npc,  skill, npc[skill],  npcBonus, lead, skill, lead[skill], pcBonus);
      var leadSide = rollOpposed(lead, skill, lead[skill], pcBonus,  npc,  skill, npc[skill],  npcBonus);
      paintCell(npcCell, npcSide.roll.net - leadSide.roll.net,
                { self: npcSide, opp: leadSide });

      pcCells.forEach(function(td) {
        var pc = findById(pcStats, td.getAttribute('data-pc-id'));
        if (!pc) return;
        var pcSide;
        if (String(pc.id) === String(lead.id)) pcSide = leadSide;
        else pcSide = rollOpposed(pc, skill, pc[skill], pcBonus, npc, skill, npc[skill], npcBonus);
        paintCell(td, pcSide.roll.net - npcSide.roll.net,
                  { self: pcSide, opp: npcSide });
      });
      return;
    }

    if (kind === 'opposed_persuasion') {
      // Active side rolls persuasion; the *opposing* side defends
      // with whichever of (persuasion, sense_motive) they're more
      // apt at — that pre-resolved skill is on each character as
      // persuasion_opp. PC[i].persuasion is opposed by NPC's
      // persuasion_opp; NPC.persuasion is opposed by lead's
      // persuasion_opp.
      var npcAct  = npc.persuasion;
      var leadOpp = lead.persuasion_opp;
      var npcOpp  = npc.persuasion_opp;

      var npcSide     = rollOpposed(npc,  'persuasion',          npcAct,  npcBonus, lead, leadOpp.skill, leadOpp, pcBonus);
      var leadOppSide = rollOpposed(lead, leadOpp.skill,         leadOpp, pcBonus,  npc,  'persuasion',  npcAct,  npcBonus);
      paintCell(npcCell, npcSide.roll.net - leadOppSide.roll.net,
                { self: npcSide, opp: leadOppSide });

      pcCells.forEach(function(td) {
        var pc = findById(pcStats, td.getAttribute('data-pc-id'));
        if (!pc) return;
        var pcAct = pc.persuasion;
        var pcSide  = rollOpposed(pc,  'persuasion',  pcAct,  pcBonus,  npc, npcOpp.skill, npcOpp, npcBonus);
        var npcOppSide = rollOpposed(npc, npcOpp.skill, npcOpp, npcBonus, pc, 'persuasion', pcAct,  pcBonus);
        paintCell(td, pcSide.roll.net - npcOppSide.roll.net,
                  { self: pcSide, opp: npcOppSide });
      });
      return;
    }
  }

  window.dmSocialRollAll = function() {
    var sel = currentSelection();
    saveSelection(sel);
    refreshHeader();
    clearAllCells();
    document.querySelectorAll('#dm-social-table tbody tr').forEach(function(tr) {
      var rowKey = tr.getAttribute('data-row');
      var kind = tr.getAttribute('data-kind');
      rollRow(rowKey, kind, sel);
    });
  };

  // Persist selection on every change so a refresh restores it.
  document.addEventListener('change', function(e) {
    if (!e.target.matches('input[name="dm-social-lead"], input[name="dm-social-npc"]')) return;
    saveSelection(currentSelection());
    refreshHeader();
  });
  document.addEventListener('input', function(e) {
    if (!e.target.matches('.dm-social-bonus')) return;
    saveSelection(currentSelection());
  });

  applyStoredSelection();
})();
</script>
