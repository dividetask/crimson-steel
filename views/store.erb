  <h1>Store</h1>

  <div class="gold-display">Party Gold: <%= @campaign['gold'] %> gp</div>

  <% if params[:error] == 'insufficient_gold' %>
    <div class="alert alert-error">Insufficient gold!</div>
  <% end %>

  <% if params[:error] == 'already_known' %>
    <div class="alert alert-error">That character already knows this ritual.</div>
  <% end %>

  <% if params[:success] %>
    <div class="alert alert-success">Purchase successful!</div>
  <% end %>

  <% pcs = @characters.select { |c| c['group'] == 'PC' } %>
  <div class="store-layout">
    <div class="filter-sidebar">
      <h3>Filters</h3>
      <button class="clear-btn" id="clear-filters">Clear All</button>

      <div class="filter-group">
        <h4>Type</h4>
        <label><input type="checkbox" class="filter-cb" data-filter="category" value="item"> Item</label>
        <label><input type="checkbox" class="filter-cb" data-filter="category" value="ammunition"> Ammunition</label>
        <label><input type="checkbox" class="filter-cb" data-filter="category" value="equipment"> Equipment</label>
      </div>

      <div class="filter-group">
        <h4>Tier</h4>
        <% (0..6).each do |t| %>
          <label><input type="checkbox" class="filter-cb" data-filter="tier" value="<%= t %>"> Tier <%= t %></label>
        <% end %>
      </div>
    </div>

    <div class="store-content">
      <h2>Equipment</h2>
      <div class="store-grid" id="equipment-grid">
        <% @store_items.each_with_index do |item, index| %>
          <% if item['variants'] %>
            <% tier_values = item['variants'].map { |v| v['bonus'] }.uniq.join(' ') %>
            <% first_variant = item['variants'].first %>
            <div class="store-item variant-item" data-category="<%= item['type'] %>" data-tier="<%= tier_values %>" data-rules-table="<%= item['variant_rules_table'] %>">
              <h3><%= item['name'] %></h3>
              <p><strong>Type:</strong> <%= item['type'].capitalize %> - <%= item['subtype'] %></p>
              <% item['variant_selectors'].each do |selector| %>
                <% options = item['variants'].map { |v| v[selector['key']] }.uniq %>
                <div class="variant-selector-row">
                  <label><%= selector['label'] %>:
                    <select class="variant-selector" data-selector-key="<%= selector['key'] %>">
                      <% options.each do |opt| %>
                        <option value="<%= opt %>"><%= opt %></option>
                      <% end %>
                    </select>
                  </label>
                </div>
              <% end %>
              <p class="variant-desc" data-desc-template="<%= h(item['description']) %>"><%= item['description'] %></p>
              <p class="price"><span class="variant-price"><%= first_variant['price'] %></span> gp</p>

              <form method="post" action="/purchase/<%= index %>" class="purchase-form">
                <input type="hidden" name="variant_index" class="variant-index-input" value="0">
                <select name="owner_id" required>
                  <option value="">Select Character</option>
                  <% pcs.each do |char| %>
                    <option value="<%= char['id'] %>"><%= char['name'] %></option>
                  <% end %>
                </select>
                <button type="submit">Purchase</button>
              </form>
              <script type="application/json" class="variant-data"><%= JSON.generate(item['variants']) %></script>
            </div>
          <% else %>
            <div class="store-item" data-category="<%= item['type'] %>" data-tier="<%= item['bonus'] %>">
              <h3><%= item['name'] %></h3>
              <p><strong>Type:</strong> <%= item['type'].capitalize %> - <%= item['subtype'] %></p>
              <% if item['bonus'] > 0 %>
                <p><strong>Bonus:</strong> +<%= item['bonus'] %></p>
              <% end %>
              <p class="price"><%= item['price'] %> gp</p>

              <form method="post" action="/purchase/<%= index %>" class="purchase-form">
                <select name="owner_id" required>
                  <option value="">Select Character</option>
                  <% pcs.each do |char| %>
                    <option value="<%= char['id'] %>"><%= char['name'] %></option>
                  <% end %>
                </select>
                <button type="submit">Purchase</button>
              </form>
            </div>
          <% end %>
        <% end %>
      </div>

      <h2>Ammunition</h2>
      <div class="store-card-grid">
        <div class="store-card">
          <div class="card-header">
            <span class="item-type item-type-ammunition">Ammunition</span>
          </div>
          <div class="selector-row">
            <div class="selector-field-narrow">
              <label>Tier</label>
              <select id="ammo-tier-select">
                <option value="">-</option>
              </select>
            </div>
            <div class="selector-field">
              <label>Property</label>
              <select id="ammo-property-select" disabled>
                <option value="">None</option>
              </select>
            </div>
          </div>
        <div id="ammo-details" style="display:none;">
          <p class="ammo-description"></p>
          <p class="price">0 gp</p>
          <form method="post" action="/purchase/ammo_lookup" class="purchase-form">
            <input type="hidden" name="tier" value="">
            <input type="hidden" name="property" value="">
            <select name="owner_id" required>
              <option value="">Select Character</option>
              <% pcs.each do |char| %>
                <option value="<%= char['id'] %>"><%= char['name'] %></option>
              <% end %>
            </select>
            <button type="submit">Purchase</button>
          </form>
          </div>
        </div>
      </div>

      <h2>Spell Items</h2>
      <div class="store-card-grid">
        <% ['scroll', 'potion', 'oil', 'wand'].each do |item_type| %>
          <% uses_skill = %w[scroll wand].include?(item_type) %>
          <% uses_pc_grid = %w[scroll potion oil].include?(item_type) %>
          <div class="store-card">
            <div class="card-header">
              <span class="item-type item-type-<%= item_type %>"><%= item_type.capitalize %></span>
            </div>
            <div class="selector-row">
              <% if uses_skill %>
                <div class="selector-field">
                  <label>Skill</label>
                  <select class="skill-select" data-item-type="<%= item_type %>">
                    <option value="">Select Skill</option>
                  </select>
                </div>
              <% end %>
              <div class="selector-field-narrow">
                <label>Tier</label>
                <select class="tier-select" data-item-type="<%= item_type %>" <%= 'disabled' if uses_skill %>>
                  <option value="">-</option>
                </select>
              </div>
              <div class="selector-field">
                <label>Spell</label>
                <select class="spell-select" data-item-type="<%= item_type %>" disabled>
                  <option value="">Select Spell</option>
                </select>
              </div>
            </div>
            <div class="spell-details" id="details-<%= item_type %>" style="display:none;">
              <p class="spell-description"></p>
              <p class="price">0 gp</p>
              <form method="post" action="/purchase/spell_lookup" class="purchase-form">
                <input type="hidden" name="spell_name" value="">
                <input type="hidden" name="item_type" value="<%= item_type %>">
                <input type="hidden" name="tier" value="">
                <% if uses_pc_grid %>
                  <div class="pc-qty-grid">
                    <% pcs.each do |pc| %>
                      <div class="pc-qty-row">
                        <label><%= pc['name'] %></label>
                        <input type="number" class="pc-qty" name="quantities[<%= pc['id'] %>]" value="0" min="0" step="1">
                      </div>
                    <% end %>
                  </div>
                  <div class="total-cost">Total: <span class="total-display">0 gp</span></div>
                  <button type="submit">Purchase</button>
                <% else %>
                  <select name="owner_id" required>
                    <option value="">Select Character</option>
                    <% pcs.each do |char| %>
                      <option value="<%= char['id'] %>"><%= char['name'] %></option>
                    <% end %>
                  </select>
                  <button type="submit">Purchase</button>
                <% end %>
              </form>
            </div>
          </div>
        <% end %>
      </div>

      <h2>Rituals</h2>
      <div class="store-card-grid">
        <div class="store-card">
          <div class="card-header">
            <span class="item-type item-type-ritual">Ritual</span>
            <p class="dt-note" style="margin-top:6px;">Inscribe a spell into a character's ritual spellbook. Cost equals the scroll price (25 &times; tier &times; (2&times;tier-1)).</p>
          </div>
          <div class="selector-row">
            <div class="selector-field-narrow">
              <label>Tier</label>
              <select id="ritual-tier-select">
                <option value="">-</option>
              </select>
            </div>
            <div class="selector-field">
              <label>Ritual</label>
              <select id="ritual-spell-select" disabled>
                <option value="">Select Ritual</option>
              </select>
            </div>
          </div>
          <div id="ritual-details" style="display:none; margin-top:15px; padding-top:15px; border-top:1px solid #ddd;">
            <p class="spell-description"></p>
            <p class="price">0 gp</p>
            <form method="post" action="/purchase_ritual" class="purchase-form">
              <input type="hidden" name="spell_name" value="">
              <select name="owner_id" id="ritual-owner-select" required>
                <option value="">Select Character</option>
                <% pcs.each do |char| %>
                  <option value="<%= char['id'] %>"><%= char['name'] %></option>
                <% end %>
              </select>
              <button type="submit">Purchase</button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    var ritualItems = <%= JSON.generate(@ritual_items) %>;
    var characterRituals = <%= JSON.generate(@character_rituals) %>;
    var spellData = <%= JSON.generate(@spell_data) %>;
    var itemCosts = <%= JSON.generate(@item_costs) %>;
    var propertyCosts = <%= JSON.generate(@property_costs) %>;
    var rulesReference = <%= JSON.generate(@rules_reference || {}) %>;
    var ammoCosts = itemCosts['ammunition'];

    // Variant items: each card has one or more <select class="variant-selector">
    // dropdowns (Size, Attribute, Enhancement, etc.). The variants array lists every
    // legal combination; matching the selected values back into the list resolves
    // price, display name, and the description template (which may reference
    // rulesReference[table][rules_key] for size-dependent numbers like bag weight).
    document.querySelectorAll('.variant-item').forEach(function(card) {
      var dataEl = card.querySelector('.variant-data');
      var variants = JSON.parse(dataEl.textContent);
      var selectors = card.querySelectorAll('.variant-selector');
      var priceEl = card.querySelector('.variant-price');
      var descEl = card.querySelector('.variant-desc');
      var indexInput = card.querySelector('.variant-index-input');
      var descTemplate = descEl.getAttribute('data-desc-template') || descEl.textContent;
      var rulesTable = card.getAttribute('data-rules-table');

      function findVariantIndex() {
        for (var i = 0; i < variants.length; i++) {
          var match = true;
          selectors.forEach(function(sel) {
            var key = sel.getAttribute('data-selector-key');
            if (String(variants[i][key]) !== String(sel.value)) match = false;
          });
          if (match) return i;
        }
        return -1;
      }

      function resolveDescription(variant) {
        if (!rulesTable) return descTemplate;
        var table = rulesReference[rulesTable];
        if (!table) return descTemplate;
        var refData = table[variant.rules_key];
        if (!refData) return descTemplate;
        return descTemplate.replace(/\{(\w+)\}/g, function(m, k) {
          return refData[k] != null ? refData[k] : m;
        });
      }

      function update() {
        var idx = findVariantIndex();
        if (idx < 0) return;
        var v = variants[idx];
        priceEl.textContent = v.price;
        descEl.textContent = resolveDescription(v);
        indexInput.value = idx;
      }

      selectors.forEach(function(sel) {
        sel.addEventListener('change', update);
      });
      update();
    });

    var skillLabels = {
      'nature': 'Nature', 'perform_': 'Perform', 'arcana': 'Arcana',
      'use_magic_device': 'Use Magic Device', 'healing': 'Healing'
    };

    function calcPrice(itemType, tier) {
      var formula = itemCosts[itemType];
      if (!formula) return 0;
      return eval(formula.replace(/tier/g, tier));
    }

    function getSpellName(spellKey, spell, tierIdx, totalTiers, itemType) {
      if (totalTiers > 1 && spell.prefix) {
        return spell.prefix[tierIdx] + ' ' + spellKey + ' ' + itemType.charAt(0).toUpperCase() + itemType.slice(1);
      } else if (totalTiers > 1 && spell.suffix) {
        return spellKey + ' ' + spell.suffix[tierIdx] + ' ' + itemType.charAt(0).toUpperCase() + itemType.slice(1);
      }
      return spellKey + ' ' + itemType.charAt(0).toUpperCase() + itemType.slice(1);
    }

    function getSpellsForType(itemType) {
      var result = [];
      for (var name in spellData) {
        var spell = spellData[name];
        if (spell.items && spell.items.indexOf(itemType) !== -1) {
          result.push({key: name, spell: spell});
        }
      }
      return result;
    }

    function getSkillsForType(itemType) {
      var spells = getSpellsForType(itemType);
      var skills = {};
      spells.forEach(function(s) {
        s.spell.skill.forEach(function(sk) { skills[sk] = true; });
      });
      // Always add use_magic_device
      skills['use_magic_device'] = true;
      return Object.keys(skills).sort();
    }

    function getTiersForSkillAndType(skill, itemType) {
      var spells = getSpellsForType(itemType);
      var tiers = {};
      spells.forEach(function(s) {
        if (skill === 'use_magic_device' || s.spell.skill.indexOf(skill) !== -1) {
          var tierList = Array.isArray(s.spell.tier) ? s.spell.tier : [s.spell.tier];
          tierList.forEach(function(t) { tiers[t] = true; });
        }
      });
      return Object.keys(tiers).map(Number).sort(function(a,b) { return a - b; });
    }

    function getSpellsForSkillTierType(skill, tier, itemType) {
      var spells = getSpellsForType(itemType);
      var result = [];
      spells.forEach(function(s) {
        if (skill !== 'use_magic_device' && s.spell.skill.indexOf(skill) === -1) return;
        var tierList = Array.isArray(s.spell.tier) ? s.spell.tier : [s.spell.tier];
        var tierIdx = tierList.indexOf(tier);
        if (tierIdx === -1) return;
        result.push({key: s.key, spell: s.spell, tierIdx: tierIdx, tier: tier});
      });
      return result;
    }

    function getTiersForType(itemType) {
      var spells = getSpellsForType(itemType);
      var tiers = {};
      spells.forEach(function(s) {
        var tierList = Array.isArray(s.spell.tier) ? s.spell.tier : [s.spell.tier];
        tierList.forEach(function(t) { tiers[t] = true; });
      });
      return Object.keys(tiers).map(Number).sort(function(a,b){return a-b;});
    }

    function getSpellsForTierType(tier, itemType) {
      var spells = getSpellsForType(itemType);
      var result = [];
      spells.forEach(function(s) {
        var tierList = Array.isArray(s.spell.tier) ? s.spell.tier : [s.spell.tier];
        var tierIdx = tierList.indexOf(tier);
        if (tierIdx === -1) return;
        result.push({key: s.key, spell: s.spell, tierIdx: tierIdx, tier: tier});
      });
      return result;
    }

    function updateTotalCost(details) {
      var priceText = details.querySelector('.price').textContent;
      var price = parseInt(priceText) || 0;
      var inputs = details.querySelectorAll('.pc-qty');
      var total = 0;
      inputs.forEach(function(inp) { total += (parseInt(inp.value) || 0) * price; });
      var display = details.querySelector('.total-display');
      if (display) display.textContent = total + ' gp';
    }

    function resolveDescription(spell, tierIdx, tierVal) {
      return spell.description.replace(/\{(\w+)\}/g, function(match, varName) {
        var val = spell.effect_hash ? spell.effect_hash[varName] : null;
        if (!val) return match;
        if (Array.isArray(val)) return val[tierIdx];
        if (typeof val === 'string') {
          try { return eval(val.replace(/tier/g, tierVal)); } catch(e) { return val; }
        }
        return val;
      });
    }

    // Initialize ammunition selects
    (function() {
      var tierSelect = document.getElementById('ammo-tier-select');
      var propSelect = document.getElementById('ammo-property-select');
      var details = document.getElementById('ammo-details');

      ammoCosts.forEach(function(price, tier) {
        var opt = document.createElement('option');
        opt.value = tier;
        opt.textContent = tier;
        tierSelect.appendChild(opt);
      });

      tierSelect.addEventListener('change', function() {
        propSelect.innerHTML = '<option value="">None</option>';
        propSelect.disabled = true;
        details.style.display = 'none';

        if (!this.value) return;
        var tier = parseInt(this.value);
        var basePrice = ammoCosts[tier];

        // Add property options available at this tier
        for (var propName in propertyCosts) {
          var prop = propertyCosts[propName];
          var available = prop.requirements.some(function(req) {
            if (req.type !== 'ammunition') return false;
            var minTier = parseInt(req.tier.toString().replace('>=', ''));
            return tier >= minTier;
          });
          if (available) {
            var opt = document.createElement('option');
            opt.value = propName;
            opt.textContent = propName;
            propSelect.appendChild(opt);
          }
        }
        propSelect.disabled = false;

        // Show base arrow details
        var name = tier === 0 ? 'Arrows' : 'Arrows +' + tier;
        var desc = tier === 0 ? 'Standard arrows.' : 'Magical arrows with a +' + tier + ' enhancement bonus.';
        details.querySelector('.ammo-description').textContent = desc;
        details.querySelector('.price').textContent = basePrice + ' gp';
        details.querySelector('input[name="tier"]').value = tier;
        details.querySelector('input[name="property"]').value = '';
        details.style.display = '';
      });

      propSelect.addEventListener('change', function() {
        var tier = parseInt(tierSelect.value);
        var basePrice = ammoCosts[tier];
        var propName = this.value;

        if (propName && propertyCosts[propName]) {
          var prop = propertyCosts[propName];
          var price = basePrice + prop.cost;
          details.querySelector('.ammo-description').textContent = prop.description;
          details.querySelector('.price').textContent = price + ' gp';
          details.querySelector('input[name="property"]').value = propName;
        } else {
          var desc = tier === 0 ? 'Standard arrows.' : 'Magical arrows with a +' + tier + ' enhancement bonus.';
          details.querySelector('.ammo-description').textContent = desc;
          details.querySelector('.price').textContent = basePrice + ' gp';
          details.querySelector('input[name="property"]').value = '';
        }
      });
    })();

    // Initialize per-item-type selects. Scrolls and wands use a Skill -> Tier -> Spell
    // flow; potions and oils skip the skill dropdown since any skill can be used to
    // drink/apply them.
    ['scroll', 'potion', 'oil', 'wand'].forEach(function(itemType) {
      var usesSkill = itemType === 'scroll' || itemType === 'wand';
      var skillSelect = document.querySelector('.skill-select[data-item-type="' + itemType + '"]');
      var tierSelect = document.querySelector('.tier-select[data-item-type="' + itemType + '"]');
      var spellSelect = document.querySelector('.spell-select[data-item-type="' + itemType + '"]');
      var details = document.getElementById('details-' + itemType);

      if (usesSkill) {
        var skills = getSkillsForType(itemType);
        skills.forEach(function(sk) {
          var opt = document.createElement('option');
          opt.value = sk;
          opt.textContent = skillLabels[sk] || sk;
          skillSelect.appendChild(opt);
        });

        skillSelect.addEventListener('change', function() {
          tierSelect.innerHTML = '<option value="">-</option>';
          spellSelect.innerHTML = '<option value="">Select Spell</option>';
          tierSelect.disabled = true;
          spellSelect.disabled = true;
          details.style.display = 'none';

          if (!this.value) return;
          var tiers = getTiersForSkillAndType(this.value, itemType);
          tiers.forEach(function(t) {
            var opt = document.createElement('option');
            opt.value = t;
            opt.textContent = t;
            tierSelect.appendChild(opt);
          });
          tierSelect.disabled = false;
        });
      } else {
        // No skill filter: populate tiers directly with every tier that has a spell of this type.
        var tiers = getTiersForType(itemType);
        tiers.forEach(function(t) {
          var opt = document.createElement('option');
          opt.value = t;
          opt.textContent = t;
          tierSelect.appendChild(opt);
        });
      }

      tierSelect.addEventListener('change', function() {
        spellSelect.innerHTML = '<option value="">Select Spell</option>';
        spellSelect.disabled = true;
        details.style.display = 'none';

        if (!this.value) return;
        var tier = parseInt(this.value);
        var spells = usesSkill
          ? getSpellsForSkillTierType(skillSelect.value, tier, itemType)
          : getSpellsForTierType(tier, itemType);

        // Update price display immediately
        var price = calcPrice(itemType, tier);
        details.querySelector('.price').textContent = price + ' gp';

        spells.forEach(function(s) {
          var opt = document.createElement('option');
          var tierList = Array.isArray(s.spell.tier) ? s.spell.tier : [s.spell.tier];
          opt.value = s.key.toLowerCase().replace(/ /g, '_');
          opt.textContent = getSpellName(s.key, s.spell, s.tierIdx, tierList.length, itemType);
          spellSelect.appendChild(opt);
        });
        spellSelect.disabled = false;
      });

      spellSelect.addEventListener('change', function() {
        details.style.display = 'none';
        if (!this.value) return;

        var tier = parseInt(tierSelect.value);
        var spellKey = this.value;
        var price = calcPrice(itemType, tier);

        // Find the spell data
        var spell = null;
        var tierIdx = 0;
        for (var name in spellData) {
          if (name.toLowerCase().replace(/ /g, '_') === spellKey) {
            spell = spellData[name];
            var tierList = Array.isArray(spell.tier) ? spell.tier : [spell.tier];
            tierIdx = tierList.indexOf(tier);
            break;
          }
        }

        if (!spell) return;

        var desc = resolveDescription(spell, tierIdx, tier);
        details.querySelector('.spell-description').textContent = desc;
        details.querySelector('.price').textContent = price + ' gp';
        details.querySelector('input[name="spell_name"]').value = spellKey;
        details.querySelector('input[name="tier"]').value = tier;
        details.style.display = '';
        // Reset quantities and recompute total when a new spell is picked.
        details.querySelectorAll('.pc-qty').forEach(function(inp) { inp.value = 0; });
        updateTotalCost(details);
      });

      // Live-update the total as quantities change.
      if (details) {
        details.querySelectorAll('.pc-qty').forEach(function(inp) {
          inp.addEventListener('input', function() { updateTotalCost(details); });
        });
      }
    });

    // --- Ritual purchase card ---
    (function() {
      var tierSel = document.getElementById('ritual-tier-select');
      var spellSel = document.getElementById('ritual-spell-select');
      var ownerSel = document.getElementById('ritual-owner-select');
      var details = document.getElementById('ritual-details');
      if (!tierSel) return;

      var tiers = {};
      ritualItems.forEach(function(r) { tiers[r.tier] = true; });
      Object.keys(tiers).map(Number).sort(function(a,b){return a-b;}).forEach(function(t) {
        var opt = document.createElement('option'); opt.value = t; opt.textContent = t;
        tierSel.appendChild(opt);
      });

      tierSel.addEventListener('change', function() {
        spellSel.innerHTML = '<option value="">Select Ritual</option>';
        details.style.display = 'none';
        spellSel.disabled = !this.value;
        if (!this.value) return;
        var tier = parseInt(this.value, 10);
        ritualItems.filter(function(r) { return r.tier === tier; }).forEach(function(r) {
          var opt = document.createElement('option');
          opt.value = r.name; opt.textContent = r.name;
          spellSel.appendChild(opt);
        });
      });

      function refreshOwnerOptions(ritualName) {
        // Disable PCs who already know the selected ritual so the form can
        // only submit purchases that will actually land.
        Array.from(ownerSel.options).forEach(function(opt) {
          if (!opt.value) return;
          var known = (characterRituals[opt.value] || []).indexOf(ritualName) !== -1;
          opt.disabled = known;
          opt.textContent = opt.textContent.replace(/ \(Already known\)$/, '');
          if (known) opt.textContent += ' (Already known)';
        });
        // If the currently selected owner knows it, reset selection.
        var selected = ownerSel.options[ownerSel.selectedIndex];
        if (selected && selected.disabled) ownerSel.value = '';
      }

      spellSel.addEventListener('change', function() {
        details.style.display = 'none';
        if (!this.value) return;
        var tier = parseInt(tierSel.value, 10);
        var ritual = ritualItems.find(function(r) { return r.name === spellSel.value && r.tier === tier; });
        if (!ritual) return;
        details.querySelector('.spell-description').textContent = ritual.description || '';
        details.querySelector('.price').textContent = ritual.price + ' gp';
        details.querySelector('input[name="spell_name"]').value = ritual.name;
        refreshOwnerOptions(ritual.name);
        details.style.display = '';
      });
    })();

    // Equipment/Ammo filters
    document.querySelectorAll('.filter-cb').forEach(function(cb) {
      cb.addEventListener('change', applyFilters);
    });

    document.getElementById('clear-filters').addEventListener('click', function() {
      document.querySelectorAll('.filter-cb').forEach(function(cb) {
        cb.checked = false;
      });
      applyFilters();
    });

    function applyFilters() {
      var activeCategories = getChecked('category');
      var activeTiers = getChecked('tier');

      var noCategories = activeCategories.length === 0;
      var noTiers = activeTiers.length === 0;

      document.querySelectorAll('.store-item').forEach(function(card) {
        var category = card.dataset.category;
        // Variant items publish a space-separated list of bonuses (one per variant)
        // so the tier filter matches if any of the variants sits at an active tier.
        var tiers = (card.dataset.tier || '').split(' ').filter(Boolean);

        var categoryMatch = noCategories || activeCategories.indexOf(category) !== -1;
        var tierMatch = noTiers || tiers.some(function(t) { return activeTiers.indexOf(t) !== -1; });

        card.style.display = (categoryMatch && tierMatch) ? '' : 'none';
      });
    }

    function getChecked(filterName) {
      var checked = [];
      document.querySelectorAll('.filter-cb[data-filter="' + filterName + '"]:checked').forEach(function(cb) {
        checked.push(cb.value);
      });
      return checked;
    }
  </script>
