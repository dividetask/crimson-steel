  <style>
    body { font-family: Arial, sans-serif; margin: 20px auto; padding: 20px; }
    .menu { background: #333; padding: 10px; margin: -20px -20px 20px -20px; }
    .menu a { color: white; margin-right: 20px; text-decoration: none; }
    .menu a:hover { text-decoration: underline; }

    .gold-display { font-size: 24px; font-weight: bold; margin-bottom: 20px; }
    .store-layout { display: flex; gap: 20px; }
    .filter-sidebar { width: 200px; flex-shrink: 0; }
    .filter-sidebar h3 { margin-top: 0; }
    .filter-group { margin-bottom: 15px; }
    .filter-group h4 { margin: 0 0 8px 0; color: #555; font-size: 13px; text-transform: uppercase; }
    .filter-group label { display: block; padding: 4px 0; cursor: pointer; font-size: 14px; }
    .filter-group input[type="checkbox"] { margin-right: 6px; }
    .clear-btn { background: #888; color: white; border: none; padding: 6px 12px; border-radius: 3px; cursor: pointer; font-size: 13px; margin-bottom: 15px; }
    .clear-btn:hover { background: #666; }
    .store-content { flex: 1; min-width: 0; }
    .store-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 20px; }
    .store-item { border: 1px solid #ddd; padding: 15px; border-radius: 5px; }
    .store-item h3 { margin-top: 0; }
    .price { font-weight: bold; font-size: 18px; }
    .purchase-form { margin-top: 10px; display: flex; gap: 10px; align-items: center; }
    select, button { padding: 8px; }
    button { background: #4CAF50; color: white; border: none; cursor: pointer; }
    button:hover { background: #45a049; }
    .alert { padding: 10px; margin-bottom: 20px; border-radius: 5px; }
    .alert-success { background: #d4edda; color: #155724; }
    .alert-error { background: #f8d7da; color: #721c24; }
    .spell-item { border: 1px solid #a0c4e8; padding: 15px; border-radius: 5px; background: #f0f7ff; }
    .spell-item h3 { margin-top: 0; }
    .item-type { display: inline-block; padding: 2px 8px; border-radius: 3px; font-size: 12px; font-weight: bold; color: white; }
    .item-type-potion { background: #9c27b0; }
    .item-type-scroll { background: #1976d2; }
    .item-type-oil { background: #e65100; }
    .item-type-wand { background: #2e7d32; }
    .tier-badge { display: inline-block; padding: 2px 8px; border-radius: 3px; font-size: 12px; background: #666; color: white; margin-left: 5px; }
  </style>

  <h1>Store</h1>

  <div class="gold-display">Party Gold: <%= @campaign['gold'] %> gp</div>

  <% if params[:error] == 'insufficient_gold' %>
    <div class="alert alert-error">Insufficient gold!</div>
  <% end %>

  <% if params[:success] %>
    <div class="alert alert-success">Purchase successful!</div>
  <% end %>

  <div class="store-layout">
    <div class="filter-sidebar">
      <h3>Filters</h3>
      <button class="clear-btn" id="clear-filters">Clear All</button>

      <div class="filter-group">
        <h4>Type</h4>
        <label><input type="checkbox" class="filter-cb" data-filter="category" value="item"> Item</label>
        <label><input type="checkbox" class="filter-cb" data-filter="category" value="ammunition"> Ammunition</label>
        <label><input type="checkbox" class="filter-cb" data-filter="category" value="equipment"> Equipment</label>
        <label><input type="checkbox" class="filter-cb" data-filter="category" value="potion"> Potion</label>
        <label><input type="checkbox" class="filter-cb" data-filter="category" value="scroll"> Scroll</label>
        <label><input type="checkbox" class="filter-cb" data-filter="category" value="oil"> Oil</label>
        <label><input type="checkbox" class="filter-cb" data-filter="category" value="wand"> Wand</label>
      </div>

      <div class="filter-group">
        <h4>Tier</h4>
        <% (0..6).each do |t| %>
          <label><input type="checkbox" class="filter-cb" data-filter="tier" value="<%= t %>"> Tier <%= t %></label>
        <% end %>
      </div>
    </div>

    <div class="store-content">
      <h2>Equipment</h2>
      <div class="store-grid" id="equipment-grid">
        <% @store_items.each_with_index do |item, index| %>
          <div class="store-item" data-category="<%= item['type'] %>">
            <h3><%= item['name'] %></h3>
            <p><strong>Type:</strong> <%= item['type'].capitalize %> - <%= item['subtype'] %></p>
            <% if item['bonus'] > 0 %>
              <p><strong>Bonus:</strong> +<%= item['bonus'] %></p>
            <% end %>
            <p class="price"><%= item['price'] %> gp</p>

            <form method="post" action="/purchase/<%= index %>" class="purchase-form">
              <select name="owner_id" required>
                <option value="">Select Character</option>
                <% @characters.each do |char| %>
                  <option value="<%= char['id'] %>"><%= char['name'] %></option>
                <% end %>
              </select>
              <button type="submit">Purchase</button>
            </form>
          </div>
        <% end %>
      </div>

      <h2>Spell Items</h2>
      <div class="store-grid" id="spell-grid">
        <% @spell_items.each_with_index do |item, index| %>
          <div class="spell-item" data-category="<%= item['subtype'] %>" data-tier="<%= item['tier'] %>">
            <h3><%= item['name'] %></h3>
            <p>
              <span class="item-type item-type-<%= item['subtype'] %>"><%= item['subtype'].capitalize %></span>
              <span class="tier-badge">Tier <%= item['tier'] %></span>
            </p>
            <p><%= item['description'] %></p>
            <p class="price"><%= item['price'] %> gp</p>

            <form method="post" action="/purchase/spell_<%= index %>" class="purchase-form">
              <select name="owner_id" required>
                <option value="">Select Character</option>
                <% @characters.each do |char| %>
                  <option value="<%= char['id'] %>"><%= char['name'] %></option>
                <% end %>
              </select>
              <button type="submit">Purchase</button>
            </form>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <script>
    document.querySelectorAll('.filter-cb').forEach(function(cb) {
      cb.addEventListener('change', applyFilters);
    });

    document.getElementById('clear-filters').addEventListener('click', function() {
      document.querySelectorAll('.filter-cb').forEach(function(cb) {
        cb.checked = false;
      });
      applyFilters();
    });

    function applyFilters() {
      var activeCategories = getChecked('category');
      var activeTiers = getChecked('tier');

      var noCategories = activeCategories.length === 0;
      var noTiers = activeTiers.length === 0;

      var equipmentVisible = false;
      var spellVisible = false;

      document.querySelectorAll('.store-item, .spell-item').forEach(function(card) {
        var category = card.dataset.category;
        var tier = card.dataset.tier;
        var isSpell = card.classList.contains('spell-item');

        var categoryMatch = noCategories || activeCategories.indexOf(category) !== -1;
        var tierMatch = !isSpell || noTiers || activeTiers.indexOf(tier) !== -1;

        var visible = categoryMatch && tierMatch;
        card.style.display = visible ? '' : 'none';

        if (visible) {
          if (isSpell) spellVisible = true;
          else equipmentVisible = true;
        }
      });

      document.getElementById('equipment-grid').previousElementSibling.style.display = equipmentVisible ? '' : 'none';
      document.getElementById('equipment-grid').style.display = equipmentVisible ? '' : 'none';

      document.getElementById('spell-grid').previousElementSibling.style.display = spellVisible ? '' : 'none';
      document.getElementById('spell-grid').style.display = spellVisible ? '' : 'none';
    }

    function getChecked(filterName) {
      var checked = [];
      document.querySelectorAll('.filter-cb[data-filter="' + filterName + '"]:checked').forEach(function(cb) {
        checked.push(cb.value);
      });
      return checked;
    }
  </script>
