<%
  chapters = CommonDocs.chapters
  dupes    = CommonDocs.duplicate_chapters

  # One shape for every nav entry, so all three groups render identically:
  # a chapter number reads the same in the Common Rules group as it does in
  # the player list above it.
  entry = lambda do |key, label, href, chapter = nil|
    { key: key, label: label, href: href, chapter: chapter,
      dupe: chapter && dupes.include?(chapter) }
  end

  chapter_items = chapters.map do |c|
    entry.call(c.key, c.chapter_title, "/compendium?view=#{c.key}", c.chapter)
  end
  # Numbered entries never interleave with unnumbered ones: the chapters run
  # in order, then the unnumbered entries, then the Glossary — which is
  # always last and never carries a chapter number.
  player_items = chapter_items + [
    entry.call('spells',   'Spells',   '/compendium?view=spells'),
    entry.call('classes',  'Classes',  '/compendium?view=classes'),
    entry.call('glossary', 'Glossary', '/compendium?view=glossary')
  ]

  # DM-only. Every concept folder under docs/common/ gets a page whether or
  # not it is finished — a half-written concept shows up as a gap rather
  # than silently not existing. Same ordering and the same labels as the
  # player list: a concept in the manual is named by its chapter title.
  common_items = dm_view? ? CommonDocs.in_nav_order.map do |c|
    entry.call("common:#{c.key}", c.chapter_title, "/compendium?view=common:#{c.key}", c.chapter)
  end + [entry.call('common', 'Coverage', '/compendium?view=common')] : []

  design_items = dm_view? ? DesignDocs.keys.map do |key|
    entry.call(key, DesignDocs.title_for(key), "/compendium?view=#{key}")
  end : []

  nav_groups = [
    { title: nil,                     items: player_items },
    { title: 'Common Rules (DM)',     items: common_items },
    { title: 'Website Design (DM)',   items: design_items }
  ].reject { |g| g[:items].empty? }

  page_html   = @doc_html.to_s + @config_html.to_s + @tests_html.to_s + @explainer_html.to_s
  has_mermaid = page_html.include?('class="mermaid"')
%>

<div class="compendium-layout">
  <aside class="compendium-nav">
    <% nav_groups.each do |group| %>
      <% if group[:title] %>
        <p class="compendium-nav-group"><%= group[:title] %></p>
      <% end %>
      <ul>
        <% group[:items].each do |item| %>
          <li class="<%= 'active' if @view == item[:key] %>">
            <a href="<%= item[:href] %>">
              <% if item[:chapter] %><span class="chapter-num"><%= item[:chapter] %>.</span> <% end %><%= item[:label] %><% if item[:dupe] %> <span class="chapter-dupe" title="More than one chapter claims this number">!</span><% end %>
            </a>
          </li>
        <% end %>
      </ul>
    <% end %>
  </aside>

  <section class="compendium-content">
    <% if @view == 'glossary' %>
      <h1>Glossary</h1>
      <p class="lead">Vocabulary used throughout the Crimson Steel rules. Common terms take precedence over per-domain definitions.</p>
      <%= @glossary_html %>

    <% elsif @view == 'spells' %>
      <%= erb :_spell_list, locals: { spells: @spells_list, schools: @spell_schools, skills: @spell_skills } %>

    <% elsif @view == 'classes' %>
      <%= erb :_class_list, locals: { classes: @classes_list } %>

    <% elsif @view == 'common' %>
      <h1>Common Rules — Coverage</h1>
      <p class="lead">Every concept folder under <code>docs/common/</code> and the files it does or does not carry. A missing file is a gap in the rules, not a gap in the site.</p>
      <table class="coverage-table">
        <thead>
          <tr><th>Concept</th><th>Chapter</th><th>Design</th><th>Config</th><th>Glossary</th><th>Tests</th></tr>
        </thead>
        <tbody>
          <% @coverage.each do |c| %>
            <tr>
              <th scope="row"><a href="/compendium?view=common:<%= c.key %>"><%= c.title %></a></th>
              <td><%= c.chapter ? c.chapter : '—' %><%= ' !' if c.chapter && dupes.include?(c.chapter) %></td>
              <td class="<%= c.design?   ? 'have' : 'missing' %>"><%= c.design?   ? 'yes' : 'missing' %></td>
              <td class="<%= c.config?   ? 'have' : 'missing' %>"><%= c.config?   ? 'yes' : 'missing' %></td>
              <td class="<%= c.glossary? ? 'have' : 'missing' %>"><%= c.glossary? ? 'yes' : 'missing' %></td>
              <td class="<%= c.tests?    ? 'have' : 'missing' %>"><%= c.tests?    ? 'yes' : 'missing' %></td>
            </tr>
          <% end %>
        </tbody>
      </table>

    <% elsif @concept %>
      <article class="explainer">
        <% if @audience == :dm %>
          <p class="doc-crosslink">
            Common Rules (DM)
            <% if @concept.chapter? %>
              &middot; <a href="/compendium?view=<%= @concept.key %>">Read chapter <%= @concept.chapter %> as a player &rarr;</a>
            <% else %>
              &middot; <em>not in the player's manual — no <code>@chapter</code> directive</em>
            <% end %>
          </p>
        <% end %>

        <% if @doc_html.to_s.empty? %>
          <p class="doc-gap">No <code><%= @concept.key %>_design.md</code> in this concept folder yet.</p>
        <% else %>
          <%= @doc_html %>
        <% end %>

        <% unless @config_html.to_s.empty? %>
          <h2 class="doc-section-h">Configuration</h2>
          <p class="doc-section-note">Tunable values, read live from <code><%= File.basename(@concept.config_path) %></code>. These are playtest knobs — expect them to move.</p>
          <%= @config_html %>
        <% end %>

        <% unless @tests_html.to_s.empty? %>
          <h2 class="doc-section-h">Tests</h2>
          <p class="doc-section-note">The canonical cases from <code><%= File.basename(@concept.tests_path) %></code>. DM-only.</p>
          <div class="doc-tests"><%= @tests_html %></div>
        <% end %>
      </article>

    <% elsif @explainer_html %>
      <article class="explainer">
        <%= @explainer_html %>
      </article>
    <% end %>
  </section>
</div>

<% if has_mermaid %>
  <script src="https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.min.js"></script>
  <script>
    mermaid.initialize({ startOnLoad: true, theme: 'neutral', securityLevel: 'strict' });
  </script>
<% end %>

<% if @view == 'spells' %>
  <%# Loads the shared spell-detail modal (clicking a spell opens its popup)
      and the local filter controller. %>
  <script type="module" src="/app.js"></script>
  <script type="module" src="/js/ui/spellList.js"></script>
<% end %>

<% if @view == 'classes' %>
  <%# app.js delegates the .cs-class-link clicks that open the class-detail modal. %>
  <script type="module" src="/app.js"></script>
<% end %>
