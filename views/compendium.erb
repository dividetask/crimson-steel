<%
  explainer_items = ExplainerDocs.keys.map do |key|
    { key: key, label: ExplainerDocs.title_for(key), href: "/compendium?view=#{key}" }
  end
  glossary_item = { key: 'glossary', label: 'Glossary', href: '/compendium?view=glossary' }
  spells_item   = { key: 'spells',   label: 'Spells',   href: '/compendium?view=spells' }
  classes_item  = { key: 'classes',  label: 'Classes',  href: '/compendium?view=classes' }
  # 'Magical Tier' is pinned as the first nav entry, above the Glossary;
  # the remaining Explainer chapters follow in declared order.
  pinned, rest = explainer_items.partition { |i| i[:key] == 'magical_tier' }
  nav_items = pinned + [glossary_item, spells_item, classes_item] + rest
  has_mermaid = @view != 'glossary' && @explainer_html&.include?('class="mermaid"')
%>

<div class="compendium-layout">
  <aside class="compendium-nav">
    <ul>
      <% nav_items.each do |item| %>
        <li class="<%= 'active' if @view == item[:key] %>">
          <a href="<%= item[:href] %>"><%= item[:label] %></a>
        </li>
      <% end %>
    </ul>
  </aside>

  <section class="compendium-content">
    <% if @view == 'glossary' %>
      <h1>Glossary</h1>
      <p class="lead">Vocabulary used throughout the Crimson Steel rules. Common terms take precedence over per-domain definitions.</p>
      <%= @glossary_html %>
    <% elsif @view == 'spells' %>
      <%= erb :_spell_list, locals: { spells: @spells_list, schools: @spell_schools, skills: @spell_skills } %>
    <% elsif @view == 'classes' %>
      <%= erb :_class_list, locals: { classes: @classes_list } %>
    <% elsif @explainer_html %>
      <article class="explainer">
        <%= @explainer_html %>
      </article>
    <% end %>
  </section>
</div>

<% if has_mermaid %>
  <script src="https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.min.js"></script>
  <script>
    mermaid.initialize({ startOnLoad: true, theme: 'neutral', securityLevel: 'strict' });
  </script>
<% end %>

<% if @view == 'spells' %>
  <%# Loads the shared spell-detail modal (clicking a spell opens its popup)
      and the local filter controller. %>
  <script type="module" src="/app.js"></script>
  <script type="module" src="/js/ui/spellList.js"></script>
<% end %>

<% if @view == 'classes' %>
  <%# app.js delegates the .cs-class-link clicks that open the class-detail modal. %>
  <script type="module" src="/app.js"></script>
<% end %>
