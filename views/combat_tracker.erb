  <% campaign_data = Tools.load_json('campaign.json') %>
  <% rounds_elapsed_view = campaign_data.is_a?(Hash) ? campaign_data['rounds_elapsed'].to_i : 0 %>
  <div class="combat-tracker">
  <h1>Combat Tracker</h1>
  <div class="math-detail" style="margin-bottom: 10px;">Round <%= rounds_elapsed_view %></div>

  <table>
    <thead>
      <tr>
        <th></th>
        <th>Initiative</th>
        <th>Character Name</th>
        <th>HP</th>
        <th>Temp HP</th>
        <th>Minor</th>
        <th>Moderate</th>
        <th>Major</th>
        <th>Mana</th>
        <th>Dice</th>
        <th>Saturation</th>
        <th>Conditions</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @combat.combat_turn_list.each do |combat_turn| %>
        <% next if combat_turn.dead? %>
        <% is_current = @combat.current_turn_character && @combat.current_turn_character.combat_id == combat_turn.combat_id %>
        <% row_classes = [] %>
        <% row_classes << 'current-turn' if is_current %>
        <% row_classes << 'incapacitated' if combat_turn.incapacitated? %>
        <tr class="<%= row_classes.join(' ') %>">
          <td>
            <form method="post" action="/combat/set_turn/<%= combat_turn.combat_id %>" style="margin:0;">
              <button type="submit" class="set-turn-btn" title="Set as current turn"><%= is_current ? '&#9654;' : 'Set' %></button>
            </form>
          </td>
          <td>
            <% if combat_turn.initiative.to_s.strip.empty? %>
              <form method="post" action="/combat/roll_init/<%= combat_turn.combat_id %>" style="margin:0;">
                <button type="submit" class="set-turn-btn" title="Roll initiative">Roll</button>
              </form>
            <% else %>
              <%= combat_turn.initiative %>
            <% end %>
          </td>
          <td><%= @combat.display_name(combat_turn) %></td>
          <td><%= combat_turn.hp %>/<%= combat_turn.character.hp_max %></td>
          <td>
            <form method="post" action="/combat/update/<%= combat_turn.combat_id %>" class="combat-update-form">
            <input type="number" name="temporary_hit_points" value="<%= combat_turn.temporary_hit_points %>" style="width: 45px;">
          </td>
          <td><input type="number" name="minor_damage" value="<%= combat_turn.minor_damage %>" style="width: 45px;"></td>
          <td><input type="number" name="moderate_damage" value="<%= combat_turn.moderate_damage %>" style="width: 45px;"></td>
          <td><input type="number" name="major_damage" value="<%= combat_turn.major_damage %>" style="width: 45px;"></td>
          <td><input type="number" name="mana" value="<%= combat_turn.mana %>" style="width: 45px;">/<%= combat_turn.character.mana_max %></td>
          <td><input type="number" name="combat_pool" value="<%= combat_turn.combat_pool %>" style="width: 45px;">/<%= combat_turn.character.combat_pool %></td>
          <td><input type="number" name="saturation" value="<%= combat_turn.saturation %>" style="width: 45px;">/<%= combat_turn.character.cha %></td>
          <td class="conditions-cell">
            <div class="conditions-list">
              <% combat_turn.active_conditions.each do |cname, cval| %>
                <% short, full = condition_label(cname) %>
                <% # Flag conditions (distracted, etc.) don't carry a numeric severity. %>
                <% no_severity = %w[distracted].include?(cname) %>
                <span class="condition-badge condition-<%= cname %>" title="<%= full %>"><%= short %><% unless no_severity %>: <%= cval %><% end %></span>
              <% end %>
              <% combat_turn.active_ability_damage.each do |ability, severity, val| %>
                <span class="condition-badge condition-ability-damage"><%= ability.upcase %> -<%= val %> <%= severity %></span>
              <% end %>
              <% (@combat.active_effects || []).each do |effect| %>
                <% next unless (effect['target_combat_ids'] || []).include?(combat_turn.combat_id) %>
                <% end_round = effect['ends_on_round'] %>
                <% remaining = end_round ? [end_round.to_i - rounds_elapsed_view, 0].max : nil %>
                <% duration_suffix = remaining ? " (#{remaining} round#{'s' unless remaining == 1})" : '' %>
                <% if effect['spell_name'] == 'Paralyzed' %>
                  <span class="condition-badge condition-paralyzed" title="Ends at start of round <%= end_round %>">Paralyzed<%= duration_suffix %></span>
                <% elsif %w[Blindness Deafness].include?(effect['spell_name']) %>
                  <span class="condition-badge condition-<%= effect['spell_name'].downcase %>" title="Permanent until dispelled"><%= effect['spell_name'] %></span>
                <% elsif %w[Entangled Stuck].include?(effect['spell_name']) %>
                  <span class="condition-badge condition-<%= effect['spell_name'].downcase %>" title="Ends at start of round <%= end_round %>"><%= effect['spell_name'] %><%= duration_suffix %></span>
                <% elsif end_round %>
                  <%# Every other duration-bound active effect (Ward, future %>
                  <%# spell effects with ends_on_round) gets a generic badge. %>
                  <span class="condition-badge condition-effect" title="Ends at start of round <%= end_round %>"><%= effect['spell_name'] %><%= duration_suffix %></span>
                <% end %>
              <% end %>
            </div>
          </td>
          <td><button type="submit">Update</button></form></td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <% killed = @combat.killed_list %>
  <% if killed.any? %>
    <div class="killed-list" style="margin-top: 8px;">
      <strong>Killed:</strong>
      <%= killed.map { |ct| @combat.display_name(ct) }.join(', ') %>
    </div>
  <% end %>

  <div style="margin-top: 20px; display: flex; gap: 10px;">
    <form method="post" action="/combat/reset_dice">
      <button type="submit">Reset All Dice</button>
    </form>
    <form method="post" action="/combat/reroll_init">
      <button type="submit">Reroll Init</button>
    </form>
    <form method="post" action="/combat/end_combat" onsubmit="return confirm('End combat? Clears initiative rolls, active effects, and resets the round counter to 0.');">
      <button type="submit">End Combat</button>
    </form>
  </div>

  <% if @combat.active_effects.any? %>
    <div class="active-effects" style="margin-top: 15px;">
      <h3 style="margin-bottom: 8px;">Active Effects</h3>
      <% @combat.active_effects.each_with_index do |effect, idx| %>
        <% duration_text = if effect['permanent']
             "permanent"
           elsif effect['ends_on_round']
             _rem = [effect['ends_on_round'].to_i - rounds_elapsed_view, 0].max
             "#{_rem} round#{'s' unless _rem == 1} remaining"
           elsif effect['rounds_remaining']
             # Legacy entries written before ends_on_round existed.
             "#{effect['rounds_remaining']} turn#{'s' unless effect['rounds_remaining'].to_i == 1} remaining"
           else
             "round #{effect['round_cast']}"
           end %>
        <% target_text = (effect['target_names'] || []).any? ? " on #{(effect['target_names'] || []).join(', ')}" : '' %>
        <div class="effect-row" style="display: flex; align-items: center; gap: 8px; margin-bottom: 4px; padding: 4px 8px; background: #f0f4ff; border-left: 3px solid #1976d2; border-radius: 2px; font-size: 13px;">
          <span><strong><%= effect['spell_name'] %></strong> (<%= effect['caster_name'] %><%= target_text %>, <%= duration_text %>)</span>
          <form method="post" action="/combat/action" style="margin:0;">
            <input type="hidden" name="combat_action" value="dismiss_effect">
            <input type="hidden" name="effect_index" value="<%= idx %>">
            <button type="submit" style="font-size:11px;padding:2px 6px;cursor:pointer;">Dismiss</button>
          </form>
        </div>
      <% end %>
    </div>
  <% end %>

  <% current = @combat.current_turn_character %>
  <% if current %>
    <% current_incapacitated = current.incapacitated? %>
    <div class="turn-status">
      <h2>
        <%= current.character.name %>'s Turn
        <% if current_incapacitated %>
          <span class="incap-label">(Incapacitated)</span>
        <% end %>
      </h2>
    </div>

    <div class="turn-panel">
      <% bind_effects = (@combat.active_effects || []).select { |e|
           %w[Entangled Stuck].include?(e['spell_name']) && (e['target_combat_ids'] || []).include?(current.combat_id)
         } %>
      <div class="action-buttons" id="action-buttons">
        <button class="action-btn" onclick="selectAction('start_of_turn')">Start of Turn</button>
        <% unless current_incapacitated %>
          <button class="action-btn" onclick="selectAction('attack')">Attack</button>
          <button class="action-btn" onclick="selectAction('move')">Move</button>
          <button class="action-btn" onclick="selectAction('cast')">Cast</button>
          <button class="action-btn" onclick="selectAction('concentrate')">Concentrate</button>
          <% if bind_effects.any? %>
            <button class="action-btn" onclick="selectAction('escape')">Escape</button>
          <% end %>
          <button class="action-btn" onclick="selectAction('item')">Item</button>
          <button class="action-btn" onclick="selectAction('special')">Special</button>
        <% end %>
        <button class="action-btn" onclick="selectAction('end_turn')">End Turn</button>
      </div>
      <div class="action-context" id="action-context">
      </div>
    </div>
  <% end %>

  <script>
    var currentCharId = <%= current ? current.combat_id : 'null' %>;
    var currentCharName = '<%= current ? @combat.display_name(current) : '' %>';
    var equippedWeapons = <%= current ? JSON.generate(
      current.character.weapon_list.select { |w| w['equipped'] }.map { |w|
        details = (w.dig('properties', 'details') || [])
        bleed = current.character.weapon_bleed(w)
        {
          item_id: w['item_id'],
          name: w['name'],
          subtype: w['subtype'],
          weapon_dice: current.character.weapon_dice(w),
          weapon_speed: current.character.weapon_speed(w),
          weapon_attack_bonus: current.character.weapon_attack_bonus(w),
          weapon_dmg: (d = current.character.weapon_dmg(w); d.is_a?(Numeric) ? d : 0),
          weapon_threshold: (t = current.character.weapon_threshold(w); t.is_a?(Numeric) ? t : 0),
          weapon_bonus: w['bonus'].to_i,
          is_natural: w.dig('properties', 'natural') == true,
          is_ranged: details.include?('ranged'),
          weapon_bleed: bleed.is_a?(Numeric) ? bleed : 0
        }
      }
    ) : '[]' %>;

    // Current attacker metadata needed to compute default affliction amounts
    // at the damage step (e.g. ghoul_paralysis adds attacker's tier).
    var currentAttackerTier = <%= current ? current.character.tier.to_i : 0 %>;
    var currentAttackerAbilities = <%= current ? JSON.generate(current.character.ability_list) : '[]' %>;
    var diceRemaining = <%= current ? current.combat_pool : 0 %>;
    var currentMana = <%= current ? current.mana : 0 %>;
    var moveSpeed = <%= current ? current.character.speed : 0 %>;
    var spellList = <%= if current && current.character.spell_list
      compendium = Compendium.new
      JSON.generate(
        current.character.spell_list.each_with_index.map { |spells, tier|
          (spells || []).map do |name|
            cure = compendium.cure_effects(name)
            ward = compendium.ward_effects(name)
            resolved = compendium.resolve_spell_variant(name)
            base = resolved ? resolved[0] : nil
            save_attr = compendium.save_attr(name)
            spell_skills = compendium.spell_skills(name)
            # Pick the caster's best skill for this spell — highest dice
            # count, break ties on bonus.
            caster_skill = spell_skills.max_by { |s|
              [current.character.skill_dice(s).to_i, current.character.skill_bonus(s).to_i]
            }
            {name: name, tier: tier, cure: cure ? true : false, ward: ward ? true : false,
             stabilize: base == 'Stabilize',
             concentration: compendium.concentration?(name),
             ranged_attack: compendium.ranged_attack?(name),
             target_mode: compendium.target_mode(name) || "single",
             save_attr: save_attr,
             caster_skill: caster_skill,
             caster_skill_dice: caster_skill ? current.character.skill_dice(caster_skill).to_i : 0,
             caster_skill_bonus: caster_skill ? current.character.skill_bonus(caster_skill).to_i : 0,
             caster_skill_ranks: caster_skill ? current.character.skill_ranks(caster_skill).to_i : 0}
          end
        }.flatten
      )
    else
      '[]'
    end %>;

    // Caster's healing skill dice / TN, used by Stabilize cast rolls.
    var currentHealingDice = <%= current ? current.character.skill_dice('healing').to_i : 0 %>;
    var currentHealingBonus = <%= current ? current.character.skill_bonus('healing').to_i : 0 %>;
    var currentChaHalf = <%= current ? (current.character.cha / 2).to_i : 0 %>;
    var itemList = <%= if current
      compendium = Compendium.new
      JSON.generate(
        current.character.item_list.filter_map do |item|
          fx = compendium.item_effects(item)
          next nil unless fx
          # Scroll of a spell that has a specialised cast flow (Web, Blindness/
          # Deafness, Vicious Mockery, Biting Words, ranged attack spells):
          # expose enough metadata for the client to route through that flow
          # using the scroll user's own spell skill.
          base = fx[:base_name]
          skills = base ? compendium.spell_skills(base) : []
          best = skills.max_by { |s| [current.character.skill_dice(s).to_i, current.character.skill_bonus(s).to_i] }
          {
            item_id: item['item_id'],
            name: item['name'],
            quantity: item['quantity'] || 1,
            item_tier: fx[:item_tier],
            type: fx[:type].to_s,
            kind: fx[:kind].to_s,
            target_mode: fx[:target_mode].to_s,
            base_name: base,
            spell_tier: fx[:tier_val],
            save_attr: base ? compendium.save_attr(base) : nil,
            ranged_attack: base ? compendium.ranged_attack?(base) : false,
            caster_skill: best,
            caster_skill_dice: best ? current.character.skill_dice(best).to_i : 0,
            caster_skill_bonus: best ? current.character.skill_bonus(best).to_i : 0,
            caster_skill_ranks: best ? current.character.skill_ranks(best).to_i : 0
          }
        end
      )
    else
      '[]'
    end %>;
    var combatants = <%= JSON.generate(
      @combat.combat_turn_list.reject(&:dead?).each_with_index.map { |ct, idx|
        {
          turn_id: idx, combat_id: ct.combat_id, char_id: ct.character.id,
          name: @combat.display_name(ct), dice_remaining: ct.combat_pool, mana: ct.mana,
          incapacitated: ct.incapacitated?,
          bab_dice: ct.character.bab_dice, bab_bonus: ct.character.bab_bonus,
          damage_reduction: ct.character.damage_reduction,
          damage_resilience: ct.character.damage_resilience,
          abilities: ct.incapacitated? ? [] : ct.character.ability_list,
          healing_dice: ct.character.skill_dice("healing"),
          healing_bonus: ct.character.skill_bonus("healing"),
          save_dice: %w[str dex con int wis cha].each_with_object({}) { |a, h| h[a] = ct.character.save_dice(a.to_sym) },
          save_bonus: %w[str dex con int wis cha].each_with_object({}) { |a, h| h[a] = ct.character.save_bonus(a.to_sym) },
          spells: (ct.character.spell_list || []).flatten,
          shields: ct.character.shield_list.select { |s| s['equipped'] }.map { |s|
            {
              item_id: s['item_id'], name: s['name'],
              shield_dice: ct.character.shield_dice(s),
              shield_speed: ct.character.shield_speed(s),
              shield_attack_bonus: ct.character.shield_attack_bonus(s)
            }
          },
          weapons: ct.character.weapon_list.select { |w| w['equipped'] }.map { |w|
            {
              item_id: w['item_id'], name: w['name'],
              weapon_dice: ct.character.weapon_dice(w),
              weapon_speed: ct.character.weapon_speed(w),
              weapon_attack_bonus: ct.character.weapon_attack_bonus(w)
            }
          }
        }
      }
    ) %>;
    var activeEffects = <%= JSON.generate(@combat.active_effects) %>;
    var diceRules = <%= JSON.generate(Tools.load_json('rules.json')['dice']) %>;
    // Campaign-wide round counter. Effects with ends_on_round <= this value
    // are scheduled to end at the target's next Start of Turn confirm.
    var roundsElapsed = <%= (Tools.load_json('campaign.json').is_a?(Hash) ? Tools.load_json('campaign.json')['rounds_elapsed'].to_i : 0) %>;

    // Start-of-turn info for the current combatant: each active condition
    // paired with the save dice/TN the DM should roll against. TN starts at 9
    // and is reduced by the character's CON save proficiency bonus; specific
    // conditions may add more (ghoul paralysis adds the highest ghoul tier
    // that has hit the target). TN is clamped to the rules' [min, max] range.
    var startOfTurnConditions = <%= if current
      dice_rules = Tools.load_json('rules.json')['dice']
      tn_min = dice_rules['tn_minimum'].to_i
      tn_max = dice_rules['tn_maximum'].to_i
      base_dice = current.character.save_dice(:con).to_i
      base_tn = 9 - current.character.save_bonus(:con).to_i
      max_ghoul_tier = current.condition_meta['max_ghoul_tier'].to_i
      # Flag conditions that auto-clear at start of turn and don't need a save.
      auto_clear = %w[distracted]
      JSON.generate(
        current.active_conditions.reject { |cname, _| auto_clear.include?(cname) }.map do |cname, value|
          tn_mod = cname == 'ghoul_paralysis' ? max_ghoul_tier : 0
          raw_tn = base_tn + tn_mod
          clamped_tn = [[raw_tn, tn_min].max, tn_max].min
          {
            name: cname,
            label: cname.tr('_', ' ').split.map(&:capitalize).join(' '),
            value: value.to_i,
            dice: base_dice,
            tn: clamped_tn,
            tn_mod: tn_mod,
            tn_mod_label: cname == 'ghoul_paralysis' && tn_mod > 0 ? ('ghoul tier +' + tn_mod.to_s) : ''
          }
        end
      )
    else
      '[]'
    end %>;

    // --- Client-side attack state ---
    var attackState = null;
    // --- Client-side start-of-turn state ---
    var startOfTurnState = null;

    function selectAction(action) {
      var context = document.getElementById('action-context');
      context.innerHTML = '';
      attackState = null;
      startOfTurnState = null;
      clearActiveScroll();

      if (action === 'move') {
        if (diceRemaining < 4) {
          addStep('<strong>Cannot move</strong> - need 4 dice, have ' + diceRemaining);
          return;
        }
        addStep('<strong>Move</strong>: ' + currentCharName + ' moves up to ' + moveSpeed + ' feet' +
          '<br><button class="action-btn" onclick="submitAction({id: currentCharId, combat_action: \'move\'})" style="margin-top:8px;">Confirm Move</button>');
        return;
      }

      if (action === 'end_turn') {
        addStep('<strong>End Turn</strong>: ' + currentCharName + ' ends their turn' +
          '<br><button class="action-btn" onclick="submitAction({id: currentCharId, combat_action: \'end_turn\'})" style="margin-top:8px;">Confirm End Turn</button>');
        return;
      }

      if (action === 'start_of_turn') {
        showStartOfTurn();
        return;
      }

      if (action === 'attack') {
        showTargetSelection();
      }

      if (action === 'cast') {
        showSpellSelection();
      }

      if (action === 'concentrate') {
        showConcentrateSelection();
      }

      if (action === 'escape') {
        showEscapeSelection();
      }

      if (action === 'item') {
        showItemSelection();
      }
    }

    // Active effects targeting the current combatant that will expire at
    // the next Start of Turn confirm (ends_on_round <= campaign
    // rounds_elapsed). Purely display -- the server performs the actual
    // removal when Confirm Start of Turn is submitted.
    function expiringEffectsForCurrent() {
      if (currentCharId == null) return [];
      return (activeEffects || []).filter(function(e) {
        return e.ends_on_round != null &&
               (e.target_combat_ids || []).indexOf(currentCharId) !== -1 &&
               e.ends_on_round <= roundsElapsed;
      });
    }

    // --- START OF TURN: show every active-condition save at once, then
    // preview consequences before confirm. Two screens: entry -> preview.
    function showStartOfTurn() {
      startOfTurnState = { successes: {} };
      var expiring = expiringEffectsForCurrent();
      if ((!startOfTurnConditions || startOfTurnConditions.length === 0) && expiring.length === 0) {
        addStep('<strong>Start of Turn</strong>: no active conditions for ' + currentCharName +
          '<br><button class="action-btn" onclick="confirmStartOfTurn()" style="margin-top:8px;">Confirm</button>');
        return;
      }
      if (!startOfTurnConditions || startOfTurnConditions.length === 0) {
        // No saves to roll, but there are effects to end; go straight to
        // the preview so the DM can see and confirm.
        showStartOfTurnPreview();
        return;
      }
      var rows = startOfTurnConditions.map(function(cond, i) {
        var tnSuffix = cond.tn_mod_label ? ' <span class="math-detail">(' + cond.tn_mod_label + ')</span>' : '';
        var inputId = 'save-successes-' + i;
        var rollsId = 'save-rolls-' + i;
        return '<div style="margin:6px 0;padding:4px 6px;border-left:3px solid #ddd;">' +
          '<strong>Save vs ' + cond.label + '</strong> <span class="math-detail">(severity ' + cond.value + ')</span>' +
          '<br><span class="math-detail">Roll ' + cond.dice + ' dice at TN ' + cond.tn + '</span>' + tnSuffix +
          '<br><label>Successes: <input type="number" id="' + inputId + '" min="0" max="' + cond.dice + '" value="0" style="width:50px;"></label>' +
          ' <button class="action-btn" onclick="rollSaveDice(' + i + ', \'' + inputId + '\', \'' + rollsId + '\')">Roll</button>' +
          '<div id="' + rollsId + '" class="math-detail" style="margin-top:4px;"></div>' +
          '</div>';
      }).join('');
      addStep('<strong>Start of Turn</strong>: ' + currentCharName + ' has ' +
        startOfTurnConditions.length + ' condition' + (startOfTurnConditions.length === 1 ? '' : 's') + ' to save against.' +
        rows +
        '<button class="action-btn" onclick="showStartOfTurnPreview()" style="margin-top:6px;">Next</button>');
    }

    // Collect successes, show consequences, then offer a single Confirm.
    // Replaces the action-context so repeated clicks don't duplicate.
    function showStartOfTurnPreview() {
      for (var i = 0; i < (startOfTurnConditions || []).length; i++) {
        var cond = startOfTurnConditions[i];
        var inp = document.getElementById('save-successes-' + i);
        var val = inp ? parseInt(inp.value, 10) : 0;
        if (isNaN(val) || val < 0) { alert('Enter a non-negative number of successes for ' + cond.label + '.'); return; }
        startOfTurnState.successes[cond.name] = val;
      }
      var summary = (startOfTurnConditions || []).map(function(c) {
        return '<li>' + summarizeConditionOutcome(c, startOfTurnState.successes[c.name] || 0) + '</li>';
      }).join('');
      // Append one bullet per active effect that will be purged on confirm.
      var expiring = expiringEffectsForCurrent();
      expiring.forEach(function(e) {
        summary += '<li><strong>' + e.spell_name + '</strong> ends (ended round ' + e.ends_on_round + ')</li>';
      });
      var context = document.getElementById('action-context');
      context.innerHTML = '';
      var hasBack = (startOfTurnConditions || []).length > 0;
      addStep('<strong>All saves recorded.</strong>' +
        '<br><span class="math-detail">Consequences:</span><ul style="margin:4px 0 8px 18px;">' + summary + '</ul>' +
        '<button class="action-btn" onclick="confirmStartOfTurn()">Confirm Start of Turn</button>' +
        (hasBack ? ' <button class="action-btn" onclick="showStartOfTurn()" style="background:#eee;color:#333;">Back</button>' : ''));
    }

    // Roll `dice` d10s, count results >= `tn`, fill `inputId`, render the
    // raw dice in `rollsId`. A 10 is a crit and counts as 2 successes;
    // every other result >= tn counts as 1; every rolled 1 is a fumble
    // and subtracts 1 from the running total. Final successes are
    // floored at 0 for the input. Colors: red=1 (fumble), blue=10 (crit),
    // green=other success, grey=other failure. Re-clickable so the DM
    // can fudge by re-rolling. Used by every combat roll (attack/
    // defense/ally/healing/condition saves).
    function rollDicePool(dice, tn, inputId, rollsId) {
      var rolls = [];
      var successes = 0;
      for (var r = 0; r < dice; r++) {
        var d = Math.floor(Math.random() * 10) + 1;
        rolls.push(d);
        if (d === 10) successes += 2;
        else if (d >= tn) successes++;
        else if (d === 1) successes--;
      }
      var displaySuccesses = Math.max(0, successes);
      var inputEl = document.getElementById(inputId);
      if (inputEl) inputEl.value = displaySuccesses;
      var rollsEl = document.getElementById(rollsId);
      if (rollsEl) {
        var colored = rolls.map(function(d) {
          var bg = null;
          if (d === 1) bg = '#e57373';          // red   (fumble)
          else if (d === 10) bg = '#64b5f6';    // blue  (crit)
          else if (d >= tn) bg = '#81c784';     // green (success)
          if (bg) {
            return '<span style="background:' + bg + ';color:#000;padding:1px 6px;border-radius:3px;font-weight:bold;">' + d + '</span>';
          }
          return '<span style="color:#777;">' + d + '</span>';
        }).join(', ');
        rollsEl.innerHTML = 'Rolled: [' + colored + '] &rarr; ' + displaySuccesses + ' success' + (displaySuccesses === 1 ? '' : 'es') +
          (successes < 0 ? ' <span class="math-detail">(raw ' + successes + ', floored)</span>' : '');
      }
    }

    function rollSaveDice(i, inputId, rollsId) {
      var cond = startOfTurnConditions[i];
      rollDicePool(cond.dice, cond.tn, inputId, rollsId);
    }

    // Preview of what a save with `successes` will do to `cond` on Confirm.
    // Mirrors the server-side resolution in app.rb start_of_turn so the DM
    // can see damage/paralysis/decay before submitting.
    function summarizeConditionOutcome(cond, successes) {
      var parts = [];
      if (cond.name === 'bleed') {
        var raw = 1 + Math.floor(cond.value / 10);
        var dealt = Math.max(0, raw - successes);
        if (dealt > 0) {
          parts.push('<strong>Bleed:</strong> ' + dealt + ' minor damage (' + raw + ' - ' + successes + ' successes, temp HP absorbs first)');
        } else {
          parts.push('<strong>Bleed:</strong> no damage (' + raw + ' blocked by ' + successes + ' successes)');
        }
      } else if (cond.name === 'ghoul_paralysis') {
        var rawRounds = 1 + Math.floor(cond.value / 10);
        var rounds = Math.max(0, rawRounds - successes);
        if (rounds > 0) {
          var endRound = roundsElapsed + rounds;
          parts.push('<strong>Ghoul Paralysis:</strong> <span style="color:#6a1b9a;font-weight:bold;">PARALYZED until R' + endRound + '</span> (' + rounds + ' round' + (rounds === 1 ? '' : 's') + ', stacks with existing)');
        } else {
          parts.push('<strong>Ghoul Paralysis:</strong> no paralysis (' + rawRounds + ' blocked by ' + successes + ' successes)');
        }
      } else if (cond.name === 'minor_strength_poison') {
        var rawPoisonDmg = 1 + Math.floor(cond.value / 10);
        var poisonDmg = Math.max(0, rawPoisonDmg - successes);
        if (poisonDmg > 0) {
          parts.push('<strong>Minor Strength Poison:</strong> ' + poisonDmg + ' minor STR damage (' + rawPoisonDmg + ' - ' + successes + ' successes)');
        } else {
          parts.push('<strong>Minor Strength Poison:</strong> no damage (' + rawPoisonDmg + ' blocked by ' + successes + ' successes)');
        }
      } else {
        parts.push('<strong>' + cond.label + ':</strong> save recorded');
      }
      var decay = 1 + successes;
      var newValue = Math.max(0, cond.value - decay);
      if (newValue <= 0) {
        parts.push(cond.label + ' ends (' + cond.value + ' &rarr; 0)');
      } else {
        parts.push(cond.label + ' decays ' + cond.value + ' &rarr; ' + newValue);
      }
      return parts.join('; ');
    }

    function confirmStartOfTurn() {
      var fields = { id: currentCharId, combat_action: 'start_of_turn' };
      for (var cname in startOfTurnState.successes) {
        fields['successes_' + cname] = startOfTurnState.successes[cname];
      }
      submitAction(fields);
    }

    // --- ATTACK STEP 1: Select target ---
    function showTargetSelection() {
      addStep('<strong>Select Target</strong>' +
        '<br><select id="attack-target" style="margin-top:4px;"><option value="">-- select target --</option>' +
        combatants.map(function(c) { return '<option value="' + c.turn_id + '">' + c.name + '</option>'; }).join('') +
        '</select>' +
        '<div id="weapon-buttons" style="margin-top:8px;"></div>');

      document.getElementById('attack-target').addEventListener('change', function() {
        var weaponDiv = document.getElementById('weapon-buttons');
        weaponDiv.innerHTML = '';
        if (!this.value) return;
        var tid = parseInt(this.value, 10);
        equippedWeapons.forEach(function(weapon) {
          var btn = document.createElement('button');
          btn.className = 'weapon-btn';
          btn.textContent = weapon.name;
          btn.addEventListener('click', function() { showAttackDice(weapon, tid); });
          weaponDiv.appendChild(btn);
        });
      });
    }

    // --- CAST: Spell selection ---
    function spellManaCost(tier) {
      return tier === 0 ? 1 : (tier * 2 + 2);
    }

    function showSpellSelection() {
      if (!spellList || spellList.length === 0) {
        addStep('<strong>No spells available</strong>');
        return;
      }

      // Group spells by tier
      var tiers = {};
      spellList.forEach(function(s) {
        if (!tiers[s.tier]) tiers[s.tier] = [];
        tiers[s.tier].push(s);
      });

      var html = '<strong>Cast Spell</strong> (Mana: ' + currentMana + ')';
      var tierKeys = Object.keys(tiers).sort(function(a, b) { return a - b; });
      tierKeys.forEach(function(tier) {
        var cost = spellManaCost(parseInt(tier, 10));
        var canAfford = currentMana >= cost;
        html += '<div style="margin-top:6px;"><span class="math-detail">Tier ' + tier + ' (' + cost + ' mana):</span><br>';
        tiers[tier].forEach(function(spell) {
          var isInstant = spell.cure || spell.ward || spell.stabilize;
          var mode = spell.target_mode || 'single';
          var conc = spell.concentration ? ' \u29BF' : '';
          var marker = mode === 'multi' ? ' *' : (mode === 'none' ? ' \u25CB' : '');
          var label = spell.name + marker + conc;
          var effectLabel = spell.cure ? 'cure' : (spell.ward ? 'ward' : (spell.stabilize ? 'stabilize' : ''));
          if (canAfford) {
            html += '<button class="action-btn spell-btn" onclick="selectSpellTarget(\'' +
              spell.name.replace(/'/g, "\\'") + '\', ' + spell.tier + ', ' + (isInstant ? 'true' : 'false') +
              ', \'' + effectLabel + '\'' +
              ', \'' + mode + '\'' +
              ', ' + (spell.concentration ? 'true' : 'false') +
              ')" style="margin:2px;">' + label + '</button>';
          } else {
            html += '<button class="action-btn spell-btn" disabled style="margin:2px;opacity:0.5;">' + label + '</button>';
          }
        });
        html += '</div>';
      });
      html += '<br><span class="math-detail">* = multi-target &nbsp; \u25CB = no target &nbsp; \u29BF = concentration</span>';

      addStep(html);
    }

    function selectSpellTarget(spellName, spellTier, isInstant, effectLabel, targetMode, isConcentration) {
      if (targetMode === 'none') {
        selectSpellDice(spellName, spellTier, [], isInstant, effectLabel, 'none', isConcentration);
        return;
      }
      var selectId = 'cast-target-' + Date.now();
      if (targetMode === 'multi') {
        var checkboxesHtml = combatants.map(function(c) {
          return '<label style="display:block;margin:2px 0;">' +
            '<input type="checkbox" class="' + selectId + '-cb" value="' + c.combat_id + '"> ' + c.name + '</label>';
        }).join('');
        addStep('<strong>Select Targets for ' + spellName + '</strong>' +
          '<br><span class="math-detail">Pick one or more.</span>' +
          '<div style="margin-top:4px;">' + checkboxesHtml + '</div>' +
          '<button class="action-btn" style="margin-top:8px;" onclick="(function(){' +
          'var boxes=document.getElementsByClassName(\'' + selectId + '-cb\');' +
          'var ids=[];for(var i=0;i<boxes.length;i++){if(boxes[i].checked)ids.push(parseInt(boxes[i].value,10));}' +
          'if(ids.length===0){alert(\'Pick at least one target\');return;}' +
          'selectSpellDice(\'' + spellName.replace(/'/g, "\\'") + '\', ' + spellTier + ', ids, ' +
          (isInstant ? 'true' : 'false') + ', \'' + effectLabel + '\', \'multi\', ' +
          (isConcentration ? 'true' : 'false') + ');})()">Next</button>');
      } else {
        var optionsHtml = combatants.map(function(c) {
          return '<option value="' + c.combat_id + '">' + c.name + '</option>';
        }).join('');
        addStep('<strong>Select Target for ' + spellName + '</strong>' +
          '<br><select id="' + selectId + '" style="margin-top:4px;">' +
          '<option value="">-- select target --</option>' + optionsHtml + '</select>' +
          '<br><button class="action-btn" style="margin-top:8px;" onclick="(function(){' +
          'var v=document.getElementById(\'' + selectId + '\').value;' +
          'if(!v){alert(\'Pick a target\');return;}' +
          'selectSpellDice(\'' + spellName.replace(/'/g, "\\'") + '\', ' + spellTier + ', [parseInt(v,10)], ' +
          (isInstant ? 'true' : 'false') + ', \'' + effectLabel + '\', \'single\', ' +
          (isConcentration ? 'true' : 'false') + ');})()">Next</button>');
      }
    }

    // Spiritual Weapon records the number of dice spent at cast time so
    // later concentrate attacks know how many dice to roll. For every
    // other spell we skip this step. The dice cap is the caster's Healing
    // skill dice (Spiritual Weapon rolls off Healing) capped by their
    // remaining combat pool. Default value is the max.
    function selectSpellDice(spellName, spellTier, targetIds, isInstant, effectLabel, targetMode, isConcentration) {
      var spellEntry = spellList.find(function(s) { return s.name === spellName; });
      if (spellName === 'Blindness/Deafness') {
        startBlindnessDeafnessCast(spellName, spellTier, targetIds);
        return;
      }
      if (spellName === 'Vicious Mockery') {
        startViciousMockeryCast(spellName, spellTier, targetIds);
        return;
      }
      if (spellName === 'Biting Words') {
        startBitingWordsCast(spellName, spellTier, targetIds);
        return;
      }
      if (spellName === 'Web') {
        startWebCast(spellName, spellTier, targetIds);
        return;
      }
      if (spellEntry && spellEntry.ranged_attack) {
        startRangedAttackSpellCast(spellName, spellTier, targetIds, /*isConcentrateReuse=*/false, /*effectIndex=*/-1);
        return;
      }
      if (spellName !== 'Spiritual Weapon') {
        confirmCast(spellName, spellTier, targetIds, isInstant, effectLabel, targetMode, isConcentration, 0);
        return;
      }
      var me = combatants.find(function(c) { return c.combat_id === currentCharId; });
      var healingDice = me ? me.healing_dice : 0;
      var minDice = 2;
      var maxDice = Math.min(healingDice, diceRemaining);
      if (maxDice < minDice) {
        addStep('<strong>Cannot cast Spiritual Weapon</strong> - need at least ' + minDice +
          ' dice (healing skill allows ' + healingDice + ', pool has ' + diceRemaining + ')');
        return;
      }
      var inputId = 'sw-dice-' + Date.now();
      addStep('<strong>Spiritual Weapon Dice</strong>' +
        '<br><span class="math-detail">Rolls off Healing skill (' + healingDice + ' dice max). ' +
        'These are rolled on every later attack. Range: ' + minDice + '-' + maxDice + '.</span>' +
        '<br><label>Dice: <input type="number" id="' + inputId + '" min="' + minDice + '" max="' + maxDice + '" value="' + maxDice + '" style="width:50px;"></label>' +
        ' <button class="action-btn" style="margin-top:4px;" onclick="(function(){' +
        'var v=parseInt(document.getElementById(\'' + inputId + '\').value,10);' +
        'if(isNaN(v)||v<' + minDice + '||v>' + maxDice + '){alert(\'Enter ' + minDice + '-' + maxDice + '.\');return;}' +
        'confirmCast(\'' + spellName.replace(/'/g, "\\'") + '\', ' + spellTier + ', ' + JSON.stringify(targetIds) + ', ' +
        (isInstant ? 'true' : 'false') + ', \'' + effectLabel + '\', \'' + targetMode + '\', ' +
        (isConcentration ? 'true' : 'false') + ', v);})()">Next</button>');
    }

    function confirmCast(spellName, spellTier, targetIds, isInstant, effectLabel, targetMode, isConcentration, diceSpent) {
      var cost = spellManaCost(spellTier);

      var targetNames = [];
      for (var t = 0; t < targetIds.length; t++) {
        for (var i = 0; i < combatants.length; i++) {
          if (combatants[i].combat_id === targetIds[t]) { targetNames.push(combatants[i].name); break; }
        }
      }

      var label = effectLabel ? ' | ' + effectLabel.charAt(0).toUpperCase() + effectLabel.slice(1) : '';
      var targetLabel;
      if (targetMode === 'none') {
        targetLabel = '';
      } else if (targetMode === 'multi') {
        targetLabel = ' | Targets: ' + targetNames.join(', ');
      } else {
        targetLabel = ' | Target: ' + targetNames.join(', ');
      }
      var fields = 'id: currentCharId, combat_action: \'cast\', spell_name: \'' +
        spellName.replace(/'/g, "\\'") + '\', spell_tier: ' + spellTier;
      if (targetMode === 'multi') {
        fields += ', target_combat_ids: \'' + targetIds.join(',') + '\'';
      } else if (targetMode === 'single') {
        fields += ', target_combat_id: ' + targetIds[0];
      }
      if (diceSpent && diceSpent > 0) {
        fields += ', dice_spent: ' + diceSpent;
      }
      var diceLabel = (diceSpent && diceSpent > 0) ? ' | ' + diceSpent + ' dice' : '';

      // Stabilize is a concentration spell that spends combat dice and rolls
      // a healing check; each success reduces target's bleed by 3. We walk
      // the DM through: pick dice -> roll -> summary -> submit.
      if (effectLabel === 'stabilize') {
        showStabilizeDice(spellName, spellTier, targetIds[0], targetLabel);
        return;
      }

      addStep('<strong>Casting: ' + spellName + '</strong>' +
        '<br><span class="math-detail">Tier ' + spellTier + ' | Cost: ' + cost + ' mana' + targetLabel + diceLabel +
        (isConcentration ? ' | Concentration' : '') + label + '</span>' +
        '<br><button class="action-btn" onclick="submitAction({' + fields + '})" style="margin-top:8px;">Confirm Cast</button>');
    }

    // --- STABILIZE: multi-step flow (dice -> roll -> summary -> submit) ---
    function showStabilizeDice(spellName, spellTier, targetId, targetLabel) {
      var target = combatants.find(function(c) { return c.combat_id === targetId; });
      var targetName = target ? target.name : 'target';
      var maxDice = Math.min(currentHealingDice, diceRemaining);
      if (maxDice < 1) {
        addStep('<strong>Cannot cast Stabilize</strong> - no combat dice remaining (healing ' + currentHealingDice + ', remaining ' + diceRemaining + ')');
        return;
      }
      var tn = clampTn(diceRules.base_target_number - currentHealingBonus);
      addStep('<strong>Stabilize</strong> on ' + targetName +
        '<br><span class="math-detail">Healing check, TN ' + tn + ' | Max dice: ' + maxDice + ' (healing ' + currentHealingDice + ', remaining ' + diceRemaining + ')</span>' +
        '<br><label>Dice to spend: <input type="number" id="stabilize-dice" min="1" max="' + maxDice + '" value="' + maxDice + '" style="width:50px;"></label>' +
        ' <button class="action-btn" onclick="showStabilizeRoll(\'' + spellName.replace(/'/g, "\\'") + '\', ' + spellTier + ', ' + targetId + ', ' + tn + ')" style="margin-top:4px;">Next</button>');
    }

    function showStabilizeRoll(spellName, spellTier, targetId, tn) {
      var dice = parseInt(document.getElementById('stabilize-dice').value, 10);
      var maxDice = Math.min(currentHealingDice, diceRemaining);
      if (isNaN(dice) || dice < 1 || dice > maxDice) { alert('Enter 1-' + maxDice + '.'); return; }
      addStep('<strong>Stabilize Roll</strong>: ' + dice + ' dice, TN ' + tn +
        '<br><label>Successes: <input type="number" id="stabilize-successes" min="0" value="0" style="width:50px;"></label>' +
        ' <button class="action-btn" onclick="showStabilizeSummary(\'' + spellName.replace(/'/g, "\\'") + '\', ' + spellTier + ', ' + targetId + ', ' + dice + ')">Next</button>' +
        ' <button class="action-btn" onclick="rollDicePool(' + dice + ', ' + tn + ', \'stabilize-successes\', \'stabilize-roll-display\')">Roll</button>' +
        '<div id="stabilize-roll-display" class="math-detail" style="margin-top:4px;"></div>');
    }

    function showStabilizeSummary(spellName, spellTier, targetId, dice) {
      var successes = parseInt(document.getElementById('stabilize-successes').value, 10);
      if (isNaN(successes) || successes < 0) { alert('Enter a non-negative number of successes.'); return; }
      var target = combatants.find(function(c) { return c.combat_id === targetId; });
      var targetName = target ? target.name : 'target';
      var cost = spellManaCost(spellTier);
      var reduction = 3 * successes;
      addStep('<strong>Confirm Stabilize</strong> on ' + targetName +
        '<br><span class="math-detail">Tier ' + spellTier + ' | Cost: ' + cost + ' mana + ' + dice + ' dice | Concentration</span>' +
        '<br>' + successes + ' success' + (successes === 1 ? '' : 'es') + ' &times; 3 = <strong>bleed &minus;' + reduction + '</strong> on ' + targetName +
        '<br><button class="action-btn" onclick="submitAction({id: currentCharId, combat_action: \'cast\', spell_name: \'' +
          spellName.replace(/'/g, "\\'") + '\', spell_tier: ' + spellTier + ', concentration: true, target_combat_id: ' + targetId +
          ', stabilize_dice: ' + dice + ', stabilize_successes: ' + successes + '})" style="margin-top:8px;">Submit</button>');
    }

    // --- Blindness/Deafness: save-based spell flow ---
    //   1. Pick blindness vs deafness + dice to spend on the spell check.
    //   2. DM enters caster spell check successes (rolled at TN derived from
    //      the caster's best spell-skill proficiency).
    //   3. DM enters target save successes (rolled at TN penalised by the
    //      spell tier and caster's skill bonus).
    //   4. Net (caster - target) >= 2 applies the condition; either way the
    //      caster still pays mana.
    var bdCast = null;

    function startBlindnessDeafnessCast(spellName, spellTier, targetIds) {
      var targetCombatId = targetIds[0];
      var target = combatants.find(function(c) { return c.combat_id === targetCombatId; });
      if (!target) { alert('No target'); return; }
      var spellEntry = spellMetaFor(spellName);
      if (!spellEntry || !spellEntry.caster_skill) {
        alert('Caster has no eligible skill for ' + spellName);
        return;
      }

      bdCast = {
        spellName: spellName,
        spellTier: spellTier,
        targetCombatId: targetCombatId,
        targetName: target.name,
        saveAttr: spellEntry.save_attr,
        casterSkill: spellEntry.caster_skill,
        casterSkillDice: spellEntry.caster_skill_dice,
        casterSkillBonus: spellEntry.caster_skill_bonus,
        effectType: null,
        diceSpent: 0,
        casterSuccesses: null,
        saveSuccesses: null
      };

      var maxDice = Math.min(bdCast.casterSkillDice, diceRemaining);
      var minDice = 2;
      if (maxDice < minDice) {
        addStep('<strong>Cannot cast ' + spellName + '</strong> - need at least ' +
          minDice + ' dice (skill allows ' + bdCast.casterSkillDice + ', pool has ' + diceRemaining + ')');
        return;
      }

      var diceId = 'bd-dice-' + Date.now();
      addStep('<strong>' + spellName + ' on ' + target.name + '</strong>' +
        '<br><span class="math-detail">Rolls off ' + bdCast.casterSkill.replace('_', ' ') +
        ' (' + bdCast.casterSkillDice + ' dice max, bonus ' +
        (bdCast.casterSkillBonus >= 0 ? '+' : '') + bdCast.casterSkillBonus + ').</span>' +
        '<br><label>Dice: <input type="number" id="' + diceId + '" min="' + minDice + '" max="' + maxDice + '" value="' + maxDice + '" style="width:50px;"></label>' +
        '<br><span class="math-detail">Choose which condition to inflict:</span>' +
        '<br><button class="action-btn" style="margin:2px;" onclick="bdPickEffect(\'blindness\', \'' + diceId + '\')">Blindness</button>' +
        '<button class="action-btn" style="margin:2px;" onclick="bdPickEffect(\'deafness\', \'' + diceId + '\')">Deafness</button>');
    }

    function bdPickEffect(effect, diceInputId) {
      var v = parseInt(document.getElementById(diceInputId).value, 10);
      var maxDice = Math.min(bdCast.casterSkillDice, diceRemaining);
      if (isNaN(v) || v < 2 || v > maxDice) {
        alert('Enter 2-' + maxDice + '.');
        return;
      }
      bdCast.effectType = effect;
      bdCast.diceSpent = v;
      bdCasterRollStep();
    }

    function bdCasterRollStep() {
      var casterTn = clampTn(diceRules.base_target_number - bdCast.casterSkillBonus);
      var tnMath = tnBreakdown('Caster TN', diceRules.base_target_number,
        [{value: -bdCast.casterSkillBonus, label: bdCast.casterSkill.replace('_', ' ') + ' bonus'}], casterTn);
      addStep('<strong>Caster Spell Check</strong>: ' + bdCast.diceSpent + ' dice, TN ' + casterTn +
        '<br><span class="math-detail">' + tnMath + ' &nbsp;|&nbsp; failures subtract from successes.</span>' +
        '<br><label>Net successes: <input type="number" id="bd-caster-successes" min="0" value="0" style="width:50px;"></label>' +
        ' <button class="action-btn" onclick="bdConfirmCasterSuccesses()">Confirm</button>' +
        ' <button class="action-btn" onclick="rollDicePool(' + bdCast.diceSpent + ', ' + casterTn + ', \'bd-caster-successes\', \'bd-caster-roll-display\')">Roll</button>' +
        '<div id="bd-caster-roll-display" class="math-detail" style="margin-top:4px;"></div>');
    }

    function bdConfirmCasterSuccesses() {
      var input = document.getElementById('bd-caster-successes');
      var val = parseInt(input.value, 10);
      if (isNaN(val) || val < 0) { alert('Invalid number.'); return; }
      bdCast.casterSuccesses = val;
      input.disabled = true;
      input.parentElement.nextElementSibling.style.display = 'none';
      bdSaveRollStep();
    }

    function bdSaveRollStep() {
      var target = combatants.find(function(c) { return c.combat_id === bdCast.targetCombatId; });
      if (!target) { alert('Target vanished'); return; }
      var saveAttr = bdCast.saveAttr;
      var saveDice = (target.save_dice && target.save_dice[saveAttr]) || 0;
      var saveBonus = (target.save_bonus && target.save_bonus[saveAttr]) || 0;
      var baseTn = diceRules.base_target_number;
      var rawTn = baseTn - saveBonus + bdCast.spellTier + bdCast.casterSkillBonus;
      var saveTn = clampTn(rawTn);
      bdCast.saveDice = saveDice;
      bdCast.saveTn = saveTn;
      var tnMods = [
        {value: -saveBonus, label: saveAttr.toUpperCase() + ' save bonus'},
        {value: bdCast.spellTier, label: 'spell tier penalty'},
        {value: bdCast.casterSkillBonus, label: 'caster skill penalty'}
      ];
      var tnMath = tnBreakdown('Save TN', baseTn, tnMods, saveTn);
      addStep('<strong>' + bdCast.targetName + '\'s ' + saveAttr.toUpperCase() + ' Save</strong>: ' +
        saveDice + ' dice, TN ' + saveTn +
        '<br><span class="math-detail">' + tnMath + '</span>' +
        '<br><label>Save successes: <input type="number" id="bd-save-successes" min="0" value="0" style="width:50px;"></label>' +
        ' <button class="action-btn" onclick="bdConfirmSaveSuccesses()">Confirm</button>' +
        ' <button class="action-btn" onclick="rollDicePool(' + saveDice + ', ' + saveTn + ', \'bd-save-successes\', \'bd-save-roll-display\')">Roll</button>' +
        '<div id="bd-save-roll-display" class="math-detail" style="margin-top:4px;"></div>');
    }

    function bdConfirmSaveSuccesses() {
      var input = document.getElementById('bd-save-successes');
      var val = parseInt(input.value, 10);
      if (isNaN(val) || val < 0) { alert('Invalid number.'); return; }
      bdCast.saveSuccesses = val;
      input.disabled = true;
      input.parentElement.nextElementSibling.style.display = 'none';
      bdShowResult();
    }

    function bdShowResult() {
      var net = bdCast.casterSuccesses - bdCast.saveSuccesses;
      var required = 2;
      var hit = net >= required;
      var manaCost = spellManaCost(bdCast.spellTier);
      var effectLabel = bdCast.effectType.charAt(0).toUpperCase() + bdCast.effectType.slice(1);
      var summary = hit
        ? '<strong>' + effectLabel + ' applied!</strong> (' + bdCast.casterSuccesses + ' caster - ' +
            bdCast.saveSuccesses + ' save = ' + net + ' net, need ' + required + '; permanent until dispelled)'
        : '<strong>Save succeeded.</strong> ' + bdCast.targetName + ' resists ' + effectLabel + '. (' +
            bdCast.casterSuccesses + ' caster - ' + bdCast.saveSuccesses + ' save = ' + net + ' net, need ' + required + ')';

      var fields =
        'id: currentCharId, combat_action: \'cast\', spell_name: \'Blindness/Deafness\', spell_tier: ' + bdCast.spellTier +
        ', target_combat_id: ' + bdCast.targetCombatId +
        ', dice_spent: ' + bdCast.diceSpent +
        ', bd_effect: \'' + bdCast.effectType + '\'' +
        ', bd_hit: ' + (hit ? 'true' : 'false') +
        ', bd_caster_successes: ' + bdCast.casterSuccesses +
        ', bd_save_successes: ' + bdCast.saveSuccesses +
        scrollFields();
      addStep(summary +
        '<br><span class="math-detail">Cost: ' + costLabel(manaCost) + ' + ' + bdCast.diceSpent + ' dice</span>' +
        '<br><button class="action-btn" onclick="submitAction({' + fields + '})" style="margin-top:8px;">Submit</button>');
    }

    // --- Ranged attack spells (Acid Splash / Sacred Flame / Fire Bolt) ---
    //   Each cast picks a target + dice, then falls through to the
    //   standard defense/attack-resolution UI via a pseudo-weapon built
    //   from the caster's spell skill. On submit, the cast is routed
    //   through /combat/action either as combat_action=cast (first cast)
    //   or combat_action=concentrate sub_action=ranged_attack (re-use).
    function startRangedAttackSpellCast(spellName, spellTier, targetIds, isConcentrateReuse, effectIndex) {
      var spellEntry = spellMetaFor(spellName);
      if (!spellEntry || !spellEntry.caster_skill) {
        alert('Caster has no eligible skill for ' + spellName);
        return;
      }
      var targetCombatId = targetIds[0];
      var maxDice = Math.min(spellEntry.caster_skill_dice, diceRemaining);
      var minDice = 2;
      if (maxDice < minDice) {
        addStep('<strong>Cannot cast ' + spellName + '</strong> - need at least ' + minDice +
          ' dice (skill allows ' + spellEntry.caster_skill_dice + ', pool has ' + diceRemaining + ')');
        return;
      }
      var diceId = 'rs-dice-' + Date.now();
      var manaNote = isConcentrateReuse ? 'no mana cost' : spellManaCost(spellTier) + ' mana';
      addStep('<strong>' + spellName + ' - Attack Dice</strong>' +
        '<br><span class="math-detail">Rolls off ' + spellEntry.caster_skill.replace('_', ' ') +
        ' (' + spellEntry.caster_skill_dice + ' dice max, bonus ' +
        (spellEntry.caster_skill_bonus >= 0 ? '+' : '') + spellEntry.caster_skill_bonus +
        '). Cost: ' + manaNote + '.</span>' +
        '<br><label>Dice: <input type="number" id="' + diceId + '" min="' + minDice + '" max="' + maxDice + '" value="' + maxDice + '" style="width:50px;"></label>' +
        ' <button class="action-btn" style="margin-top:4px;" onclick="(function(){' +
        'var v=parseInt(document.getElementById(\'' + diceId + '\').value,10);' +
        'if(isNaN(v)||v<' + minDice + '||v>' + maxDice + '){alert(\'Enter ' + minDice + '-' + maxDice + '.\');return;}' +
        'beginRangedSpellAttack(\'' + spellName.replace(/'/g, "\\'") + '\', ' + spellTier + ', ' +
        targetCombatId + ', v, ' + (isConcentrateReuse ? 'true' : 'false') + ', ' + effectIndex + ');' +
        '})()">Next</button>');
    }

    function beginRangedSpellAttack(spellName, spellTier, targetCombatId, dice, isConcentrateReuse, effectIndex) {
      var spellEntry = spellMetaFor(spellName);
      var target = combatants.find(function(c) { return c.combat_id === targetCombatId; });
      if (!target) { alert('Target missing'); return; }

      // Build a pseudo-weapon so the normal defense/attack-resolution UI
      // works. Ranged attack uses the caster's skill proficiency as the
      // attack bonus. Damage = successes (no base, no enhancement).
      var swWeapon = {
        item_id: 0,
        name: spellName,
        weapon_dice: dice,
        weapon_speed: 0,
        weapon_attack_bonus: spellEntry.caster_skill_bonus || 0,
        weapon_dmg: 0,
        weapon_threshold: 0,
        weapon_bonus: 0
      };

      attackState = {
        weapon: swWeapon,
        targetTurnId: null,
        target: target,
        attackerCombatId: currentCharId,
        targetCombatId: targetCombatId,
        attackDiceSpeed: 0,
        attackDice: dice,
        // Dice are spent up-front as part of the spell cast (not on top of it)
        attackerDiceSpent: dice,
        isRangedSpell: true,
        rangedSpellName: spellName,
        rangedSpellTier: spellTier,
        rangedSpellReuse: isConcentrateReuse,
        rangedSpellEffectIndex: effectIndex
      };

      showDefenseSelection();
    }

    // --- Vicious Mockery: opposed roll with distracted condition + crit damage ---
    var vmCast = null;

    function startViciousMockeryCast(spellName, spellTier, targetIds) {
      var targetCombatId = targetIds[0];
      var target = combatants.find(function(c) { return c.combat_id === targetCombatId; });
      if (!target) { alert('No target'); return; }
