    function vmCasterRollStep() {
      var casterTn = clampTn(diceRules.base_target_number - vmCast.casterSkillBonus);
      var tnMath = tnBreakdown('Caster TN', diceRules.base_target_number,
        [{value: -vmCast.casterSkillBonus, label: vmCast.casterSkill.replace('_', ' ') + ' bonus'}], casterTn);
      addStep('<strong>Caster Spell Check</strong>: ' + vmCast.diceSpent + ' dice, TN ' + casterTn +
        '<br><span class="math-detail">' + tnMath + ' &nbsp;|&nbsp; count crits (10s) separately.</span>' +
        '<br><label>Net successes: <input type="number" id="vm-caster-successes" min="0" value="0" style="width:50px;"></label>' +
        '&nbsp;<label>Crits (10s): <input type="number" id="vm-caster-crits" min="0" value="0" style="width:50px;"></label>' +
        ' <button class="action-btn" onclick="vmConfirmCasterSuccesses()">Confirm</button>' +
        ' <button class="action-btn" onclick="rollVmCasterDice(' + vmCast.diceSpent + ', ' + casterTn + ')">Roll</button>' +
        '<div id="vm-caster-roll-display" class="math-detail" style="margin-top:4px;"></div>');
    }

    // Variant of rollDicePool that also populates a crit count input
    // (used by Vicious Mockery where 10s deal bonus damage even on save).
    function rollVmCasterDice(dice, tn) {
      var rolls = [];
      var successes = 0;
      var crits = 0;
      for (var r = 0; r < dice; r++) {
        var d = Math.floor(Math.random() * 10) + 1;
        rolls.push(d);
        if (d === 10) { successes += 2; crits++; }
        else if (d >= tn) successes++;
        else if (d === 1) successes--;
      }
      var displaySuccesses = Math.max(0, successes);
      var succEl = document.getElementById('vm-caster-successes');
      if (succEl) succEl.value = displaySuccesses;
      var critEl = document.getElementById('vm-caster-crits');
      if (critEl) critEl.value = crits;
      var rollsEl = document.getElementById('vm-caster-roll-display');
      if (rollsEl) {
        var colored = rolls.map(function(d) {
          var bg = null;
          if (d === 1) bg = '#e57373';
          else if (d === 10) bg = '#64b5f6';
          else if (d >= tn) bg = '#81c784';
          if (bg) return '<span style="background:' + bg + ';color:#000;padding:1px 6px;border-radius:3px;font-weight:bold;">' + d + '</span>';
          return '<span style="color:#777;">' + d + '</span>';
        }).join(', ');
        rollsEl.innerHTML = 'Rolled: [' + colored + '] &rarr; ' + displaySuccesses + ' successes, ' + crits + ' crit' + (crits === 1 ? '' : 's');
      }
    }

    function vmConfirmCasterSuccesses() {
