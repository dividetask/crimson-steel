  <div class="combat-tracker">
  <h1>Combat Tracker</h1>

  <table>
    <thead>
      <tr>
        <th></th>
        <th>Initiative</th>
        <th>Character Name</th>
        <th>HP</th>
        <th>Minor</th>
        <th>Moderate</th>
        <th>Major</th>
        <th>Mana</th>
        <th>Dice</th>
        <th>Saturation</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @combat.combat_turn_list.each do |combat_turn| %>
        <% is_current = @combat.current_turn_character && @combat.current_turn_character.combat_id == combat_turn.combat_id %>
        <tr class="<%= 'current-turn' if is_current %>">
          <td>
            <form method="post" action="/combat/set_turn/<%= combat_turn.combat_id %>" style="margin:0;">
              <button type="submit" class="set-turn-btn" title="Set as current turn"><%= is_current ? '&#9654;' : 'Set' %></button>
            </form>
          </td>
          <td><%= combat_turn.initiative %></td>
          <td><%= @combat.display_name(combat_turn) %></td>
          <td><%= combat_turn.hp %>/<%= combat_turn.character.hp_max %></td>
          <td>
            <form method="post" action="/combat/update/<%= combat_turn.combat_id %>" class="combat-update-form">
            <input type="number" name="minor_damage" value="<%= combat_turn.minor_damage %>" style="width: 45px;">
          </td>
          <td><input type="number" name="moderate_damage" value="<%= combat_turn.moderate_damage %>" style="width: 45px;"></td>
          <td><input type="number" name="major_damage" value="<%= combat_turn.major_damage %>" style="width: 45px;"></td>
          <td><input type="number" name="mana" value="<%= combat_turn.mana %>" style="width: 45px;">/<%= combat_turn.character.mana_max %></td>
          <td><input type="number" name="combat_pool" value="<%= combat_turn.combat_pool %>" style="width: 45px;">/<%= combat_turn.character.combat_pool %></td>
          <td><input type="number" name="saturation" value="<%= combat_turn.saturation %>" style="width: 45px;">/<%= combat_turn.character.cha %></td>
          <td><button type="submit">Update</button></form></td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <div style="margin-top: 20px; display: flex; gap: 10px;">
    <form method="post" action="/combat/reset_dice">
      <button type="submit">Reset All Dice</button>
    </form>
    <form method="post" action="/combat/reroll_init">
      <button type="submit">Reroll Init</button>
    </form>
  </div>

  <% if @combat.active_effects.any? %>
    <div class="active-effects" style="margin-top: 15px;">
      <h3 style="margin-bottom: 8px;">Active Effects</h3>
      <% @combat.active_effects.each_with_index do |effect, idx| %>
        <div class="effect-row" style="display: flex; align-items: center; gap: 8px; margin-bottom: 4px; padding: 4px 8px; background: #f0f4ff; border-left: 3px solid #1976d2; border-radius: 2px; font-size: 13px;">
          <span><strong><%= effect['spell_name'] %></strong> (<%= effect['caster_name'] %>, round <%= effect['round_cast'] %>)</span>
          <form method="post" action="/combat/action" style="margin:0;">
            <input type="hidden" name="combat_action" value="dismiss_effect">
            <input type="hidden" name="effect_index" value="<%= idx %>">
            <button type="submit" style="font-size:11px;padding:2px 6px;cursor:pointer;">Dismiss</button>
          </form>
        </div>
      <% end %>
    </div>
  <% end %>

  <% current = @combat.current_turn_character %>
  <% if current %>
    <div class="turn-status">
      <h2><%= current.character.name %>'s Turn</h2>
    </div>

    <div class="turn-panel">
      <div class="action-buttons" id="action-buttons">
        <button class="action-btn" onclick="selectAction('attack')">Attack</button>
        <button class="action-btn" onclick="selectAction('move')">Move</button>
        <button class="action-btn" onclick="selectAction('cast')">Cast</button>
        <button class="action-btn" onclick="selectAction('item')">Item</button>
        <button class="action-btn" onclick="selectAction('special')">Special</button>
        <button class="action-btn" onclick="selectAction('end_turn')">End Turn</button>
      </div>
      <div class="action-context" id="action-context">
      </div>
    </div>
  <% end %>

  <script>
    var currentCharId = <%= current ? current.combat_id : 'null' %>;
    var currentCharName = '<%= current ? @combat.display_name(current) : '' %>';
    var equippedWeapons = <%= current ? JSON.generate(
      current.character.weapon_list.select { |w| w['equipped'] }.map { |w|
        {
          item_id: w['item_id'],
          name: w['name'],
          weapon_dice: current.character.weapon_dice(w),
          weapon_speed: current.character.weapon_speed(w),
          weapon_attack_bonus: current.character.weapon_attack_bonus(w),
          weapon_dmg: (d = current.character.weapon_dmg(w); d.is_a?(Numeric) ? d : 0),
          weapon_threshold: (t = current.character.weapon_threshold(w); t.is_a?(Numeric) ? t : 0),
          weapon_bonus: w['bonus'].to_i
        }
      }
    ) : '[]' %>;
    var diceRemaining = <%= current ? current.combat_pool : 0 %>;
    var currentMana = <%= current ? current.mana : 0 %>;
    var moveSpeed = <%= current ? current.character.speed : 0 %>;
    var spellList = <%= if current && current.character.spell_list
      compendium = Compendium.new
      JSON.generate(
        current.character.spell_list.each_with_index.map { |spells, tier|
          (spells || []).map do |name|
            cure = compendium.cure_effects(name)
            {name: name, tier: tier, cure: cure ? true : false}
          end
        }.flatten
      )
    else
      '[]'
    end %>;
    var combatants = <%= JSON.generate(
      @combat.combat_turn_list.each_with_index.map { |ct, idx|
        {
          turn_id: idx, combat_id: ct.combat_id, char_id: ct.character.id,
          name: @combat.display_name(ct), dice_remaining: ct.combat_pool, mana: ct.mana,
          bab_dice: ct.character.bab_dice, bab_bonus: ct.character.bab_bonus,
          damage_reduction: ct.character.damage_reduction,
          damage_resilience: ct.character.damage_resilience,
          abilities: ct.character.ability_list,
          healing_dice: ct.character.skill_dice("healing"),
          healing_bonus: ct.character.skill_bonus("healing"),
          spells: (ct.character.spell_list || []).flatten,
          shields: ct.character.shield_list.select { |s| s['equipped'] }.map { |s|
            {
              item_id: s['item_id'], name: s['name'],
              shield_dice: ct.character.shield_dice(s),
              shield_speed: ct.character.shield_speed(s),
              shield_attack_bonus: ct.character.shield_attack_bonus(s)
            }
          },
          weapons: ct.character.weapon_list.select { |w| w['equipped'] }.map { |w|
            {
              item_id: w['item_id'], name: w['name'],
              weapon_dice: ct.character.weapon_dice(w),
              weapon_speed: ct.character.weapon_speed(w),
              weapon_attack_bonus: ct.character.weapon_attack_bonus(w)
            }
          }
        }
      }
    ) %>;
    var activeEffects = <%= JSON.generate(@combat.active_effects) %>;
    var diceRules = <%= JSON.generate(Tools.load_json('rules.json')['dice']) %>;

    // --- Client-side attack state ---
    var attackState = null;

    function selectAction(action) {
      var context = document.getElementById('action-context');
      context.innerHTML = '';
      attackState = null;

      if (action === 'move') {
        if (diceRemaining < 4) {
          addStep('<strong>Cannot move</strong> - need 4 dice, have ' + diceRemaining);
          return;
        }
        addStep('<strong>Move</strong>: ' + currentCharName + ' moves up to ' + moveSpeed + ' feet' +
          '<br><button class="action-btn" onclick="submitAction({id: currentCharId, combat_action: \'move\'})" style="margin-top:8px;">Confirm Move</button>');
        return;
      }

      if (action === 'end_turn') {
        addStep('<strong>End Turn</strong>: ' + currentCharName + ' ends their turn' +
          '<br><button class="action-btn" onclick="submitAction({id: currentCharId, combat_action: \'end_turn\'})" style="margin-top:8px;">Confirm End Turn</button>');
        return;
      }

      if (action === 'attack') {
        showTargetSelection();
      }

      if (action === 'cast') {
        showSpellSelection();
      }
    }

    // --- ATTACK STEP 1: Select target ---
    function showTargetSelection() {
      addStep('<strong>Select Target</strong>' +
        '<br><select id="attack-target" style="margin-top:4px;"><option value="">-- select target --</option>' +
        combatants.map(function(c) { return '<option value="' + c.turn_id + '">' + c.name + '</option>'; }).join('') +
        '</select>' +
        '<div id="weapon-buttons" style="margin-top:8px;"></div>');

      document.getElementById('attack-target').addEventListener('change', function() {
        var weaponDiv = document.getElementById('weapon-buttons');
        weaponDiv.innerHTML = '';
        if (!this.value) return;
        var tid = parseInt(this.value, 10);
        equippedWeapons.forEach(function(weapon) {
          var btn = document.createElement('button');
          btn.className = 'weapon-btn';
          btn.textContent = weapon.name;
          btn.addEventListener('click', function() { showAttackDice(weapon, tid); });
          weaponDiv.appendChild(btn);
        });
      });
    }

    // --- CAST: Spell selection ---
    function spellManaCost(tier) {
      return tier === 0 ? 1 : (tier * 2 + 2);
    }

    function showSpellSelection() {
      if (!spellList || spellList.length === 0) {
        addStep('<strong>No spells available</strong>');
        return;
      }

      // Group spells by tier
      var tiers = {};
      spellList.forEach(function(s) {
        if (!tiers[s.tier]) tiers[s.tier] = [];
        tiers[s.tier].push(s);
      });

      var html = '<strong>Cast Spell</strong> (Mana: ' + currentMana + ')';
      var tierKeys = Object.keys(tiers).sort(function(a, b) { return a - b; });
      tierKeys.forEach(function(tier) {
        var cost = spellManaCost(parseInt(tier, 10));
        var canAfford = currentMana >= cost;
        html += '<div style="margin-top:6px;"><span class="math-detail">Tier ' + tier + ' (' + cost + ' mana):</span><br>';
        tiers[tier].forEach(function(spell) {
          if (canAfford) {
            html += '<button class="action-btn spell-btn" onclick="selectSpellTarget(\'' +
              spell.name.replace(/'/g, "\\'") + '\', ' + spell.tier + ', ' + (spell.cure ? 'true' : 'false') +
              ')" style="margin:2px;">' + spell.name + '</button>';
          } else {
            html += '<button class="action-btn spell-btn" disabled style="margin:2px;opacity:0.5;">' + spell.name + '</button>';
          }
        });
        html += '</div>';
      });

      addStep(html);
    }

    function selectSpellTarget(spellName, spellTier, isCure) {
      var optionsHtml = combatants.map(function(c) {
        return '<option value="' + c.combat_id + '">' + c.name + '</option>';
      }).join('');
      var selectId = 'cast-target-' + Date.now();
      addStep('<strong>Select Target for ' + spellName + '</strong>' +
        '<br><select id="' + selectId + '" style="margin-top:4px;">' +
        '<option value="">-- select target --</option>' + optionsHtml + '</select>' +
        '<br><button class="action-btn" style="margin-top:8px;" onclick="(function(){' +
        'var v=document.getElementById(\'' + selectId + '\').value;' +
        'if(!v){alert(\'Pick a target\');return;}' +
        'confirmCast(\'' + spellName.replace(/'/g, "\\'") + '\', ' + spellTier + ', parseInt(v,10), ' +
        (isCure ? 'true' : 'false') + ');})()">Next</button>');
    }

    function confirmCast(spellName, spellTier, targetCombatId, isCure) {
      var cost = spellManaCost(spellTier);
      var isConcentration = false;
      if (!isCure) {
        isConcentration = confirm(spellName + ' (Tier ' + spellTier + ', ' + cost + ' mana)\n\nIs this a concentration spell?');
      }

      var targetName = '';
      for (var i = 0; i < combatants.length; i++) {
        if (combatants[i].combat_id === targetCombatId) { targetName = combatants[i].name; break; }
      }

      addStep('<strong>Casting: ' + spellName + '</strong>' +
        '<br><span class="math-detail">Tier ' + spellTier + ' | Cost: ' + cost + ' mana | Target: ' + targetName +
        (isConcentration ? ' | Concentration' : '') + (isCure ? ' | Cure' : '') + '</span>' +
        '<br><button class="action-btn" onclick="submitAction({id: currentCharId, combat_action: \'cast\', spell_name: \'' +
        spellName.replace(/'/g, "\\'") + '\', spell_tier: ' + spellTier +
        ', concentration: ' + isConcentration + ', target_combat_id: ' + targetCombatId + '})" style="margin-top:8px;">Confirm Cast</button>');
    }

    // --- ATTACK STEP 2: Choose attack dice ---
    function showAttackDice(weapon, targetTurnId) {
      var target = combatants[targetTurnId];
      var speed = weapon.weapon_speed;
      var available = diceRemaining - speed;
      var minDice = 2;
      var capDice = Math.min(weapon.weapon_dice, available);

      if (available < minDice) {
        addStep('<strong>Cannot attack</strong> - need at least ' + (minDice + speed) + ' dice (' + minDice + ' + ' + speed + ' speed), have ' + diceRemaining);
        return;
      }

      // Lock in target selection
      document.getElementById('attack-target').disabled = true;
      var btns = document.getElementById('weapon-buttons');
      if (btns) btns.innerHTML = '<em>Weapon: ' + weapon.name + '</em>';

      attackState = {
        weapon: weapon,
        targetTurnId: targetTurnId,
        target: target,
        attackerCombatId: currentCharId,
        targetCombatId: target.combat_id,
        attackDiceSpeed: speed
      };

      addStep('<strong>Attack Dice</strong>: ' + currentCharName + ' attacks ' + target.name + ' with ' + weapon.name +
        '<br><span class="math-detail">Dice range: ' + minDice + '-' + capDice + ' | Weapon speed: ' + speed + ' (total cost: dice + ' + speed + ')</span>' +
        '<br><label>Attack dice: <input type="number" id="attack-dice-input" min="' + minDice + '" max="' + capDice + '" value="' + capDice + '" style="width:50px;"></label>' +
        ' <button class="action-btn" onclick="confirmAttackDice(' + minDice + ',' + capDice + ')">Confirm</button>');
    }

    function confirmAttackDice(minDice, capDice) {
      var input = document.getElementById('attack-dice-input');
      var val = parseInt(input.value, 10);
      if (isNaN(val) || val < minDice || val > capDice) {
        alert('Enter ' + minDice + '-' + capDice + '.'); return;
      }
      attackState.attackDice = val;
      attackState.attackerDiceSpent = val + attackState.attackDiceSpeed;
      input.disabled = true;
      input.parentElement.nextElementSibling.style.display = 'none';
      showDefenseSelection();
    }

    // --- ATTACK STEP 3: Select defense ---
    function showDefenseSelection() {
      var target = attackState.target;
      var targetWeapons = target.weapons || [];
      var targetShields = target.shields || [];
      var weaponOptions = targetWeapons.map(function(w) {
        return '<option value="w-' + w.item_id + '">' + w.name +
          ' (Atk/Def ' + (w.weapon_attack_bonus >= 0 ? '+' : '') + w.weapon_attack_bonus + ', Spd ' + w.weapon_speed + ')</option>';
      }).join('');
      var shieldOptions = targetShields.map(function(s) {
        return '<option value="s-' + s.item_id + '">' + s.name +
          ' (Def ' + (s.shield_attack_bonus >= 0 ? '+' : '') + s.shield_attack_bonus + ', Spd ' + s.shield_speed + ')</option>';
      }).join('');

      var abilities = target.abilities || [];
      var abilityBtns = '';
      if (abilities.indexOf('better_lucky_than_good') !== -1 && target.mana >= 4) {
        abilityBtns += ' <button class="action-btn" onclick="selectDefense(\'better_lucky_than_good\')">Better Lucky Than Good</button>';
      }

      var hasEquipment = targetWeapons.length > 0 || targetShields.length > 0;
      var blockBtn = targetShields.length > 0 ? ' <button class="action-btn" onclick="selectDefense(\'block\')">Block</button>' : '';

      addStep('<strong>Select Defense for ' + target.name + '</strong>' +
        '<br><button class="action-btn" onclick="selectDefense(\'nothing\')">Nothing</button>' +
        ' <button class="action-btn" onclick="selectDefense(\'dodge\')">Dodge</button>' +
        ' <button class="action-btn" onclick="selectDefense(\'parry\')">Parry</button>' +
        blockBtn +
        abilityBtns +
        (hasEquipment ?
          '<br><label style="margin-top:6px;display:inline-block;font-size:11px;font-weight:bold;">Parry/Block with: ' +
          '<select id="defense-weapon" style="font-size:11px;padding:2px;"><option value="">-- select --</option>' +
          weaponOptions + shieldOptions + '</select></label>' : ''));
    }

    // --- Utility functions ---
    function addStep(html) {
      var context = document.getElementById('action-context');
      var step = document.createElement('div');
      step.className = 'resolve-step';
      step.innerHTML = html;
      context.appendChild(step);
      step.scrollIntoView({behavior: 'smooth', block: 'nearest'});
      return step;
    }

    function clampTn(tn) {
      return Math.max(diceRules.tn_minimum, Math.min(diceRules.tn_maximum, tn));
    }

    function calcDamageSplit(totalDamage, threshold) {
      var minor = Math.min(totalDamage, threshold);
      var moderate = Math.min(Math.max(totalDamage - threshold, 0), threshold);
      var major = Math.max(totalDamage - 2 * threshold, 0);
      return {minor: minor, moderate: moderate, major: major};
    }

    function tnBreakdown(label, base, modifiers, clamped) {
      var parts = label + ': ' + base + ' (base)';
      modifiers.forEach(function(m) {
        parts += (m.value >= 0 ? ' + ' : ' - ') + Math.abs(m.value) + ' (' + m.label + ')';
      });
      var raw = base;
      modifiers.forEach(function(m) { raw += m.value; });
      if (raw !== clamped) parts += ' = ' + raw + ', clamped to ' + clamped;
      else parts += ' = ' + clamped;
      return parts;
    }

    // --- Defense resolution ---
    function selectDefense(defense) {
      // Remove the defense selection step and rebuild from there
      var steps = document.querySelectorAll('.resolve-step');
      var lastStep = steps[steps.length - 1];
      if (lastStep && lastStep.innerHTML.indexOf('Select Defense') !== -1) {
        // Keep it but disable buttons
      }

      if (!attackState) return;

      attackState.defense = defense;
      var target = attackState.target;
      var baseTn = diceRules.base_target_number;
      var hasUncannyDodge = (target.abilities || []).indexOf('uncanny_dodge') !== -1;
      var flatPenalty = hasUncannyDodge ? 0 : (diceRules.flatfooted_penalty || 1);
      var weapon = attackState.weapon;

      // --- Defense: Nothing (flatfooted, unless uncanny dodge) ---
      if (defense === 'nothing') {
        attackState.defenseDice = 0;
        attackState.attackTn = clampTn(baseTn - weapon.weapon_attack_bonus - flatPenalty);
        var tnMods = [{value: -weapon.weapon_attack_bonus, label: 'weapon proficiency'}];
        if (flatPenalty > 0) tnMods.push({value: -flatPenalty, label: 'flatfooted'});
        var tnMath = tnBreakdown('Attack TN', baseTn, tnMods, attackState.attackTn);
        var defLabel = hasUncannyDodge ? '<strong>Defense: Nothing</strong> (Uncanny Dodge - not flatfooted)' : '<strong>Defense: Flatfooted</strong>';
        addStep(defLabel + '<br><span class="math-detail">' + tnMath + '</span>');
        showAllyActions();
      }

      // --- Defense: Dodge ---
      else if (defense === 'dodge') {
        attackState.attackTn = clampTn(baseTn - weapon.weapon_attack_bonus);
        var dodgeTn = clampTn(baseTn - target.bab_bonus + weapon.weapon_attack_bonus);
        attackState.dodgeTn = dodgeTn;
        var minDice = 2;
        var maxDice = Math.min(target.bab_dice, target.dice_remaining);

        var atkTnMath = tnBreakdown('Attack TN', baseTn,
          [{value: -weapon.weapon_attack_bonus, label: 'weapon proficiency'}],
          attackState.attackTn);
        var dodgeTnMath = tnBreakdown('Dodge TN', baseTn,
          [{value: -target.bab_bonus, label: 'dodge bonus'}, {value: weapon.weapon_attack_bonus, label: 'attacker proficiency'}],
          dodgeTn);

        if (maxDice < minDice) {
          attackState.defenseDice = 0;
          addStep('<strong>Defense: Dodge</strong> - <em>Cannot dodge (need ' + minDice + ' dice, have ' + target.dice_remaining + ')</em>' +
            '<br><span class="math-detail">' + atkTnMath + '</span>');
          showAllyActions();
          return;
        }

        attackState.dodgeMin = minDice;
        attackState.dodgeMax = maxDice;
        addStep('<strong>Defense: Dodge</strong>' +
          '<br><span class="math-detail">' + atkTnMath + '</span>' +
          '<br><span class="math-detail">' + dodgeTnMath + '</span>' +
          '<br><label>Dodge dice (' + minDice + '-' + maxDice + '): <input type="number" id="dodge-dice-input" min="' + minDice + '" max="' + maxDice + '" value="' + minDice + '" style="width:50px;"></label>' +
          ' <button class="action-btn" onclick="confirmDodgeDice()">Confirm</button>');
      }

      // --- Defense: Parry ---
      else if (defense === 'parry') {
        var defWeaponSelect = document.getElementById('defense-weapon');
        var selectedVal = defWeaponSelect ? defWeaponSelect.value : '';
        if (!selectedVal || !selectedVal.startsWith('w-')) {
          alert('Select a weapon to parry with first.');
          return;
        }
        var selectedId = parseInt(selectedVal.substring(2), 10);
        var targetWeapons = target.weapons || [];
        var parryWeapon = targetWeapons.find(function(w) { return w.item_id === selectedId; });

        if (!parryWeapon) {
          alert('Select a weapon to parry with first.');
          return;
        }
        attackState.parryWeapon = parryWeapon;

        var parryTn = clampTn(baseTn - parryWeapon.weapon_attack_bonus + weapon.weapon_attack_bonus);
        var attackTn = clampTn(baseTn - weapon.weapon_attack_bonus + parryWeapon.weapon_attack_bonus);
        attackState.attackTn = attackTn;
        attackState.parryTn = parryTn;

        var parrySpeed = parryWeapon.weapon_speed;
        attackState.parrySpeed = parrySpeed;
        var minDice = 2;
        var maxAvailable = target.dice_remaining - parrySpeed;
        var maxDice = Math.min(parryWeapon.weapon_dice, maxAvailable);

        var atkTnMath = tnBreakdown('Attack TN', baseTn,
          [{value: -weapon.weapon_attack_bonus, label: 'weapon proficiency'}, {value: parryWeapon.weapon_attack_bonus, label: parryWeapon.name + ' defense'}],
          attackTn);
        var parryTnMath = tnBreakdown('Parry TN', baseTn,
          [{value: -parryWeapon.weapon_attack_bonus, label: parryWeapon.name + ' proficiency'}, {value: weapon.weapon_attack_bonus, label: 'attacker proficiency'}],
          parryTn);

        if (maxDice < minDice) {
          addStep('<strong>Defense: Parry with ' + parryWeapon.name + '</strong> - <em>Cannot parry (need ' + (minDice + parrySpeed) + ' dice, have ' + target.dice_remaining + ')</em>');
          return;
        }

        attackState.parryMin = minDice;
        attackState.parryMax = maxDice;
        addStep('<strong>Defense: Parry with ' + parryWeapon.name + '</strong>' +
          '<br><span class="math-detail">' + atkTnMath + '</span>' +
          '<br><span class="math-detail">' + parryTnMath + '</span>' +
          '<br><span class="math-detail">Parry cost: dice + ' + parrySpeed + ' (weapon speed)</span>' +
          '<br><label>Parry dice (' + minDice + '-' + maxDice + '): <input type="number" id="parry-dice-input" min="' + minDice + '" max="' + maxDice + '" value="' + minDice + '" style="width:50px;"></label>' +
          ' <button class="action-btn" onclick="confirmParryDice()">Confirm</button>');
      }

      // --- Defense: Block (with shield, works like parry) ---
      else if (defense === 'block') {
        var defWeaponSelect = document.getElementById('defense-weapon');
        var selectedVal = defWeaponSelect ? defWeaponSelect.value : '';
        if (!selectedVal || !selectedVal.startsWith('s-')) {
          alert('Select a shield to block with first.');
          return;
        }
        var selectedId = parseInt(selectedVal.substring(2), 10);
        var targetShields = target.shields || [];
        var blockShield = targetShields.find(function(s) { return s.item_id === selectedId; });

        if (!blockShield) {
          alert('Select a shield to block with first.');
          return;
        }
        attackState.blockShield = blockShield;

        var blockTn = clampTn(baseTn - blockShield.shield_attack_bonus + weapon.weapon_attack_bonus);
        var attackTn = clampTn(baseTn - weapon.weapon_attack_bonus + blockShield.shield_attack_bonus);
        attackState.attackTn = attackTn;
        attackState.blockTn = blockTn;

        var blockSpeed = blockShield.shield_speed;
        attackState.blockSpeed = blockSpeed;
        var minDice = 2;
        var maxAvailable = target.dice_remaining - blockSpeed;
        var maxDice = Math.min(blockShield.shield_dice, maxAvailable);

        var atkTnMath = tnBreakdown('Attack TN', baseTn,
          [{value: -weapon.weapon_attack_bonus, label: 'weapon proficiency'}, {value: blockShield.shield_attack_bonus, label: blockShield.name + ' defense'}],
          attackTn);
        var blockTnMath = tnBreakdown('Block TN', baseTn,
          [{value: -blockShield.shield_attack_bonus, label: blockShield.name + ' bonus'}, {value: weapon.weapon_attack_bonus, label: 'attacker proficiency'}],
          blockTn);

        if (maxDice < minDice) {
          addStep('<strong>Defense: Block with ' + blockShield.name + '</strong> - <em>Cannot block (need ' + (minDice + blockSpeed) + ' dice, have ' + target.dice_remaining + ')</em>');
          return;
        }

        attackState.blockMin = minDice;
        attackState.blockMax = maxDice;
        addStep('<strong>Defense: Block with ' + blockShield.name + '</strong>' +
          '<br><span class="math-detail">' + atkTnMath + '</span>' +
          '<br><span class="math-detail">' + blockTnMath + '</span>' +
          '<br><span class="math-detail">Block cost: dice + ' + blockSpeed + ' (shield speed)</span>' +
          '<br><label>Block dice (' + minDice + '-' + maxDice + '): <input type="number" id="block-dice-input" min="' + minDice + '" max="' + maxDice + '" value="' + minDice + '" style="width:50px;"></label>' +
          ' <button class="action-btn" onclick="confirmBlockDice()">Confirm</button>');
      }

      // --- Better Lucky Than Good (stays in defense step since it affects attack dice) ---
      else if (defense === 'better_lucky_than_good') {
        attackState.defenseDice = 0;
        attackState.manaCost = 4;
        attackState.attackDiceOverride = 3;
        attackState.attackTn = clampTn(baseTn - weapon.weapon_attack_bonus - flatPenalty);
        var tnMods = [{value: -weapon.weapon_attack_bonus, label: 'weapon proficiency'}];
        if (flatPenalty > 0) tnMods.push({value: -flatPenalty, label: 'flatfooted'});
        var tnMath = tnBreakdown('Attack TN', baseTn, tnMods, attackState.attackTn);

        addStep('<strong>Defense: Better Lucky Than Good</strong> (4 mana)' +
          '<br><span class="math-detail">Attacker dice reduced to 3</span>' +
          '<br><span class="math-detail">' + tnMath + '</span>');
        showAllyActions();
      }
    }

    function confirmDodgeDice() {
      var input = document.getElementById('dodge-dice-input');
      var val = parseInt(input.value, 10);
      if (isNaN(val) || val < attackState.dodgeMin || val > attackState.dodgeMax) {
        alert('Enter ' + attackState.dodgeMin + '-' + attackState.dodgeMax + '.'); return;
      }
      attackState.defenseDice = val;
      input.disabled = true;
      input.parentElement.nextElementSibling.style.display = 'none';
      showAllyActions();
    }

    function confirmParryDice() {
      var input = document.getElementById('parry-dice-input');
      var val = parseInt(input.value, 10);
      if (isNaN(val) || val < attackState.parryMin || val > attackState.parryMax) {
        alert('Enter ' + attackState.parryMin + '-' + attackState.parryMax + '.'); return;
      }
      attackState.parryDice = val;
      attackState.defenseDice = val + attackState.parrySpeed;
      input.disabled = true;
      input.parentElement.nextElementSibling.style.display = 'none';
      showAllyActions();
    }

    function confirmBlockDice() {
      var input = document.getElementById('block-dice-input');
      var val = parseInt(input.value, 10);
      if (isNaN(val) || val < attackState.blockMin || val > attackState.blockMax) {
        alert('Enter ' + attackState.blockMin + '-' + attackState.blockMax + '.'); return;
      }
      attackState.blockDice = val;
      attackState.defenseDice = val + attackState.blockSpeed;
      input.disabled = true;
      input.parentElement.nextElementSibling.style.display = 'none';
      showAllyActions();
    }

    // --- Ally actions step (after defense, before attack roll) ---
    // Store available shield casters for use across functions
    var pendingAllyShields = [];

    function showAllyActions() {
      attackState.allyActions = [];
      pendingAllyShields = [];

      activeEffects.forEach(function(effect) {
        if ((effect.spell_name || '').trim() !== 'Shield of Faith') return;
        var caster = combatants.find(function(c) { return c.combat_id === effect.caster_id; });
        if (!caster) return;
        if (caster.combat_id === attackState.attackerCombatId) return;
        if (caster.dice_remaining < 2) return;
        pendingAllyShields.push({
          caster: caster,
          shieldBonus: 1,
          defenseBonus: caster.healing_bonus,
          maxDice: caster.healing_dice,
          available: caster.dice_remaining,
          used: false
        });
      });

      if (pendingAllyShields.length === 0) {
        showAttackRoll();
        return;
      }

      showAllyButtons();
    }

    function showAllyButtons() {
      var html = '<strong>Ally Reactions</strong><br>';
      var anyRemaining = false;
      pendingAllyShields.forEach(function(ally, idx) {
        if (ally.used) return;
        anyRemaining = true;
        html += '<button class="action-btn" onclick="activateShieldOfFaith(' + idx + ')" style="margin:2px;">' +
          ally.caster.name + ' — Shield of Faith</button> ';
      });
      if (!anyRemaining) {
        finalizeAllyActions();
        return;
      }
      html += '<button class="action-btn" onclick="finalizeAllyActions()" style="margin:2px;">Skip</button>';
      addStep(html);
    }

    function activateShieldOfFaith(idx) {
      var ally = pendingAllyShields[idx];
      ally.used = true;
      var capDice = Math.min(ally.maxDice, ally.available);
      var minDice = 2;

      // Remove the buttons step
      var steps = document.querySelectorAll('.resolve-step');
      steps[steps.length - 1].remove();

      addStep('<strong>' + ally.caster.name + ' — Shield of Faith</strong>' +
        '<br><span class="math-detail">+' + ally.shieldBonus + ' shield, defense bonus ' +
        (ally.defenseBonus >= 0 ? '+' : '') + ally.defenseBonus + '</span>' +
        '<br><label>Block dice (' + minDice + '-' + capDice + '): ' +
        '<input type="number" id="ally-dice-' + idx + '" min="' + minDice + '" max="' + capDice + '" value="' + minDice + '" style="width:50px;"></label>' +
        '<input type="hidden" id="ally-cid-' + idx + '" value="' + ally.caster.combat_id + '">' +
        '<input type="hidden" id="ally-bonus-' + idx + '" value="' + ally.defenseBonus + '">' +
        ' <button class="action-btn" onclick="confirmOneAlly(' + idx + ')">Confirm</button>');
    }

    function confirmOneAlly(idx) {
      var diceInput = document.getElementById('ally-dice-' + idx);
      var ally = pendingAllyShields[idx];
      var dice = parseInt(diceInput.value, 10) || 0;
      var minDice = 2;
      var capDice = Math.min(ally.maxDice, ally.available);
      if (dice < minDice || dice > capDice) {
        alert('Enter ' + minDice + '-' + capDice + '.'); return;
      }
      var cid = parseInt(document.getElementById('ally-cid-' + idx).value, 10);
      var bonus = parseInt(document.getElementById('ally-bonus-' + idx).value, 10);
      attackState.allyActions.push({combat_id: cid, dice: dice, bonus: bonus});
      diceInput.disabled = true;
      diceInput.parentElement.parentElement.querySelector('button').style.display = 'none';

      // Check if more allies available
      var moreAvailable = pendingAllyShields.some(function(a) { return !a.used; });
      if (moreAvailable) {
        showAllyButtons();
      } else {
        finalizeAllyActions();
      }
    }

    function finalizeAllyActions() {
      var baseTn = diceRules.base_target_number;
      var weapon = attackState.weapon;

      // Remove the skip/buttons step if it's still there
      var steps = document.querySelectorAll('.resolve-step');
      var lastStep = steps[steps.length - 1];
      if (lastStep && lastStep.innerHTML.indexOf('Ally Reactions') !== -1) {
        lastStep.remove();
      }

      if (attackState.allyActions.length > 0) {
        // Ally intervention removes flatfooted — recalculate TN without it
        var tnMods = [{value: -weapon.weapon_attack_bonus, label: 'weapon proficiency'}];
        if (attackState.defense === 'parry' && attackState.parryWeapon) {
          tnMods.push({value: attackState.parryWeapon.weapon_attack_bonus, label: attackState.parryWeapon.name + ' defense'});
        }
        if (attackState.defense === 'block' && attackState.blockShield) {
          tnMods.push({value: attackState.blockShield.shield_attack_bonus, label: attackState.blockShield.name + ' defense'});
        }
        attackState.allyActions.forEach(function(a) {
          var allyName = combatants.find(function(c) { return c.combat_id === a.combat_id; });
          tnMods.push({value: a.bonus, label: (allyName ? allyName.name : 'Ally') + ' Shield of Faith'});
        });

        attackState.attackTn = clampTn(baseTn + tnMods.reduce(function(sum, m) { return sum + m.value; }, 0));
        var tnMath = tnBreakdown('Attack TN (revised)', baseTn, tnMods, attackState.attackTn);
        addStep('<span class="math-detail">' + tnMath + '</span>');
      }

      showAttackRoll();
    }

    // --- Attack roll step ---
    function showAttackRoll() {
      var rollDice = attackState.attackDiceOverride || attackState.attackDice;
      var diceNote = attackState.attackDiceOverride ? ' (reduced from ' + attackState.attackDice + ')' : '';
      addStep('<strong>Attack Roll</strong>: ' + rollDice + ' dice' + diceNote + ', TN ' + attackState.attackTn +
        '<br><label>Attack successes: <input type="number" id="attack-successes-input" min="0" value="0" style="width:50px;"></label>' +
        ' <button class="action-btn" onclick="confirmAttackSuccesses()">Confirm</button>');
    }

    function confirmAttackSuccesses() {
      var input = document.getElementById('attack-successes-input');
      var val = parseInt(input.value, 10);
      if (isNaN(val) || val < 0) { alert('Invalid number.'); return; }
      attackState.attackSuccesses = val;
      input.disabled = true;
      input.parentElement.nextElementSibling.style.display = 'none';

      if (attackState.defense === 'dodge' && attackState.defenseDice > 0) {
        showDodgeRoll();
      } else if (attackState.defense === 'parry') {
        showParryRoll();
      } else if (attackState.defense === 'block') {
        showBlockRoll();
      } else {
        proceedToAllyRolls(val, 0);
      }
    }

    // --- Defense roll steps ---
    function showDodgeRoll() {
      addStep('<strong>Dodge Roll</strong>: ' + attackState.defenseDice + ' dice, TN ' + attackState.dodgeTn +
        '<br><label>Dodge successes: <input type="number" id="defense-successes-input" min="0" value="0" style="width:50px;"></label>' +
        ' <button class="action-btn" onclick="confirmDefenseSuccesses()">Confirm</button>');
    }

    function showParryRoll() {
      addStep('<strong>Parry Roll</strong>: ' + attackState.parryDice + ' dice, TN ' + attackState.parryTn +
        '<br><label>Parry successes: <input type="number" id="defense-successes-input" min="0" value="0" style="width:50px;"></label>' +
        ' <button class="action-btn" onclick="confirmDefenseSuccesses()">Confirm</button>');
    }

    function showBlockRoll() {
      addStep('<strong>Block Roll</strong>: ' + attackState.blockDice + ' dice, TN ' + attackState.blockTn +
        '<br><label>Block successes: <input type="number" id="defense-successes-input" min="0" value="0" style="width:50px;"></label>' +
        ' <button class="action-btn" onclick="confirmDefenseSuccesses()">Confirm</button>');
    }

    function confirmDefenseSuccesses() {
      var input = document.getElementById('defense-successes-input');
      var val = parseInt(input.value, 10);
      if (isNaN(val) || val < 0) { alert('Invalid number.'); return; }
      attackState.defenseSuccesses = val;
      input.disabled = true;
      input.parentElement.nextElementSibling.style.display = 'none';
      proceedToAllyRolls(attackState.attackSuccesses, val);
    }

    // --- Ally block rolls ---
    function proceedToAllyRolls(attackSuccesses, defenseSuccesses) {
      attackState.allyRollQueue = (attackState.allyActions || []).slice();
      attackState.allyBlockSuccesses = 0;
      attackState.pendingAttackSuccesses = attackSuccesses;
      attackState.pendingDefenseSuccesses = defenseSuccesses;
      showNextAllyRoll();
    }

    function showNextAllyRoll() {
      if (attackState.allyRollQueue.length === 0) {
        showPostDefenseAbilities();
        return;
      }
      var ally = attackState.allyRollQueue.shift();
      var caster = combatants.find(function(c) { return c.combat_id === ally.combat_id; });
      var baseTn = diceRules.base_target_number;
      var blockTn = clampTn(baseTn - ally.bonus + attackState.weapon.weapon_attack_bonus);
      var tnMath = tnBreakdown('Block TN', baseTn,
        [{value: -ally.bonus, label: 'healing bonus'}, {value: attackState.weapon.weapon_attack_bonus, label: 'attacker proficiency'}],
        blockTn);
      addStep('<strong>' + (caster ? caster.name : 'Ally') + ' blocks with Shield of Faith</strong>: ' + ally.dice + ' dice' +
        '<br><span class="math-detail">' + tnMath + '</span>' +
        '<br><label>Block successes: <input type="number" id="ally-block-successes" min="0" value="0" style="width:50px;"></label>' +
        ' <button class="action-btn" onclick="confirmAllyBlockSuccesses()">Confirm</button>');
    }

    function confirmAllyBlockSuccesses() {
      var input = document.getElementById('ally-block-successes');
      var val = parseInt(input.value, 10);
      if (isNaN(val) || val < 0) { alert('Invalid number.'); return; }
      attackState.allyBlockSuccesses += val;
      input.disabled = true;
      input.parentElement.nextElementSibling.style.display = 'none';
      showNextAllyRoll();
    }

    // --- Post-defense abilities (Danger Sense, Primal Tenacity) ---
    function showPostDefenseAbilities() {
      var target = attackState.target;
      var abilities = target.abilities || [];
      var isNothing = (attackState.defense === 'nothing' || attackState.defense === 'better_lucky_than_good');

      if (!isNothing) {
        showHealingWord();
        return;
      }

      var btns = '';
      if (abilities.indexOf('danger_sense') !== -1 && target.mana >= 4) {
        btns += '<button class="action-btn" onclick="usePostAbility(\'danger_sense\')" style="margin:2px;">Danger Sense</button> ';
      }
      if (abilities.indexOf('primal_tenacity') !== -1 && target.mana >= 4) {
        btns += '<button class="action-btn" onclick="usePostAbility(\'primal_tenacity\')" style="margin:2px;">Primal Tenacity</button> ';
      }

      if (btns === '') {
        showHealingWord();
        return;
      }

      btns += '<button class="action-btn" onclick="showHealingWord()" style="margin:2px;">Skip</button>';
      addStep('<strong>Reactive Abilities for ' + target.name + '</strong><br>' + btns);
    }

    function usePostAbility(ability) {
      // Remove buttons step
      var steps = document.querySelectorAll('.resolve-step');
      steps[steps.length - 1].remove();

      attackState.manaCost += 4;
      if (ability === 'danger_sense') {
        attackState.resilienceBonus = 4;
        addStep('<strong>Danger Sense</strong> (4 mana)<br><span class="math-detail">Damage resilience +4 for this attack</span>');
      } else if (ability === 'primal_tenacity') {
        attackState.drBonus = 4;
        addStep('<strong>Primal Tenacity</strong> (4 mana)<br><span class="math-detail">Damage reduction +4 for this attack</span>');
      }
      showHealingWord();
    }

    // --- Healing Word reactive ally spell ---
    function showHealingWord() {
      attackState.healingWordActions = attackState.healingWordActions || [];
      attackState.healingWordSuccesses = attackState.healingWordSuccesses || 0;

      // Find allies who know Healing Word, have mana, and have dice
      var healers = [];
      var healingWordCost = spellManaCost(1); // tier 1 = 4 mana
      combatants.forEach(function(c) {
        if (c.combat_id === attackState.attackerCombatId) return;
        // Skip already used healers
        var alreadyUsed = attackState.healingWordActions.some(function(a) { return a.combat_id === c.combat_id; });
        if (alreadyUsed) return;
        if (!c.spells || c.spells.indexOf('Healing Word') === -1) return;
        if (c.mana < healingWordCost) return;
        if (c.dice_remaining < 2) return;
        healers.push(c);
      });

      if (healers.length === 0) {
        proceedToDamage();
        return;
      }

      var html = '<strong>Healing Word Reactions</strong><br>';
      healers.forEach(function(healer) {
        html += '<button class="action-btn" onclick="activateHealingWord(' + healer.combat_id + ')" style="margin:2px;">' +
          healer.name + ' — Healing Word (' + healingWordCost + ' mana)</button> ';
      });
      html += '<button class="action-btn" onclick="proceedToDamage()" style="margin:2px;">Skip</button>';
      addStep(html);
    }

    function activateHealingWord(combatId) {
      var healer = combatants.find(function(c) { return c.combat_id === combatId; });
      if (!healer) return;
      var maxDice = Math.min(healer.healing_dice, healer.dice_remaining);
      var minDice = 2;
      var healingWordCost = spellManaCost(1);
      var baseTn = diceRules.base_target_number;
      var healTn = clampTn(baseTn - healer.healing_bonus);
      var tnMath = tnBreakdown('Healing TN', baseTn,
        [{value: -healer.healing_bonus, label: 'healing bonus'}], healTn);

      // Remove the buttons step
      var steps = document.querySelectorAll('.resolve-step');
      steps[steps.length - 1].remove();

      addStep('<strong>' + healer.name + ' — Healing Word</strong> (' + healingWordCost + ' mana)' +
        '<br><span class="math-detail">' + tnMath + '</span>' +
        '<br><label>Healing dice (' + minDice + '-' + maxDice + '): ' +
        '<input type="number" id="hw-dice" min="' + minDice + '" max="' + maxDice + '" value="' + minDice + '" style="width:50px;"></label>' +
        '<input type="hidden" id="hw-cid" value="' + combatId + '">' +
        '<input type="hidden" id="hw-tn" value="' + healTn + '">' +
        ' <button class="action-btn" onclick="confirmHealingWordDice()">Confirm</button>');
    }

    function confirmHealingWordDice() {
      var diceInput = document.getElementById('hw-dice');
      var dice = parseInt(diceInput.value, 10) || 0;
      var cid = parseInt(document.getElementById('hw-cid').value, 10);
      var healTn = parseInt(document.getElementById('hw-tn').value, 10);
      var healer = combatants.find(function(c) { return c.combat_id === cid; });
      var maxDice = Math.min(healer.healing_dice, healer.dice_remaining);
      if (dice < 2 || dice > maxDice) { alert('Enter 2-' + maxDice + '.'); return; }

      diceInput.disabled = true;
      diceInput.parentElement.parentElement.querySelector('button').style.display = 'none';

      attackState.healingWordActions.push({combat_id: cid, dice: dice});

      addStep('<strong>' + healer.name + ' rolls Healing Word</strong>: ' + dice + ' dice, TN ' + healTn +
        '<br><label>Successes (each reduces damage by 1): <input type="number" id="hw-successes" min="0" value="0" style="width:50px;"></label>' +
        ' <button class="action-btn" onclick="confirmHealingWordSuccesses()">Confirm</button>');
    }

    function confirmHealingWordSuccesses() {
      var input = document.getElementById('hw-successes');
      var val = parseInt(input.value, 10);
      if (isNaN(val) || val < 0) { alert('Invalid number.'); return; }
      attackState.healingWordSuccesses += val;
      input.disabled = true;
      input.parentElement.nextElementSibling.style.display = 'none';
      // Offer more healers
      showHealingWord();
    }

    function proceedToDamage() {
      // Remove skip buttons step if present
      var steps = document.querySelectorAll('.resolve-step');
      var lastStep = steps[steps.length - 1];
      if (lastStep && (lastStep.innerHTML.indexOf('Healing Word Reactions') !== -1)) {
        lastStep.remove();
      }

      var totalDef = attackState.pendingDefenseSuccesses + attackState.allyBlockSuccesses;
      showDamageResult(attackState.pendingAttackSuccesses, totalDef);
    }

    // --- Damage result ---
    function showDamageResult(attackSuccesses, defenseSuccesses) {
      var weapon = attackState.weapon;
      var target = attackState.target;
      var reqSuccesses = diceRules.default_required_successes;
      var netSuccesses = attackSuccesses - defenseSuccesses;

      if (netSuccesses < reqSuccesses) {
        var missMsg = '<strong>Miss!</strong> ' + attackSuccesses + ' attack' + (defenseSuccesses > 0 ? ' - ' + defenseSuccesses + ' defense' : '') +
          ' = ' + netSuccesses + ' net (need ' + reqSuccesses + ')';
        addStep(missMsg +
          '<br><button class="action-btn" onclick="submitFinalResult(true)" style="margin-top:8px;">Submit (Miss)</button>' +
          ' <button class="action-btn" onclick="restartDefense()" style="margin-top:8px;">Change Defense</button>');
        return;
      }

      var drBonus = attackState.drBonus || 0;
      var resilienceBonus = attackState.resilienceBonus || 0;
      var effectiveDR = target.damage_reduction + drBonus;
      var effectiveResilience = target.damage_resilience + resilienceBonus;
      var threshold = effectiveResilience + weapon.weapon_threshold;

      var hwReduction = attackState.healingWordSuccesses || 0;
      var totalDamage = Math.max(0, weapon.weapon_dmg + netSuccesses + weapon.weapon_bonus - effectiveDR - hwReduction);

      var drText = 'Damage Reduction: ' + target.damage_reduction;
      if (drBonus > 0) drText += ' + ' + drBonus + ' (Primal Tenacity)';
      var hwText = hwReduction > 0 ? ' - Healing Word: ' + hwReduction : '';
      var breakdown = '<strong>Damage Calculation</strong><br>' +
        '<span class="math-detail">' +
        'Weapon Damage: ' + weapon.weapon_dmg + ' (' + weapon.name + ')' +
        ' + Net Successes: ' + netSuccesses +
        (defenseSuccesses > 0 ? ' (' + attackSuccesses + ' attack - ' + defenseSuccesses + ' defense)' : '') +
        ' + Weapon Enhancement: ' + weapon.weapon_bonus +
        ' - ' + drText + hwText +
        ' = <strong>' + totalDamage + '</strong></span>';

      var split = calcDamageSplit(totalDamage, threshold);
      var resilText = 'Resilience ' + target.damage_resilience;
      if (resilienceBonus > 0) resilText += ' + ' + resilienceBonus + ' (Danger Sense)';
      var thresholdMath = '<span class="math-detail">Threshold: ' + threshold +
        ' (' + resilText + ' + Weapon Threshold ' + weapon.weapon_threshold + ')</span>';
      var splitDisplay = '<span class="math-detail">Minor: ' + split.minor + ' | Moderate: ' + split.moderate + ' | Major: ' + split.major + '</span>';

      addStep(breakdown + '<br>' + thresholdMath + '<br>' + splitDisplay +
        '<br><label style="margin-top:8px;display:inline-block;">Final damage (editable): <input type="number" id="final-damage-input" min="0" value="' + totalDamage + '" style="width:60px;" onchange="updateDamageSplit()"></label>' +
        '<span id="final-split" class="math-detail" style="margin-left:10px;">Minor: ' + split.minor + ' | Moderate: ' + split.moderate + ' | Major: ' + split.major + '</span>' +
        '<br><button class="action-btn" onclick="submitFinalResult(false)" style="margin-top:8px;">Submit Damage</button>' +
        ' <button class="action-btn" onclick="restartDefense()" style="margin-top:8px;">Change Defense</button>');
    }

    function updateDamageSplit() {
      var input = document.getElementById('final-damage-input');
      var val = parseInt(input.value, 10) || 0;
      var target = attackState.target;
      var effectiveResilience = target.damage_resilience + (attackState.resilienceBonus || 0);
      var threshold = effectiveResilience + attackState.weapon.weapon_threshold;
      var split = calcDamageSplit(val, threshold);
      document.getElementById('final-split').textContent = 'Minor: ' + split.minor + ' | Moderate: ' + split.moderate + ' | Major: ' + split.major;
    }

    function restartDefense() {
      // Remove steps from defense selection onward, keep target + dice steps
      var steps = document.querySelectorAll('.resolve-step');
      var removing = false;
      for (var i = 0; i < steps.length; i++) {
        if (steps[i].innerHTML.indexOf('Select Defense') !== -1) removing = true;
        if (removing) steps[i].remove();
      }
      attackState.defense = null;
      attackState.defenseDice = 0;
      attackState.attackSuccesses = null;
      attackState.defenseSuccesses = null;
      attackState.manaCost = 0;
      attackState.drBonus = 0;
      attackState.resilienceBonus = 0;
      attackState.attackDiceOverride = null;
      attackState.blockShield = null;
      attackState.blockDice = 0;
      attackState.blockTn = null;
      attackState.blockSpeed = 0;
      attackState.allyActions = [];
      attackState.allyBlockSuccesses = [];
      attackState.allyRollQueue = [];
      attackState.healingWordActions = [];
      attackState.healingWordSuccesses = 0;
      showDefenseSelection();
    }

    function submitFinalResult(isMiss) {
      var defenseDice = attackState.defenseDice || 0;
      var attackerDiceSpent = attackState.attackerDiceSpent || 0;
      var manaCost = attackState.manaCost || 0;

      // Build ally_data string from allyActions: "combat_id:dice;combat_id:dice"
      var allyDataStr = '';
      if (attackState.allyActions && attackState.allyActions.length > 0) {
        allyDataStr = attackState.allyActions.map(function(a) {
          return a.combat_id + ':' + a.dice;
        }).join(';');
      }

      // Build healing_word_data string: "combat_id:mana_cost;combat_id:mana_cost"
      var hwDataStr = '';
      var hwCost = spellManaCost(1);
      if (attackState.healingWordActions && attackState.healingWordActions.length > 0) {
        hwDataStr = attackState.healingWordActions.map(function(a) {
          return a.combat_id + ':' + hwCost;
        }).join(';');
      }

      if (isMiss) {
        submitAction({
          combat_action: 'attack',
          attacker_combat_id: attackState.attackerCombatId,
          target_combat_id: attackState.targetCombatId,
          attacker_dice_spent: attackerDiceSpent,
          defense_dice: defenseDice,
          target_mana_cost: manaCost,
          ally_data: allyDataStr,
          healing_word_data: hwDataStr,
          minor_damage: 0, moderate_damage: 0, major_damage: 0
        });
        return;
      }

      var finalDamage = parseInt(document.getElementById('final-damage-input').value, 10);
      if (isNaN(finalDamage) || finalDamage < 0) { alert('Invalid damage.'); return; }
      var target = attackState.target;
      var effectiveResilience = target.damage_resilience + (attackState.resilienceBonus || 0);
      var threshold = effectiveResilience + attackState.weapon.weapon_threshold;
      var split = calcDamageSplit(finalDamage, threshold);

      submitAction({
        combat_action: 'attack',
        attacker_combat_id: attackState.attackerCombatId,
        target_combat_id: attackState.targetCombatId,
        attacker_dice_spent: attackerDiceSpent,
        defense_dice: defenseDice,
        target_mana_cost: manaCost,
        ally_data: allyDataStr,
        healing_word_data: hwDataStr,
        minor_damage: split.minor, moderate_damage: split.moderate, major_damage: split.major
      });
    }

    function submitAction(fields) {
      var form = document.createElement('form');
      form.method = 'post';
      form.action = '/combat/action';
      form.style.display = 'none';
      for (var key in fields) {
        var el = document.createElement('input');
        el.type = 'hidden';
        el.name = key;
        el.value = fields[key];
        form.appendChild(el);
      }
      document.body.appendChild(form);
      form.submit();
    }
  </script>
  </div>
