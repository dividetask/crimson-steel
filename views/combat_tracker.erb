  <div class="combat-tracker">
  <h1>Combat Tracker</h1>

  <% if @combat.current_action == 'attack' %>
    <% atk_actor = @combat.combat_turn_list[@combat.current_actor_turn_id] %>
    <% atk_target = @combat.combat_turn_list[@combat.target_id] %>
    <% atk_weapon = atk_actor.character.weapon_list.find { |i| i['item_id'] == @combat.current_action_tool_id } %>
    <div class="attack-banner">
      <%= @combat.display_name(atk_actor) %> attacks <%= @combat.display_name(atk_target) %> with <%= atk_weapon ? atk_weapon['name'] : 'Unknown' %>
    </div>
  <% end %>

  <table>
    <thead>
      <tr>
        <th>Initiative</th>
        <th>Character Name</th>
        <th>HP</th>
        <th>Minor</th>
        <th>Moderate</th>
        <th>Major</th>
        <th>Mana</th>
        <th>Dice</th>
        <th>Saturation</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @combat.combat_turn_list.each do |combat_turn| %>
        <tr>
          <td><%= combat_turn.initiative %></td>
          <td><%= @combat.display_name(combat_turn) %></td>
          <td><%= combat_turn.hp %>/<%= combat_turn.character.hp_max %></td>
          <td>
            <form method="post" action="/combat/update/<%= combat_turn.combat_id %>" class="combat-update-form">
            <input type="number" name="minor_damage" value="<%= combat_turn.minor_damage %>" style="width: 45px;">
          </td>
          <td><input type="number" name="moderate_damage" value="<%= combat_turn.moderate_damage %>" style="width: 45px;"></td>
          <td><input type="number" name="major_damage" value="<%= combat_turn.major_damage %>" style="width: 45px;"></td>
          <td><input type="number" name="mana" value="<%= combat_turn.mana %>" style="width: 45px;">/<%= combat_turn.character.mana_max %></td>
          <td><input type="number" name="combat_pool" value="<%= combat_turn.combat_pool %>" style="width: 45px;">/<%= combat_turn.character.combat_pool %></td>
          <td><input type="number" name="saturation" value="<%= combat_turn.saturation %>" style="width: 45px;">/<%= combat_turn.character.cha %></td>
          <td><button type="submit">Update</button></form></td>
        </tr>
      <% end %>
    </tbody>
  </table>
  
  <form method="post" action="/combat/reset_dice" style="margin-top: 20px;">
    <button type="submit">Reset All Dice Remaining</button>
  </form>

  <form method="post" action="/combat/reroll_init" style="margin-top: 20px;">
    <button type="submit">Reroll Init</button>
  </form>

  <% current = @combat.current_turn_character %>
  <% if current %>
    <div class="turn-status">
      <% if @combat.current_action == 'attack' || @combat.current_action == 'dodge' %>
        <% actor = @combat.combat_turn_list[@combat.current_actor_turn_id] %>
        <% target = @combat.combat_turn_list[@combat.target_id] %>
        <% if actor&.character && target&.character %>
          <% action_weapon = actor.character.weapon_list.find { |i| i['item_id'] == @combat.current_action_tool_id } %>
          <% weapon_display = action_weapon ? action_weapon['name'] : 'Unknown' %>
          <% if @combat.current_action == 'dodge' %>
            <h2><%= @combat.display_name(actor) %> attacks <%= @combat.display_name(target) %> with <%= weapon_display %> - <%= @combat.display_name(target) %> dodges</h2>
          <% else %>
            <h2><%= @combat.display_name(actor) %> attacks <%= @combat.display_name(target) %> with <%= weapon_display %></h2>
          <% end %>
        <% end %>
      <% else %>
        <h2><%= current.character.name %>'s Turn</h2>
      <% end %>
    </div>

    <div class="turn-panel">
      <div class="action-buttons" id="action-buttons">
        <% if @combat.current_action == 'attack' || @combat.current_action == 'dodge' %>
          <button class="action-btn" onclick="selectDefense('ally_action')">Ally Action</button>
          <button class="action-btn" onclick="selectDefense('dodge')">Dodge</button>
          <button class="action-btn" onclick="selectDefense('block')">Block</button>
          <button class="action-btn" onclick="selectDefense('parry')">Parry</button>
          <button class="action-btn" onclick="selectDefense('nothing')">Nothing</button>
        <% else %>
          <button class="action-btn" onclick="selectAction('attack')">Attack</button>
          <button class="action-btn" onclick="selectAction('move')">Move</button>
          <button class="action-btn" onclick="selectAction('cast')">Cast</button>
          <button class="action-btn" onclick="selectAction('item')">Item</button>
          <button class="action-btn" onclick="selectAction('special')">Special</button>
          <button class="action-btn" onclick="selectAction('end_turn')">End Turn</button>
        <% end %>
      </div>
      <div class="action-context" id="action-context">
      </div>
    </div>
  <% end %>

  <script>
    var currentCharId = <%= current ? current.combat_id : 'null' %>;
    var currentCharName = '<%= current ? @combat.display_name(current) : '' %>';
    var equippedWeapons = <%= current ? JSON.generate(
      current.character.weapon_list.select { |w| w['equipped'] }.map { |w|
        {
          item_id: w['item_id'],
          name: w['name'],
          weapon_dice: current.character.weapon_dice(w),
          weapon_speed: current.character.weapon_speed(w),
          weapon_attack_bonus: current.character.weapon_attack_bonus(w),
          weapon_dmg: (d = current.character.weapon_dmg(w); d.is_a?(Numeric) ? d : 0),
          weapon_threshold: (t = current.character.weapon_threshold(w); t.is_a?(Numeric) ? t : 0),
          weapon_bonus: w['bonus'].to_i
        }
      }
    ) : '[]' %>;
    var diceRemaining = <%= current ? current.combat_pool : 0 %>;
    var moveSpeed = <%= current ? current.character.speed : 0 %>;
    var combatants = <%= JSON.generate(
      @combat.combat_turn_list.each_with_index.map { |ct, idx|
        {
          turn_id: idx, combat_id: ct.combat_id, char_id: ct.character.id,
          name: @combat.display_name(ct), dice_remaining: ct.combat_pool,
          bab_dice: ct.character.bab_dice, bab_bonus: ct.character.bab_bonus,
          damage_reduction: ct.character.damage_reduction,
          damage_resilience: ct.character.damage_resilience
        }
      }
    ) %>;
    var targetId = <%= @combat.target_id %>;
    var diceRules = <%= JSON.generate(Tools.load_json('rules.json')['dice']) %>;
    <% if (@combat.current_action == 'attack' || @combat.current_action == 'dodge') &&
          (actor = @combat.combat_turn_list[@combat.current_actor_turn_id]) &&
          (target = @combat.combat_turn_list[@combat.target_id]) &&
          (action_weapon = actor.character.weapon_list.find { |i| i['item_id'] == @combat.current_action_tool_id }) %>
    var attackContext = <%= JSON.generate({
      attacker_turn_id: @combat.current_actor_turn_id,
      attacker_combat_id: actor.combat_id,
      target_combat_id: target.combat_id,
      attack_dice: (@combat.action_params['attack_dice'] || 0),
      weapon: {
        name: action_weapon['name'],
        attack_bonus: actor.character.weapon_attack_bonus(action_weapon),
        dmg: (d = actor.character.weapon_dmg(action_weapon); d.is_a?(Numeric) ? d : 0),
        threshold: (t = actor.character.weapon_threshold(action_weapon); t.is_a?(Numeric) ? t : 0),
        bonus: action_weapon['bonus'].to_i
      }
    }) %>;
    <% else %>
    var attackContext = null;
    <% end %>

    function selectAction(action) {
      var context = document.getElementById('action-context');
      context.innerHTML = '';

      if (action === 'move') {
        if (diceRemaining < 4) {
          alert('Not enough dice remaining to move. Need 4, have ' + diceRemaining + '.');
          return;
        }
        var result = confirm(currentCharName + ' moves up to ' + moveSpeed + ' feet');
        if (!result) return;
        submitAction({id: currentCharId, combat_action: 'move'});
        return;
      }

      if (action === 'end_turn') {
        var result = confirm(currentCharName + ' ends turn?');
        if (!result) return;
        submitAction({id: currentCharId, combat_action: 'end_turn'});
        return;
      }

      if (action === 'attack') {
        // Target dropdown
        var label = document.createElement('label');
        label.textContent = 'Target: ';
        label.style.fontWeight = 'bold';
        var select = document.createElement('select');
        select.id = 'attack-target';
        var defaultOpt = document.createElement('option');
        defaultOpt.value = '';
        defaultOpt.textContent = 'Select Target';
        select.appendChild(defaultOpt);
        combatants.forEach(function(c) {
          var opt = document.createElement('option');
          opt.value = c.turn_id;
          opt.textContent = c.name;
          select.appendChild(opt);
        });
        context.appendChild(label);
        context.appendChild(select);

        // Weapon buttons container (hidden until target selected)
        var weaponDiv = document.createElement('div');
        weaponDiv.id = 'weapon-buttons';
        weaponDiv.style.marginTop = '10px';
        context.appendChild(weaponDiv);

        select.addEventListener('change', function() {
          weaponDiv.innerHTML = '';
          if (!this.value) return;
          equippedWeapons.forEach(function(weapon) {
            var btn = document.createElement('button');
            btn.className = 'weapon-btn';
            btn.textContent = weapon.name;
            btn.addEventListener('click', function() {
              promptAttackDice(weapon, parseInt(select.value, 10));
            });
            weaponDiv.appendChild(btn);
          });
        });
      }
    }

    function promptAttackDice(weapon, targetTurnId) {
      var target = combatants[targetTurnId];
      var minDice = 2;
      var maxDice = weapon.weapon_dice;
      var speed = weapon.weapon_speed;
      var available = diceRemaining - speed;
      if (available < minDice) {
        alert('Not enough dice remaining. Need at least ' + (minDice + speed) + ' dice (' + minDice + ' + ' + speed + ' speed).');
        return;
      }
      var capDice = Math.min(maxDice, available);

      var input = prompt(currentCharName + ' spends how many dice attacking ' + target.name + ' with ' + weapon.name + '? ' + minDice + '-' + capDice + ' (Speed ' + speed + ')');
      if (input === null) return;

      var dice = parseInt(input, 10);
      if (isNaN(dice) || dice < minDice || dice > capDice) {
        alert('Invalid. Enter a number between ' + minDice + ' and ' + capDice + '.');
        return;
      }

      submitAction({id: currentCharId, combat_action: 'attack', dice: dice, weapon_item_id: weapon.item_id, target_turn_id: targetTurnId});
    }

    function clampTn(tn) {
      return Math.max(diceRules.tn_minimum, Math.min(diceRules.tn_maximum, tn));
    }

    function calcDamageSplit(totalDamage, threshold) {
      var minor = Math.min(totalDamage, threshold);
      var moderate = Math.min(Math.max(totalDamage - threshold, 0), threshold);
      var major = Math.max(totalDamage - 2 * threshold, 0);
      return {minor: minor, moderate: moderate, major: major};
    }

    function showDamagePrompt(totalDamage, threshold, target, breakdown) {
      var split = calcDamageSplit(totalDamage, threshold);
      var msg = breakdown + '\n\n' +
        'Threshold: ' + threshold + ' (Resilience ' + target.damage_resilience + ' + Weapon TH ' + attackContext.weapon.threshold + ')\n' +
        'Minor: ' + split.minor + ' | Moderate: ' + split.moderate + ' | Major: ' + split.major + '\n\n' +
        'Total damage (editable):';
      return prompt(msg, totalDamage);
    }

    function selectDefense(defense) {
      var context = document.getElementById('action-context');
      context.innerHTML = '';
      if (!attackContext) return;

      var target = combatants[targetId];
      var baseTn = diceRules.base_target_number;
      var reqSuccesses = diceRules.default_required_successes;
      var weaponDmg = attackContext.weapon.dmg;
      var weaponBonus = attackContext.weapon.bonus;
      var threshold = target.damage_resilience + attackContext.weapon.threshold;

      if (defense === 'nothing') {
        // Flatfooted: TN reduced by 2
        var tn = clampTn(baseTn - attackContext.weapon.attack_bonus - 2);

        var input = prompt(currentCharName + ' attacks (TN ' + tn + ', ' + attackContext.attack_dice + ' dice, flatfooted -2)\nHow many successes?');
        if (input === null) return;
        var successes = parseInt(input, 10);
        if (isNaN(successes) || successes < 0) { alert('Invalid number.'); return; }

        if (successes < reqSuccesses) {
          alert('Miss! (' + successes + ' successes, need ' + reqSuccesses + ')');
          submitAction({combat_action: 'clear_action'});
          return;
        }

        var totalDamage = Math.max(0, weaponDmg + successes + weaponBonus - target.damage_reduction);
        var breakdown = 'Weapon Dmg: ' + weaponDmg + ' + Successes: ' + successes + ' + Bonus: ' + weaponBonus + ' - DR: ' + target.damage_reduction + ' = ' + totalDamage;

        var finalDamage = showDamagePrompt(totalDamage, threshold, target, breakdown);
        if (finalDamage === null) {
          submitAction({combat_action: 'clear_action'});
          return;
        }
        finalDamage = parseInt(finalDamage, 10);
        if (isNaN(finalDamage) || finalDamage < 0) { alert('Invalid number.'); return; }

        var split = calcDamageSplit(finalDamage, threshold);
        submitAction({
          combat_action: 'resolve_attack',
          target_combat_id: attackContext.target_combat_id,
          minor_damage: split.minor, moderate_damage: split.moderate, major_damage: split.major,
          dodge_dice: 0
        });
      }

      else if (defense === 'dodge') {
        // Attack TN: no flatfooted bonus
        var attackTn = clampTn(baseTn - attackContext.weapon.attack_bonus);

        var atkInput = prompt(currentCharName + ' attacks (TN ' + attackTn + ', ' + attackContext.attack_dice + ' dice)\nHow many successes?');
        if (atkInput === null) return;
        var attackSuccesses = parseInt(atkInput, 10);
        if (isNaN(attackSuccesses) || attackSuccesses < 0) { alert('Invalid number.'); return; }

        // Dodge TN: base - defender's bab_bonus + attacker's weapon_attack_bonus
        var dodgeTn = clampTn(baseTn - target.bab_bonus + attackContext.weapon.attack_bonus);

        var minDice = 2;
        var maxDice = Math.min(target.bab_dice, target.dice_remaining);
        if (maxDice < minDice) {
          alert(target.name + ' cannot dodge (need ' + minDice + ' dice, have ' + target.dice_remaining + ').');
          // Fall through as flatfooted
          var netSuccesses = attackSuccesses;
          if (netSuccesses < reqSuccesses) {
            alert('Miss! (' + netSuccesses + ' successes, need ' + reqSuccesses + ')');
            submitAction({combat_action: 'clear_action'});
            return;
          }
          var totalDamage = Math.max(0, weaponDmg + netSuccesses + weaponBonus - target.damage_reduction);
          var breakdown = 'Weapon Dmg: ' + weaponDmg + ' + Successes: ' + netSuccesses + ' + Bonus: ' + weaponBonus + ' - DR: ' + target.damage_reduction + ' = ' + totalDamage;
          var finalDamage = showDamagePrompt(totalDamage, threshold, target, breakdown);
          if (finalDamage === null) { submitAction({combat_action: 'clear_action'}); return; }
          finalDamage = parseInt(finalDamage, 10);
          if (isNaN(finalDamage) || finalDamage < 0) { alert('Invalid number.'); return; }
          var split = calcDamageSplit(finalDamage, threshold);
          submitAction({
            combat_action: 'resolve_attack',
            target_combat_id: attackContext.target_combat_id,
            minor_damage: split.minor, moderate_damage: split.moderate, major_damage: split.major,
            dodge_dice: 0
          });
          return;
        }

        var dodgeDiceInput = prompt(target.name + ' dodges (TN ' + dodgeTn + '). How many dice? ' + minDice + '-' + maxDice);
        if (dodgeDiceInput === null) return;
        var dodgeDice = parseInt(dodgeDiceInput, 10);
        if (isNaN(dodgeDice) || dodgeDice < minDice || dodgeDice > maxDice) {
          alert('Invalid. Enter a number between ' + minDice + ' and ' + maxDice + '.');
          return;
        }

        var dodgeInput = prompt(target.name + ' rolls ' + dodgeDice + ' dice (TN ' + dodgeTn + '). How many successes?');
        if (dodgeInput === null) return;
        var dodgeSuccesses = parseInt(dodgeInput, 10);
        if (isNaN(dodgeSuccesses) || dodgeSuccesses < 0) { alert('Invalid number.'); return; }

        var netSuccesses = attackSuccesses - dodgeSuccesses;

        if (netSuccesses < reqSuccesses) {
          alert('Attack dodged! (Attack: ' + attackSuccesses + ' - Dodge: ' + dodgeSuccesses + ' = ' + netSuccesses + ' net, need ' + reqSuccesses + ')');
          submitAction({
            combat_action: 'resolve_attack',
            target_combat_id: attackContext.target_combat_id,
            minor_damage: 0, moderate_damage: 0, major_damage: 0,
            dodge_dice: dodgeDice
          });
          return;
        }

        var totalDamage = Math.max(0, weaponDmg + netSuccesses + weaponBonus - target.damage_reduction);
        var breakdown = 'Attack: ' + attackSuccesses + ' - Dodge: ' + dodgeSuccesses + ' = ' + netSuccesses + ' net successes\n' +
          'Weapon Dmg: ' + weaponDmg + ' + Net Successes: ' + netSuccesses + ' + Bonus: ' + weaponBonus + ' - DR: ' + target.damage_reduction + ' = ' + totalDamage;

        var finalDamage = showDamagePrompt(totalDamage, threshold, target, breakdown);
        if (finalDamage === null) {
          // Cancel: still subtract dodge dice, no damage
          submitAction({
            combat_action: 'resolve_attack',
            target_combat_id: attackContext.target_combat_id,
            minor_damage: 0, moderate_damage: 0, major_damage: 0,
            dodge_dice: dodgeDice
          });
          return;
        }
        finalDamage = parseInt(finalDamage, 10);
        if (isNaN(finalDamage) || finalDamage < 0) { alert('Invalid number.'); return; }

        var split = calcDamageSplit(finalDamage, threshold);
        submitAction({
          combat_action: 'resolve_attack',
          target_combat_id: attackContext.target_combat_id,
          minor_damage: split.minor, moderate_damage: split.moderate, major_damage: split.major,
          dodge_dice: dodgeDice
        });
      }
    }

    function submitAction(fields) {
      var form = document.createElement('form');
      form.method = 'post';
      form.action = '/combat/action';
      form.style.display = 'none';
      for (var key in fields) {
        var el = document.createElement('input');
        el.type = 'hidden';
        el.name = key;
        el.value = fields[key];
        form.appendChild(el);
      }
      document.body.appendChild(form);
      form.submit();
    }
  </script>
  </div>
