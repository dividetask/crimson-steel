        '<br><label>Dice: <input type="number" id="' + diceId + '" min="' + minDice + '" max="' + maxDice + '" value="' + maxDice + '" style="width:50px;"></label>' +
        ' <button class="action-btn" style="margin-top:4px;" onclick="(function(){' +
        'var v=parseInt(document.getElementById(\'' + diceId + '\').value,10);' +
        'if(isNaN(v)||v<' + minDice + '||v>' + maxDice + '){alert(\'Enter ' + minDice + '-' + maxDice + '.\');return;}' +
        'vmCast.diceSpent=v;vmCasterRollStep();})()">Next</button>');
