    // --- Web: multi-target entangle + stuck with per-target DEX saves ---
    //   1. Pick dice. Caster rolls once.
    //   2. DM enters caster's total successes.
    //   3. For each target, DM enters save successes; net = caster - save.
    //      net >= 1 => Entangled; net >= 2 => Entangled + Stuck.
    //   4. Duration: caster_skill_ranks * 10 rounds (rank*10 per compendium).
    var webCast = null;

    function startWebCast(spellName, spellTier, targetIds) {
      var spellEntry = spellMetaFor(spellName);
      if (!spellEntry || !spellEntry.caster_skill) {
        alert('Caster has no eligible skill for ' + spellName);
        return;
      }
      if (!targetIds || targetIds.length === 0) {
        alert('Pick at least one target');
        return;
      }

      webCast = {
        spellName: spellName, spellTier: spellTier,
        targetIds: targetIds.slice(),
        casterSkill: spellEntry.caster_skill,
        casterSkillDice: spellEntry.caster_skill_dice,
        casterSkillBonus: spellEntry.caster_skill_bonus,
        casterSkillRanks: spellEntry.caster_skill_ranks,
        saveAttr: spellEntry.save_attr,
        diceSpent: 0, casterSuccesses: null,
        targetSaves: {} // target_combat_id -> save_successes
      };

      var maxDice = Math.min(webCast.casterSkillDice, diceRemaining);
      var minDice = 2;
      if (maxDice < minDice) {
        addStep('<strong>Cannot cast Web</strong> - need at least ' + minDice +
          ' dice (skill allows ' + webCast.casterSkillDice + ', pool has ' + diceRemaining + ')');
        return;
      }
      var diceId = 'web-dice-' + Date.now();
      var targetNames = targetIds.map(function(id) {
        var c = combatants.find(function(x) { return x.combat_id === id; });
        return c ? c.name : '?';
      }).join(', ');
      addStep('<strong>Web</strong> on ' + targetNames +
        '<br><span class="math-detail">Rolls off ' + webCast.casterSkill.replace('_', ' ') +
        ' (' + webCast.casterSkillDice + ' dice max). Dex save; net &ge;1 entangles, &ge;2 also sticks. ' +
        'Duration: ' + (webCast.casterSkillRanks * 10) + ' rounds.</span>' +
        '<br><label>Dice: <input type="number" id="' + diceId + '" min="' + minDice + '" max="' + maxDice + '" value="' + maxDice + '" style="width:50px;"></label>' +
        ' <button class="action-btn" style="margin-top:4px;" onclick="(function(){' +
        'var v=parseInt(document.getElementById(\'' + diceId + '\').value,10);' +
        'if(isNaN(v)||v<' + minDice + '||v>' + maxDice + '){alert(\'Enter ' + minDice + '-' + maxDice + '.\');return;}' +
        'webCast.diceSpent=v;webCasterRollStep();})()">Next</button>');
    }

    function webCasterRollStep() {
      var casterTn = clampTn(diceRules.base_target_number - webCast.casterSkillBonus);
      var tnMath = tnBreakdown('Caster TN', diceRules.base_target_number,
        [{value: -webCast.casterSkillBonus, label: webCast.casterSkill.replace('_', ' ') + ' bonus'}], casterTn);
      webCast.casterTn = casterTn;
      addStep('<strong>Caster Spell Check</strong>: ' + webCast.diceSpent + ' dice, TN ' + casterTn +
        '<br><span class="math-detail">' + tnMath + ' &nbsp;|&nbsp; compared individually against each target save.</span>' +
        '<br><label>Successes: <input type="number" id="web-caster-successes" min="0" value="0" style="width:50px;"></label>' +
        ' <button class="action-btn" onclick="webConfirmCasterSuccesses()">Confirm</button>' +
        ' <button class="action-btn" onclick="rollDicePool(' + webCast.diceSpent + ', ' + casterTn + ', \'web-caster-successes\', \'web-caster-roll-display\')">Roll</button>' +
        '<div id="web-caster-roll-display" class="math-detail" style="margin-top:4px;"></div>');
    }

    function webConfirmCasterSuccesses() {
      var input = document.getElementById('web-caster-successes');
      var val = parseInt(input.value, 10);
      if (isNaN(val) || val < 0) { alert('Invalid number.'); return; }
      webCast.casterSuccesses = val;
      input.disabled = true;
      input.parentElement.nextElementSibling.style.display = 'none';
      webShowAllSaves();
    }

    // All targets shown on one screen, grouped by unique (saveTn, saveDice)
    // so creatures with identical DEX saves share one roll. Each group has
    // a Roll button; a master "Roll All" button rolls every group at once.
    function webShowAllSaves() {
      var saveAttr = webCast.saveAttr;
      var baseTn = diceRules.base_target_number;
      var groups = {}; // key = "dice:tn" -> {dice, tn, targetIds[], inputId}
      var groupOrder = [];
      webCast.targetIds.forEach(function(tid) {
        var target = combatants.find(function(c) { return c.combat_id === tid; });
        if (!target) return;
        var saveDice = (target.save_dice && target.save_dice[saveAttr]) || 0;
        var saveBonus = (target.save_bonus && target.save_bonus[saveAttr]) || 0;
        var saveTn = clampTn(baseTn - saveBonus + webCast.spellTier + webCast.casterSkillBonus);
        var key = saveDice + ':' + saveTn;
        if (!groups[key]) {
          groups[key] = {
            dice: saveDice, tn: saveTn,
            targetIds: [], targetNames: [],
            inputId: 'web-group-success-' + groupOrder.length,
            rollsId: 'web-group-rolls-' + groupOrder.length
          };
          groupOrder.push(key);
        }
        groups[key].targetIds.push(tid);
        groups[key].targetNames.push(target.name);
      });

      webCast.saveGroups = groupOrder.map(function(k) { return groups[k]; });

      var rowsHtml = webCast.saveGroups.map(function(g) {
        var namesHtml = g.targetNames.join(', ');
        return '<div style="margin:6px 0;padding:4px 6px;border-left:3px solid #ddd;">' +
          '<strong>' + saveAttr.toUpperCase() + ' Save: ' + namesHtml + '</strong>' +
          ' <span class="math-detail">(' + g.dice + ' dice, TN ' + g.tn + ')</span>' +
          '<br><label>Successes: <input type="number" id="' + g.inputId + '" min="0" value="0" style="width:50px;"></label>' +
          ' <button class="action-btn" onclick="rollDicePool(' + g.dice + ', ' + g.tn + ', \'' + g.inputId + '\', \'' + g.rollsId + '\')">Roll</button>' +
          '<div id="' + g.rollsId + '" class="math-detail" style="margin-top:4px;"></div>' +
          '</div>';
      }).join('');

      addStep('<strong>Target Saves</strong> <span class="math-detail">(' +
        webCast.saveGroups.length + (webCast.saveGroups.length === 1 ? ' unique TN' : ' unique TNs') +
        ', targets sharing a TN roll as a group)</span>' +
        rowsHtml +
        '<button class="action-btn" onclick="webRollAllSaves()">Roll All Saves</button>' +
        ' <button class="action-btn" onclick="webConfirmAllSaves()">Next</button>');
    }

    function webRollAllSaves() {
      (webCast.saveGroups || []).forEach(function(g) {
        rollDicePool(g.dice, g.tn, g.inputId, g.rollsId);
      });
    }

    function webConfirmAllSaves() {
      var groups = webCast.saveGroups || [];
      for (var i = 0; i < groups.length; i++) {
        var g = groups[i];
        var val = parseInt(document.getElementById(g.inputId).value, 10);
        if (isNaN(val) || val < 0) { alert('Enter a valid success count for each group.'); return; }
        g.successes = val;
        g.targetIds.forEach(function(tid) { webCast.targetSaves[tid] = val; });
      }
      webShowResult();
    }

    function webShowResult() {
      var rows = [];
      // Build payload: "tid:save_successes:outcome" joined by ';'
      // outcome ∈ {'free','entangled','stuck'} so server knows what to apply.
      var payloadParts = [];
      webCast.targetIds.forEach(function(tid) {
        var save = webCast.targetSaves[tid] || 0;
        var net = webCast.casterSuccesses - save;
        var target = combatants.find(function(c) { return c.combat_id === tid; });
        var name = target ? target.name : '?';
        var outcome = 'free';
        if (net >= 2) outcome = 'stuck';
        else if (net >= 1) outcome = 'entangled';
        var label;
        if (outcome === 'stuck')
          label = '<strong style="color:#ad1457;">' + name + ': Entangled + Stuck</strong> (' + webCast.casterSuccesses + ' - ' + save + ' = ' + net + ' net)';
        else if (outcome === 'entangled')
          label = '<strong style="color:#6a1b9a;">' + name + ': Entangled</strong> (' + webCast.casterSuccesses + ' - ' + save + ' = ' + net + ' net)';
        else
          label = name + ': clean save (' + webCast.casterSuccesses + ' - ' + save + ' = ' + net + ' net)';
        rows.push(label);
        payloadParts.push(tid + ':' + save + ':' + outcome);
      });
      var manaCost = spellManaCost(webCast.spellTier);
      var fields =
        'id: currentCharId, combat_action: \'cast\', spell_name: \'Web\', spell_tier: ' + webCast.spellTier +
        ', target_combat_ids: \'' + webCast.targetIds.join(',') + '\'' +
        ', dice_spent: ' + webCast.diceSpent +
        ', web_caster_successes: ' + webCast.casterSuccesses +
        ', web_duration_rounds: ' + (webCast.casterSkillRanks * 10) +
        ', web_caster_skill_bonus: ' + webCast.casterSkillBonus +
        ', web_results: \'' + payloadParts.join(';') + '\'' +
        scrollFields();
      addStep(rows.join('<br>') +
        '<br><span class="math-detail">Cost: ' + costLabel(manaCost) + ' + ' + webCast.diceSpent + ' dice</span>' +
        '<br><button class="action-btn" onclick="submitAction({' + fields + '})" style="margin-top:8px;">Submit</button>');
    }

    // --- Escape (break Entangled / Stuck) ---
    //   Strength save with TN penalty equal to the caster's skill bonus
    //   plus spell tier (recorded on the effect when Web was cast). Two
    //   or more successes frees the target from both conditions.
    function showEscapeSelection() {
      var me = combatants.find(function(c) { return c.combat_id === currentCharId; });
      if (!me) return;
      var binds = activeEffects
        .map(function(e, i) { return {effect: e, idx: i}; })
        .filter(function(p) {
          if (!p.effect) return false;
          if (['Entangled', 'Stuck'].indexOf(p.effect.spell_name) === -1) return false;
          return (p.effect.target_combat_ids || []).indexOf(currentCharId) !== -1;
        });
      if (binds.length === 0) {
        addStep('<strong>Nothing to escape from</strong>');
        return;
      }
      // Collect the most punitive penalty across current binds (usually
      // the same spell, but if stacked from different casts, use the worst).
      var worst = binds.reduce(function(acc, p) {
        var tier = (p.effect.spell_tier || 0) | 0;
        var bonus = (p.effect.caster_skill_bonus || 0) | 0;
        var penalty = tier + bonus;
        if (acc == null || penalty > acc.penalty) {
          return {penalty: penalty, tier: tier, skillBonus: bonus, labels: [p.effect.spell_name]};
        }
        if (penalty === acc.penalty && acc.labels.indexOf(p.effect.spell_name) === -1) {
          acc.labels.push(p.effect.spell_name);
        }
        return acc;
      }, null);

      var strDice = (me.save_dice && me.save_dice.str) || 0;
      var strBonus = (me.save_bonus && me.save_bonus.str) || 0;
      var baseTn = diceRules.base_target_number;
      var escapeTn = clampTn(baseTn - strBonus + worst.penalty);
      var tnMath = tnBreakdown('Escape TN', baseTn, [
        {value: -strBonus, label: 'STR save bonus'},
        {value: worst.tier, label: 'spell tier penalty'},
        {value: worst.skillBonus, label: 'caster skill penalty'}
      ], escapeTn);

      var effectIndices = binds.map(function(p) { return p.idx; });
      addStep('<strong>Escape: Strength Check</strong>' +
        '<br><span class="math-detail">Bound by: ' + worst.labels.join(', ') + '. ' +
        'Roll ' + strDice + ' STR dice at TN ' + escapeTn + '. 2+ successes frees all binds.</span>' +
        '<br><span class="math-detail">' + tnMath + '</span>' +
        '<br><label>Successes: <input type="number" id="escape-successes" min="0" value="0" style="width:50px;"></label>' +
        ' <button class="action-btn" onclick="confirmEscape(\'' + effectIndices.join(',') + '\')">Confirm</button>');
    }

    function confirmEscape(indicesCsv) {
      var input = document.getElementById('escape-successes');
      var val = parseInt(input.value, 10);
      if (isNaN(val) || val < 0) { alert('Invalid number.'); return; }
      var free = val >= 2;
      var summary = free ?
        '<strong>Escaped!</strong> ' + val + ' successes &ge; 2 &mdash; binds removed.' :
        '<strong>Still bound.</strong> ' + val + ' successes (need 2).';
      addStep(summary +
        '<br><button class="action-btn" onclick="submitAction({' +
          'id: currentCharId, combat_action: \'escape\'' +
          ', successes: ' + val +
          ', effect_indices: \'' + indicesCsv + '\'' +
        '})" style="margin-top:8px;">Submit</button>');
    }

    // --- ITEM: Consumable selection ---
    function showItemSelection() {
      if (!itemList || itemList.length === 0) {
        addStep('<strong>No usable items</strong>');
        return;
      }
      var html = '<strong>Use Item</strong>';
      itemList.forEach(function(item) {
        var mode = item.target_mode || 'single';
        var marker = mode === 'multi' ? ' *' : (mode === 'none' ? ' \u25CB' : '');
        var label = item.name + ' (tier ' + item.item_tier + ', x' + item.quantity + ')' + marker;
        html += '<br><button class="action-btn" style="margin:2px;" onclick="selectItemTarget(' + item.item_id + ', \'' +
          item.name.replace(/'/g, "\\'") + '\', ' + item.item_tier + ', \'' + item.type + '\', \'' + item.kind + '\', \'' +
          mode + '\')">' + label + '</button>';
      });
      html += '<br><span class="math-detail">* = multi-target &nbsp; \u25CB = no target</span>';
      addStep(html);
    }

    // Active scroll (set when routing a scroll through a spell cast flow).
    // The specialised cast functions read activeScrollSpellMeta in place of
    // the current character's spellList entry — scrolls can be cast by
    // characters who don't know the spell — and the submit payload adds
    // from_scroll + scroll_item_id so the server skips mana and consumes
    // the scroll charge instead.
    var activeScroll = null;
    var activeScrollSpellMeta = null;

    function clearActiveScroll() { activeScroll = null; activeScrollSpellMeta = null; }

    // Extra hidden fields appended to a specialised cast's submit payload
    // when that cast was routed through a scroll. The server uses these
    // to skip mana cost and consume the scroll charge.
    function scrollFields() {
      if (!activeScroll) return '';
      return ', from_scroll: \'true\', scroll_item_id: ' + activeScroll.itemId;
    }

    // "N mana" normally, "scroll: <name>" when casting from a scroll.
    function costLabel(manaCost) {
      if (activeScroll) return 'scroll: ' + activeScroll.itemName;
      return manaCost + ' mana';
    }

    // If a scroll's underlying spell has a specialised cast flow (Web,
    // Blindness/Deafness, Vicious Mockery, Biting Words, ranged attack
    // spells), route through that flow. Returns true when handled.
    function routeScrollToCastFlow(item) {
      if (item.kind !== 'scroll' || !item.base_name) return false;
      var base = item.base_name;
      var tier = (item.spell_tier != null) ? item.spell_tier : item.item_tier;
      activeScroll = { itemId: item.item_id, itemName: item.name };
      activeScrollSpellMeta = item;
      if (base === 'Web') {
        pickScrollMultiTargets(base, tier);
      } else if (base === 'Blindness/Deafness' || base === 'Vicious Mockery' || base === 'Biting Words') {
        pickScrollSingleTarget(base, tier);
      } else if (item.ranged_attack) {
        pickScrollSingleTarget(base, tier);
      } else {
        clearActiveScroll();
        return false;
      }
      return true;
    }

    function pickScrollSingleTarget(spellName, spellTier) {
      var selectId = 'scroll-target-' + Date.now();
      var optionsHtml = combatants.map(function(c) {
        return '<option value="' + c.combat_id + '">' + c.name + '</option>';
      }).join('');
      addStep('<strong>Scroll: ' + spellName + ' - Target</strong>' +
        '<br><select id="' + selectId + '" style="margin-top:4px;">' +
        '<option value="">-- select target --</option>' + optionsHtml + '</select>' +
        '<br><button class="action-btn" style="margin-top:8px;" onclick="scrollSingleTargetPicked(\'' +
          selectId + '\', \'' + spellName.replace(/'/g, "\\'") + '\', ' + spellTier + ')">Next</button>');
    }

    function scrollSingleTargetPicked(selectId, spellName, spellTier) {
      var v = document.getElementById(selectId).value;
      if (!v) { alert('Pick a target'); return; }
      var ids = [parseInt(v, 10)];
      dispatchScrollCast(spellName, spellTier, ids);
    }

    function pickScrollMultiTargets(spellName, spellTier) {
      var selectId = 'scroll-multi-' + Date.now();
      var checkboxesHtml = combatants.map(function(c) {
        return '<label style="display:block;margin:2px 0;">' +
          '<input type="checkbox" class="' + selectId + '-cb" value="' + c.combat_id + '"> ' + c.name + '</label>';
      }).join('');
      addStep('<strong>Scroll: ' + spellName + ' - Targets</strong>' +
        '<br><span class="math-detail">Pick one or more.</span>' +
        '<div style="margin-top:4px;">' + checkboxesHtml + '</div>' +
        '<button class="action-btn" style="margin-top:8px;" onclick="scrollMultiTargetsPicked(\'' +
          selectId + '\', \'' + spellName.replace(/'/g, "\\'") + '\', ' + spellTier + ')">Next</button>');
    }

    function scrollMultiTargetsPicked(selectId, spellName, spellTier) {
      var boxes = document.getElementsByClassName(selectId + '-cb');
      var ids = [];
      for (var i = 0; i < boxes.length; i++) if (boxes[i].checked) ids.push(parseInt(boxes[i].value, 10));
      if (ids.length === 0) { alert('Pick at least one target'); return; }
      dispatchScrollCast(spellName, spellTier, ids);
    }

    function dispatchScrollCast(spellName, spellTier, ids) {
      if (spellName === 'Web') { startWebCast(spellName, spellTier, ids); return; }
      if (spellName === 'Blindness/Deafness') { startBlindnessDeafnessCast(spellName, spellTier, ids); return; }
      if (spellName === 'Vicious Mockery') { startViciousMockeryCast(spellName, spellTier, ids); return; }
      if (spellName === 'Biting Words') { startBitingWordsCast(spellName, spellTier, ids); return; }
      if (activeScrollSpellMeta && activeScrollSpellMeta.ranged_attack) {
        startRangedAttackSpellCast(spellName, spellTier, ids, false, -1);
        return;
      }
    }

    // Returns the spell-skill metadata the current cast should use. When
    // casting from a scroll the user may not know the spell, so we fall
    // back to the metadata stored on the scroll itemList entry.
    function spellMetaFor(name) {
      if (activeScrollSpellMeta) return activeScrollSpellMeta;
      return spellList.find(function(s) { return s.name === name; });
    }

    function selectItemTarget(itemId, itemName, itemTier, itemType, itemKind, targetMode) {
      var item = itemList.find(function(i) { return i.item_id === itemId; });
      if (item && routeScrollToCastFlow(item)) return;
      if (targetMode === 'none') {
        confirmItemUse(itemId, itemName, itemTier, itemType, itemKind, [], 'none');
        return;
      }
      var selectId = 'item-target-' + Date.now();
      if (targetMode === 'multi') {
        var checkboxesHtml = combatants.map(function(c) {
          return '<label style="display:block;margin:2px 0;">' +
            '<input type="checkbox" class="' + selectId + '-cb" value="' + c.combat_id + '"> ' + c.name + '</label>';
        }).join('');
        addStep('<strong>Select Targets for ' + itemName + '</strong>' +
          '<br><span class="math-detail">Pick one or more.</span>' +
          '<div style="margin-top:4px;">' + checkboxesHtml + '</div>' +
          '<button class="action-btn" style="margin-top:8px;" onclick="(function(){' +
          'var boxes=document.getElementsByClassName(\'' + selectId + '-cb\');' +
          'var ids=[];for(var i=0;i<boxes.length;i++){if(boxes[i].checked)ids.push(parseInt(boxes[i].value,10));}' +
          'if(ids.length===0){alert(\'Pick at least one target\');return;}' +
          'confirmItemUse(' + itemId + ', \'' + itemName.replace(/'/g, "\\'") + '\', ' + itemTier + ', \'' + itemType + '\', \'' + itemKind + '\', ids, \'multi\');})()">Next</button>');
      } else {
        var optionsHtml = combatants.map(function(c) {
          var sel = c.combat_id === currentCharId ? ' selected' : '';
          return '<option value="' + c.combat_id + '"' + sel + '>' + c.name + '</option>';
        }).join('');
        addStep('<strong>Select Target for ' + itemName + '</strong>' +
          '<br><span class="math-detail">Default target is self.</span>' +
          '<br><select id="' + selectId + '" style="margin-top:4px;">' + optionsHtml + '</select>' +
          '<br><button class="action-btn" style="margin-top:8px;" onclick="(function(){' +
          'var v=document.getElementById(\'' + selectId + '\').value;' +
          'if(!v){alert(\'Pick a target\');return;}' +
          'confirmItemUse(' + itemId + ', \'' + itemName.replace(/'/g, "\\'") + '\', ' + itemTier + ', \'' + itemType + '\', \'' + itemKind + '\', [parseInt(v,10)], \'single\');})()">Next</button>');
      }
    }

    function confirmItemUse(itemId, itemName, itemTier, itemType, itemKind, targetIds, targetMode) {
      var targetNames = [];
      for (var t = 0; t < targetIds.length; t++) {
        for (var i = 0; i < combatants.length; i++) {
          if (combatants[i].combat_id === targetIds[t]) { targetNames.push(combatants[i].name); break; }
        }
      }
      var kindLabel = itemKind.charAt(0).toUpperCase() + itemKind.slice(1);
      var targetLabel;
      if (targetMode === 'none') {
        targetLabel = '';
      } else if (targetMode === 'multi') {
        targetLabel = ' | Targets: ' + targetNames.join(', ');
      } else {
        targetLabel = ' | Target: ' + targetNames.join(', ');
      }
      var fields = 'id: currentCharId, combat_action: \'item\', item_id: ' + itemId;
      if (targetMode === 'multi') {
        fields += ', target_combat_ids: \'' + targetIds.join(',') + '\'';
      } else if (targetMode === 'single') {
        fields += ', target_combat_id: ' + targetIds[0];
      }
      addStep('<strong>Using: ' + itemName + '</strong>' +
        '<br><span class="math-detail">Tier ' + itemTier + ' | ' + kindLabel + ' | Effect: ' + itemType + targetLabel + '</span>' +
        '<br><button class="action-btn" onclick="submitAction({' + fields + '})" style="margin-top:8px;">Confirm Use</button>');
    }

    // --- CONCENTRATE: reuse active concentration effects without mana ---
    function showConcentrateSelection() {
      var myEffects = [];
      activeEffects.forEach(function(effect, idx) {
        if (effect.caster_id !== currentCharId) return;
        myEffects.push({effect: effect, idx: idx});
      });

      if (myEffects.length === 0) {
        addStep('<strong>No active concentration effects</strong>');
        return;
      }

      var html = '<strong>Concentrate</strong> (no mana cost)';
      myEffects.forEach(function(entry) {
        var effect = entry.effect;
        var tgtNames = (effect.target_names || []).join(', ');
        var tgtLabel = tgtNames ? ' \u2192 ' + tgtNames : '';
        html += '<br><button class="action-btn" style="margin:2px;" onclick="showConcentrateActions(' +
          entry.idx + ')">' + effect.spell_name + tgtLabel + '</button>';
      });
      addStep(html);
    }

    function showConcentrateActions(effectIndex) {
      var effect = activeEffects[effectIndex];
      if (!effect) return;
      var name = effect.spell_name;

      if (name === 'Spiritual Weapon') {
        var tgtNames = (effect.target_names || []).join(', ');
        var dice = effect.dice_spent || 0;
        var html = '<strong>Spiritual Weapon</strong>' +
          '<br><span class="math-detail">Current target: ' + (tgtNames || '(none)') +
          ' | Dice: ' + dice + '</span>' +
          '<br><button class="action-btn" style="margin:2px;" onclick="startSpiritualWeaponAttack(' + effectIndex + ')">Attack</button>' +
          '<button class="action-btn" style="margin:2px;" onclick="selectConcentrateNewTarget(' + effectIndex + ')">Change Target (4 dice)</button>';
        addStep(html);
        return;
      }

      if (name === 'Shield of Faith') {
        var tgtNames = (effect.target_names || []).join(', ');
        addStep('<strong>Shield of Faith</strong>' +
          '<br><span class="math-detail">Current ally: ' + (tgtNames || '(none)') + '</span>' +
          '<br><button class="action-btn" style="margin:2px;" onclick="selectConcentrateNewTarget(' + effectIndex + ')">Move to Ally (4 dice)</button>');
        return;
      }

      // Ranged attack spells (Acid Splash / Sacred Flame / Fire Bolt):
      // each concentrate use re-runs the ranged attack flow against a
      // target the caster picks, spending dice from the combat pool
      // without paying additional mana.
      var spellEntry = spellList.find(function(s) { return s.name === effect.spell_name; });
      if (spellEntry && spellEntry.ranged_attack) {
        var tgtNames = (effect.target_names || []).join(', ');
        addStep('<strong>' + effect.spell_name + '</strong>' +
          '<br><span class="math-detail">Last target: ' + (tgtNames || '(none)') + '</span>' +
          '<br><button class="action-btn" style="margin:2px;" onclick="pickRangedSpellTarget(' + effectIndex + ')">Ranged Attack</button>');
        return;
      }

      // Generic concentration spell: continue focus. No mana cost; targets
      // can optionally be re-picked (useful for mobile/multi-target spells).
      var mode = 'single';
      if (spellEntry) mode = spellEntry.target_mode || 'single';
      selectConcentrateReapplyTarget(effectIndex, mode);
    }

    function pickRangedSpellTarget(effectIndex) {
      var effect = activeEffects[effectIndex];
      var selectId = 'rs-target-' + Date.now();
      var lastTarget = (effect.target_combat_ids || [])[0];
      var optionsHtml = combatants.map(function(c) {
        var sel = c.combat_id === lastTarget ? ' selected' : '';
        return '<option value="' + c.combat_id + '"' + sel + '>' + c.name + '</option>';
      }).join('');
      addStep('<strong>' + effect.spell_name + ' - Target</strong>' +
        '<br><select id="' + selectId + '" style="margin-top:4px;">' + optionsHtml + '</select>' +
        '<br><button class="action-btn" style="margin-top:8px;" onclick="(function(){' +
        'var v=document.getElementById(\'' + selectId + '\').value;' +
        'if(!v){alert(\'Pick a target\');return;}' +
        'startRangedAttackSpellCast(\'' + effect.spell_name.replace(/'/g, "\\'") + '\', ' +
          (effect.spell_tier || 0) + ', [parseInt(v,10)], true, ' + effectIndex + ');})()">Next</button>');
    }

    function selectConcentrateNewTarget(effectIndex) {
      var effect = activeEffects[effectIndex];
      var selectId = 'conc-new-target-' + Date.now();
      var optionsHtml = combatants.map(function(c) {
        return '<option value="' + c.combat_id + '">' + c.name + '</option>';
      }).join('');
      addStep('<strong>' + effect.spell_name + ' - New Target</strong>' +
        '<br><span class="math-detail">Costs 4 action dice.</span>' +
        '<br><select id="' + selectId + '" style="margin-top:4px;">' +
        '<option value="">-- select target --</option>' + optionsHtml + '</select>' +
        '<br><button class="action-btn" style="margin-top:8px;" onclick="(function(){' +
        'var v=document.getElementById(\'' + selectId + '\').value;' +
        'if(!v){alert(\'Pick a target\');return;}' +
        'submitAction({id: currentCharId, combat_action: \'concentrate\', effect_index: ' + effectIndex +
        ', sub_action: \'change_target\', target_combat_id: parseInt(v,10)});})()">Confirm</button>');
    }

    function selectConcentrateReapplyTarget(effectIndex, targetMode) {
      var effect = activeEffects[effectIndex];
      if (targetMode === 'none') {
        confirmConcentrateReapply(effectIndex, [], 'none');
        return;
      }
      var selectId = 'conc-reapply-target-' + Date.now();
      if (targetMode === 'multi') {
        var checkboxesHtml = combatants.map(function(c) {
          var checked = (effect.target_combat_ids || []).indexOf(c.combat_id) !== -1 ? ' checked' : '';
          return '<label style="display:block;margin:2px 0;">' +
            '<input type="checkbox" class="' + selectId + '-cb" value="' + c.combat_id + '"' + checked + '> ' + c.name + '</label>';
        }).join('');
        addStep('<strong>' + effect.spell_name + ' - Targets</strong>' +
          '<br><span class="math-detail">No mana cost.</span>' +
          '<div style="margin-top:4px;">' + checkboxesHtml + '</div>' +
          '<button class="action-btn" style="margin-top:8px;" onclick="(function(){' +
          'var boxes=document.getElementsByClassName(\'' + selectId + '-cb\');' +
          'var ids=[];for(var i=0;i<boxes.length;i++){if(boxes[i].checked)ids.push(parseInt(boxes[i].value,10));}' +
          'if(ids.length===0){alert(\'Pick at least one target\');return;}' +
          'confirmConcentrateReapply(' + effectIndex + ', ids, \'multi\');})()">Confirm</button>');
      } else {
        var currentId = (effect.target_combat_ids || [])[0];
        var optionsHtml = combatants.map(function(c) {
          var sel = c.combat_id === currentId ? ' selected' : '';
          return '<option value="' + c.combat_id + '"' + sel + '>' + c.name + '</option>';
        }).join('');
        addStep('<strong>' + effect.spell_name + ' - Target</strong>' +
          '<br><span class="math-detail">No mana cost.</span>' +
          '<br><select id="' + selectId + '" style="margin-top:4px;">' +
          '<option value="">-- select target --</option>' + optionsHtml + '</select>' +
          '<br><button class="action-btn" style="margin-top:8px;" onclick="(function(){' +
          'var v=document.getElementById(\'' + selectId + '\').value;' +
          'if(!v){alert(\'Pick a target\');return;}' +
          'confirmConcentrateReapply(' + effectIndex + ', [parseInt(v,10)], \'single\');})()">Confirm</button>');
      }
    }

    function confirmConcentrateReapply(effectIndex, targetIds, targetMode) {
      var effect = activeEffects[effectIndex];
      var fields = 'id: currentCharId, combat_action: \'concentrate\', effect_index: ' + effectIndex +
        ', sub_action: \'reapply\'';
      if (targetMode === 'multi') {
        fields += ', target_combat_ids: \'' + targetIds.join(',') + '\'';
      } else if (targetMode === 'single') {
        fields += ', target_combat_id: ' + targetIds[0];
      }
      var tgtNames = [];
      targetIds.forEach(function(id) {
        for (var i = 0; i < combatants.length; i++) {
          if (combatants[i].combat_id === id) { tgtNames.push(combatants[i].name); break; }
        }
      });
      var targetLabel = targetMode === 'none' ? '' :
        (targetMode === 'multi' ? ' | Targets: ' : ' | Target: ') + tgtNames.join(', ');
      addStep('<strong>Concentrate: ' + effect.spell_name + '</strong>' +
        '<br><span class="math-detail">No mana cost' + targetLabel + '</span>' +
        '<br><button class="action-btn" onclick="submitAction({' + fields + '})" style="margin-top:8px;">Confirm</button>');
    }

    function startSpiritualWeaponAttack(effectIndex) {
      var effect = activeEffects[effectIndex];
      var dice = effect.dice_spent || 0;
      var tier = effect.spell_tier || 0;
      var currentTargetId = (effect.target_combat_ids || [])[0];
      var me = combatants.find(function(c) { return c.combat_id === currentCharId; });
      var healingBonus = me ? me.healing_bonus : 0;
      // Spiritual Weapon has a magical enhancement bonus equal to the
      // spell's tier, which adds to both the attack bonus and damage.
      var attackBonus = healingBonus + tier;

      var selectId = 'sw-target-' + Date.now();
      var optionsHtml = combatants.map(function(c) {
        var sel = c.combat_id === currentTargetId ? ' selected' : '';
        return '<option value="' + c.combat_id + '"' + sel + '>' + c.name + '</option>';
      }).join('');
      addStep('<strong>Spiritual Weapon Attack</strong>' +
        '<br><span class="math-detail">Rolls ' + dice + ' dice, attack bonus ' +
        (attackBonus >= 0 ? '+' : '') + attackBonus + ' (healing ' +
        (healingBonus >= 0 ? '+' : '') + healingBonus + ' + enhancement +' + tier +
        '). No action dice or mana cost.</span>' +
        '<br><select id="' + selectId + '" style="margin-top:4px;">' + optionsHtml + '</select>' +
        '<br><button class="action-btn" style="margin-top:8px;" onclick="(function(){' +
        'var v=document.getElementById(\'' + selectId + '\').value;' +
        'if(!v){alert(\'Pick a target\');return;}' +
        'beginSpiritualWeaponAttack(' + effectIndex + ', parseInt(v,10));})()">Next</button>');
    }

    function beginSpiritualWeaponAttack(effectIndex, targetCombatId) {
      var effect = activeEffects[effectIndex];
      var dice = effect.dice_spent || 0;
      var tier = effect.spell_tier || 0;
      var me = combatants.find(function(c) { return c.combat_id === currentCharId; });
      var healingBonus = me ? me.healing_bonus : 0;
      var target = combatants.find(function(c) { return c.combat_id === targetCombatId; });
      if (!target) { alert('Target missing'); return; }

      // Build a pseudo-weapon for the Spiritual Weapon so the existing
      // defense / ally / damage flow can be reused verbatim. Attack bonus
      // comes from the Healing skill; the spell grants a magical
      // enhancement bonus equal to its tier that adds to both attack and
      // damage (matching the +enhancement semantics on real weapons).
      var swWeapon = {
        item_id: 0,
        name: 'Spiritual Weapon',
        weapon_dice: dice,
        weapon_speed: 0,
        weapon_attack_bonus: healingBonus + tier,
        weapon_dmg: 0,
        weapon_threshold: 0,
        weapon_bonus: tier
      };

      attackState = {
        weapon: swWeapon,
        targetTurnId: null,
        target: target,
        attackerCombatId: currentCharId,
        targetCombatId: targetCombatId,
        attackDiceSpeed: 0,
        attackDice: dice,
        attackerDiceSpent: 0,
        concentrateEffectIndex: effectIndex,
        isSpiritualWeapon: true
      };

      showDefenseSelection();
    }

    // --- ATTACK STEP 2: Choose attack dice ---
    function showAttackDice(weapon, targetTurnId) {
      var target = combatants[targetTurnId];
      var speed = weapon.weapon_speed;
      var available = diceRemaining - speed;
      var minDice = 2;
      var capDice = Math.min(weapon.weapon_dice, available);

      if (available < minDice) {
        addStep('<strong>Cannot attack</strong> - need at least ' + (minDice + speed) + ' dice (' + minDice + ' + ' + speed + ' speed), have ' + diceRemaining);
        return;
      }

      // Lock in target selection
      document.getElementById('attack-target').disabled = true;
      var btns = document.getElementById('weapon-buttons');
      if (btns) btns.innerHTML = '<em>Weapon: ' + weapon.name + '</em>';

      attackState = {
        weapon: weapon,
        targetTurnId: targetTurnId,
        target: target,
        attackerCombatId: currentCharId,
        targetCombatId: target.combat_id,
        attackDiceSpeed: speed
      };

      addStep('<strong>Attack Dice</strong>: ' + currentCharName + ' attacks ' + target.name + ' with ' + weapon.name +
        '<br><span class="math-detail">Dice range: ' + minDice + '-' + capDice + ' | Weapon speed: ' + speed + ' (total cost: dice + ' + speed + ')</span>' +
        '<br><label>Attack dice: <input type="number" id="attack-dice-input" min="' + minDice + '" max="' + capDice + '" value="' + capDice + '" style="width:50px;"></label>' +
        ' <button class="action-btn" onclick="confirmAttackDice(' + minDice + ',' + capDice + ')">Confirm</button>');
    }

    function confirmAttackDice(minDice, capDice) {
      var input = document.getElementById('attack-dice-input');
      var val = parseInt(input.value, 10);
      if (isNaN(val) || val < minDice || val > capDice) {
        alert('Enter ' + minDice + '-' + capDice + '.'); return;
      }
      attackState.attackDice = val;
      attackState.attackerDiceSpent = val + attackState.attackDiceSpeed;
      input.disabled = true;
      input.parentElement.nextElementSibling.style.display = 'none';
      showDefenseSelection();
    }

    // --- ATTACK STEP 3: Select defense ---
    function showDefenseSelection() {
      var target = attackState.target;

      // Incapacitated targets can't spend dice or mana to defend; the DM
      // has only one option -- Nothing (flatfooted). No reactive abilities
      // either. Allies can still Shield of Faith / Healing Word in the
      // next step.
      if (target.incapacitated) {
        addStep('<strong>Select Defense for ' + target.name + '</strong>' +
          ' <span class="math-detail">(incapacitated -- no defensive actions)</span>' +
          '<br><button class="action-btn" onclick="selectDefense(\'nothing\')">Nothing</button>');
        return;
      }

      var targetWeapons = target.weapons || [];
      var targetShields = target.shields || [];
      var weaponOptions = targetWeapons.map(function(w) {
        return '<option value="w-' + w.item_id + '">' + w.name +
          ' (Atk/Def ' + (w.weapon_attack_bonus >= 0 ? '+' : '') + w.weapon_attack_bonus + ', Spd ' + w.weapon_speed + ')</option>';
      }).join('');
      var shieldOptions = targetShields.map(function(s) {
        return '<option value="s-' + s.item_id + '">' + s.name +
          ' (Def ' + (s.shield_attack_bonus >= 0 ? '+' : '') + s.shield_attack_bonus + ', Spd ' + s.shield_speed + ')</option>';
      }).join('');

      var abilities = target.abilities || [];
      var abilityBtns = '';
      if (abilities.indexOf('better_lucky_than_good') !== -1 && target.mana >= 4) {
        abilityBtns += ' <button class="action-btn" onclick="selectDefense(\'better_lucky_than_good\')">Better Lucky Than Good</button>';
      }

      var hasEquipment = targetWeapons.length > 0 || targetShields.length > 0;
      var blockBtn = targetShields.length > 0 ? ' <button class="action-btn" onclick="selectDefense(\'block\')">Block</button>' : '';

      addStep('<strong>Select Defense for ' + target.name + '</strong>' +
        '<br><button class="action-btn" onclick="selectDefense(\'nothing\')">Nothing</button>' +
        ' <button class="action-btn" onclick="selectDefense(\'dodge\')">Dodge</button>' +
        ' <button class="action-btn" onclick="selectDefense(\'parry\')">Parry</button>' +
        blockBtn +
        abilityBtns +
        (hasEquipment ?
          '<br><label style="margin-top:6px;display:inline-block;font-size:11px;font-weight:bold;">Parry/Block with: ' +
          '<select id="defense-weapon" style="font-size:11px;padding:2px;"><option value="">-- select --</option>' +
          weaponOptions + shieldOptions + '</select></label>' : ''));
    }

    // --- Utility functions ---
    function addStep(html) {
      var context = document.getElementById('action-context');
      var step = document.createElement('div');
      step.className = 'resolve-step';
      step.innerHTML = html;
      context.appendChild(step);
      step.scrollIntoView({behavior: 'smooth', block: 'nearest'});
      return step;
    }

    function clampTn(tn) {
      return Math.max(diceRules.tn_minimum, Math.min(diceRules.tn_maximum, tn));
    }

    function calcDamageSplit(totalDamage, threshold) {
      var minor = Math.min(totalDamage, threshold);
      var moderate = Math.min(Math.max(totalDamage - threshold, 0), threshold);
      var major = Math.max(totalDamage - 2 * threshold, 0);
      return {minor: minor, moderate: moderate, major: major};
    }

    function tnBreakdown(label, base, modifiers, clamped) {
      var parts = label + ': ' + base + ' (base)';
      modifiers.forEach(function(m) {
        parts += (m.value >= 0 ? ' + ' : ' - ') + Math.abs(m.value) + ' (' + m.label + ')';
      });
      var raw = base;
      modifiers.forEach(function(m) { raw += m.value; });
      if (raw !== clamped) parts += ' = ' + raw + ', clamped to ' + clamped;
      else parts += ' = ' + clamped;
      return parts;
    }

    // --- Defense resolution ---
    function selectDefense(defense) {
      // Remove the defense selection step and rebuild from there
      var steps = document.querySelectorAll('.resolve-step');
      var lastStep = steps[steps.length - 1];
      if (lastStep && lastStep.innerHTML.indexOf('Select Defense') !== -1) {
        // Keep it but disable buttons
      }

      if (!attackState) return;

      attackState.defense = defense;
      var target = attackState.target;
      var baseTn = diceRules.base_target_number;
      var hasUncannyDodge = (target.abilities || []).indexOf('uncanny_dodge') !== -1;
      var flatPenalty = hasUncannyDodge ? 0 : (diceRules.flatfooted_penalty || 1);
      var weapon = attackState.weapon;

      // --- Defense: Nothing (flatfooted, unless uncanny dodge) ---
      if (defense === 'nothing') {
        attackState.defenseDice = 0;
        attackState.attackTn = clampTn(baseTn - weapon.weapon_attack_bonus - flatPenalty);
        var tnMods = [{value: -weapon.weapon_attack_bonus, label: 'weapon proficiency'}];
        if (flatPenalty > 0) tnMods.push({value: -flatPenalty, label: 'flatfooted'});
        var tnMath = tnBreakdown('Attack TN', baseTn, tnMods, attackState.attackTn);
        var defLabel = hasUncannyDodge ? '<strong>Defense: Nothing</strong> (Uncanny Dodge - not flatfooted)' : '<strong>Defense: Flatfooted</strong>';
        addStep(defLabel + '<br><span class="math-detail">' + tnMath + '</span>');
        showAllyActions();
      }

      // --- Defense: Dodge ---
      else if (defense === 'dodge') {
        attackState.attackTn = clampTn(baseTn - weapon.weapon_attack_bonus);
        var dodgeTn = clampTn(baseTn - target.bab_bonus + weapon.weapon_attack_bonus);
        attackState.dodgeTn = dodgeTn;
        var minDice = 2;
        var maxDice = Math.min(target.bab_dice, target.dice_remaining);

        var atkTnMath = tnBreakdown('Attack TN', baseTn,
          [{value: -weapon.weapon_attack_bonus, label: 'weapon proficiency'}],
          attackState.attackTn);
        var dodgeTnMath = tnBreakdown('Dodge TN', baseTn,
          [{value: -target.bab_bonus, label: 'dodge bonus'}, {value: weapon.weapon_attack_bonus, label: 'attacker proficiency'}],
          dodgeTn);

        if (maxDice < minDice) {
          attackState.defenseDice = 0;
          addStep('<strong>Defense: Dodge</strong> - <em>Cannot dodge (need ' + minDice + ' dice, have ' + target.dice_remaining + ')</em>' +
            '<br><span class="math-detail">' + atkTnMath + '</span>');
          showAllyActions();
          return;
        }

        attackState.dodgeMin = minDice;
        attackState.dodgeMax = maxDice;
        addStep('<strong>Defense: Dodge</strong>' +
          '<br><span class="math-detail">' + atkTnMath + '</span>' +
          '<br><span class="math-detail">' + dodgeTnMath + '</span>' +
          '<br><label>Dodge dice (' + minDice + '-' + maxDice + '): <input type="number" id="dodge-dice-input" min="' + minDice + '" max="' + maxDice + '" value="' + minDice + '" style="width:50px;"></label>' +
          ' <button class="action-btn" onclick="confirmDodgeDice()">Confirm</button>');
      }

      // --- Defense: Parry ---
      else if (defense === 'parry') {
        var defWeaponSelect = document.getElementById('defense-weapon');
        var selectedVal = defWeaponSelect ? defWeaponSelect.value : '';
        if (!selectedVal || !selectedVal.startsWith('w-')) {
          alert('Select a weapon to parry with first.');
          return;
        }
        var selectedId = parseInt(selectedVal.substring(2), 10);
        var targetWeapons = target.weapons || [];
        var parryWeapon = targetWeapons.find(function(w) { return w.item_id === selectedId; });

        if (!parryWeapon) {
          alert('Select a weapon to parry with first.');
          return;
        }
        attackState.parryWeapon = parryWeapon;

        var parryTn = clampTn(baseTn - parryWeapon.weapon_attack_bonus + weapon.weapon_attack_bonus);
        var attackTn = clampTn(baseTn - weapon.weapon_attack_bonus + parryWeapon.weapon_attack_bonus);
        attackState.attackTn = attackTn;
        attackState.parryTn = parryTn;

        var parrySpeed = parryWeapon.weapon_speed;
        attackState.parrySpeed = parrySpeed;
        var minDice = 2;
        var maxAvailable = target.dice_remaining - parrySpeed;
        var maxDice = Math.min(parryWeapon.weapon_dice, maxAvailable);

        var atkTnMath = tnBreakdown('Attack TN', baseTn,
          [{value: -weapon.weapon_attack_bonus, label: 'weapon proficiency'}, {value: parryWeapon.weapon_attack_bonus, label: parryWeapon.name + ' defense'}],
          attackTn);
        var parryTnMath = tnBreakdown('Parry TN', baseTn,
          [{value: -parryWeapon.weapon_attack_bonus, label: parryWeapon.name + ' proficiency'}, {value: weapon.weapon_attack_bonus, label: 'attacker proficiency'}],
          parryTn);

        if (maxDice < minDice) {
          addStep('<strong>Defense: Parry with ' + parryWeapon.name + '</strong> - <em>Cannot parry (need ' + (minDice + parrySpeed) + ' dice, have ' + target.dice_remaining + ')</em>');
          return;
        }

        attackState.parryMin = minDice;
        attackState.parryMax = maxDice;
        addStep('<strong>Defense: Parry with ' + parryWeapon.name + '</strong>' +
          '<br><span class="math-detail">' + atkTnMath + '</span>' +
          '<br><span class="math-detail">' + parryTnMath + '</span>' +
          '<br><span class="math-detail">Parry cost: dice + ' + parrySpeed + ' (weapon speed)</span>' +
          '<br><label>Parry dice (' + minDice + '-' + maxDice + '): <input type="number" id="parry-dice-input" min="' + minDice + '" max="' + maxDice + '" value="' + minDice + '" style="width:50px;"></label>' +
          ' <button class="action-btn" onclick="confirmParryDice()">Confirm</button>');
      }

      // --- Defense: Block (with shield, works like parry) ---
      else if (defense === 'block') {
        var defWeaponSelect = document.getElementById('defense-weapon');
        var selectedVal = defWeaponSelect ? defWeaponSelect.value : '';
        if (!selectedVal || !selectedVal.startsWith('s-')) {
          alert('Select a shield to block with first.');
          return;
        }
        var selectedId = parseInt(selectedVal.substring(2), 10);
        var targetShields = target.shields || [];
        var blockShield = targetShields.find(function(s) { return s.item_id === selectedId; });

        if (!blockShield) {
          alert('Select a shield to block with first.');
          return;
        }
        attackState.blockShield = blockShield;

        var blockTn = clampTn(baseTn - blockShield.shield_attack_bonus + weapon.weapon_attack_bonus);
        var attackTn = clampTn(baseTn - weapon.weapon_attack_bonus + blockShield.shield_attack_bonus);
        attackState.attackTn = attackTn;
        attackState.blockTn = blockTn;

        var blockSpeed = blockShield.shield_speed;
        attackState.blockSpeed = blockSpeed;
        var minDice = 2;
        var maxAvailable = target.dice_remaining - blockSpeed;
        var maxDice = Math.min(blockShield.shield_dice, maxAvailable);

        var atkTnMath = tnBreakdown('Attack TN', baseTn,
          [{value: -weapon.weapon_attack_bonus, label: 'weapon proficiency'}, {value: blockShield.shield_attack_bonus, label: blockShield.name + ' defense'}],
          attackTn);
        var blockTnMath = tnBreakdown('Block TN', baseTn,
          [{value: -blockShield.shield_attack_bonus, label: blockShield.name + ' bonus'}, {value: weapon.weapon_attack_bonus, label: 'attacker proficiency'}],
          blockTn);

        if (maxDice < minDice) {
          addStep('<strong>Defense: Block with ' + blockShield.name + '</strong> - <em>Cannot block (need ' + (minDice + blockSpeed) + ' dice, have ' + target.dice_remaining + ')</em>');
          return;
        }

        attackState.blockMin = minDice;
        attackState.blockMax = maxDice;
        addStep('<strong>Defense: Block with ' + blockShield.name + '</strong>' +
          '<br><span class="math-detail">' + atkTnMath + '</span>' +
          '<br><span class="math-detail">' + blockTnMath + '</span>' +
          '<br><span class="math-detail">Block cost: dice + ' + blockSpeed + ' (shield speed)</span>' +
          '<br><label>Block dice (' + minDice + '-' + maxDice + '): <input type="number" id="block-dice-input" min="' + minDice + '" max="' + maxDice + '" value="' + minDice + '" style="width:50px;"></label>' +
          ' <button class="action-btn" onclick="confirmBlockDice()">Confirm</button>');
      }

      // --- Better Lucky Than Good (stays in defense step since it affects attack dice) ---
      else if (defense === 'better_lucky_than_good') {
        attackState.defenseDice = 0;
        attackState.manaCost = 4;
        attackState.attackDiceOverride = 3;
        attackState.attackTn = clampTn(baseTn - weapon.weapon_attack_bonus - flatPenalty);
        var tnMods = [{value: -weapon.weapon_attack_bonus, label: 'weapon proficiency'}];
        if (flatPenalty > 0) tnMods.push({value: -flatPenalty, label: 'flatfooted'});
        var tnMath = tnBreakdown('Attack TN', baseTn, tnMods, attackState.attackTn);

        addStep('<strong>Defense: Better Lucky Than Good</strong> (4 mana)' +
          '<br><span class="math-detail">Attacker dice reduced to 3</span>' +
          '<br><span class="math-detail">' + tnMath + '</span>');
        showAllyActions();
      }
    }

    function confirmDodgeDice() {
      var input = document.getElementById('dodge-dice-input');
      var val = parseInt(input.value, 10);
      if (isNaN(val) || val < attackState.dodgeMin || val > attackState.dodgeMax) {
        alert('Enter ' + attackState.dodgeMin + '-' + attackState.dodgeMax + '.'); return;
      }
      attackState.defenseDice = val;
      input.disabled = true;
      input.parentElement.nextElementSibling.style.display = 'none';
      showAllyActions();
    }

    function confirmParryDice() {
      var input = document.getElementById('parry-dice-input');
      var val = parseInt(input.value, 10);
      if (isNaN(val) || val < attackState.parryMin || val > attackState.parryMax) {
        alert('Enter ' + attackState.parryMin + '-' + attackState.parryMax + '.'); return;
      }
      attackState.parryDice = val;
      attackState.defenseDice = val + attackState.parrySpeed;
      input.disabled = true;
      input.parentElement.nextElementSibling.style.display = 'none';
      showAllyActions();
    }

    function confirmBlockDice() {
      var input = document.getElementById('block-dice-input');
      var val = parseInt(input.value, 10);
      if (isNaN(val) || val < attackState.blockMin || val > attackState.blockMax) {
        alert('Enter ' + attackState.blockMin + '-' + attackState.blockMax + '.'); return;
      }
      attackState.blockDice = val;
      attackState.defenseDice = val + attackState.blockSpeed;
      input.disabled = true;
      input.parentElement.nextElementSibling.style.display = 'none';
      showAllyActions();
    }

    // --- Ally actions step (after defense, before attack roll) ---
    // Store available shield casters for use across functions
    var pendingAllyShields = [];

    function showAllyActions() {
      attackState.allyActions = [];
      pendingAllyShields = [];

      activeEffects.forEach(function(effect) {
        if ((effect.spell_name || '').trim() !== 'Shield of Faith') return;
        // Shield of Faith only defends the ally it was cast upon.
        var protectedIds = effect.target_combat_ids || [];
        if (protectedIds.indexOf(attackState.targetCombatId) === -1) return;
        var caster = combatants.find(function(c) { return c.combat_id === effect.caster_id; });
        if (!caster) return;
        if (caster.incapacitated) return;
        if (caster.combat_id === attackState.attackerCombatId) return;
        if (caster.dice_remaining < 2) return;
        pendingAllyShields.push({
          caster: caster,
          shieldBonus: 1,
          defenseBonus: caster.healing_bonus,
          maxDice: caster.healing_dice,
          available: caster.dice_remaining,
          used: false
        });
      });

      if (pendingAllyShields.length === 0) {
        showAttackRoll();
        return;
      }

      showAllyButtons();
    }

    function showAllyButtons() {
      var html = '<strong>Ally Reactions</strong><br>';
      var anyRemaining = false;
      pendingAllyShields.forEach(function(ally, idx) {
        if (ally.used) return;
        anyRemaining = true;
        html += '<button class="action-btn" onclick="activateShieldOfFaith(' + idx + ')" style="margin:2px;">' +
          ally.caster.name + ' — Shield of Faith</button> ';
      });
      if (!anyRemaining) {
        finalizeAllyActions();
        return;
      }
      html += '<button class="action-btn" onclick="finalizeAllyActions()" style="margin:2px;">Skip</button>';
      addStep(html);
    }

    function activateShieldOfFaith(idx) {
      var ally = pendingAllyShields[idx];
      ally.used = true;
      var capDice = Math.min(ally.maxDice, ally.available);
      var minDice = 2;

      // Remove the buttons step
      var steps = document.querySelectorAll('.resolve-step');
      steps[steps.length - 1].remove();

      addStep('<strong>' + ally.caster.name + ' — Shield of Faith</strong>' +
        '<br><span class="math-detail">+' + ally.shieldBonus + ' shield, defense bonus ' +
        (ally.defenseBonus >= 0 ? '+' : '') + ally.defenseBonus + '</span>' +
        '<br><label>Block dice (' + minDice + '-' + capDice + '): ' +
        '<input type="number" id="ally-dice-' + idx + '" min="' + minDice + '" max="' + capDice + '" value="' + minDice + '" style="width:50px;"></label>' +
        '<input type="hidden" id="ally-cid-' + idx + '" value="' + ally.caster.combat_id + '">' +
        '<input type="hidden" id="ally-bonus-' + idx + '" value="' + ally.defenseBonus + '">' +
        ' <button class="action-btn" onclick="confirmOneAlly(' + idx + ')">Confirm</button>');
    }

    function confirmOneAlly(idx) {
      var diceInput = document.getElementById('ally-dice-' + idx);
      var ally = pendingAllyShields[idx];
      var dice = parseInt(diceInput.value, 10) || 0;
      var minDice = 2;
      var capDice = Math.min(ally.maxDice, ally.available);
      if (dice < minDice || dice > capDice) {
        alert('Enter ' + minDice + '-' + capDice + '.'); return;
      }
      var cid = parseInt(document.getElementById('ally-cid-' + idx).value, 10);
      var bonus = parseInt(document.getElementById('ally-bonus-' + idx).value, 10);
      attackState.allyActions.push({combat_id: cid, dice: dice, bonus: bonus});
      diceInput.disabled = true;
      diceInput.parentElement.parentElement.querySelector('button').style.display = 'none';

      // Check if more allies available
      var moreAvailable = pendingAllyShields.some(function(a) { return !a.used; });
      if (moreAvailable) {
        showAllyButtons();
      } else {
        finalizeAllyActions();
      }
    }

    function finalizeAllyActions() {
      var baseTn = diceRules.base_target_number;
      var weapon = attackState.weapon;

      // Remove the skip/buttons step if it's still there
      var steps = document.querySelectorAll('.resolve-step');
      var lastStep = steps[steps.length - 1];
      if (lastStep && lastStep.innerHTML.indexOf('Ally Reactions') !== -1) {
        lastStep.remove();
      }

      if (attackState.allyActions.length > 0) {
        // Ally intervention removes flatfooted — recalculate TN without it
        var tnMods = [{value: -weapon.weapon_attack_bonus, label: 'weapon proficiency'}];
        if (attackState.defense === 'parry' && attackState.parryWeapon) {
          tnMods.push({value: attackState.parryWeapon.weapon_attack_bonus, label: attackState.parryWeapon.name + ' defense'});
        }
        if (attackState.defense === 'block' && attackState.blockShield) {
          tnMods.push({value: attackState.blockShield.shield_attack_bonus, label: attackState.blockShield.name + ' defense'});
        }
        attackState.allyActions.forEach(function(a) {
          var allyName = combatants.find(function(c) { return c.combat_id === a.combat_id; });
          tnMods.push({value: a.bonus, label: (allyName ? allyName.name : 'Ally') + ' Shield of Faith'});
        });

        attackState.attackTn = clampTn(baseTn + tnMods.reduce(function(sum, m) { return sum + m.value; }, 0));
        var tnMath = tnBreakdown('Attack TN (revised)', baseTn, tnMods, attackState.attackTn);
        addStep('<span class="math-detail">' + tnMath + '</span>');
      }

      showAttackRoll();
    }

    // --- Attack roll step ---
    function showAttackRoll() {
      var rollDice = attackState.attackDiceOverride || attackState.attackDice;
      var diceNote = attackState.attackDiceOverride ? ' (reduced from ' + attackState.attackDice + ')' : '';
      addStep('<strong>Attack Roll</strong>: ' + rollDice + ' dice' + diceNote + ', TN ' + attackState.attackTn +
        '<br><label>Attack successes: <input type="number" id="attack-successes-input" min="0" value="0" style="width:50px;"></label>' +
        ' <button class="action-btn" onclick="confirmAttackSuccesses()">Confirm</button>' +
        ' <button class="action-btn" onclick="rollDicePool(' + rollDice + ', ' + attackState.attackTn + ', \'attack-successes-input\', \'attack-roll-display\')">Roll</button>' +
        '<div id="attack-roll-display" class="math-detail" style="margin-top:4px;"></div>');
    }

    function confirmAttackSuccesses() {
      var input = document.getElementById('attack-successes-input');
      var val = parseInt(input.value, 10);
      if (isNaN(val) || val < 0) { alert('Invalid number.'); return; }
      attackState.attackSuccesses = val;
      input.disabled = true;
      input.parentElement.nextElementSibling.style.display = 'none';

      if (attackState.defense === 'dodge' && attackState.defenseDice > 0) {
        showDodgeRoll();
      } else if (attackState.defense === 'parry') {
        showParryRoll();
      } else if (attackState.defense === 'block') {
        showBlockRoll();
      } else {
        proceedToAllyRolls(val, 0);
      }
    }

    // --- Defense roll steps ---
    function showDodgeRoll() {
      addStep('<strong>Dodge Roll</strong>: ' + attackState.defenseDice + ' dice, TN ' + attackState.dodgeTn +
        '<br><label>Dodge successes: <input type="number" id="defense-successes-input" min="0" value="0" style="width:50px;"></label>' +
        ' <button class="action-btn" onclick="confirmDefenseSuccesses()">Confirm</button>' +
        ' <button class="action-btn" onclick="rollDicePool(' + attackState.defenseDice + ', ' + attackState.dodgeTn + ', \'defense-successes-input\', \'defense-roll-display\')">Roll</button>' +
        '<div id="defense-roll-display" class="math-detail" style="margin-top:4px;"></div>');
    }

    function showParryRoll() {
      addStep('<strong>Parry Roll</strong>: ' + attackState.parryDice + ' dice, TN ' + attackState.parryTn +
        '<br><label>Parry successes: <input type="number" id="defense-successes-input" min="0" value="0" style="width:50px;"></label>' +
        ' <button class="action-btn" onclick="confirmDefenseSuccesses()">Confirm</button>' +
        ' <button class="action-btn" onclick="rollDicePool(' + attackState.parryDice + ', ' + attackState.parryTn + ', \'defense-successes-input\', \'defense-roll-display\')">Roll</button>' +
        '<div id="defense-roll-display" class="math-detail" style="margin-top:4px;"></div>');
    }

    function showBlockRoll() {
      addStep('<strong>Block Roll</strong>: ' + attackState.blockDice + ' dice, TN ' + attackState.blockTn +
        '<br><label>Block successes: <input type="number" id="defense-successes-input" min="0" value="0" style="width:50px;"></label>' +
        ' <button class="action-btn" onclick="confirmDefenseSuccesses()">Confirm</button>' +
        ' <button class="action-btn" onclick="rollDicePool(' + attackState.blockDice + ', ' + attackState.blockTn + ', \'defense-successes-input\', \'defense-roll-display\')">Roll</button>' +
        '<div id="defense-roll-display" class="math-detail" style="margin-top:4px;"></div>');
    }

    function confirmDefenseSuccesses() {
      var input = document.getElementById('defense-successes-input');
      var val = parseInt(input.value, 10);
      if (isNaN(val) || val < 0) { alert('Invalid number.'); return; }
      attackState.defenseSuccesses = val;
      input.disabled = true;
      input.parentElement.nextElementSibling.style.display = 'none';
      proceedToAllyRolls(attackState.attackSuccesses, val);
    }

    // --- Ally block rolls ---
    function proceedToAllyRolls(attackSuccesses, defenseSuccesses) {
      attackState.allyRollQueue = (attackState.allyActions || []).slice();
      attackState.allyBlockSuccesses = 0;
      attackState.pendingAttackSuccesses = attackSuccesses;
      attackState.pendingDefenseSuccesses = defenseSuccesses;
      showNextAllyRoll();
    }

    function showNextAllyRoll() {
      if (attackState.allyRollQueue.length === 0) {
        showPostDefenseAbilities();
        return;
      }
      var ally = attackState.allyRollQueue.shift();
      var caster = combatants.find(function(c) { return c.combat_id === ally.combat_id; });
      var baseTn = diceRules.base_target_number;
      var blockTn = clampTn(baseTn - ally.bonus + attackState.weapon.weapon_attack_bonus);
      var tnMath = tnBreakdown('Block TN', baseTn,
        [{value: -ally.bonus, label: 'healing bonus'}, {value: attackState.weapon.weapon_attack_bonus, label: 'attacker proficiency'}],
        blockTn);
      addStep('<strong>' + (caster ? caster.name : 'Ally') + ' blocks with Shield of Faith</strong>: ' + ally.dice + ' dice' +
        '<br><span class="math-detail">' + tnMath + '</span>' +
        '<br><label>Block successes: <input type="number" id="ally-block-successes" min="0" value="0" style="width:50px;"></label>' +
        ' <button class="action-btn" onclick="confirmAllyBlockSuccesses()">Confirm</button>' +
        ' <button class="action-btn" onclick="rollDicePool(' + ally.dice + ', ' + blockTn + ', \'ally-block-successes\', \'ally-block-display\')">Roll</button>' +
        '<div id="ally-block-display" class="math-detail" style="margin-top:4px;"></div>');
    }

    function confirmAllyBlockSuccesses() {
      var input = document.getElementById('ally-block-successes');
      var val = parseInt(input.value, 10);
      if (isNaN(val) || val < 0) { alert('Invalid number.'); return; }
      attackState.allyBlockSuccesses += val;
      input.disabled = true;
      input.parentElement.nextElementSibling.style.display = 'none';
      showNextAllyRoll();
    }

    // --- Post-defense abilities (Danger Sense, Primal Tenacity) ---
    function showPostDefenseAbilities() {
      var target = attackState.target;
      var abilities = target.abilities || [];
      var isNothing = (attackState.defense === 'nothing' || attackState.defense === 'better_lucky_than_good');

      if (!isNothing) {
        showHealingWord();
        return;
      }

      var btns = '';
      if (abilities.indexOf('danger_sense') !== -1 && target.mana >= 4) {
        btns += '<button class="action-btn" onclick="usePostAbility(\'danger_sense\')" style="margin:2px;">Danger Sense</button> ';
      }
      if (abilities.indexOf('primal_tenacity') !== -1 && target.mana >= 4) {
        btns += '<button class="action-btn" onclick="usePostAbility(\'primal_tenacity\')" style="margin:2px;">Primal Tenacity</button> ';
      }

      if (btns === '') {
        showHealingWord();
        return;
      }

      btns += '<button class="action-btn" onclick="showHealingWord()" style="margin:2px;">Skip</button>';
      addStep('<strong>Reactive Abilities for ' + target.name + '</strong><br>' + btns);
    }

    function usePostAbility(ability) {
      // Remove buttons step
      var steps = document.querySelectorAll('.resolve-step');
      steps[steps.length - 1].remove();

      attackState.manaCost += 4;
      if (ability === 'danger_sense') {
        attackState.resilienceBonus = 4;
        addStep('<strong>Danger Sense</strong> (4 mana)<br><span class="math-detail">Damage resilience +4 for this attack</span>');
      } else if (ability === 'primal_tenacity') {
        attackState.drBonus = 4;
        addStep('<strong>Primal Tenacity</strong> (4 mana)<br><span class="math-detail">Damage reduction +4 for this attack</span>');
      }
      showHealingWord();
    }

    // --- Healing Word reactive ally spell ---
    function showHealingWord() {
      attackState.healingWordActions = attackState.healingWordActions || [];
      attackState.healingWordSuccesses = attackState.healingWordSuccesses || 0;

      // Each character has 1 reaction per attack. Shield of Faith and
      // Healing Word are both reactions, so an ally that already used
      // Shield of Faith on this attack cannot also cast Healing Word.
      var reactionUsed = {};
      (attackState.allyActions || []).forEach(function(a) { reactionUsed[a.combat_id] = true; });

      // Find allies who know Healing Word, have mana, and have dice
      var healers = [];
      var healingWordCost = spellManaCost(1); // tier 1 = 4 mana
      combatants.forEach(function(c) {
        if (c.combat_id === attackState.attackerCombatId) return;
        if (c.incapacitated) return;
        if (reactionUsed[c.combat_id]) return;
        // Skip already used healers
        var alreadyUsed = attackState.healingWordActions.some(function(a) { return a.combat_id === c.combat_id; });
        if (alreadyUsed) return;
        if (!c.spells || c.spells.indexOf('Healing Word') === -1) return;
        if (c.mana < healingWordCost) return;
        if (c.dice_remaining < 2) return;
        healers.push(c);
      });

      if (healers.length === 0) {
        proceedToDamage();
        return;
      }

      var html = '<strong>Healing Word Reactions</strong>' +
        '<br><span class="math-detail">1 reaction per character — Shield of Faith users above cannot also cast Healing Word.</span><br>';
      healers.forEach(function(healer) {
        html += '<button class="action-btn" onclick="activateHealingWord(' + healer.combat_id + ')" style="margin:2px;">' +
          healer.name + ' — Healing Word (' + healingWordCost + ' mana)</button> ';
      });
      html += '<button class="action-btn" onclick="proceedToDamage()" style="margin:2px;">Skip</button>';
      addStep(html);
    }

    function activateHealingWord(combatId) {
      var healer = combatants.find(function(c) { return c.combat_id === combatId; });
      if (!healer) return;
      var maxDice = Math.min(healer.healing_dice, healer.dice_remaining);
      var minDice = 2;
      var healingWordCost = spellManaCost(1);
      var baseTn = diceRules.base_target_number;
      var healTn = clampTn(baseTn - healer.healing_bonus);
      var tnMath = tnBreakdown('Healing TN', baseTn,
        [{value: -healer.healing_bonus, label: 'healing bonus'}], healTn);

      // Remove the buttons step
      var steps = document.querySelectorAll('.resolve-step');
      steps[steps.length - 1].remove();

      addStep('<strong>' + healer.name + ' — Healing Word</strong> (' + healingWordCost + ' mana)' +
        '<br><span class="math-detail">' + tnMath + '</span>' +
        '<br><label>Healing dice (' + minDice + '-' + maxDice + '): ' +
        '<input type="number" id="hw-dice" min="' + minDice + '" max="' + maxDice + '" value="' + minDice + '" style="width:50px;"></label>' +
        '<input type="hidden" id="hw-cid" value="' + combatId + '">' +
        '<input type="hidden" id="hw-tn" value="' + healTn + '">' +
        ' <button class="action-btn" onclick="confirmHealingWordDice()">Confirm</button>');
    }

    function confirmHealingWordDice() {
      var diceInput = document.getElementById('hw-dice');
      var dice = parseInt(diceInput.value, 10) || 0;
      var cid = parseInt(document.getElementById('hw-cid').value, 10);
      var healTn = parseInt(document.getElementById('hw-tn').value, 10);
      var healer = combatants.find(function(c) { return c.combat_id === cid; });
      var maxDice = Math.min(healer.healing_dice, healer.dice_remaining);
      if (dice < 2 || dice > maxDice) { alert('Enter 2-' + maxDice + '.'); return; }

      diceInput.disabled = true;
      diceInput.parentElement.parentElement.querySelector('button').style.display = 'none';

      attackState.healingWordActions.push({combat_id: cid, dice: dice});

      addStep('<strong>' + healer.name + ' rolls Healing Word</strong>: ' + dice + ' dice, TN ' + healTn +
        '<br><label>Successes (each reduces damage by 1): <input type="number" id="hw-successes" min="0" value="0" style="width:50px;"></label>' +
        ' <button class="action-btn" onclick="confirmHealingWordSuccesses()">Confirm</button>' +
        ' <button class="action-btn" onclick="rollDicePool(' + dice + ', ' + healTn + ', \'hw-successes\', \'hw-roll-display\')">Roll</button>' +
        '<div id="hw-roll-display" class="math-detail" style="margin-top:4px;"></div>');
    }

    function confirmHealingWordSuccesses() {
      var input = document.getElementById('hw-successes');
      var val = parseInt(input.value, 10);
      if (isNaN(val) || val < 0) { alert('Invalid number.'); return; }
      attackState.healingWordSuccesses += val;
      input.disabled = true;
      input.parentElement.nextElementSibling.style.display = 'none';
      // Offer more healers
      showHealingWord();
    }

    function proceedToDamage() {
      // Remove skip buttons step if present
      var steps = document.querySelectorAll('.resolve-step');
      var lastStep = steps[steps.length - 1];
      if (lastStep && (lastStep.innerHTML.indexOf('Healing Word Reactions') !== -1)) {
        lastStep.remove();
      }

      var totalDef = attackState.pendingDefenseSuccesses + attackState.allyBlockSuccesses;
      showDamageResult(attackState.pendingAttackSuccesses, totalDef);
    }

    // --- Damage result ---
    function showDamageResult(attackSuccesses, defenseSuccesses) {
      var weapon = attackState.weapon;
      var target = attackState.target;
      var reqSuccesses = diceRules.default_required_successes;
      var netSuccesses = attackSuccesses - defenseSuccesses;

      if (netSuccesses < reqSuccesses) {
        var missMsg = '<strong>Miss!</strong> ' + attackSuccesses + ' attack' + (defenseSuccesses > 0 ? ' - ' + defenseSuccesses + ' defense' : '') +
          ' = ' + netSuccesses + ' net (need ' + reqSuccesses + ')';
        addStep(missMsg +
          '<br><button class="action-btn" onclick="submitFinalResult(true)" style="margin-top:8px;">Submit (Miss)</button>' +
          ' <button class="action-btn" onclick="restartDefense()" style="margin-top:8px;">Change Defense</button>');
        return;
      }

      var drBonus = attackState.drBonus || 0;
      var resilienceBonus = attackState.resilienceBonus || 0;
      var effectiveDR = target.damage_reduction + drBonus;
      var effectiveResilience = target.damage_resilience + resilienceBonus;
      var threshold = effectiveResilience + weapon.weapon_threshold;

      // Pre-DR damage -- what the weapon would deal before armor soaks it.
      // Used to decide if afflictions (bleed / poison / paralysis) apply:
      // if raw damage >= target's DR, the strike penetrates enough to
      // inflict conditions, even when net HP damage ends up 0.
      var preDrDamage = weapon.weapon_dmg + netSuccesses + weapon.weapon_bonus;
      attackState.attackPenetrates = preDrDamage >= effectiveDR;

      var hwReduction = attackState.healingWordSuccesses || 0;
      var totalDamage = Math.max(0, weapon.weapon_dmg + netSuccesses + weapon.weapon_bonus - effectiveDR - hwReduction);

      var drText = 'Damage Reduction: ' + target.damage_reduction;
      if (drBonus > 0) drText += ' + ' + drBonus + ' (Primal Tenacity)';
      var hwText = hwReduction > 0 ? ' - Healing Word: ' + hwReduction : '';
      var breakdown = '<strong>Damage Calculation</strong><br>' +
        '<span class="math-detail">' +
        'Weapon Damage: ' + weapon.weapon_dmg + ' (' + weapon.name + ')' +
        ' + Net Successes: ' + netSuccesses +
        (defenseSuccesses > 0 ? ' (' + attackSuccesses + ' attack - ' + defenseSuccesses + ' defense)' : '') +
        ' + Weapon Enhancement: ' + weapon.weapon_bonus +
        ' - ' + drText + hwText +
        ' = <strong>' + totalDamage + '</strong></span>';

      var split = calcDamageSplit(totalDamage, threshold);
      var resilText = 'Resilience ' + target.damage_resilience;
      if (resilienceBonus > 0) resilText += ' + ' + resilienceBonus + ' (Danger Sense)';
      var thresholdMath = '<span class="math-detail">Threshold: ' + threshold +
        ' (' + resilText + ' + Weapon Threshold ' + weapon.weapon_threshold + ')</span>';
      var splitDisplay = '<span class="math-detail">Minor: ' + split.minor + ' | Moderate: ' + split.moderate + ' | Major: ' + split.major + '</span>';

      // Affliction defaults, computed from the same totalDamage shown above.
      // Only afflictions that would naturally apply to this attack are
      // shown; the DM can edit each value (or zero it out to suppress).
      // Must match the order used by the server's attack handler.
      var afflictionHtml = '';
      attackState.afflictionDefaults = [];
      if (attackState.attackPenetrates) {
        if (!weapon.is_ranged && weapon.weapon_bleed > 0) {
          attackState.afflictionDefaults.push({ key: 'bleed', label: 'Bleed', amount: totalDamage + weapon.weapon_bleed });
        }
        if (weapon.is_natural && currentAttackerAbilities.indexOf('ghoul_paralysis') !== -1) {
          attackState.afflictionDefaults.push({ key: 'ghoul_paralysis', label: 'Ghoul Paralysis', amount: totalDamage + currentAttackerTier });
        }
        if (weapon.is_natural && weapon.subtype === 'bite' && currentAttackerAbilities.indexOf('poison_bite') !== -1) {
          attackState.afflictionDefaults.push({ key: 'minor_strength_poison', label: 'Poison (minor STR)', amount: 5 + totalDamage });
        }
      }
      if (attackState.afflictionDefaults.length > 0) {
        afflictionHtml = '<br><span class="math-detail" style="margin-top:6px;display:inline-block;">Afflictions (editable):</span>';
        attackState.afflictionDefaults.forEach(function(a) {
          afflictionHtml += '<br><label style="margin-left:8px;">' + a.label + ': ' +
            '<input type="number" id="afflict-' + a.key + '" min="0" value="' + a.amount + '" style="width:60px;"></label>';
        });
      }

      addStep(breakdown + '<br>' + thresholdMath + '<br>' + splitDisplay +
        '<br><label style="margin-top:8px;display:inline-block;">Final damage (editable): <input type="number" id="final-damage-input" min="0" value="' + totalDamage + '" style="width:60px;" onchange="updateDamageSplit()"></label>' +
        '<span id="final-split" class="math-detail" style="margin-left:10px;">Minor: ' + split.minor + ' | Moderate: ' + split.moderate + ' | Major: ' + split.major + '</span>' +
        afflictionHtml +
        '<br><button class="action-btn" onclick="submitFinalResult(false)" style="margin-top:8px;">Submit Damage</button>' +
        ' <button class="action-btn" onclick="restartDefense()" style="margin-top:8px;">Change Defense</button>');
    }

    function updateDamageSplit() {
      var input = document.getElementById('final-damage-input');
      var val = parseInt(input.value, 10) || 0;
      var target = attackState.target;
      var effectiveResilience = target.damage_resilience + (attackState.resilienceBonus || 0);
      var threshold = effectiveResilience + attackState.weapon.weapon_threshold;
      var split = calcDamageSplit(val, threshold);
      document.getElementById('final-split').textContent = 'Minor: ' + split.minor + ' | Moderate: ' + split.moderate + ' | Major: ' + split.major;
    }

    function restartDefense() {
      // Remove steps from defense selection onward, keep target + dice steps
      var steps = document.querySelectorAll('.resolve-step');
      var removing = false;
      for (var i = 0; i < steps.length; i++) {
        if (steps[i].innerHTML.indexOf('Select Defense') !== -1) removing = true;
        if (removing) steps[i].remove();
      }
      attackState.defense = null;
      attackState.defenseDice = 0;
      attackState.attackSuccesses = null;
      attackState.defenseSuccesses = null;
      attackState.manaCost = 0;
      attackState.drBonus = 0;
      attackState.resilienceBonus = 0;
      attackState.attackDiceOverride = null;
      attackState.blockShield = null;
      attackState.blockDice = 0;
      attackState.blockTn = null;
      attackState.blockSpeed = 0;
      attackState.allyActions = [];
      attackState.allyBlockSuccesses = [];
      attackState.allyRollQueue = [];
      attackState.healingWordActions = [];
      attackState.healingWordSuccesses = 0;
      showDefenseSelection();
    }

    function submitFinalResult(isMiss) {
      var defenseDice = attackState.defenseDice || 0;
      var attackerDiceSpent = attackState.attackerDiceSpent || 0;
      var manaCost = attackState.manaCost || 0;

      // Build ally_data string from allyActions: "combat_id:dice;combat_id:dice"
      var allyDataStr = '';
      if (attackState.allyActions && attackState.allyActions.length > 0) {
        allyDataStr = attackState.allyActions.map(function(a) {
          return a.combat_id + ':' + a.dice;
        }).join(';');
      }

      // Build healing_word_data string: "combat_id:mana_cost;combat_id:mana_cost"
      var hwDataStr = '';
      var hwCost = spellManaCost(1);
      if (attackState.healingWordActions && attackState.healingWordActions.length > 0) {
        hwDataStr = attackState.healingWordActions.map(function(a) {
          return a.combat_id + ':' + hwCost;
        }).join(';');
      }

      var minor = 0, moderate = 0, major = 0;
      if (!isMiss) {
        var finalDamage = parseInt(document.getElementById('final-damage-input').value, 10);
        if (isNaN(finalDamage) || finalDamage < 0) { alert('Invalid damage.'); return; }
        var target = attackState.target;
        var effectiveResilience = target.damage_resilience + (attackState.resilienceBonus || 0);
        var threshold = effectiveResilience + attackState.weapon.weapon_threshold;
        var split = calcDamageSplit(finalDamage, threshold);
        minor = split.minor; moderate = split.moderate; major = split.major;
      }

      // Spiritual Weapon concentrate attacks route through the concentrate
      // endpoint so the caster spends no action dice or mana.
      if (attackState.isSpiritualWeapon) {
        submitAction({
          id: attackState.attackerCombatId,
          combat_action: 'concentrate',
          sub_action: 'attack',
          effect_index: attackState.concentrateEffectIndex,
          target_combat_id: attackState.targetCombatId,
          defense_dice: defenseDice,
          target_mana_cost: manaCost,
          ally_data: allyDataStr,
          healing_word_data: hwDataStr,
          afflict: 'false',
          minor_damage: minor, moderate_damage: moderate, major_damage: major
        });
        return;
      }

      // Ranged attack spells (Acid Splash / Sacred Flame / Fire Bolt).
      // First cast is cast+mana+dice; reuse via Concentrate skips mana
      // but still spends dice. Neither applies physical afflictions.
      if (attackState.isRangedSpell) {
        if (attackState.rangedSpellReuse) {
          submitAction({
            id: attackState.attackerCombatId,
            combat_action: 'concentrate',
            sub_action: 'ranged_attack',
            effect_index: attackState.rangedSpellEffectIndex,
            target_combat_id: attackState.targetCombatId,
            dice_spent: attackState.attackDice,
            defense_dice: defenseDice,
            target_mana_cost: manaCost,
            ally_data: allyDataStr,
            healing_word_data: hwDataStr,
            afflict: 'false',
            minor_damage: minor, moderate_damage: moderate, major_damage: major
          });
        } else {
          var castFields = {
            id: attackState.attackerCombatId,
            combat_action: 'cast',
            spell_name: attackState.rangedSpellName,
            spell_tier: attackState.rangedSpellTier,
            target_combat_id: attackState.targetCombatId,
            dice_spent: attackState.attackDice,
            defense_dice: defenseDice,
            target_mana_cost: manaCost,
            ally_data: allyDataStr,
            healing_word_data: hwDataStr,
            ranged_attack: 'true',
            minor_damage: minor, moderate_damage: moderate, major_damage: major
          };
          if (activeScroll) {
            castFields.from_scroll = 'true';
            castFields.scroll_item_id = activeScroll.itemId;
          }
          submitAction(castFields);
        }
        return;
      }

      var fields = {
        combat_action: 'attack',
        attacker_combat_id: attackState.attackerCombatId,
        target_combat_id: attackState.targetCombatId,
        weapon_item_id: attackState.weapon.item_id,
        attacker_dice_spent: attackerDiceSpent,
        defense_dice: defenseDice,
        target_mana_cost: manaCost,
        ally_data: allyDataStr,
        healing_word_data: hwDataStr,
        afflict: (!isMiss && attackState.attackPenetrates) ? 'true' : 'false',
        minor_damage: minor, moderate_damage: moderate, major_damage: major
      };

      // Forward DM-edited affliction amounts; only keys shown in the UI
      // are sent so the server doesn't double-apply anything. Each key is
      // named afflict_<condition> and is an absolute amount to add.
      if (!isMiss) {
        (attackState.afflictionDefaults || []).forEach(function(a) {
          var el = document.getElementById('afflict-' + a.key);
          if (el) {
            var v = parseInt(el.value, 10);
            if (!isNaN(v) && v >= 0) fields['afflict_' + a.key] = v;
          }
        });
      }

      submitAction(fields);
    }

    function submitAction(fields) {
      var form = document.createElement('form');
      form.method = 'post';
      form.action = '/combat/action';
      form.style.display = 'none';
      for (var key in fields) {
        var el = document.createElement('input');
        el.type = 'hidden';
        el.name = key;
        el.value = fields[key];
        form.appendChild(el);
      }
      document.body.appendChild(form);
      form.submit();
    }
  </script>

  <% if current %>
    <h2 style="margin-top: 30px;">Current Character</h2>
    <% _saved_character = @character %>
    <% _saved_compendium = @compendium %>
    <% _saved_route_prefix = @route_prefix %>
    <% @character = current.character %>
    <% @compendium = Compendium.new %>
    <% @route_prefix = nil %>
    <%= erb :character_sheet, layout: false %>
    <% @character = _saved_character %>
    <% @compendium = _saved_compendium %>
    <% @route_prefix = _saved_route_prefix %>
  <% end %>
  </div>
