<%
  base_url      = '/character-sheets'
  toggle_detail = @detail == 'full' ? 'minimal' : 'full'
  toggle_href   = "#{base_url}?i=#{@i}&detail=#{toggle_detail}"
  prev_href     = "#{base_url}?i=#{@prev_i}&detail=#{@detail}"
  next_href     = "#{base_url}?i=#{@next_i}&detail=#{@detail}"
  pager_label   = "#{@i + 1} / #{@total}"
%>

<div class="cs-page">
  <% if @detail == 'minimal' %>
    <nav class="cs-pager">
      <a class="cs-pager-arrow" href="<%= prev_href %>">&#9664;</a>
      <span class="cs-pager-label"><%= pager_label %></span>
      <a class="cs-pager-arrow" href="<%= next_href %>">&#9654;</a>
    </nav>
    <%= erb :_creature_minimal, locals: { demo: @demo, toggle_target: toggle_href } %>
  <% else %>
    <%= erb :_creature_full,
            locals: { demo: @demo, toggle_target: toggle_href,
                      prev_target: prev_href, next_target: next_href,
                      page_label: pager_label } %>
  <% end %>
</div>
