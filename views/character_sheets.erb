<%
  toggle_detail = @detail == 'full' ? 'minimal' : 'full'
  toggle_href   = "/character-sheets?creature_id=#{@creature_id}&detail=#{toggle_detail}"
%>

<div class="cs-page<%= ' cs-page-with-sidebar' if @roster %>">
  <% if @roster %>
    <%= erb :_creatures_roster_sidebar,
            locals: { roster: @roster, current_creature_id: @creature_id, detail: @detail } %>
  <% end %>
  <div class="cs-main">
    <div id="random-encounter-roll-result"></div>
    <% if @prev_creature_id || @next_creature_id %>
      <nav class="cs-sheet-nav">
        <a class="cs-sheet-arrow" href="/character-sheets?creature_id=<%= @prev_creature_id %>&detail=<%= @detail %>" aria-label="Previous sheet">‹ Prev</a>
        <a class="cs-sheet-arrow" href="/character-sheets?creature_id=<%= @next_creature_id %>&detail=<%= @detail %>" aria-label="Next sheet">Next ›</a>
      </nav>
    <% end %>
    <% if @random_encounter_template_id %>
      <%= erb :_random_encounter_template,
              locals: { table_id: @random_encounter_template_id,
                        table: @random_encounter_template,
                        name_for: @random_encounter_name_for } %>
    <% elsif @demo.nil? %>
      <p class="lead">No creatures in the roster.</p>
    <% elsif @detail == 'minimal' %>
      <%= erb :_creature_minimal, locals: { demo: @demo, toggle_target: toggle_href } %>
    <% else %>
      <%= erb :_creature_full, locals: { demo: @demo, toggle_target: toggle_href } %>
    <% end %>

    <% if !@random_encounter_template_id && @inventory_stub %>
      <%= erb :_creature_inventory_stub, locals: {
            creature_id: @inventory_stub[:creature_id],
            detail:      @detail,
            equipped:    @inventory_stub[:equipped],
            inventory:   @inventory_stub[:inventory],
            sell:        @inventory_stub[:sell] } %>
    <% end %>
  </div>
</div>

<script type="module" src="/app.js"></script>
