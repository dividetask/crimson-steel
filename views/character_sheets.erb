<%
  base_url      = '/character-sheets'
  toggle_detail = @detail == 'full' ? 'minimal' : 'full'
  toggle_href   = "#{base_url}?i=#{@i}&detail=#{toggle_detail}"
%>

<div class="cs-page<%= ' cs-page-with-sidebar' if @roster %>">
  <% if @roster %>
    <%= erb :_creatures_roster_sidebar,
            locals: { roster: @roster, current_index: @i, detail: @detail } %>
  <% end %>
  <div class="cs-main">
    <% if @detail == 'minimal' %>
      <%= erb :_creature_minimal, locals: { demo: @demo, toggle_target: toggle_href } %>
    <% else %>
      <%= erb :_creature_full, locals: { demo: @demo, toggle_target: toggle_href } %>
    <% end %>
  </div>
</div>
