<% scene = DATA.scene %>

<h1><%= h scene['title'] %></h1>
<p class="scene-description"><%= h scene['description'] %></p>

<%= notes_block(
      current_chapter:    nil,
      active_only:        true,
      scene_state:        SCENE_STATE,
      interactive_maps:   true,
      section_order:      %w[maps journal characters images]
    ) %>

<% if scene['show_initiative'] %>
  <h2>Initiative</h2>
  <%= initiative_stub(
        turns: DATA.initiative_turns,
        current_combat_id: SCENE_STATE.current_turn || DATA.combat_state['current_turn'],
        dm_view: dm?
      ) %>
<% end %>
