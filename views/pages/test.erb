<% p = @test_params || {} %>

<%# Newest stub previews go at the top — see CLAUDE.md. %>

<h2>Start of Turn Stub</h2>

<p class="dt-note">
  Walks the active combatant through the start-of-turn pipeline:
  reset action dice &rarr; consume shock &rarr; halve acid counter
  &rarr; per-affliction saves (each via the standard roll_stub)
  &rarr; clear expired effects. One Confirm at the bottom commits
  every change atomically through the real Combat / Conditions
  state files in <code>data/</code>.
</p>

<%= start_of_turn_stub %>

<h2>Attack Stub</h2>

<p class="dt-note">
  Walks the DM through target &rarr; weapon &rarr; attack dice &rarr; defense
  &rarr; ally reactions &rarr; rolls &rarr; target reactions &rarr; damage.
  Same stub serves melee and ranged. Steps with a single (or zero)
  option auto-advance.
</p>

<%= attack_stub(
      attacker:       DATA.attacker_sample,
      targets:        DATA.target_samples,
      ally_reactions: DATA.ally_reactions,
      luck_sources:   DATA.luck_sources
    ) %>

<div class="stub-test-capture">
  <label>Last attack result:
    <textarea id="test-attack-result" rows="6" readonly
              placeholder="(submit the damage step)"
              style="width:100%;font-family:monospace;font-size:11px;"></textarea>
  </label>
</div>

<script>
  // Echo the attack:confirm payload so the test harness can show
  // what the stub would hand off to a real combat handler.
  document.addEventListener('attack:confirm', function(e) {
    var out = document.getElementById('test-attack-result');
    if (out) out.value = JSON.stringify(e.detail, null, 2);
  });
</script>

<h2>Roll Stub</h2>

<form method="post" action="/test" class="stub-test-form">
  <label>Character: <input type="text" name="character_name"
         value="<%= h(p['character_name'] || 'Alice') %>"></label>
  <label>Check Name: <input type="text" name="check_name"
         value="<%= h(p['check_name'] || 'Perception') %>"></label>
  <label>Dice Count: <input type="number" name="dice_count" min="1"
         value="<%= h(p['dice_count'] || 6) %>"></label>
  <label>TN: <input type="number" name="tn"
         value="<%= h(p['tn'] || 6) %>"></label>
  <label>Starting Value: <input type="number" name="starting_value"
         value="<%= h(p['starting_value'] || 0) %>"></label>
  <label>Luck Amount: <input type="number" name="luck_amount"
         value="<%= h(p['luck_amount'] || 2) %>"></label>
  <label>Luck Label: <input type="text" name="luck_label"
         value="<%= h(p['luck_label'] || 'Bardic Inspiration') %>"></label>
  <label>Insight Amount: <input type="number" name="insight_amount"
         value="<%= h(p['insight_amount'] || 1) %>"></label>
  <label>Insight Label: <input type="text" name="insight_label"
         value="<%= h(p['insight_label'] || 'Heroic Insight') %>"></label>
  <button type="submit">Submit</button>
</form>

<% unless p.empty? %>
  <%= roll_stub(
        character_name: p['character_name'].to_s,
        check_name:     p['check_name'].to_s,
        dice_count:     p['dice_count'].to_i,
        tn:             p['tn'].to_i,
        starting_value: p['starting_value'].to_i,
        luck_amount:    p['luck_amount'].to_i,
        luck_label:     p['luck_label'].to_s,
        insight_amount: p['insight_amount'].to_i,
        insight_label:  p['insight_label'].to_s
      ) %>

  <div class="stub-test-capture">
    <label>Confirmed result:
      <textarea id="test-rollstub-result" rows="3" readonly
                placeholder="(press Confirm)"
                style="width:100%;font-family:monospace;font-size:11px;"></textarea>
    </label>
  </div>

  <script>
    document.addEventListener('rollstub:confirm', function(e) {
      var out = document.getElementById('test-rollstub-result');
      if (out) out.value = JSON.stringify(e.detail, null, 2);
    });
  </script>
<% end %>

<h2>Multi Roll Stub</h2>

<%= multi_roll_stub(
      title: 'Group Perception Check',
      rolls: [
        { key: 'alice',   character_name: 'Alice',   check_name: 'Perception',
          dice_count: 6, tn: 6, starting_value: 0,
          luck_amount:    2, luck_label:    'Bardic Inspiration',
          insight_amount: 1, insight_label: 'Heroic Insight' },
        { key: 'bob',     character_name: 'Bob',     check_name: 'Perception',
          dice_count: 5, tn: 6, starting_value: 1,
          luck_amount:   -1, luck_label:    'Unsettling Words' },
        { key: 'charlie', character_name: 'Charlie', check_name: 'Perception',
          dice_count: 4, tn: 7, starting_value: 0 }
      ]
    ) %>

<div class="stub-test-capture">
  <label>Confirmed rows:
    <textarea id="test-multiroll-result" rows="6" readonly
              placeholder="(press Confirm All)"
              style="width:100%;font-family:monospace;font-size:11px;"></textarea>
  </label>
</div>

<script>
  document.addEventListener('multiroll:confirm', function(e) {
    var out = document.getElementById('test-multiroll-result');
    if (out) out.value = JSON.stringify(e.detail.rows, null, 2);
  });
</script>

<h2>Notes Map Stub</h2>

<h3>As player (current turn)</h3>
<%= notes_map_stub(
      entries: DATA.note_maps,
      dm_view: false,
      active_only: true,
      interactive: true,
      scene_state: NOTES_STATE,
      can_draw: true
    ) %>

<% if dm_view? %>
  <h3>As DM</h3>
  <%= notes_map_stub(
        entries: DATA.note_maps,
        dm_view: true,
        active_only: true,
        interactive: true,
        scene_state: NOTES_STATE
      ) %>
<% end %>

<h2>Initiative Stub</h2>

<% current_turn = NOTES_STATE.current_turn || DATA.combat_state['current_turn'] %>

<h3>As current viewer</h3>
<%= initiative_stub(
      turns: DATA.initiative_turns,
      current_combat_id: current_turn,
      dm_view: dm_view?
    ) %>

<h3>As player</h3>
<%= initiative_stub(
      turns: DATA.initiative_turns,
      current_combat_id: current_turn,
      dm_view: false
    ) %>

<h3>Empty state</h3>
<%= initiative_stub(turns: []) %>

<% if dm_view? %>
  <h2>Character Assignment Stub <small>(DM only)</small></h2>
  <%= assignment_stub(
        devices: USER_STORE.list,
        characters: DATA.pcs,
        current_device_id: current_user&.device_id
      ) %>
<% end %>

<h2>Debug Stub</h2>
<%= debug_stub %>
