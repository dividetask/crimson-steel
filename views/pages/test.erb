<% p = @test_params || {} %>
<%# Newest stub previews go at the top — see CLAUDE.md. %>

<h2>Attack Stub</h2>

<p class="dt-note">
  Walks the DM through target &rarr; weapon &rarr; attack dice &rarr; defense
  &rarr; ally reactions &rarr; rolls &rarr; target reactions &rarr; damage.
  Same stub serves melee and ranged. Steps with a single (or zero)
  option auto-advance.
</p>

<%= attack_stub(
      attacker:       DATA.attacker_sample,
      targets:        DATA.target_samples,
      ally_reactions: DATA.ally_reactions,
      luck_sources:   DATA.luck_sources
    ) %>

<div class="stub-test-capture">
  <label>Last attack result:
    <textarea id="test-attack-result" rows="6" readonly
              placeholder="(submit the damage step)"
              style="width:100%;font-family:monospace;font-size:11px;"></textarea>
  </label>
</div>

<script>
  // Echo the attack:confirm payload so the test harness can show
  // what the stub would hand off to a real combat handler.
  document.addEventListener('attack:confirm', function(e) {
    var out = document.getElementById('test-attack-result');
    if (out) out.value = JSON.stringify(e.detail, null, 2);
  });
</script>

<h2>Notes Map Stub</h2>

<h3>As player (current turn)</h3>
<%= notes_map_stub(
      entries: DATA.note_maps,
      dm_view: false,
      active_only: true,
      interactive: true,
      scene_state: NOTES_STATE,
      can_draw: true
    ) %>

<% if dm? %>
  <h3>As DM</h3>
  <%= notes_map_stub(
        entries: DATA.note_maps,
        dm_view: true,
        active_only: true,
        interactive: true,
        scene_state: NOTES_STATE
      ) %>
<% end %>

<h2>Initiative Stub</h2>

<% current_turn = NOTES_STATE.current_turn || DATA.combat_state['current_turn'] %>

<h3>As current viewer</h3>
<%= initiative_stub(
      turns: DATA.initiative_turns,
      current_combat_id: current_turn,
      dm_view: dm?
    ) %>

<h3>As player</h3>
<%= initiative_stub(
      turns: DATA.initiative_turns,
      current_combat_id: current_turn,
      dm_view: false
    ) %>

<h3>Empty state</h3>
<%= initiative_stub(turns: []) %>

<% if dm? %>
  <h2>Character Assignment Stub <small>(DM only)</small></h2>
  <%= assignment_stub(
        devices: USER_STORE.list,
        characters: DATA.pcs,
        current_device_id: current_user&.device_id
      ) %>
<% end %>

<h2>Debug Stub</h2>
<%= debug_stub %>

<h2>Roll Stub</h2>

<form method="post" action="/test" class="stub-test-form">
  <label>Check Name: <input type="text" name="check_name"
         value="<%= h(p['check_name'] || 'Perception') %>"></label>
  <label>Dice Count: <input type="number" name="dice_count" min="1"
         value="<%= h(p['dice_count'] || 6) %>"></label>
  <label>TN: <input type="number" name="tn"
         value="<%= h(p['tn'] || 6) %>"></label>
  <label>Starting Value: <input type="number" name="starting_value"
         value="<%= h(p['starting_value'] || 0) %>"></label>
  <label>Luck Amount: <input type="number" name="luck_amount" min="0"
         value="<%= h(p['luck_amount'] || 2) %>"></label>
  <label>Insight Amount: <input type="number" name="insight_amount" min="0"
         value="<%= h(p['insight_amount'] || 4) %>"></label>
  <button type="submit">Submit</button>
</form>

<% unless p.empty? %>
  <%= roll_stub(
        check_name: p['check_name'].to_s,
        dice_count: p['dice_count'].to_i,
        tn: p['tn'].to_i,
        starting_value: p['starting_value'].to_i,
        luck_bonus_name: "Bardic Inspiration",
        luck_penalty_name: "Unsettling Words",
        luck_amount: p['luck_amount'].to_i,
        insight_bonus_name: "Insight Bonus",
        insight_penalty_name: "Insight Penalty",
        insight_amount: p['insight_amount'].to_i
      ) %>

  <div class="stub-test-capture">
    <label>Confirmed total:
      <input type="text" id="test-confirmed-total" readonly
             placeholder="(press Confirm)">
    </label>
  </div>

  <script>
    // Capture the stub's confirm event so the test harness can show the
    // total it would hand off to whatever feature embeds this stub.
    // The stub itself stays unaware of the listener.
    document.addEventListener('rollstub:confirm', function(e) {
      var out = document.getElementById('test-confirmed-total');
      if (out) out.value = e.detail.value;
    });
  </script>
<% end %>
