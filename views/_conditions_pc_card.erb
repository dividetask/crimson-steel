<%#
  Conditions Downtime PC Card Stub.

  See docs/common/ui/conditions_downtime_pc_card_stub.md.

  Locals:
    creature  — required. Hash with :id, :name, :race, :klass, :tier,
                :max_hp, :mana_max, :charisma, :attributes (hash),
                :consumables (array of {name, tier, quantity}),
                :state (Conditions::State).
    catalog   — required. Conditions::Catalog instance.
    viewer    — :dm or :player. Affects nothing in this stub; the parent
                page filters visible cards by viewer role.
    chrome    — optional boolean (default true). When false the outer
                card framing is suppressed.

  Layout: compact card. HP, Mana, and Toxicity render as four-segment
  bars. Minor HP damage shows only as a bar segment (no row label).
  Moderate / Major HP Damage, Ability Damage, Active Effects,
  Afflictions and Healing items blocks render only when non-empty.
%>
<%
  inst = Conditions::Instance.new(state: creature[:state], catalog: catalog)

  total_hp_damage = creature[:state].hp_damage.values.sum
  current_hp = [creature[:max_hp] - total_hp_damage, 0].max
  minor_dmg    = creature[:state].hp_damage_at(:minor)
  moderate_dmg = creature[:state].hp_damage_at(:moderate)
  major_dmg    = creature[:state].hp_damage_at(:major)

  current_mana = creature[:mana_max] - creature[:state].mana_spent

  threshold = inst.toxicity_threshold(creature[:charisma], creature[:tier])
  tox = creature[:state].magic_toxicity
  tox_blocked = tox > threshold
  tox_pct = threshold.positive? ? [(tox.to_f / threshold * 100).round, 100].min : 0

  hp_total_for_bar = [creature[:max_hp], 1].max
  pct = ->(n) { (n.to_f / hp_total_for_bar * 100).round(2) }

  temp_hp = creature[:state].temporary_hit_points ? creature[:state].temporary_hit_points[:amount] : 0

  ability_chips = []
  Conditions::SEVERITIES.each do |sev|
    (creature[:state].ability_damage[sev] || {}).each do |attr, n|
      ability_chips << { attr: attr, sev: sev, count: n } if n.positive?
    end
  end

  named_mechanics = inst.active_named_effect_mechanics.uniq { |m| m[:effect_name] }

  chrome_on = defined?(chrome) ? chrome : true
%>

<div class="pc-card<%= chrome_on ? '' : ' pc-card-bare' %>" data-creature-id="<%= creature[:id] %>">
  <h3 class="pc-name tier-<%= creature[:tier] %>"><%= creature[:name] %></h3>
  <div class="pc-subtitle">
    <%= creature[:race] %> <%= creature[:klass] %> &middot; Tier <%= creature[:tier] %>
  </div>

  <div class="pc-bar-row">
    <span class="pc-bar-label">HP</span>
    <div class="bar bar-hp">
      <span class="bar-seg seg-hp"          style="width: <%= pct.call(current_hp) %>%"></span>
      <span class="bar-seg seg-hp-minor"    style="width: <%= pct.call(minor_dmg) %>%"></span>
      <span class="bar-seg seg-hp-moderate" style="width: <%= pct.call(moderate_dmg) %>%"></span>
      <span class="bar-seg seg-hp-major"    style="width: <%= pct.call(major_dmg) %>%"></span>
    </div>
    <span class="pc-bar-value"><%= current_hp %>/<%= creature[:max_hp] %></span>
  </div>

  <div class="pc-bar-row">
    <span class="pc-bar-label">Mana</span>
    <div class="bar bar-mana">
      <span class="bar-seg seg-mana"
            style="width: <%= creature[:mana_max].positive? ? (current_mana.to_f / creature[:mana_max] * 100).round(2) : 0 %>%"></span>
    </div>
    <span class="pc-bar-value"><%= current_mana %>/<%= creature[:mana_max] %></span>
  </div>

  <div class="pc-bar-row">
    <span class="pc-bar-label">Toxicity</span>
    <div class="bar bar-tox <%= 'bar-tox-blocked' if tox_blocked %>">
      <span class="bar-seg seg-tox" style="width: <%= tox_pct %>%"></span>
    </div>
    <span class="pc-bar-value"><%= tox %>/<%= threshold %></span>
  </div>

  <% if temp_hp.positive? %>
    <div class="pc-line"><span class="label">Temp HP</span><span class="value"><%= temp_hp %></span></div>
  <% end %>

  <% if moderate_dmg.positive? || major_dmg.positive? %>
    <div class="pc-dmg-row">
      <% if moderate_dmg.positive? %>
        <span class="pc-dmg-pill pc-dmg-moderate">Mod <%= moderate_dmg %></span>
      <% end %>
      <% if major_dmg.positive? %>
        <span class="pc-dmg-pill pc-dmg-major">Maj <%= major_dmg %></span>
      <% end %>
    </div>
  <% end %>

  <% if ability_chips.any? %>
    <div class="pc-stats pc-ability-damage">
      <% ability_chips.each do |chip|
           sev_class = case chip[:sev]
                       when :major    then 'pc-dmg-major'
                       when :moderate then 'pc-dmg-moderate'
                       else 'pc-dmg-minor'
                       end %>
        <div class="pc-line <%= sev_class %>"><span class="label"><%= chip[:sev].to_s.capitalize %> <%= chip[:attr].to_s.upcase %> Damage</span><span class="value"><%= chip[:count] %></span></div>
      <% end %>
    </div>
  <% end %>

  <% if named_mechanics.any? %>
    <div class="pc-section">
      <h4>Active effects</h4>
      <ul class="effect-badges">
        <% named_mechanics.each do |m| %>
          <li class="effect-badge"><%= m[:effect_name] %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <% if creature[:state].afflictions.any? %>
    <div class="pc-section">
      <h4>Afflictions</h4>
      <table class="affliction-table">
        <thead>
          <tr><th>Affliction</th><th>Potency</th></tr>
        </thead>
        <tbody>
          <% creature[:state].afflictions.each do |name, a| %>
            <tr>
              <td><%= name %></td>
              <td class="potency tier-<%= a[:inflicting_tier] %>"><%= a[:potency] %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>

  <% if creature[:consumables] && creature[:consumables].any? %>
    <div class="pc-section">
      <h4>Healing items</h4>
      <ul class="consumable-list">
        <% creature[:consumables].each do |item| %>
          <li class="tier-<%= item[:tier] %>"><%= item[:name] %><% if item[:quantity].to_i > 1 %> ×<%= item[:quantity] %><% end %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
</div>
