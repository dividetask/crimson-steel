<%
  nav_items = [
    { key: 'status',        label: 'Status',           href: '/status' },
    { key: 'dice',          label: 'Dice Resolution',  href: '/status?view=dice' },
    { key: 'check',         label: 'Check Resolution', href: '/status?view=check' },
    { key: 'conditions',    label: 'Conditions',       href: '/status?view=conditions' },
    { key: 'creatures',     label: 'Creatures',        href: '/status?view=creatures' },
    { key: 'encounter',     label: 'Encounter',        href: '/status?view=encounter' },
    { key: 'timekeeping',   label: 'Timekeeping',      href: '/status?view=timekeeping' },
    { key: 'chronicle',     label: 'Chronicle',        href: '/status?view=chronicle' }
  ]
%>

<div class="status-layout">
  <aside class="status-nav">
    <ul>
      <% nav_items.each do |item| %>
        <li class="<%= 'active' if @view == item[:key] %>">
          <a href="<%= item[:href] %>"><%= item[:label] %></a>
        </li>
      <% end %>
    </ul>
  </aside>

  <section class="status-content">
    <% case @view
       when 'dice' %>
      <h1>Dice Resolution</h1>
      <p class="lead">Roll Resolution Stubs &mdash; one per Roll, each in its own Rolls wrapper.</p>
      <% @rolls.each do |r| %>
        <%= erb :_roll_stub, locals: { rolls: [r] } %>
      <% end %>

    <% when 'check' %>
      <h1>Check Resolution</h1>
      <p class="lead">Check Resolution Stub &mdash; one Rolls wrapper containing multiple Rolls.</p>
      <%= erb :_check_stub, locals: { check: @check } %>

      <h2>Save Resolution Demo</h2>
      <p class="lead">One example Save Resolution Stub (a Bleed save with both a Reroll source and a Blessing Nudge source). The Conditions-tied examples live on the Conditions sub-view.</p>
      <% @save_examples.each do |s| %>
        <%= erb :_conditions_save_resolution, locals: { save: s } %>
      <% end %>

    <% when 'conditions' %>
      <h1>Conditions &mdash; Downtime PC Cards</h1>
      <p class="lead">One card per player-character Creature: current Conditions State plus carried Consumables.</p>
      <div class="pc-card-grid">
        <% @creatures.each do |creature| %>
          <%= erb :_conditions_pc_card,
                  locals: { creature: creature, catalog: @catalog, viewer: :dm } %>
        <% end %>
      </div>

      <h2>Save Resolution</h2>
      <p class="lead">Conditions Save Resolution Stub examples &mdash; one per Affliction save scenario.</p>
      <% @save_examples.each do |s| %>
        <%= erb :_conditions_save_resolution, locals: { save: s } %>
      <% end %>

    <% when 'creatures' %>
      <h1>Creatures &mdash; Character Sheet Stubs</h1>
      <p class="lead">Each sample Creature is rendered twice: first through the Minimal Sheet stub (<code>docs/common/ui/creatures_minimal_stub.md</code>), then through the Full Sheet stub (<code>docs/common/ui/creatures_full_stub.md</code>). Use this page to compare the two layouts side-by-side; the live <code>/character-sheets</code> page picks one or the other via the detail-mode toggle.</p>
      <% @creature_demos.each do |demo| %>
        <h2 class="cs-demo-label"><%= demo[:label] %></h2>
        <%= erb :_creature_minimal, locals: { demo: demo } %>
        <%= erb :_creature_full,    locals: { demo: demo } %>
      <% end %>

    <% when 'encounter' %>
      <h1>Encounter &mdash; Combat Tracker Stub</h1>
      <p class="lead">The Encounter Initiative Stub (<code>docs/common/ui/encounter_initiative_stub.md</code>), rendered once per scenario to compare how it looks across viewer roles and Combat state. The live tracker lives on <code>/encounter</code> and is fed from the Encounter, Creatures, and Conditions domains; these examples use hand-curated rows.</p>
      <div class="tk-stack">
        <% @encounter_scenarios.each do |sc| %>
          <div class="tk-stack-row">
            <div class="tk-stack-label"><%= sc[:label] %></div>
            <%= erb :_initiative_stub, locals: {
                  rows: sc[:rows], combat_active: sc[:combat_active],
                  viewer: sc[:viewer], round_label: sc[:round_label] } %>
          </div>
        <% end %>
      </div>

    <% when 'timekeeping' %>
      <h1>Timekeeping</h1>
      <p class="lead">Timekeeping Stub &mdash; one banner per example Timestamp, varying the Time of Day to show how the sun and moon trace across the sky and how the day/night background transitions.</p>
      <div class="tk-stack">
        <% @timekeeping_examples.each do |ex| %>
          <div class="tk-stack-row">
            <div class="tk-stack-label"><%= ex[:label] %></div>
            <%= erb :_timekeeping_stub, locals: { timestamp: ex[:timestamp] } %>
          </div>
        <% end %>
      </div>

    <% when 'chronicle' %>
      <h1>Chronicle</h1>
      <p class="lead">Five example Entries, rendered first under the DM viewer role and then under a player viewer (Bryn). Status tags and the Edit affordance only appear when the viewer is allowed to see or change them.</p>

      <h2>DM View</h2>
      <div class="notes-list">
        <% @chronicle_examples.each do |ex| %>
          <div class="ce-example-row">
            <div class="ce-example-label"><%= ex[:label] %></div>
            <%= erb :_chronicle_entry, locals: { entry: ex[:entry], viewer: :dm, viewing_id: nil, player_creatures: Creatures.player_controlled } %>
          </div>
        <% end %>
      </div>

      <h2>Player View</h2>
      <div class="notes-list">
        <% @chronicle_examples.each do |ex| %>
          <div class="ce-example-row">
            <div class="ce-example-label"><%= ex[:label] %></div>
            <%= erb :_chronicle_entry, locals: { entry: ex[:entry], viewer: :player, viewing_id: 2, player_creatures: Creatures.player_controlled } %>
          </div>
        <% end %>
      </div>

    <% else %>
      <h1>Status</h1>
      <p class="lead">Pick a stub from the menu on the left.</p>
    <% end %>

    <% if @tests_html %>
      <section class="tests-doc">
        <h2><%= @tests_title %></h2>
        <%= @tests_html %>
      </section>
    <% end %>
  </section>
</div>

<script type="module" src="/app.js"></script>
