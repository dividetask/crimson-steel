<%#
  Check Resolution Stub. Renders one .rolls-wrapper containing every
  Supporting and Opposing Roll (in that order, with no visible
  divider — order is the convention).

  Local: check — hash with :supporting and :opposing arrays of Rolls.

  Confirm collapses the wrapper to the .rolls-results section just
  like the standalone Roll Resolution Stub does; Change un-collapses
  without resetting any values.
%>
<%
  all_rolls = check[:supporting] + check[:opposing]
  roll_label = all_rolls.length > 1 ? 'Roll All' : 'Roll'
%>
<div class="rolls-wrapper" data-stub="check" data-state="active">
  <div class="rolls-header">
    <span class="rolls-title">Rolls</span>
    <div class="rolls-actions">
      <button type="button" class="btn-roll-all"><%= roll_label %></button>
      <button type="button" class="btn-confirm">Confirm</button>
    </div>
  </div>
  <table class="stub-table roll-table">
    <colgroup>
      <col class="col-character">
      <col class="col-mod">
      <col class="col-mod">
      <col class="col-dice">
      <col class="col-result">
      <col class="col-result">
      <col class="col-lock">
    </colgroup>
    <thead>
      <tr>
        <th>Character</th>
        <th>Reroll</th>
        <th>Nudge</th>
        <th>Dice</th>
        <th>Result</th>
        <th>Crits</th>
        <th></th>
      </tr>
    </thead>
    <%= erb :_roll_stub, locals: { rolls: all_rolls, wrapper: false } %>
  </table>
  <div class="rolls-results" hidden>
    <% all_rolls.each_with_index do |roll, idx| %>
      <div class="rolls-result-row" data-roll-idx="<%= idx %>">
        <span class="rolls-result-name"><%= roll[:roll_name] %>:</span>
        <span class="rolls-result-value"></span>
      </div>
    <% end %>
    <button type="button" class="btn-rolls-change"><span class="cr-change-icon">↶</span> Change</button>
  </div>
</div>
