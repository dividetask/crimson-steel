<%#
  Roll Table Reaction Stub — docs/common/ui/encounter_roll_table_stub.md

  Rendered alongside the Attack Action Builder, in the same place as the
  Standard Shield's ally block, when a Combatant other than the attacker can
  answer this attack with a Roll Table Reaction (Kesser's Gambit). Picking a
  channeler mounts the channel-check Action Builder (Evocation for the Ring,
  Invocation for a Cleric's Channel Divinity); on Confirm the rolled Channel
  Successes + dice POST to /encounter/roll_table_reaction, a die is rolled on
  the table, and the matched entry renders for the DM to adjudicate.

  Locals:
    channelers  — see roll_table_reaction_channelers in lib/routes/encounter.rb
    attacker_id — the attacking Combatant id
%>
<% require 'cgi' %>
<section class="ta-roll-table" data-attacker-id="<%= attacker_id %>" aria-label="Roll Table Reactions">
  <div class="ta-rt-head">
    <h4 class="ta-rt-title">Reactions</h4>
    <p class="ta-rt-lead">A bystander may channel a Roll Table Reaction against this attack.</p>
  </div>
  <div class="ta-rt-menu cb-line">
    <% channelers.each do |ch| %>
      <button type="button" class="cr-mod-btn cb-opt ta-rt-opt"
              data-combatant-id="<%= ch[:combatant_id] %>"
              data-ability="<%= CGI.escapeHTML(ch[:ability].to_s) %>"
              data-table="<%= CGI.escapeHTML(ch[:table].to_s) %>"
              data-skill="<%= ch[:skill] %>"
              <% if ch[:disabled] %>disabled title="<%= ch[:disabled_reason] %>"<% end %>>
        <%= CGI.escapeHTML(ch[:name].to_s) %> &mdash; <%= CGI.escapeHTML(ch[:ability].to_s) %>
        <span class="ta-rt-skill">(<%= ch[:skill_label] %>, <%= ch[:mana_cost] %> mana)</span>
      </button>
    <% end %>
  </div>
  <div class="ta-rt-builder" hidden></div>
  <div class="ta-rt-result" hidden></div>
</section>
