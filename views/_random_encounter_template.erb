<%
  # Creatures Encounter Template Stub —
  # docs/common/ui/creatures_random_encounter_template_stub.md
  #
  # Locals:
  #   table_id — string, the snake_case Random Encounter Table key.
  #   table    — Hash from random_encounter_tables.yaml ({'name', 'rolls'}).
  #   name_for — callable: template_id (Integer) → String. Resolves
  #              the Creature template name.
%>

<article class="cs-random-encounter-template">
  <header class="cs-enc-header">
    <h2 class="cs-enc-name"><%= table['name'] || table_id %></h2>
    <div class="cs-enc-subtitle"><code><%= table_id %></code></div>
  </header>

  <section class="cs-enc-body">
    <% Array(table['rolls']).each_with_index do |row, idx| %>
      <%
        chance_text =
          if row.key?('chance')
            sprintf('%d%%', (row['chance'].to_f * 100).round)
          else
            'Always'
          end
      %>
      <div class="cs-enc-row">
        <div class="cs-enc-row-head">
          <span class="cs-enc-row-chance"><%= chance_text %></span>
          <% if row['when'] %>
            <span class="cs-enc-row-when">
              <% row['when'].each do |k, v| %>
                When <code><%= k %></code> = <code><%= v %></code>
              <% end %>
            </span>
          <% end %>
          <% if row['as'] %>
            <span class="cs-enc-row-as">Publishes <code><%= row['as'] %></code></span>
          <% end %>
        </div>
        <ul class="cs-enc-spawn-list">
          <% Array(row['spawn']).each do |s| %>
            <li class="cs-enc-spawn">
              <span class="cs-enc-spawn-count"><%= s['count'] || 1 %>×</span>
              <span class="cs-enc-spawn-name">
                <% if s['name_override'] %>
                  <%= s['name_override'] %>
                  <em class="cs-enc-template-src">(<%= name_for.call(Integer(s['template_id'])) %>)</em>
                <% else %>
                  <%= name_for.call(Integer(s['template_id'])) %>
                <% end %>
              </span>
              <% if s['loot_table'] %>
                <em class="cs-enc-loot-tag">loot: <%= s['loot_table'] %></em>
              <% end %>
            </li>
          <% end %>
        </ul>
      </div>
    <% end %>
  </section>

  <footer class="cs-enc-footer">
    <button type="button"
            class="cs-enc-roll-btn cs-random-encounter-roll-btn"
            data-table-id="<%= table_id %>"
            data-table-name="<%= table['name'] || table_id %>">Roll</button>
  </footer>
</article>
