<%#
  Conditions Save Resolution Stub.

  Renders as a single Rolls wrapper. Each save walks four steps:
  Rerolls → Nudges → Dice → Result. Steps without inputs collapse
  silently (a save with no reroll sources starts on Dice).

  Layout (top → bottom inside the wrapper):
    - .rolls-header     (title + active step's controls)
    - .step-summaries   (one row per completed step, below the header)
    - per-step .step-body blocks (only the active step's body renders)

  Lifecycle per step:
    - active   — body visible, controls render in .rolls-actions
    - pending  — body + controls hidden
    - complete — body + controls hidden, a thin summary row appears
                 in .step-summaries (with a Change button to re-open)

  Locals:
    save  — see conditions_save_resolution_stub.md
%>
<%
  require 'json'

  s = save
  c = s[:creature]
  a = s[:affliction]
  stub_id = s[:stub_id]

  effect_kind = a[:rule]['effect']['kind']
  effect_severity = a[:rule]['effect']['severity']
  effect_attribute = a[:rule]['effect']['attribute']
  effect_named = a[:rule]['effect']['name']

  category_label = (a[:rule]['category'] || a[:name]).to_s
                                                     .split('_')
                                                     .map(&:capitalize)
                                                     .join(' ')

  preview_data = {
    potency_before:  a[:potency],
    potency_divisor: s[:potency_divisor],
    effect: a[:rule]['effect'],
    creature_tier:   c[:tier]
  }

  has_reroll      = !s[:reroll_sources].nil? && !s[:reroll_sources].empty?
  has_mass_reroll = !s[:mass_reroll_sources].nil? && !s[:mass_reroll_sources].empty?
  has_nudge       = !s[:nudge_sources].nil? && !s[:nudge_sources].empty?

  interactive_steps = []
  interactive_steps << :reroll      if has_reroll
  interactive_steps << :mass_reroll if has_mass_reroll
  interactive_steps << :nudge       if has_nudge

  first_active = interactive_steps.first || :dice

  step_label = {
    reroll:      'Rerolls',
    mass_reroll: 'Mass Rerolls',
    nudge:       'Nudges',
    dice:        'Result'
  }

  base_roll = {
    creature_name: c[:name],
    roll_name:     "#{category_label} Save",
    dice_count:    s[:save_dice],
    tn:            s[:save_tn],
    die_size:      s[:die_size],
    starting_value: 0,
    reroll: nil, mass_reroll: nil, nudge: nil,
    dois: 0, critical_count: 0
  }
  rolls = [base_roll]

  render_mod_step_body = lambda do |kind, sources|
    out = +%(<table class="step-mod-table"><thead><tr><th>Roll</th>)
    sources.each do |src|
      out << %(<th><span class="step-mod-src">#{src[:source_name]}</span>)
      out << %( <span class="step-mod-actor">(#{src[:creature_name]})</span></th>)
    end
    out << '</tr></thead><tbody>'
    rolls.each_with_index do |r, idx|
      out << %(<tr><td class="step-mod-rollname">#{r[:roll_name]}</td>)
      sources.each do |src|
        out << '<td class="step-mod-buttons">'
        if kind == :mass_reroll
          sign_ch = src[:direction] == 'neg' ? '-' : '+'
          out << %(<button type="button" class="cr-mod-btn" )
          out << %(data-kind="mass_reroll" data-roll-idx="#{idx}" )
          out << %(data-sign="#{src[:direction]}" data-label="#{src[:source_name]}">#{sign_ch}*</button>)
        else
          (1..src[:pool].to_i).each do |n|
            sign_ch = src[:direction] == 'neg' ? '-' : '+'
            out << %(<button type="button" class="cr-mod-btn" )
            out << %(data-kind="#{kind}" data-roll-idx="#{idx}" )
            out << %(data-sign="#{src[:direction]}" data-count="#{n}" )
            out << %(data-label="#{src[:source_name]}">#{sign_ch}#{n}</button>)
          end
        end
        out << '</td>'
      end
      out << '</tr>'
    end
    out << '</tbody></table>'
    out
  end
%>

<div class="rolls-wrapper save-resolution" data-stub-id="<%= stub_id %>"
     data-preview='<%= preview_data.to_json %>'>

  <div class="rolls-header">
    <span class="rolls-title"><%= category_label %> Save - <%= c[:name] %></span>
    <div class="rolls-actions">
      <% interactive_steps.each do |kind| %>
        <div class="step-controls" data-step="<%= kind %>"
             data-state="<%= first_active == kind ? 'active' : 'pending' %>">
          <button type="button" class="cr-step-none" data-step="<%= kind %>">None</button>
        </div>
      <% end %>
      <div class="step-controls" data-step="dice"
           data-state="<%= first_active == :dice ? 'active' : 'pending' %>">
        <button type="button" class="btn-roll-all">Roll</button>
        <button type="button" class="btn-confirm-all">Confirm</button>
      </div>
      <div class="step-controls" data-step="result" data-state="pending">
        <button type="button" class="btn-save-confirm">Confirm</button>
      </div>
    </div>
  </div>

  <div class="step-summaries">
    <% (interactive_steps + [:dice]).each do |kind| %>
      <div class="step-summary" data-step="<%= kind %>" hidden>
        <span class="step-summary-label"><%= step_label[kind] %>:</span>
        <span class="step-summary-value"></span>
        <button type="button" class="cr-step-change" data-step="<%= kind %>"><span class="cr-change-icon">↶</span> Change</button>
      </div>
    <% end %>
  </div>

  <% if has_reroll %>
    <div class="step-body" data-step="reroll"
         data-state="<%= first_active == :reroll ? 'active' : 'pending' %>">
      <%= render_mod_step_body.call(:reroll, s[:reroll_sources]) %>
    </div>
  <% end %>

  <% if has_mass_reroll %>
    <div class="step-body" data-step="mass_reroll"
         data-state="<%= first_active == :mass_reroll ? 'active' : 'pending' %>">
      <%= render_mod_step_body.call(:mass_reroll, s[:mass_reroll_sources]) %>
    </div>
  <% end %>

  <% if has_nudge %>
    <div class="step-body" data-step="nudge"
         data-state="<%= first_active == :nudge ? 'active' : 'pending' %>">
      <%= render_mod_step_body.call(:nudge, s[:nudge_sources]) %>
    </div>
  <% end %>

  <div class="step-body step-body-dice" data-step="dice"
       data-state="<%= first_active == :dice ? 'active' : 'pending' %>">
    <table class="stub-table roll-table">
      <colgroup>
        <col class="col-character">
        <col class="col-mod">
        <col class="col-mod">
        <col class="col-dice">
        <col class="col-result">
        <col class="col-result">
        <col class="col-lock">
      </colgroup>
      <thead>
        <tr>
          <th>Character</th>
          <th>Reroll</th>
          <th>Nudge</th>
          <th>Dice</th>
          <th>Result</th>
          <th>Crits</th>
          <th></th>
        </tr>
      </thead>
      <%= erb :_roll_stub, locals: { rolls: [base_roll], wrapper: false } %>
    </table>
  </div>

  <div class="step-body step-body-result" data-step="result" data-state="pending">
    <input type="hidden" class="sp-dois" value="0">
    <input type="hidden" class="sp-net-mag" value="0">
    <div class="save-preview-fields">
      <% if effect_kind == 'hit_point_damage' %>
        <label><%= effect_severity.to_s.capitalize %> HP Damage
          <input type="number" class="sp-effect-amount" data-kind="hit_point_damage" data-severity="<%= effect_severity %>" value="0">
        </label>
      <% elsif effect_kind == 'ability_damage' %>
        <label><%= effect_severity.to_s.capitalize %> <%= effect_attribute.to_s.upcase %> Damage
          <input type="number" class="sp-effect-amount" data-kind="ability_damage" data-severity="<%= effect_severity %>" data-attribute="<%= effect_attribute %>" value="0">
        </label>
      <% elsif effect_kind == 'named_effect' %>
        <label>Apply effect
          <input type="text" class="sp-effect-amount" data-kind="named_effect" data-name="<%= effect_named %>" value="(none)" readonly>
        </label>
      <% end %>
      <label>Adjusted Potency <input type="number" class="sp-new-potency" value="<%= a[:potency] %>"></label>
    </div>
  </div>
</div>
