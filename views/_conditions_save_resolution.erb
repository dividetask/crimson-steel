<%#
  Conditions Save Resolution Stub.

  Renders as a single Rolls wrapper (matching the Roll Resolution stub
  shell) with the Builder's step controls living inside the header's
  Rolls Actions slot — the same place Roll All / Confirm All live on
  the underlying Check Resolution Stub. One step is active at a time:
  Rerolls → Nudges → (Roll All / Confirm All) → effect preview. The
  dice table and preview stay hidden until every interactive step has
  been resolved or skipped via None.

  Locals:
    save  — required. See conditions_save_resolution_stub.md.
%>
<%
  require 'json'

  s = save
  c = s[:creature]
  a = s[:affliction]
  stub_id = s[:stub_id]

  effect_kind = a[:rule]['effect']['kind']
  effect_severity = a[:rule]['effect']['severity']
  effect_attribute = a[:rule]['effect']['attribute']
  effect_named = a[:rule]['effect']['name']

  category_label = (a[:rule]['category'] || a[:name]).to_s
                                                     .split('_')
                                                     .map(&:capitalize)
                                                     .join(' ')

  preview_data = {
    potency_before:  a[:potency],
    potency_divisor: s[:potency_divisor],
    effect: a[:rule]['effect'],
    creature_tier:   c[:tier]
  }

  has_reroll      = !s[:reroll_sources].nil? && !s[:reroll_sources].empty?
  has_mass_reroll = !s[:mass_reroll_sources].nil? && !s[:mass_reroll_sources].empty?
  has_nudge       = !s[:nudge_sources].nil? && !s[:nudge_sources].empty?

  steps = []
  steps << :reroll      if has_reroll
  steps << :mass_reroll if has_mass_reroll
  steps << :nudge       if has_nudge

  initial_active = steps.first || :check
  check_state = steps.empty? ? 'active' : 'pending'

  step_label = { reroll: 'Rerolls', mass_reroll: 'Mass Rerolls', nudge: 'Nudges' }

  base_roll = {
    creature_name: c[:name],
    roll_name:     "Save vs #{a[:name]}",
    dice_count:    s[:save_dice],
    tn:            s[:save_tn],
    die_size:      s[:die_size],
    starting_value: 0,
    reroll: nil, mass_reroll: nil, nudge: nil,
    dois: 0, critical_count: 0
  }

  render_step_controls = lambda do |kind, sources|
    out = +''
    sources.each do |src|
      out << %(<span class="step-src-tag">#{src[:source_name]}:</span>)
      if kind == :mass_reroll
        sign_ch = src[:direction] == 'neg' ? '-' : '+'
        out << %(<button type="button" class="cr-mod-btn" )
        out << %(data-kind="mass_reroll" data-roll-idx="0" )
        out << %(data-sign="#{src[:direction]}" data-label="#{src[:source_name]}">#{sign_ch}*</button>)
      else
        (1..src[:pool].to_i).each do |n|
          sign_ch = src[:direction] == 'neg' ? '-' : '+'
          out << %(<button type="button" class="cr-mod-btn" )
          out << %(data-kind="#{kind}" data-roll-idx="0" )
          out << %(data-sign="#{src[:direction]}" data-count="#{n}" )
          out << %(data-label="#{src[:source_name]}">#{sign_ch}#{n}</button>)
        end
      end
    end
    out << %(<button type="button" class="cr-step-none" data-step="#{kind}">None</button>)
    out
  end
%>

<div class="rolls-wrapper save-resolution" data-stub-id="<%= stub_id %>"
     data-preview='<%= preview_data.to_json %>'>
  <div class="rolls-header">
    <span class="rolls-title"><%= category_label %> Save - <%= c[:name] %></span>
    <div class="rolls-actions">
      <% if has_reroll %>
        <div class="step-controls" data-step="reroll"
             data-state="<%= initial_active == :reroll ? 'active' : 'pending' %>">
          <%= render_step_controls.call(:reroll, s[:reroll_sources]) %>
        </div>
      <% end %>
      <% if has_mass_reroll %>
        <div class="step-controls" data-step="mass_reroll"
             data-state="<%= initial_active == :mass_reroll ? 'active' : 'pending' %>">
          <%= render_step_controls.call(:mass_reroll, s[:mass_reroll_sources]) %>
        </div>
      <% end %>
      <% if has_nudge %>
        <div class="step-controls" data-step="nudge"
             data-state="<%= initial_active == :nudge ? 'active' : 'pending' %>">
          <%= render_step_controls.call(:nudge, s[:nudge_sources]) %>
        </div>
      <% end %>
      <div class="step-controls" data-step="check" data-state="<%= check_state %>">
        <button type="button" class="btn-roll-all">Roll All</button>
        <button type="button" class="btn-confirm-all">Confirm All</button>
      </div>
    </div>
  </div>

  <% if steps.any? %>
    <div class="step-summaries">
      <% steps.each do |kind| %>
        <div class="step-summary" data-step="<%= kind %>" hidden>
          <span class="step-summary-label"><%= step_label[kind] %>:</span>
          <span class="step-summary-value"></span>
          <button type="button" class="cr-step-change" data-step="<%= kind %>">Change</button>
        </div>
      <% end %>
    </div>
  <% end %>

  <table class="stub-table roll-table save-roll-table"
         data-roll-state="<%= check_state %>">
    <colgroup>
      <col class="col-character">
      <col class="col-mod">
      <col class="col-mod">
      <col class="col-dice">
      <col class="col-result">
      <col class="col-result">
      <col class="col-lock">
    </colgroup>
    <thead>
      <tr>
        <th>Character</th>
        <th>Reroll</th>
        <th>Nudge</th>
        <th>Dice</th>
        <th>Result</th>
        <th>Crits</th>
        <th></th>
      </tr>
    </thead>
    <%= erb :_roll_stub, locals: { roll: base_roll, rows_only: true } %>
  </table>

  <div class="save-preview" hidden>
    <div class="save-preview-fields">
      <label>DoIS <input type="number" class="sp-dois" value="0"></label>
      <label>Net Magnitude <input type="number" class="sp-net-mag" value="0"></label>
      <% if effect_kind == 'hit_point_damage' %>
        <label><%= effect_severity.to_s.capitalize %> HP Damage
          <input type="number" class="sp-effect-amount" data-kind="hit_point_damage" data-severity="<%= effect_severity %>" value="0">
        </label>
      <% elsif effect_kind == 'ability_damage' %>
        <label><%= effect_severity.to_s.capitalize %> <%= effect_attribute.to_s.upcase %> Damage
          <input type="number" class="sp-effect-amount" data-kind="ability_damage" data-severity="<%= effect_severity %>" data-attribute="<%= effect_attribute %>" value="0">
        </label>
      <% elsif effect_kind == 'named_effect' %>
        <label>Apply effect
          <input type="text" class="sp-effect-amount" data-kind="named_effect" data-name="<%= effect_named %>" value="(none)" readonly>
        </label>
      <% end %>
      <label>New Potency <input type="number" class="sp-new-potency" value="<%= a[:potency] %>"></label>
    </div>
    <button type="button" class="btn-save-confirm" disabled>Confirm</button>
    <span class="save-confirm-msg"></span>
  </div>
</div>
