<%#
  Roll Resolution Stub.

  Locals:
    rolls    — required Array of Roll hashes. Single-Roll callers pass [roll].
    wrapper  — Bool, default true. true = full standalone shell
               (.rolls-wrapper + header + <table> + .rolls-results);
               false = only the per-Roll <tbody> blocks (the parent
               supplies the wrapper, the table, and any collapse UI).
    stub_id  — optional String for JS targeting.

  Standalone shell:
    - Header: title "Rolls" + first button + Confirm.
        First button label: "Roll" when rolls.length == 1, "Roll All"
        when > 1. CSS class stays .btn-roll-all so existing handlers
        bind.
    - Confirm collapses the table: every per-Roll Result + Crits is
      written into a row in .rolls-results, the table + header
      buttons hide, and the .rolls-results section reveals (with a
      single Change button at the right edge).
    - Change un-collapses without resetting anything. The dice and
      input values stay as the DM left them; the section simply
      hides and the table + buttons return.
%>
<%
  require 'json'

  all_rolls   = defined?(rolls) ? rolls : []
  wrapper_on  = defined?(wrapper) ? wrapper : true
  sid         = defined?(stub_id) ? stub_id : nil
  roll_label  = all_rolls.length > 1 ? 'Roll All' : 'Roll'

  fmt_amount = lambda do |mod|
    next nil if mod.nil?
    sign = (mod[:sign] || (mod[:amount].to_i.negative? ? :neg : :pos))
    sign_ch = sign == :neg ? '-' : '+'
    magnitude = mod[:max] ? '*' : mod[:amount].abs.to_s
    "#{sign_ch}#{magnitude}"
  end

  fmt_mass = lambda do |mod|
    next nil if mod.nil?
    sign_ch = mod[:sign] == :neg ? '-' : '+'
    "#{sign_ch}*"
  end

  serialize_amount = lambda do |mod|
    next nil if mod.nil?
    sign = (mod[:sign] || (mod[:amount].to_i.negative? ? :neg : :pos))
    { sign: sign.to_s, count: mod[:amount].to_i.abs, max: mod[:max] ? true : false }
  end

  serialize_mass = lambda do |mod|
    next nil if mod.nil?
    { sign: mod[:sign].to_s }
  end
%>

<% if wrapper_on %>
<div class="rolls-wrapper" data-stub="roll" data-state="active"<%= sid ? %( data-stub-id="#{sid}") : '' %>>
  <div class="rolls-header">
    <span class="rolls-title">Rolls</span>
    <div class="rolls-actions">
      <button type="button" class="btn-roll-all"><%= roll_label %></button>
      <button type="button" class="btn-confirm">Confirm</button>
    </div>
  </div>
  <table class="stub-table roll-table">
    <colgroup>
      <col class="col-character">
      <col class="col-mod">
      <col class="col-mod">
      <col class="col-dice">
      <col class="col-result">
      <col class="col-result">
      <col class="col-lock">
    </colgroup>
    <thead>
      <tr>
        <th>Character</th>
        <th>Reroll</th>
        <th>Nudge</th>
        <th>Dice</th>
        <th>Result</th>
        <th>Crits</th>
        <th></th>
      </tr>
    </thead>
<% end %>

<% all_rolls.each_with_index do |roll, roll_idx| %>
  <% DiceResolution::Roll.validate!(roll) %>
  <%
    starting_text =
      if roll[:starting_value].to_i.positive?
        ", R+#{roll[:starting_value]}"
      elsif roll[:starting_value].to_i.negative?
        ", R-#{roll[:starting_value].abs}"
      else
        ''
      end

    reroll_text      = fmt_amount.call(roll[:reroll])
    mass_reroll_text = fmt_mass.call(roll[:mass_reroll])
    nudge_text       = fmt_amount.call(roll[:nudge])
    has_reroll       = !reroll_text.nil?
    has_mass_reroll  = !mass_reroll_text.nil?
    has_nudge        = !nudge_text.nil?
    row_count        = 1 + (has_reroll ? 1 : 0) + (has_mass_reroll ? 1 : 0) + (has_nudge ? 1 : 0)

    group_config = {
      dice_count:     roll[:dice_count],
      tn:             roll[:tn],
      die_size:       roll[:die_size],
      starting_value: roll[:starting_value].to_i,
      reroll:         serialize_amount.call(roll[:reroll]),
      mass_reroll:    serialize_mass.call(roll[:mass_reroll]),
      nudge:          serialize_amount.call(roll[:nudge])
    }
    # Optional TN-breakdown fields (used by the Action Builder to
    # show how Bonuses/Penalties formed the TN — dice_resolution_roll_tooltip.md).
    group_config[:base_tn]            = roll[:base_tn]            if roll[:base_tn]
    group_config[:bonus_penalty_list] = roll[:bonus_penalty_list] if roll[:bonus_penalty_list]
    group_config[:speed]              = roll[:speed]             if roll.key?(:speed)
    # Creature Tier for the Check Resolution Tier Mismatch (Ascendancy).
    group_config[:tier]               = roll[:tier]              if roll.key?(:tier)

    # Computation line for the character-cell TN tooltip: "Base ±mods = TN n".
    # A Bonus lowers the TN, so it shows as a negative term ("−2 Competency");
    # a Penalty raises it, shown as positive. (This is the pre-JS fallback; the
    # Check Builder re-renders it via Check Resolution after propagation.)
    tn_breakdown =
      if roll[:base_tn]
        terms = Array(roll[:bonus_penalty_list]).map do |type, amt, source|
          label = source ? "(#{source})" : type
          "#{amt.to_i >= 0 ? '+' : '−'}#{amt.to_i.abs} #{label}"
        end
        "#{terms.empty? ? '' : terms.join(' ') + ' = '}TN #{roll[:tn]}"
      end

    starting_value = roll[:starting_value].to_i
    starting_squares_html = +''
    if starting_value != 0
      cls = starting_value.positive? ? 'success' : 'fail'
      starting_value.abs.times do
        starting_squares_html << %(<span class="die #{cls} starting-die">&nbsp;</span>)
      end
      starting_squares_html << ' '
    end
  %>

  <tbody class="roll-group<%= ' roll-group-excluded' if roll[:excluded] %>" data-roll-idx="<%= roll_idx %>"<%= roll[:id] ? %( data-roll-id="#{roll[:id]}") : '' %><%= roll[:side] ? %( data-side="#{roll[:side]}") : '' %> data-config='<%= group_config.to_json %>'<%= ' hidden' if roll[:excluded] %>>
    <tr class="roll-row row-initial">
      <td rowspan="<%= row_count %>" class="character-cell">
        <span class="stub-line creature-name<%= ' has-tn-tip' if tn_breakdown %>"<%= tn_breakdown ? %( tabindex="0" data-tn-tip="#{tn_breakdown}") : '' %>><%= roll[:creature_name] %><% if tn_breakdown %><span class="tn-tip"><%= tn_breakdown %></span><% end %></span>
        <span class="stub-line params"><%= roll[:dice_count] %> dice @ TN <%= roll[:tn] %><%= starting_text %></span>
        <span class="stub-line roll-name"><em>(<%= roll[:roll_name] %>)</em></span>
      </td>
      <td class="mod-cell"></td>
      <td class="mod-cell"></td>
      <td class="dice-cell">
        <span class="dice-placeholder">[ <%= starting_squares_html %>&mdash; ]</span>
      </td>
      <td rowspan="<%= row_count %>" class="result-cell">
        <input class="result-input" type="text" value="<%= roll[:dois] %>">
      </td>
      <td rowspan="<%= row_count %>" class="result-cell">
        <input class="result-input" type="text" value="<%= roll[:critical_count] %>">
      </td>
      <td rowspan="<%= row_count %>" class="lock-cell">
        <button type="button" class="lock-btn" aria-label="Toggle lock"></button>
      </td>
    </tr>

    <% if has_reroll %>
      <tr class="modifier-row row-reroll">
        <td class="mod-cell">
          <span class="mod-badge mod-reroll" data-tooltip="<%= roll[:reroll][:label] %>"><%= reroll_text %></span>
        </td>
        <td class="mod-cell"></td>
        <td class="dice-cell"></td>
      </tr>
    <% end %>

    <% if has_mass_reroll %>
      <tr class="modifier-row row-mass-reroll">
        <td class="mod-cell">
          <span class="mod-badge mod-reroll" data-tooltip="<%= roll[:mass_reroll][:label] %>"><%= mass_reroll_text %></span>
        </td>
        <td class="mod-cell"></td>
        <td class="dice-cell"></td>
      </tr>
    <% end %>

    <% if has_nudge %>
      <tr class="modifier-row row-nudge">
        <td class="mod-cell"></td>
        <td class="mod-cell">
          <span class="mod-badge mod-nudge" data-tooltip="<%= roll[:nudge][:label] %>"><%= nudge_text %></span>
        </td>
        <td class="dice-cell"></td>
      </tr>
    <% end %>
  </tbody>
<% end %>

<% if wrapper_on %>
  </table>
  <div class="rolls-results" hidden>
    <% all_rolls.each_with_index do |roll, roll_idx| %>
      <div class="rolls-result-row" data-roll-idx="<%= roll_idx %>">
        <span class="rolls-result-name"><%= roll[:roll_name] %>:</span>
        <span class="rolls-result-value"></span>
      </div>
    <% end %>
    <button type="button" class="btn-rolls-change"><span class="cr-change-icon">↶</span> Change</button>
  </div>
</div>
<% end %>
