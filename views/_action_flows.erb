<%#
  Player actions panel (docs/project/action_flow.md) — DM only, on the
  Encounter page above the Turn Action panel. One block per action a player
  asked for from their phone:
    Request  — Approve opens the matching builder on the turn panel with the
               player's choices made, exactly as if the DM had pressed the
               action; Cancel drops it (nothing was spent).
    Builder  — it runs in the builder: the other players' choices and dice
               show up there. If the builder is closed (e.g. the page was
               reloaded), Open in builder brings it back.
  An action the DM started in the builder appears here only while its
  builder is closed (so it can be reopened or cancelled).

  Locals: flows (active ActionFlow list), acting_id (the acting Combatant).
  Refreshed in place every few seconds by public/js/ui/flowsPanel.js, which
  also opens the builder for a just-approved request (data-open-now).
%>
<% verbs = { 'attack' => 'attacks', 'cast' => 'casts', 'item' => 'uses', 'special' => 'uses' } %>
<% panes = { 'attack' => 'Attack builder', 'cast' => 'Cast builder', 'item' => 'Item builder', 'special' => 'Ability' } %>
<%# An action the DM started shows here only when its builder is closed
    (e.g. the turn moved on before it was finished), so it can be reopened
    or cancelled. %>
<% shown = flows.reject { |f| f.dm_started? && f.live? } %>
<div id="action-flows" class="action-flows" data-flows-panel="1">
  <% unless shown.empty? %>
    <h3 class="af-title">Player actions</h3>
    <% if (err = session.delete(:flow_error)) %>
      <p class="af-error"><%= Rack::Utils.escape_html(err) %></p>
    <% end %>
    <% shown.each do |f| %>
      <% declare = f.stage_tasks('declare').first %>
      <section class="af-flow" data-flow-id="<%= f.id %>"<% if f.needs_open && acting_id == f.actor_id %> data-open-now="1"<% end %>>
        <header class="af-head">
          <span class="af-what"><strong><%= Rack::Utils.escape_html(f.actor_name) %></strong> <%= verbs[f.kind] %>: <%= Rack::Utils.escape_html(declare ? declare['summary'].to_s : f.summary) %></span>
          <span class="af-stage"><%= f.stage == 'declare' ? 'Request' : (f.live? ? 'In the builder' : 'Approved') %></span>
          <% if f.stage == 'declare' %>
            <form method="post" action="/encounter/flows/<%= f.id %>/tasks/<%= declare['id'] %>/approve" class="af-inline">
              <button type="submit" class="af-btn af-primary">Approve</button>
            </form>
          <% elsif !f.live? %>
            <% if acting_id == f.actor_id %>
              <button type="button" class="af-btn af-primary af-open-builder" data-flow-id="<%= f.id %>">Open in <%= panes[f.kind] %></button>
            <% else %>
              <span class="af-note">Open the turn of <%= Rack::Utils.escape_html(f.actor_name) %> to run it.</span>
            <% end %>
          <% end %>
          <form method="post" action="/encounter/flows/<%= f.id %>/cancel" class="af-inline"
                onsubmit="return confirm('Cancel this action? Nothing has been spent.');">
            <button type="submit" class="af-btn af-cancel">Cancel</button>
          </form>
        </header>
      </section>
    <% end %>
  <% end %>
</div>
