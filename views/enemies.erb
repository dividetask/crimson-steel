<div class="navigation">
  <a href="<%= @route_prefix %>/<%= @prev_index %>" class="nav-arrow left">&#9664;</a>
  <span class="character-counter"><%= @current_index + 1 %> / <%= @total_characters %></span>
  <a href="<%= @route_prefix %>/<%= @next_index %>" class="nav-arrow right">&#9654;</a>
</div>

<div class="enemies-layout">
  <div class="enemy-sidebar">
    <h3>Enemies</h3>
    <div class="enemy-list">
      <%
        char_by_id = (@all_characters || Tools.load_json('characters.json')).each_with_object({}) { |c, h| h[c['id']] = c }
      %>
      <% (@enemy_groups || []).each_with_index do |group, gi| %>
        <div class="enemy-group">
          <div class="enemy-group-header" onclick="this.parentElement.classList.toggle('collapsed')" title="Click to expand/collapse">
            <span class="enemy-group-toggle">&#9660;</span>
            <strong><%= group[:label] %></strong>
            <span class="enemy-group-count">(<%= group[:enemies].length %>)</span>
          </div>
          <div class="enemy-group-body">
            <% group[:enemies].each do |enemy| %>
              <%
                copies = @combat_participants.select do |p|
                  char = char_by_id[p['char_id'] || p['id']]
                  char && char['template_id'].to_s == enemy[:id].to_s
                end
              %>
              <div class="enemy-entry <%= 'selected' if enemy[:index] == @current_index %>">
                <a href="/enemies/<%= enemy[:index] %>"><%= enemy[:name] %></a>
                <% unless copies.empty? %>
                  <span class="enemy-count">(<%= copies.length %>)</span>
                <% end %>
                <form method="post" action="/combat/add_enemy" style="display:inline;">
                  <input type="hidden" name="enemy_id" value="<%= enemy[:id] %>">
                  <button type="submit" class="enemy-combat-btn add" title="Add copy to combat">+</button>
                </form>
              </div>
              <% copies.each_with_index do |copy, ci| %>
                <%
                  char = char_by_id[copy['char_id'] || copy['id']]
                  label = char ? char['name'] : enemy[:name]
                  copy_char_id = copy['char_id'] || copy['id']
                %>
                <div class="enemy-copy-entry">
                  <a href="/enemies/instance/<%= copy_char_id %>" class="enemy-copy-label"><%= label %> #<%= ci + 1 %></a>
                  <form method="post" action="/combat/remove_enemy" style="display:inline;">
                    <input type="hidden" name="combat_id" value="<%= copy['id'] %>">
                    <button type="submit" class="enemy-combat-btn remove" title="Remove from combat">-</button>
                  </form>
                </div>
              <% end %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
    <form method="post" action="/combat/clear_enemies" style="margin-top: 10px;">
      <button type="submit" class="enemy-clear-btn">Clear All Enemies</button>
    </form>
  </div>

  <div class="enemy-sheet">
    <div class="sheet">
      <div class="header">
        <h1><%= @character.name %></h1>
        <div class="subtitle">
          <%= @character.race %> <%= @character.full_klass %>
        </div>
        <div class="tier-line">
          Tier <%= @character.tier %> &nbsp;&nbsp;&nbsp; BAB: <%= @character.bab %>
        </div>
        <%
          instance_ids = (@template_instances || []).map { |c| c['id'] }
          enemy_copies = @combat_participants.count { |p| instance_ids.include?(p['char_id'] || p['id']) }
        %>
        <% if enemy_copies > 0 %>
          <div style="color: #388e3c; font-weight: bold;">In Combat (<%= enemy_copies %> <%= enemy_copies == 1 ? 'copy' : 'copies' %>)</div>
        <% end %>
      </div>

      <div class="top-stats">
        <div class="stat-box">
          <span class="label">Combat Pool</span>
          <span class="value"><%= @character.combat_pool %></span>
        </div>
        <div class="stat-box">
          <span class="label">Perception</span>
          <span class="value"><%= @character.skill_dice(:perception) %>d (<%= @character.add_plus(:skill_bonus,:perception) %>)</span>
        </div>
        <div class="stat-box">
          <span class="label">Initiative</span>
          <span class="value"><%= @character.initiative %></span>
        </div>
      </div>

      <div class="top-stats">
        <div class="stat-box">
          <span class="label">Damage Reduction</span>
          <span class="value"><%= @character.damage_reduction %></span>
        </div>
        <div class="stat-box">
          <span class="label">Damage Resilience</span>
          <span class="value"><%= @character.damage_resilience %></span>
        </div>
        <div class="stat-box">
          <span class="label">Speed</span>
          <span class="value"><%= @character.speed %></span>
        </div>
      </div>

      <div class="top-stats">
        <div class="stat-box">
          <span class="label">HP</span>
          <span class="value"><%= @character.current_hp %>/<%= @character.hp_max %></span>
        </div>
        <div class="stat-box">
          <span class="label">Mana</span>
          <span class="value"><%= @character.current_mana %>/<%= @character.mana_max %></span>
        </div>
        <div class="stat-box">
          <span class="label">Mana Regen</span>
          <span class="value"><%= @character.mana_regen %></span>
        </div>
      </div>

      <div class="top-stats">
        <div class="stat-box">
          <span class="label">Temporary HP</span>
          <span class="value"><%= @character.temporary_hit_points %></span>
        </div>
        <div class="stat-box">
          <span class="label">Moderate Damage</span>
          <span class="value"><%= @character.moderate_damage %></span>
        </div>
        <div class="stat-box">
          <span class="label">Major Damage</span>
          <span class="value"><%= @character.major_damage %></span>
        </div>
      </div>

      <div class="two-column">
        <div class="left-col">
          <h2>Attributes</h2>
          <table class="attributes">
            <tr>
              <th></th>
              <th>Score</th>
              <th>&frac12;</th>
              <th colspan="2">Check</th>
              <th colspan="2">Saves</th>
            </tr>
            <% @character.ability_score_names.each do |name, sym| %>
            <tr>
              <td class="attr-name"><%= name %></td>
              <td><%= @character.score(sym) %></td>
              <td><%= @character.half_mod(sym) %></td>
              <td><%= @character.attr_dice(sym) %>d</td>
              <td><%= @character.add_plus(:attr_bonus, sym) %></td>
              <td><%= @character.save_dice(sym) %>d</td>
              <td><%= @character.add_plus(:save_bonus, sym) %></td>
            </tr>
            <% end %>
          </table>

          <h2>Skills</h2>
          <table class="skills">
            <tr>
              <th>Name</th>
              <th>Ranks</th>
              <th>Dice</th>
              <th>Bonus</th>
            </tr>
            <% @character.skill_list.each do |skill_name| %>
            <tr>
              <td><%= @character.clean_skill_name(skill_name) %></td>
              <td><%= @character.skill_ranks(skill_name) %></td>
              <td><%= @character.skill_dice(skill_name) %>d</td>
              <td><%= @character.add_plus(:skill_bonus,skill_name) %></td>
            </tr>
            <% end %>
          </table>
        </div>

        <div class="right-col">
          <h2>Abilities</h2>
          <% @character.ability_list.each do |ability_name| %>
            <% prof = @character.ability_proficiency(ability_name) %>
            <p><strong><%= h(@compendium.format_name(ability_name)) %><% if prof %> [<%= prof[:dice] %>d (<%= prof[:bonus] >= 0 ? "+#{prof[:bonus]}" : prof[:bonus] %>)]<% end %>:</strong> <%= h(@compendium.ability(ability_name)) %></p>
          <% end %>
        </div>
      </div>

      <h2>Combat</h2>
      <table class="combat">
        <tr>
          <th>Name</th>
          <th>Speed</th>
          <th>Roll</th>
          <th>Attk / Def Bonus</th>
          <th>Dmg Bonus</th>
          <th>Bleed</th>
          <th>MT*</th>
          <th>Notes</th>
        </tr>
        <% (@character.shield_list + @character.weapon_list).each do |weapon| %>
        <tr>
          <td><%= weapon["name"] %></td>
          <td><%= @character.weapon_speed(weapon) %><%= @character.weapon_arm_speed(weapon) %></td>
          <td><%= @character.weapon_dice(weapon) %>d</td>
          <td><%= @character.add_plus(:weapon_attack_bonus, weapon) %></td>
          <td><%= @character.weapon_dmg(weapon) %></td>
          <td><%= @character.weapon_bleed(weapon) %></td>
          <td><%= @character.weapon_threshold(weapon) %></td>
          <td></td>
        </tr>
        <% end %>
        <tr>
          <td>Dodge</td>
          <td>0</td>
          <td><%= @character.bab_dice %>d</td>
          <td><%= @character.add_plus(:bab_bonus) %></td>
          <td>-</td>
          <td>-</td>
          <td>-</td>
          <td></td>
        </tr>
      </table>
      <div class="formula">* MT is the base threshold for major damage.</div>

      <% unless @character.defined_items.empty? %>
        <h2>Items</h2>
        <div class="items">
          <% @character.defined_items.each do |item| %>
            <p><strong><%= h(item['name']) %>:</strong> <%= h(item['description']) %></p>
          <% end %>
        </div>
      <% end %>

      <% if @template && ((@template['variants'] || []).any? || @template['gear']) %>
        <h2>Template</h2>
        <% if (@template['variants'] || []).any? %>
          <h3>Variants</h3>
          <ul>
            <% @template['variants'].each do |variant| %>
              <li>
                <strong><%= h(variant['id']) %></strong>
                (<%= ((variant['chance'] || 0).to_f * 100).round(1) %>% chance)
                <% if variant['overrides'] %>
                  <span>- overrides: <%= h(variant['overrides'].keys.join(', ')) %></span>
                <% end %>
                <% if variant['classes_add'] %>
                  <span>- adds <%= h(variant['classes_add'].map { |c| "level #{c['level']} #{c['class']}" }.join(', ')) %></span>
                <% end %>
                <% if variant['gear_patch'] %>
                  <span>- gear patch</span>
                <% end %>
              </li>
            <% end %>
          </ul>
        <% end %>
        <%
          tables = Templates.gear_tables
          gear_ref = @template['gear']
          gear_table = GearTable.resolve(gear_ref, tables) if gear_ref
        %>
        <% if gear_table && (gear_table['rolls'] || []).any? %>
          <h3>Gear<% if gear_ref.is_a?(String) %> (<%= h(gear_ref) %>)<% end %></h3>
          <ul>
            <% gear_table['rolls'].each do |row| %>
              <li>
                <strong><%= h(row['slot']) %>:</strong>
                <% if row['options'].is_a?(Array) %>
                  <% row['options'].each do |opt| %>
                    <div>&nbsp;&nbsp;<%= (opt['chance'].to_f * 100).round(1) %>% - <%= h(opt['item'] && opt['item']['name']) %></div>
                  <% end %>
                <% elsif row.key?('chance') %>
                  <%= (row['chance'].to_f * 100).round(1) %>% - <%= h(row['item'] && row['item']['name']) %>
                <% else %>
                  <%= h(row['item'] && row['item']['name']) %>
                <% end %>
              </li>
            <% end %>
          </ul>
          <% if gear_table['gold'] %>
            <p><strong>Gold:</strong> <%= h(gear_table['gold']) %></p>
          <% end %>
        <% end %>
      <% end %>
    </div>
  </div>
</div>
