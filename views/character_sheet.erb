<%
  # Detail toggle. Only the /character page exposes the toggle; /scene
  # embeds character_sheet.erb during combat and always wants the full
  # layout, so we treat a nil @character_detail as :full.
  detail = (@character_detail == :minimal) ? :minimal : :full
  is_character_page = @route_prefix == '/character'
  query_for = ->(level) { level == :full ? '?detail=full' : '' }
  toggle_target = (detail == :full) ? :minimal : :full
  toggle_label  = (detail == :full) ? 'Show minimal' : 'Show full sheet'
%>
<% if @route_prefix %>
<div class="navigation">
  <a href="<%= @route_prefix %>/<%= @prev_index %><%= query_for.call(detail) %>" class="nav-arrow left">◀</a>
  <span class="character-counter"><%= @current_index + 1 %> / <%= @total_characters %></span>
  <a href="<%= @route_prefix %>/<%= @next_index %><%= query_for.call(detail) %>" class="nav-arrow right">▶</a>
  <% if is_character_page %>
    <a href="<%= @route_prefix %>/<%= @current_index %><%= query_for.call(toggle_target) %>" class="detail-toggle"><%= toggle_label %></a>
  <% end %>
</div>
<% end %>

<% if detail == :minimal && is_character_page %>
<%
  # Minimal monster-statblock-style card. Uses our existing
  # CharacterSheet methods directly — no dummy data layer needed.
  weapons = @character.shield_list + @character.weapon_list
  spell_list = @character.spell_list || []
  has_spells  = spell_list.any? { |t| t && t.any? }
  has_rituals = (@character.ritual_list || []).any? { |t| t && t.any? }
  has_abilities = @character.ability_list.any?
  defined_items = @character.defined_items
  consumables = @character.consumable
  ammunition = @character.ammunition
  other_items = @character.other_items
  equipped_names = @character.equip_search('equipped' => true).map { |i| i['name'] }
  attribute_short = { str: 'STR', dex: 'DEX', con: 'CON', int: 'INT', wis: 'WIS', cha: 'CHA' }
  tier_class = @character.tier && @character.tier >= 0 ? "tier-#{@character.tier}" : 'tier-unknown'
%>
<div class="char-card">
  <div class="char-card-name-row">
    <div class="char-card-name <%= tier_class %>"><%= h @character.name %></div>
    <% if @character.player %>
      <div class="char-card-player">Player: <strong><%= h @character.player %></strong></div>
    <% end %>
  </div>
  <div class="char-card-type">
    <%= h @character.race %> <%= h @character.full_klass %>,
    <span class="<%= tier_class %>">Tier <%= h @character.tier %></span>
  </div>

  <div class="char-card-rule"></div>

  <div class="char-card-top">
    <div class="char-card-attrs">
      <% attribute_short.each do |sym, label| %>
        <% base = @character.ability_score_base(sym) %>
        <% dmg  = @character.ability_damage_total(sym) %>
        <% enh  = @character.attribute_enhancement(sym) %>
        <div class="char-card-attr">
          <span class="char-card-attr-label"><%= label %></span>
          <span class="char-card-attr-value">
            <%= base %><% if dmg > 0 %><span class="ability-damage">-<%= dmg %></span><% end %><% if enh > 0 %><span class="enh-note">(+<%= enh %>)</span><% end %>
          </span>
        </div>
      <% end %>
    </div>
    <div class="char-card-vitals">
      <%
        cur_hp = @character.current_hp
        temp = @character.temporary_hit_points.to_i
        mod = @character.moderate_damage.to_i
        maj = @character.major_damage.to_i
        cur_mana = @character.current_mana
        sat = @character.saturation.to_i rescue 0
      %>
      <div class="char-card-line">
        <strong>HP</strong> <%= cur_hp %>/<%= @character.hp_max %><%
        %><% if temp > 0 %> <span class="hp-temp">+<%= temp %> tmp</span><% end %><%
        %><% if mod  > 0 %> &mdash; <span class="hp-mod">moderate <%= mod %></span><% end %><%
        %><% if maj  > 0 %> &mdash; <span class="hp-major">major <%= maj %></span><% end %>
      </div>
      <div class="char-card-line">
        <strong>Mana</strong> <%= cur_mana %>/<%= @character.mana_max %><%
        %><% if sat > 0 %>, <span class="toxicity">Toxicity <%= sat %></span><% end %>
      </div>
    </div>
  </div>

  <div class="char-card-rule"></div>

  <table class="char-card-quickrow">
    <tr>
      <td><strong>Initiative</strong> <%= h @character.initiative %></td>
      <td><strong>Perception</strong> <%= @character.skill_dice(:perception) %>d (<%= @character.add_plus(:skill_bonus, :perception) %>)</td>
      <td><strong>Speed</strong> <%= @character.speed %></td>
      <td><strong>DR</strong> <%= @character.damage_reduction %></td>
      <td><strong>Resilience</strong> <%= @character.damage_resilience %></td>
    </tr>
  </table>

  <% if weapons.any? %>
    <div class="char-card-rule"></div>
    <div class="char-card-section-title">Combat</div>
    <table class="char-card-actions">
      <tr>
        <th>Name</th>
        <th>Spd</th>
        <th>Roll</th>
        <th>Bonus</th>
        <th>Dmg</th>
        <th>Bleed</th>
        <th>MT</th>
      </tr>
      <% weapons.each do |w| %>
        <tr>
          <td><%= h w['name'] %></td>
          <td><%= @character.weapon_speed(w) %><%= @character.weapon_arm_speed(w) %></td>
          <td><%= @character.weapon_dice(w) %>d</td>
          <td><%= @character.add_plus(:weapon_attack_bonus, w) %></td>
          <td><%= @character.weapon_dmg(w) %></td>
          <td><%= @character.weapon_bleed(w) %></td>
          <td><%= @character.weapon_threshold(w) %></td>
        </tr>
      <% end %>
      <tr>
        <td>Dodge</td>
        <td>0</td>
        <td><%= @character.bab_dice %>d</td>
        <td><%= @character.add_plus(:bab_bonus) %></td>
        <td>&mdash;</td>
        <td>&mdash;</td>
        <td>&mdash;</td>
      </tr>
    </table>
  <% end %>

  <% if has_spells || has_rituals %>
    <div class="char-card-rule"></div>
    <div class="char-card-two-col">
      <div>
        <div class="char-card-section-title">Spells</div>
        <% if has_spells %>
          <% spell_list.each_with_index do |sub, idx| %>
            <% next if sub.nil? || sub.empty? %>
            <p class="char-card-entry"><em>Tier <%= idx %>.</em> <%= sub.map { |s| h(s) }.join(', ') %></p>
          <% end %>
        <% else %>
          <p class="char-card-entry char-card-empty">&mdash;</p>
        <% end %>
      </div>
      <div>
        <div class="char-card-section-title">Rituals</div>
        <% if has_rituals %>
          <% (@character.ritual_list || []).each_with_index do |sub, idx| %>
            <% next if sub.nil? || sub.empty? %>
            <p class="char-card-entry"><em>Tier <%= idx %>.</em> <%= sub.map { |s| h(s) }.join(', ') %></p>
          <% end %>
        <% else %>
          <p class="char-card-entry char-card-empty">&mdash;</p>
        <% end %>
      </div>
    </div>
  <% end %>

  <%
    item_lines = []
    item_lines << ['Equipped', equipped_names.map { |n| h(n) }.join(', ')] if equipped_names.any?
    if consumables.any?
      consumable_str = consumables.map do |item|
        if item['quantity'] && item['quantity'] > 1
          "(#{h(item['quantity'])}) #{h(item['name'])}"
        else
          h(item['name'])
        end
      end.join(', ')
      item_lines << ['Consumable', consumable_str]
    end
    if ammunition.any?
      ammo_str = ammunition.map { |i| "(#{h(i['quantity'] || 1)}) #{h(i['name'])}" }.join(', ')
      item_lines << ['Ammunition', ammo_str]
    end
    item_lines << ['Other', other_items.map { |i| h(i['name']) }.join(', ')] if other_items.any?
  %>
  <% if item_lines.any? || has_abilities %>
    <div class="char-card-rule"></div>
    <div class="char-card-two-col">
      <div>
        <div class="char-card-section-title">Items</div>
        <% if item_lines.any? %>
          <% item_lines.each do |label, body| %>
            <p class="char-card-entry"><em><%= label %>.</em> <%= body %></p>
          <% end %>
        <% else %>
          <p class="char-card-entry char-card-empty">&mdash;</p>
        <% end %>
      </div>
      <div>
        <div class="char-card-section-title">Abilities</div>
        <% if has_abilities %>
          <% @character.ability_list.each do |ability_name| %>
            <p class="char-card-entry"><em><%= h(@compendium.format_name(ability_name)) %>.</em> <%= h(@compendium.ability(ability_name)) %></p>
          <% end %>
        <% else %>
          <p class="char-card-entry char-card-empty">&mdash;</p>
        <% end %>
      </div>
    </div>
  <% end %>

  <% if defined_items.any? %>
    <div class="char-card-rule"></div>
    <div class="char-card-section-title">Item Descriptions</div>
    <% defined_items.each do |item| %>
      <p class="char-card-entry"><em><%= h(item['name']) %>.</em> <%= h(item['description']) %></p>
    <% end %>
  <% end %>
</div>
<% else %>

<div class="sheet">
  <div class="header">
    <h1><%= @character.name %></h1>
    <div class="subtitle">
      <%= @character.race %> <%= @character.full_klass %>
    </div>
    <div class="tier-line">
      Tier <%= @character.tier %> &nbsp;&nbsp;&nbsp; BAB: <%= @character.bab %>
    </div>
  </div>

  <div class="top-stats">
    <div class="stat-box">
      <span class="label">Combat Pool</span>
      <span class="value"><%= @character.combat_pool %></span>
    </div>
    <div class="stat-box">
      <span class="label">Perception</span>
      <span class="value"><%= @character.skill_dice(:perception) %>d (<%= @character.add_plus(:skill_bonus,:perception) %>)</span>
    </div>
    <div class="stat-box">
      <span class="label">Initiative</span>
      <span class="value"><%= @character.initiative %></span>
    </div>
  </div>

  <div class="top-stats">
    <div class="stat-box">
      <span class="label">Damage Reduction</span>
      <span class="value"><%= @character.damage_reduction %></span>
    </div>
    <div class="stat-box">
      <span class="label">Damage Resilience</span>
      <span class="value"><%= @character.damage_resilience %></span>
    </div>
    <div class="stat-box">
      <span class="label">Speed</span>
      <span class="value"><%= @character.speed %></span>
    </div>
  </div>

  <div class="top-stats">
    <div class="stat-box">
      <span class="label">HP</span>
      <span class="value"><%= @character.current_hp %>/<%= @character.hp_max %></span>
    </div>
    <div class="stat-box">
      <span class="label">Mana</span>
      <span class="value"><%= @character.current_mana %>/<%= @character.mana_max %></span>
    </div>
    <div class="stat-box">
      <span class="label">Mana Regen</span>
      <span class="value"><%= @character.mana_regen %></span>
    </div>
  </div>

  <div class="top-stats">
    <div class="stat-box">
      <span class="label">Temporary HP</span>
      <span class="value"><%= @character.temporary_hit_points %></span>
    </div>
    <div class="stat-box">
      <span class="label">Moderate Damage</span>
      <span class="value"><%= @character.moderate_damage %></span>
    </div>
    <div class="stat-box">
      <span class="label">Major Damage</span>
      <span class="value"><%= @character.major_damage %></span>
    </div>
  </div>

  <h2>Combat</h2>
  <table class="combat">
    <tr>
      <th>Name</th>
      <th>Speed</th>
      <th>Roll</th>
      <th>Attk / Def Bonus</th>
      <th>Dmg Bonus</th>
      <th>Bleed</th>
      <th>MT*</th>
      <th>Notes</th>
    </tr>

<% (@character.shield_list + @character.weapon_list).each do |weapon| %>
    <tr>
      <td><%= weapon["name"] %></td>
      <td><%= @character.weapon_speed(weapon) %><%= @character.weapon_arm_speed(weapon) %></td>
      <td><%= @character.weapon_dice(weapon) %>d</td>
      <td><%= @character.add_plus(:weapon_attack_bonus, weapon) %></td>
      <td><%= @character.weapon_dmg(weapon) %></td>
      <td><%= @character.weapon_bleed(weapon) %></td>
      <td><%= @character.weapon_threshold(weapon) %></td>
      <td></td>
    </tr>
<% end %>

    <tr>
      <td>Dodge</td>
      <td>0</td>
      <td><%= @character.bab_dice %>d</td>
      <td><%= @character.add_plus(:bab_bonus) %></td>
      <td>-</td>
      <td>-</td>
      <td>-</td>
      <td></td>
    </tr>

  </table>
  <div class="formula">* MT is the base threshold for major damage.</div>

  <div class="two-column">
    <div class="left-col">
      <h2>Attributes</h2>
      <table class="attributes">
        <tr>
          <th></th>
          <th>Score</th>
          <th>½</th>
          <th colspan="2">Check</th>
          <th colspan="2">Saves</th>
        </tr>
        <% @character.ability_score_names.each do |name, sym| %>
        <% dmg = @character.ability_damage_total(sym) %>
        <% attr_enh = @character.attribute_enhancement(sym) %>
        <tr>
          <td class="attr-name"><%= name %></td>
          <td>
            <%= @character.ability_score_base(sym) %><% if dmg > 0 %><span class="ability-damage">-<%= dmg %></span><% end %><% if attr_enh > 0 %><span class="enh-note" title="base <%= @character.ability_score_base(sym) %> +<%= attr_enh %> enhancement">(+<%= attr_enh %>)</span><% end %>
          </td>
          <td><%= @character.half_mod(sym) %></td>
          <td><%= @character.attr_dice(sym) %>d</td>
          <td><%= @character.add_plus(:attr_bonus, sym) %></td>
          <td><%= @character.save_dice(sym) %>d</td>
          <td><%= @character.add_plus(:save_bonus, sym) %></td>
        </tr>
        <% end %>
      </table>
      <% save_enh = @character.save_enhancement %>
      <% if save_enh > 0 %>
        <div class="formula">Saves include +<%= save_enh %> enhancement bonus.</div>
      <% end %>
      <div class="formula">Formula: 4+½ Attribute Mod, subtract 5 when &gt; 8</div>

      <h2>Skills</h2>
      <table class="skills">
        <tr>
          <th>Name</th>
          <th>Ranks</th>
          <th>Dice</th>
          <th>Bonus</th>
        </tr>
        <% @character.skill_list.each do |skill_name| %>
        <tr>
          <td><%= @character.clean_skill_name(skill_name) %></td>
          <td><%= @character.skill_ranks(skill_name) %></td>
          <td><%= @character.skill_dice(skill_name) %>d</td>
          <td><%= @character.add_plus(:skill_bonus,skill_name) %></td>
        </tr>
        <% end %>
      </table>
      <div class="formula">Formula: 6+rank+½ Attribute Mod, subtract 5 when &gt; 10</div>

      <h2>Items</h2>
      <div class="items">
				<% tattoos = @character.tattoo_list %>
				<% unless tattoos.empty? %>
					<p><strong>Tattoos:</strong> <%= tattoos.map { |item| item["name"] }.join(", ") %></p>
				<% end %>
				<p><strong>Equipped:</strong> <%= @character.equip_search({"equipped" => true}).map { |item| item["name"] }.join(", ") %></p>
				<% unless @character.ammunition.empty? %>
					<p><strong>Ammunition:</strong> <%= @character.ammunition.map { |item| "(#{item['quantity'] || 1}) #{item['name']}" }.join(", ") %></p>
				<% end %>

				<% unless @character.consumable.empty? %>
					<p><strong>Consumable:</strong> <% items = @character.consumable.map do |item|
						if item["quantity"] and item["quantity"] > 1
							"(#{item['quantity']}) #{item['name']}"
						else
							"#{item['name']}"
						end
					end %>
					<%= items.join(", ") %></p>
				<% end %>
				<p><strong>Other:</strong> <%= @character.other_items().map { |item| item["name"] }.join(", ") %></p>

				<h3>Item Descriptions</h3>
				<% @character.defined_items.each do |item| %>
					<p><strong><%= h(item['name']) %>:</strong> <%= h(item['description']) %></p>
				<% end %>
      </div>
    </div>

    <div class="right-col">
      <h2>Abilities</h2>

			<% @character.ability_list.each do |ability_name| %>
				<p><strong><%= h(@compendium.format_name(ability_name)) %>:</strong> <%= h(@compendium.ability(ability_name)) %></p>
			<% end %>

			<% if @character.spell_list %>
				<h2>Spell List</h2>

				<% @character.spell_list.each.with_index do |spell_sub_list, index| %>
					<p><strong><%= index %>:</strong> <%= spell_sub_list.map { |s| "<a href=\"/spell/#{ERB::Util.url_encode(s)}\" class=\"spell-link\">#{h(s)}</a>" }.join(', ') %></p>
				<% end %>
			<% end %>

			<% if @character.item_spell_list %>
				<h2>Item Spells</h2>

				<% @character.item_spell_list.each do |cat, spell_sub_list| %>
					<p><strong><%= cat %>:</strong> <%= spell_sub_list.map { |s| "<a href=\"/spell/#{ERB::Util.url_encode(s)}\" class=\"spell-link\">#{h(s)}</a>" }.join(', ') %></p>
				<% end %>
			<% end %>

			<% if @character.ritual_list && @character.ritual_list.any? { |t| t && t.any? } %>
				<h2>Ritual Spellbook</h2>

				<% @character.ritual_list.each_with_index do |ritual_sub_list, index| %>
					<% next unless ritual_sub_list && ritual_sub_list.any? %>
					<p><strong><%= index %>:</strong> <%= ritual_sub_list.map { |s| "<a href=\"/spell/#{ERB::Util.url_encode(s)}\" class=\"spell-link\">#{h(s)}</a>" }.join(', ') %></p>
				<% end %>
			<% end %>
    </div>
  </div>

  <h2>Notes</h2>
	<div class="notes">

		<% @character.note_list.each do |note| %>
			<% note_lines = h(note['note']).split("\n").length %>
			<div class="note-item">
				<p class="note-text<%= ' collapsed' if note_lines > 3 %>"><%= h(note['note']).gsub("\n", "<br>") %></p>
				<% if note_lines > 3 %>
					<button class="note-toggle" onclick="toggleNote(this)">Show more</button>
				<% end %>
			</div>
		<% end %>
  <form method="post" action="/add_note" style="margin-top: 20px;">
    <label>Note:</label>
    <input type="hidden" name="owner_id" value="<%= @character.id %>">
    <textarea name="note" rows="8"  style="width: 100%; box-sizing: border-box;"></textarea>
    <button type="submit">Add Note</button>
  </form>

	</div>

</div>
<% end %>
