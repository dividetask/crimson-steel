<div class="navigation">
  <a href="<%= @route_prefix %>/<%= @prev_index %>" class="nav-arrow left">◀</a>
  <span class="character-counter"><%= @current_index + 1 %> / <%= @total_characters %></span>
  <a href="<%= @route_prefix %>/<%= @next_index %>" class="nav-arrow right">▶</a>
</div>

<div class="sheet">
  <div class="header">
    <h1><%= @character.name %></h1>
    <div class="subtitle">
      <%= @character.race %> <%= @character.full_klass %>
    </div>
    <div class="tier-line">
      Tier <%= @character.tier %> &nbsp;&nbsp;&nbsp; BAB: <%= @character.bab %>
    </div>
  </div>

  <div class="top-stats">
    <div class="stat-box">
      <span class="label">Combat Pool</span>
      <span class="value"><%= @character.combat_pool %></span>
    </div>
    <div class="stat-box">
      <span class="label">Perception</span>
      <span class="value"><%= @character.skill_dice(:perception) %>d (<%= @character.add_plus(:skill_bonus,:perception) %>)</span>
    </div>
    <div class="stat-box">
      <span class="label">Initiative</span>
      <span class="value"><%= @character.initiative %></span>
    </div>
  </div>

  <div class="top-stats">
    <div class="stat-box">
      <span class="label">Damage Reduction</span>
      <span class="value"><%= @character.damage_reduction %></span>
    </div>
    <div class="stat-box">
      <span class="label">Damage Resilience</span>
      <span class="value"><%= @character.damage_resilience %></span>
    </div>
    <div class="stat-box">
      <span class="label">Speed</span>
      <span class="value"><%= @character.speed %></span>
    </div>
  </div>

  <div class="top-stats">
    <div class="stat-box">
      <span class="label">Max HP</span>
      <span class="value"><%= @character.hp_max %></span>
    </div>
    <div class="stat-box">
      <span class="label">Max Mana</span>
      <span class="value"><%= @character.mana_max %></span>
    </div>
    <div class="stat-box">
      <span class="label">Mana Regen</span>
      <span class="value"><%= @character.mana_regen %></span>
    </div>
  </div>

  <div class="two-column">
    <div class="left-col">
      <h2>Attributes</h2>
      <table class="attributes">
        <tr>
          <th></th>
          <th>Score</th>
          <th>½</th>
          <th colspan="2">Check</th>
          <th colspan="2">Saves</th>
        </tr>
        <% @character.ability_score_names.each do |name, sym| %>
        <tr>
          <td class="attr-name"><%= name %></td>
          <td><%= @character.score(sym) %></td>
          <td><%= @character.half_mod(sym) %></td>
          <td><%= @character.attr_dice(sym) %>d</td>
          <td><%= @character.add_plus(:attr_bonus, sym) %></td>
          <td><%= @character.save_dice(sym) %>d</td>
          <td><%= @character.add_plus(:save_bonus, sym) %></td>
        </tr>
        <% end %>
      </table>
      <div class="formula">Formula: 4+½ Attribute Mod, subtract 5 when &gt; 8</div>

      <h2>Skills</h2>
      <table class="skills">
        <tr>
          <th>Name</th>
          <th>Ranks</th>
          <th>Dice</th>
          <th>Bonus</th>
        </tr>
        <% @character.skill_list.each do |skill_name| %>
        <tr>
          <td><%= @character.clean_skill_name(skill_name) %></td>
          <td><%= @character.skill_ranks(skill_name) %></td>
          <td><%= @character.skill_dice(skill_name) %>d</td>
          <td><%= @character.add_plus(:skill_bonus,skill_name) %></td>
        </tr>
        <% end %>
      </table>
      <div class="formula">Formula: 6+rank+½ Attribute Mod, subtract 5 when &gt; 10</div>

      <h2>Additional Items</h2>
      <div class="items">
				<p><strong>Equipped:</strong> <%= @character.equip_search({"equipped" => true}).map { |item| item["name"] }.join(", ") %></p>
				<% unless @character.ammunition.empty? %>
					<p><strong>Ammunition:</strong> <%= @character.ammunition.map { |item| "(#{item['quantity'] || 1}) #{item['name']}" }.join(", ") %></p>
				<% end %>

				<% unless @character.consumable.empty? %>
					<p><strong>Consumable:</strong> <% items = @character.consumable.map do |item|
						if item["quantity"] and item["quantity"] > 1
							"(#{item['quantity']}) #{item['name']}" 
						else
							"#{item['name']}" 
						end
					end %>
					<%= items.join(", ") %></p>
				<% end %>
				<p><strong>Other:</strong> <%= @character.other_items().map { |item| item["name"] }.join(", ") %></p>
      </div>
    </div>

    <div class="right-col">
      <h2>Abilities</h2>

			<% @character.ability_list.each do |ability_name| %>
				<p><strong><%= h(@compendium.format_name(ability_name)) %>:</strong> <%= h(@compendium.ability(ability_name)) %></p>
			<% end %>

			<% if @character.spell_list %>
				<h2>Spell List</h2>

				<% @character.spell_list.each.with_index do |spell_sub_list, index| %>
					<p><strong><%= index %>:</strong> <%= spell_sub_list.join(', ') %></p>
				<% end %>
			<% end %>

			<% if @character.item_spell_list %>
				<h2>Item Spells</h2>

				<% @character.item_spell_list.each do |cat, spell_sub_list| %>
					<p><strong><%= cat %>:</strong> <%= spell_sub_list.join(', ') %></p>
				<% end %>
			<% end %>
    </div>
  </div>

  <h2>Combat</h2>
  <table class="combat">
    <tr>
      <th>Name</th>
      <th>Speed</th>
      <th>Roll</th>
      <th>Attk / Def Bonus</th>
      <th>Dmg Bonus</th>
      <th>Bleed</th>
      <th>MT*</th>
      <th>Notes</th>
    </tr>

<% (@character.shield_list + @character.weapon_list).each do |weapon| %>
    <tr>
      <td><%= weapon["name"] %></td>
      <td><%= @character.weapon_speed(weapon) %><%= @character.weapon_arm_speed(weapon) %></td>
      <td><%= @character.weapon_dice(weapon) %>d</td>
      <td><%= @character.add_plus(:weapon_attack_bonus, weapon) %></td>
      <td><%= @character.weapon_dmg(weapon) %></td>
      <td><%= @character.weapon_bleed(weapon) %></td>
      <td><%= @character.weapon_threshold(weapon) %></td>
      <td></td>
    </tr>
<% end %>

    <tr>
      <td>Dodge</td>
      <td>0</td>
      <td><%= @character.bab_dice %>d</td>
      <td><%= @character.add_plus(:bab_bonus) %></td>
      <td>-</td>
      <td>-</td>
      <td>-</td>
      <td></td>
    </tr>

  </table>
  <div class="formula">* MT is the base threshold for major damage.</div>


  <h2>Items</h2>
	<div class="items">

		<% @character.defined_items.each do |item| %>
			<p><strong><%= h(item['name']) %>:</strong> <%= h(item['description']) %></p>
		<% end %>
	</div>

  <h2>Notes</h2>
	<div class="notes">

		<% @character.note_list.each do |note| %>
			<% note_lines = h(note['note']).split("\n").length %>
			<div class="note-item">
				<p class="note-text<%= ' collapsed' if note_lines > 3 %>"><%= h(note['note']).gsub("\n", "<br>") %></p>
				<% if note_lines > 3 %>
					<button class="note-toggle" onclick="toggleNote(this)">Show more</button>
				<% end %>
			</div>
		<% end %>
  <form method="post" action="/add_note" style="margin-top: 20px;">
    <label>Note:</label>
    <input type="hidden" name="owner_id" value="<%= @character.id %>">
    <textarea name="note" rows="8"  style="width: 100%; box-sizing: border-box;"></textarea>
    <button type="submit">Add Note</button>
  </form>

	</div>

</div>
