<%= erb :_timekeeping_stub, locals: { timestamp: @timestamp } %>

<%# DM-only Phase override: renders the DM's own Encounter view in a chosen
    Phase without changing what the party sees. The party Phase is still set
    from the menu dropdown; "Same as party" here clears the override. %>
<% if @viewer == :dm %>
  <%
    party_label = (encounter_phases.find { |v, _| v == @party_phase } || []).last
    preview_label = (encounter_phases.find { |v, _| v == @dm_phase_override } || []).last
  %>
  <div class="dm-phase-override">
    <form method="post" action="/encounter/dm_phase" class="phase-form">
      <label class="phase-label">My view
        <select name="phase" class="phase-select" onchange="this.form.submit()">
          <option value="party"<%= ' selected' unless @dm_phase_override %>>Same as party (<%= party_label %>)</option>
          <% encounter_phases.each do |val, label| %>
            <option value="<%= val %>"<%= ' selected' if @dm_phase_override == val %>><%= label %></option>
          <% end %>
        </select>
      </label>
      <noscript><button type="submit" class="ce-btn phase-set">Set</button></noscript>
    </form>
    <% if @dm_phase_override %>
      <span class="dm-phase-note">Previewing <strong><%= preview_label %></strong> — players still see <strong><%= party_label %></strong>.</span>
    <% end %>
  </div>
<% end %>

<%
  # The Encounter Phase (DM's menu dropdown) selects which stubs show.
  #   combat   — hide Advance Time; show Initiative + Map; notes DM-only.
  #   looting  — show only the loot stubs (DM also sees notes underneath).
  #   traveling / social / downtime ("peaceful") — show the notes plus the
  #     DM's Advance Time + Rest controls, which sit directly under the time
  #     display (the natural place to pass time).
  phase    = @phase
  peaceful = %i[traveling social downtime].include?(phase)
  # Characters of Interest (Creature References) appear in the Downtime and
  # Traveling Phases.
  show_interest = %i[downtime traveling].include?(phase)
%>

<%# Advance Time + Rest (DM): the peaceful Phases, where time passes between
    scenes. Sits directly under the time display. Hidden in Combat (time is
    tracked by rounds/ticks) and Looting. Players never see it. %>
<% if @viewer == :dm && peaceful %>
  <div class="tk-controls">
    <div class="tk-controls-main">
      <form method="post" action="/chronicle/advance-time" class="tk-advance">
        <span class="tk-advance-label">Advance time:</span>
        <button type="submit" name="rounds" value="10" class="ce-btn">+1 min</button>
        <button type="submit" name="rounds" value="100" class="ce-btn">+10 min</button>
        <button type="submit" name="rounds" value="600" class="ce-btn">+1 hour</button>
        <button type="submit" name="rounds" value="2400" class="ce-btn">+4 hours</button>
        <button type="submit" name="days"   value="1"    class="ce-btn">+1 day</button>
        <button type="submit" name="rounds" value="-600" class="ce-btn">−1 hour</button>
      </form>
      <%# Set date/time: jump straight to an absolute Calendar Date + clock
          time. Prefilled with the current moment. %>
      <%
        ts_now  = @timestamp.transform_keys(&:to_sym)
        cal_now = Timekeeping.calendar_date(ts_now[:day_index])
        hh_now, mm_now, = Timekeeping.time_of_day(ts_now[:round_of_day]).split(':').map(&:to_i)
      %>
      <form method="post" action="/chronicle/set-time" class="tk-set">
        <span class="tk-advance-label">Set date/time:</span>
        <label class="tk-set-field">Day <input type="number" name="day" value="<%= cal_now[:day_of_month] %>" min="1" step="1"></label>
        <label class="tk-set-field">Month <input type="number" name="month" value="<%= cal_now[:month] %>" min="1" step="1"></label>
        <label class="tk-set-field">Year <input type="number" name="year" value="<%= cal_now[:year] %>" step="1"></label>
        <label class="tk-set-field">Hour <input type="number" name="hour" value="<%= hh_now %>" min="0" max="23" step="1"></label>
        <label class="tk-set-field">Min <input type="number" name="minute" value="<%= mm_now %>" min="0" max="59" step="1"></label>
        <button type="submit" class="ce-btn">Set</button>
      </form>
    </div>
    <%# Rest for the night (right side): set the clock to 08:00 the next day
        and apply one night of fast Natural Recovery (HP, ability damage, mana,
        Magic Toxicity decay) to every PC. %>
    <form method="post" action="/chronicle/rest-night" class="tk-rest">
      <button type="submit" class="ce-btn ce-btn-primary">🌙 Rest for the night</button>
    </form>
  </div>
<% end %>

<%# Downtime PC health cards (conditions_downtime_pc_card_stub.md): every
    Phase except Combat, both viewers, at the very top of the page. Players
    see every Player Character (own card first); the DM also sees the NPC /
    enemy Combatants. %>
<% if @phase != :combat && @downtime_cards && @downtime_cards.any? %>
  <section class="pc-card-grid downtime-cards">
    <% @downtime_cards.each do |card| %>
      <%= erb :_conditions_pc_card, locals: { creature: card, catalog: @conditions_catalog, viewer: @viewer } %>
    <% end %>
  </section>
<% end %>

<%# Affliction relief (conditions_bulk_affliction_stub.md): DM-only, every Phase
    except Combat. One card per Creature carrying a round-cadence Affliction
    (bleed, round poisons). Each card fast-forwards the save round by round —
    optionally aided by Heal channelers — then Confirms to apply. %>
<% if @viewer == :dm && @phase != :combat && @relief_groups && @relief_groups.any? %>
  <section class="ar-panel">
    <h3 class="ar-h">Afflictions <span class="ar-dm">(DM only)</span></h3>
    <% @relief_groups.each do |g| %>
      <%= erb :_conditions_affliction_relief, locals: { group: g } %>
    <% end %>
  </section>
<% end %>

<%# Initiative stub: Combat Phase only (both viewers). The Start/End Combat
    buttons inside it still drive the actual Combat mechanics. %>
<% if phase == :combat %>
  <%= erb :_initiative_stub, locals: {
        rows: @tracker_rows,
        combat_active: @combat_active,
        viewer: @viewer,
        round_label: @round_label
      } %>
<% end %>

<%# Next Turn (page-level Advance Turn control, encounter_initiative_stub.md):
    DM-only, shown during Combat. Sits at the bottom of the Combat Tracker,
    above the Turn Action stub. Advances to the next Combatant in initiative
    order, rolling over the Round when the last Combatant ends their turn. %>
<% if @viewer == :dm && phase == :combat && @combat_active %>
  <form method="post" action="/encounter/advance_turn" class="encounter-next-turn">
    <button type="submit" class="ce-btn encounter-next-turn-btn">Next Turn ▶</button>
  </form>
<% end %>

<%# Turn Action panel (turn_action_stub.md): DM-only, acts on the Acting
    Combatant. Rendered only when a Combatant currently holds the turn. %>
<% if @viewer == :dm && phase == :combat && @acting_row %>
  <%= erb :_turn_action, locals: { acting: @acting_row, dead: @acting_dead, saves: @acting_saves, main_actions: @acting_main_actions, special_options: @acting_special, has_spells: @acting_has_spells, has_items: @acting_has_items, has_active_spells: @acting_has_active_spells } %>
<% end %>

<%# Atlas map (atlas_stub.md): Combat Phase only (both viewers). DM places
    Combatant icons from the tracker, drags to reposition, and clicks a
    Token to target it from the open Attack pane. %>
<% if phase == :combat %>
  <%= erb :_atlas_stub, locals: {
        snapshot: @atlas_snapshot,
        maps: @atlas_maps,
        active_id: @atlas_active_id,
        viewer: @viewer,
        placeable: @atlas_placeable,
        terrain: @atlas_terrain
      } %>
<% end %>

<%# Acting Combatant's Character Sheet (creatures_minimal_stub.md): sits
    under the Map during active Combat, but only when the Acting Combatant is
    a Player Character. An NPC / monster turn shows no sheet — enemy stats are
    never exposed here. Shown to the DM and players alike. %>
<% if phase == :combat && @combat_active && @acting_sheet %>
  <section class="encounter-acting-sheet">
    <%= erb :_creature_minimal, locals: { demo: @acting_sheet } %>
  </section>
<% end %>

<%# Bardic Inspiration: discharge a live Reservoir to grant Luck (DM-only).
    A Reaction, so it sits outside the turn panel and fires any time. %>
<% if @viewer == :dm && phase == :combat && @inspirations && @inspirations.any? %>
  <section class="inspiration-panel">
    <h3 class="inspiration-h">Bardic Inspiration</h3>
    <% @inspirations.each do |insp| %>
      <form method="post" action="/encounter/discharge_inspiration" class="inspiration-row">
        <input type="hidden" name="combatant_id" value="<%= insp[:combatant_id] %>">
        <input type="hidden" name="spell_name" value="<%= insp[:spell_name] %>">
        <span class="insp-name"><%= insp[:name] %></span>
        <span class="insp-reservoir">Reservoir <%= insp[:reservoir] %></span>
        <label class="insp-field">Grant to
          <select name="target_id">
            <% @tracker_rows.each do |r| %>
              <option value="<%= r[:combatant_id] %>"<%= ' selected' if r[:combatant_id] == insp[:combatant_id] %>><%= r[:name] %></option>
            <% end %>
          </select>
        </label>
        <label class="insp-field">Luck
          <input type="number" name="amount" min="1" max="<%= insp[:reservoir] %>" value="1">
        </label>
        <button type="submit" class="ce-btn">Inspire</button>
      </form>
    <% end %>
  </section>
<% end %>

<%# Post-Combat Cleanup (equipment_post_combat_creatures_stub.md): DM-only,
    Looting Phase. Loots and clears the just-ended fight's non-PC
    Combatants. Only shown when such Combatants remain on the roster. %>
<% if @viewer == :dm && phase == :looting && @post_combat_rows.any? %>
  <%= erb :_equipment_post_combat_creatures_stub, locals: { rows: @post_combat_rows } %>
<% end %>

<%# Loot Pile (equipment_loot_pile_stub.md): DM + players, Looting Phase.
    Shows the active Map's Ground Pile when it holds anything. %>
<% if phase == :looting && @loot_pile %>
  <%= erb :_equipment_loot_pile_stub, locals: {
        pile: @loot_pile, viewer: @viewer,
        give_options: @loot_give_options, claim_creature_id: @loot_claim_creature_id
      } %>
<% end %>

<%# Notes / Chronicle Entries: the DM sees them in every Phase; players see
    them only in the peaceful Phases (in Combat / Looting players get the
    Initiative + Map / loot stubs instead). %>
<% if @viewer == :dm || peaceful %>
  <% scene_notes = @active_entries.select { |e| e['entry_type'] == 'note' } %>
  <section class="scene-section">
    <% if scene_notes.any? %>
      <div class="scene-list">
        <% scene_notes.each do |e| %>
          <%= erb :_chronicle_entry, locals: { entry: e, viewer: @viewer, viewing_id: @viewing_id, player_creatures: @player_creatures } %>
        <% end %>
      </div>
    <% else %>
      <p class="lead">No active scene entries.</p>
    <% end %>
  </section>
<% end %>

<%# Characters of Interest (Creature References): shown during the Downtime
    and Traveling Phases, at 1/3 width like the scene notes. %>
<% if show_interest && @interest_entries.any? %>
  <section class="scene-section scene-interest">
    <h3>Characters of Interest</h3>
    <div class="scene-list">
      <% @interest_entries.each do |e| %>
        <%= erb :_chronicle_entry, locals: { entry: e, viewer: @viewer, viewing_id: @viewing_id, player_creatures: @player_creatures } %>
      <% end %>
    </div>
  </section>
<% end %>

<% if @viewer == :dm %>
  <section class="dm-staging">
    <h3>Add Note</h3>
    <%= erb :_chronicle_add_form, locals: {
          kind: :note, chapters: @chapters, current_chapter: @current_chapter,
          player_creatures: @player_creatures, default_active: true
        } %>

    <h3>Add Creature Reference</h3>
    <%= erb :_chronicle_add_form, locals: {
          kind: :creature, chapters: @chapters, current_chapter: @current_chapter,
          player_creatures: @player_creatures, default_active: true
        } %>
  </section>
<% end %>

<script type="module" src="/app.js"></script>
