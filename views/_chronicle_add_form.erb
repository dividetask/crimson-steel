<%#
  Add Entry form. See chronicle_notes_browser_stub.md and
  chronicle_scene_staging_stub.md.

  Locals:
    kind             — :note or :creature
    chapters         — list of chapters
    current_chapter  — default chapter
    player_creatures — list for the hidden_from checklist
    default_active   — boolean (true on the scene staging panel)
    owner_id         — optional fixed owner_id (for player-owned notes)
%>
<form method="post" action="/chronicle/entries" enctype="multipart/form-data" class="ce-add-form">
  <input type="hidden" name="entry_type" value="<%= kind %>">
  <% if defined?(owner_id) && owner_id %>
    <input type="hidden" name="owner_id" value="<%= owner_id %>">
  <% end %>

  <div class="ce-add-row">
    <% if kind == :creature %>
      <label class="ce-field">
        <span>Creature ID</span>
        <input type="number" name="creature_id" required min="1" placeholder="e.g. 1003">
      </label>
    <% end %>
    <label class="ce-field">
      <span><%= kind == :creature ? 'Title suffix' : 'Title' %></span>
      <input type="text" name="title" <%= kind == :note ? 'required' : '' %>>
    </label>
    <label class="ce-field">
      <span>Chapter</span>
      <select name="chapter">
        <% chapters.each do |c| %>
          <option value="<%= c[:number] %>" <%= c[:number] == current_chapter ? 'selected' : '' %>>
            <%= c[:number] %> &mdash; <%= Rack::Utils.escape_html(c[:name]) %>
          </option>
        <% end %>
      </select>
    </label>
    <% if kind == :creature %>
      <label class="ce-field">
        <span>Tier override</span>
        <input type="number" name="tier" min="0" max="5" placeholder="(creature default)">
      </label>
    <% end %>
  </div>

  <label class="ce-field">
    <span>Public description</span>
    <textarea name="public_description" rows="2"></textarea>
  </label>
  <label class="ce-field">
    <span>GM-only description</span>
    <textarea name="dm_description" rows="2"></textarea>
  </label>

  <label class="ce-field">
    <span>Image</span>
    <input type="file" name="image" accept="image/png,image/jpeg,image/gif,image/webp">
  </label>
  <% if kind == :creature %>
    <label class="ce-field">
      <span>Token</span>
      <input type="file" name="creature_token" accept="image/png,image/jpeg,image/gif,image/webp">
    </label>
  <% end %>

  <div class="ce-add-row ce-add-flags">
    <label class="ce-checkbox">
      <input type="checkbox" name="shared" value="true" checked>
      <span>Shared with players</span>
    </label>
    <label class="ce-checkbox">
      <input type="checkbox" name="active" value="true" <%= (defined?(default_active) && default_active) ? 'checked' : '' %>>
      <span>Active (in current scene)</span>
    </label>
  </div>

  <% if player_creatures && !player_creatures.empty? %>
    <fieldset class="ce-add-hidden">
      <legend>Hidden from</legend>
      <% player_creatures.each do |pc| %>
        <label class="ce-checkbox">
          <input type="checkbox" name="hidden_from[]" value="<%= pc[:id] %>">
          <span><%= Rack::Utils.escape_html(pc[:name]) %></span>
        </label>
      <% end %>
    </fieldset>
  <% end %>

  <button type="submit" class="ce-btn ce-btn-primary">
    Add <%= kind == :creature ? 'Creature Reference' : 'Note' %>
  </button>
</form>
