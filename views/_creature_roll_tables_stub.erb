<%#
  Spawn Roll Tables stub — shown above a template's Character Sheet.
  Surfaces the tables rolled once at Spawn Creature From Template:
  the equipment loadout plus any race / class / skill / tier tables.
  locals: roll_tables (see roll_tables_data in lib/routes/inventory.rb).
%>
<%
  pct      = ->(c) { c.nil? ? nil : "#{(c.to_f * 100).round}%" }
  titleize = ->(s) { s.to_s.split(/[_\s]+/).reject(&:empty?).map(&:capitalize).join(' ') }
  cond     = ->(w) { (w || {}).map { |k, v| "#{titleize.call(k)} = #{titleize.call(v)}" }.join(', ') }
%>
<section class="cs-roll-tables" aria-label="Spawn roll tables">
  <h2 class="cs-roll-tables-title">Spawn Roll Tables</h2>
  <p class="cs-roll-tables-note">Rolled once when this template is spawned into the encounter.</p>

  <% if (eq = roll_tables[:equipment]) %>
    <div class="cs-roll-table">
      <h3>Equipment Loadout <code class="cs-roll-table-id"><%= eq[:id] %></code></h3>
      <ul>
        <% eq[:rows].each do |row| %>
          <% next if row[:items].empty? %>
          <li>
            <% unless (row[:when] || {}).empty? %><span class="cs-roll-when">[<%= cond.call(row[:when]) %>]</span> <% end %>
            <%= row[:items].map { |it|
                  label = titleize.call(it[:name])
                  label += " &times;#{it[:qty]}" if it[:qty]
                  label += " (#{pct.call(it[:chance])})" if it[:chance]
                  label
                }.join(' / ') %>
            <% if row[:equipped] %><span class="cs-tag">equipped</span><% end %>
            <% if row[:chance] %><span class="cs-tag"><%= pct.call(row[:chance]) %></span><% end %>
          </li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <% if (rt = roll_tables[:race]) %>
    <div class="cs-roll-table">
      <h3>Race</h3>
      <p><%= rt.map { |r| "#{titleize.call(r[:race])} #{pct.call(r[:chance])}" }.join(' &middot; ') %></p>
    </div>
  <% end %>

  <% if (ct = roll_tables[:classes]) %>
    <div class="cs-roll-table">
      <h3>Class</h3>
      <p><%= ct.map { |c|
            s = "#{titleize.call(c[:class])} #{pct.call(c[:chance])}"
            s += " (lvl #{c[:level]})" if c[:level] && c[:level] != 1
            s
          }.join(' &middot; ') %></p>
    </div>
  <% end %>

  <% if (sk = roll_tables[:skills]) %>
    <div class="cs-roll-table">
      <h3>Skill Candidates</h3>
      <p><%= sk.map { |s| titleize.call(s) }.join(', ') %></p>
    </div>
  <% end %>

  <% if (ta = roll_tables[:tier_advancement]) %>
    <div class="cs-roll-table">
      <h3>Tier Advancement</h3>
      <p><%= ta[:count] %> pick<%= 's' unless ta[:count] == 1 %> from <%= Array(ta[:from]).map { |a| a.to_s.upcase }.join(' / ') %></p>
    </div>
  <% end %>
</section>
