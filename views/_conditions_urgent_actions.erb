<%#
  Conditions Urgent Actions Stub.

  See docs/common/ui/conditions_urgent_actions_stub.md.

  Locals:
    creatures      — required. Array of creature hashes (see DummyData.creatures).
    catalog        — required. Conditions::Catalog instance.
    current_round  — required. Integer round number used for the Pending
                     check (List Pending Afflictions).
%>
<%
  sections = creatures.map do |c|
    inst = Conditions::Instance.new(state: c[:state], catalog: catalog)
    pending = inst.list_pending_afflictions(current_round)
    { creature: c, instance: inst, pending: pending }
  end
%>

<form class="urgent-actions" method="post" action="/status/urgent-actions">
  <% sections.each do |sec| %>
    <%
      c = sec[:creature]
      total_hp_damage = c[:state].hp_damage.values.sum
      current_hp = [c[:max_hp] - total_hp_damage, 0].max
      current_mana = c[:mana_max] - c[:state].mana_spent
      potency_divisor = catalog.potency_divisor
    %>
    <section class="urgent-section" data-creature-id="<%= c[:id] %>">
      <header class="urgent-header">
        <h2 class="tier-<%= c[:tier] %>"><%= c[:name] %></h2>
        <span class="urgent-stats">
          HP <%= current_hp %>/<%= c[:max_hp] %> · Mana <%= current_mana %>/<%= c[:mana_max] %>
        </span>
        <% mechs = sec[:instance].active_named_effect_mechanics %>
        <% if mechs.any? %>
          <ul class="effect-badges">
            <% mechs.uniq { |m| m[:effect_name] }.each do |m| %>
              <li class="effect-badge"><%= m[:effect_name] %></li>
            <% end %>
          </ul>
        <% end %>
      </header>

      <% if sec[:pending].any? %>
        <table class="affliction-save-table">
          <thead>
            <tr>
              <th>Affliction</th>
              <th>Save</th>
              <th>Successes</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% sec[:pending].each do |name| %>
              <%
                entry = c[:state].afflictions[name]
                rule = catalog.affliction(name)
                save_attr = rule['save'] || 'con'
                penalty = -(entry[:potency] / potency_divisor)
              %>
              <tr class="affliction-save-row">
                <td>
                  <span class="aff-name"><%= name %></span>
                  <span class="aff-potency">· Potency <%= entry[:potency] %></span>
                </td>
                <td>
                  <%= save_attr %> save<br>
                  <small>Competency <%= penalty %></small>
                </td>
                <td>
                  <input class="successes-input" type="number"
                         name="creatures[<%= c[:id] %>][saves][<%= name %>][successes]"
                         value="0">
                </td>
                <td>
                  <button type="button" class="btn-roll-save"
                          data-creature-id="<%= c[:id] %>"
                          data-affliction="<%= name %>">Roll</button>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <p class="empty">No pending Afflictions.</p>
      <% end %>

      <div class="queued-action">
        <label>
          Queued action:
          <select name="creatures[<%= c[:id] %>][action][kind]">
            <option value="nothing">Nothing</option>
            <option value="cast">Cast …</option>
            <option value="use">Use …</option>
          </select>
        </label>
        <label>
          Target:
          <select name="creatures[<%= c[:id] %>][action][target]">
            <option value="self">Self</option>
            <% creatures.each do |other| %>
              <% next if other[:id] == c[:id] %>
              <option value="<%= other[:id] %>"><%= other[:name] %></option>
            <% end %>
          </select>
        </label>
      </div>
    </section>
  <% end %>

  <div class="urgent-submit-row">
    <button type="submit" class="btn-urgent-submit">Submit All</button>
  </div>
</form>
