<%
  # Character Creation Stub — the DM's "New Character" wizard.
  #
  # The page is a thin shell: the full catalog blob (attribute
  # allocation rules, races, classes, per-class skill groupings and
  # spell-selection rules) is emitted as JSON and the client controller
  # (public/js/ui/characterCreation.js) builds every step from it. The
  # final step POSTs the assembled character back to /character-creation.
%>
<div class="cc-page" id="character-creation">
  <h1 class="cc-title">New Character</h1>
  <ol class="cc-steps" data-cc-steps aria-label="Creation steps"></ol>
  <div class="cc-stage" data-cc-stage>
    <noscript>
      <p class="cc-noscript">Character creation needs JavaScript enabled.</p>
    </noscript>
  </div>
  <div class="cc-error" data-cc-error hidden></div>
  <nav class="cc-nav">
    <button type="button" class="ce-btn cc-back" data-cc-back hidden>‹ Back</button>
    <button type="button" class="ce-btn cc-next" data-cc-next>Confirm ›</button>
  </nav>
</div>

<script id="cc-data" type="application/json"><%= @blob_json %></script>
<script type="module" src="/js/ui/characterCreation.js"></script>
