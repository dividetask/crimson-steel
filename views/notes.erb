<section class="notes-section">
  <nav class="notes-chapter-tabs">
    <a href="/notes?chapter=all" class="<%= @selected_chapter.nil? ? 'active' : '' %>">All</a>
    <% @chapters.each do |c| %>
      <a href="/notes?chapter=<%= c[:number] %>" class="<%= @selected_chapter == c[:number] ? 'active' : '' %>">
        <%= c[:number] %>. <%= Rack::Utils.escape_html(c[:name]) %>
      </a>
    <% end %>
  </nav>

  <%
    visible_entries = @selected_chapter ? @entries.select { |e| e['chapter'] == @selected_chapter } : @entries
    dm_notes        = visible_entries.select { |e| e['entry_type'] == 'note' && e['owner_id'].nil? }
    char_notes      = visible_entries.select { |e| e['entry_type'] == 'note' && e['owner_id'] }
    creatures_all   = @entries.select { |e| e['entry_type'] == 'creature' }
    # Characters of Interest filtering:
    #   • "All": every Creature Reference, active or inactive.
    #   • a Chapter: References assigned to that Chapter (active or inactive),
    #     plus Chapter-less References only while they are active.
    creatures_shown =
      if @selected_chapter.nil?
        creatures_all
      else
        creatures_all.select do |e|
          ch = e['chapter']
          (ch.nil? || ch.to_s.empty?) ? e['active'] : ch == @selected_chapter
        end
      end
  %>

  <h2>DM Notes</h2>
  <% if dm_notes.empty? %>
    <p class="lead">No DM notes<%= @selected_chapter ? " in this chapter" : '' %>.</p>
  <% end %>
  <div class="notes-list">
    <% dm_notes.each do |e| %>
      <%= erb :_chronicle_entry, locals: { entry: e, viewer: @viewer, viewing_id: @viewing_id, player_creatures: @player_creatures } %>
    <% end %>
  </div>

  <% if @viewer == :dm %>
    <h3>Add DM Note</h3>
    <%= erb :_chronicle_add_form, locals: {
          kind: :note, chapters: @chapters, current_chapter: @current_chapter,
          player_creatures: @player_creatures, default_active: false
        } %>
  <% end %>

  <h2>Characters of Interest</h2>
  <% if creatures_shown.empty? %>
    <p class="lead">No creature references<%= @selected_chapter ? " active or in this chapter" : '' %>.</p>
  <% end %>
  <div class="notes-list">
    <% creatures_shown.each do |e| %>
      <%= erb :_chronicle_entry, locals: { entry: e, viewer: @viewer, viewing_id: @viewing_id, player_creatures: @player_creatures } %>
    <% end %>
  </div>

  <% if @viewer == :dm %>
    <h3>Add Creature Reference</h3>
    <%= erb :_chronicle_add_form, locals: {
          kind: :creature, chapters: @chapters, current_chapter: @current_chapter,
          player_creatures: @player_creatures, default_active: false
        } %>
  <% end %>

  <% if @viewer == :player && @viewing_id %>
    <h2>My Notes</h2>
    <div class="notes-list">
      <% char_notes.select { |e| e['owner_id'] == @viewing_id }.each do |e| %>
        <%= erb :_chronicle_entry, locals: { entry: e, viewer: @viewer, viewing_id: @viewing_id, player_creatures: @player_creatures } %>
      <% end %>
    </div>
    <h3>Add Personal Note</h3>
    <%= erb :_chronicle_add_form, locals: {
          kind: :note, chapters: @chapters, current_chapter: @current_chapter,
          player_creatures: nil, default_active: false, owner_id: @viewing_id
        } %>
  <% end %>

  <% if @viewer == :dm %>
    <section class="dm-chapters">
      <h2>Chapters &amp; Campaign</h2>
      <form method="post" action="/chronicle/campaign-name" class="dm-chapters-row">
        <label class="ce-field"><span>Campaign name</span>
          <input type="text" name="campaign_name" value="<%= Rack::Utils.escape_html(@store.campaign_name) %>">
        </label>
        <button class="ce-btn">Rename</button>
      </form>

      <div class="dm-chapters-row">
        Current chapter: <strong><%= @current_chapter %></strong>
        <form method="post" action="/chronicle/current-chapter/advance" style="display:inline">
          <button class="ce-btn">Advance chapter</button>
        </form>
        <form method="post" action="/chronicle/current-chapter" style="display:inline">
          <input type="number" name="number" min="1" value="<%= @current_chapter %>" style="width:60px">
          <button class="ce-btn">Set</button>
        </form>
      </div>

      <ul class="dm-chapters-list">
        <% @chapters.each do |c| %>
          <li>
            <form method="post" action="/chronicle/chapters/<%= c[:number] %>/rename" class="dm-chapter-rename">
              <strong><%= c[:number] %>.</strong>
              <input type="text" name="name" value="<%= Rack::Utils.escape_html(c[:name]) %>">
              <button class="ce-btn">Rename</button>
            </form>
            <form method="post" action="/chronicle/chapters/<%= c[:number] %>/delete" style="display:inline" onsubmit="return confirm('Remove this chapter? Entries are kept.');">
              <button class="ce-btn ce-pill-delete">Remove</button>
            </form>
          </li>
        <% end %>
      </ul>

      <form method="post" action="/chronicle/chapters" class="dm-chapters-row">
        <label class="ce-field"><span>Number</span>
          <input type="number" name="number" min="1" style="width:80px">
        </label>
        <label class="ce-field"><span>Name</span>
          <input type="text" name="name" required>
        </label>
        <button class="ce-btn ce-btn-primary">Add chapter</button>
      </form>
    </section>
  <% end %>
</section>

<script type="module" src="/app.js"></script>
