<%#
  Equipment Post-Combat Creatures Stub —
  docs/common/ui/equipment_post_combat_creatures_stub.md

  DM-only list — one row each: <Name> <Loot/Ignore toggle> <Delete/Keep
  toggle> — beside a single combined preview of the loot the current
  selection will gather (aggregated across every row still set to Loot; a
  rolled Loot Table adds random items on top). Confirm composes Collect
  Combat Loot + Remove Combatant + Delete Creature.

  NPC allies (`npc: true`) are listed first, under an "NPCs" heading, and
  default to Ignore + Keep so they are left untouched; enemies follow and
  default to Loot + Delete.

  Locals:
    rows — [{combatant_id, creature_id, name, npc, loot_table, loot:[{name,quantity}]}].
%>
<% esc = ->(s) { Rack::Utils.escape_html(s.to_s) } %>
<%# Only the default-looted (enemy) rows contribute to the initial preview;
    postCombatLoot.js refines it from the live toggle state. %>
<% combined = combine_loot(rows.reject { |r| r[:npc] }) %>
<% has_npcs = rows.any? { |r| r[:npc] } %>
<% has_enemies = rows.any? { |r| !r[:npc] } %>
<section class="pcc-stub">
  <h3 class="pcc-title">Post-Combat Cleanup</h3>

  <% if rows.empty? %>
    <p class="pcc-empty">No creatures to clean up.</p>
  <% else %>
    <form method="post" action="/encounter/post_combat_cleanup" class="pcc-form">
      <div class="pcc-body">
        <ul class="pcc-list">
          <% prev_npc = nil %>
          <% rows.each do |row| %>
            <% cid = row[:combatant_id] %>
            <% if row[:npc] != prev_npc %>
              <% if row[:npc] %>
                <li class="pcc-group-label">NPCs</li>
              <% elsif has_npcs %>
                <li class="pcc-group-label">Enemies</li>
              <% end %>
              <% prev_npc = row[:npc] %>
            <% end %>
            <li class="pcc-row<%= ' pcc-row-npc' if row[:npc] %>" data-loot="<%= esc.call(row[:loot].to_json) %>" data-loot-table="<%= row[:loot_table] ? '1' : '' %>">
              <span class="pcc-name"><%= esc.call(row[:name]) %></span>
              <label class="pcc-btn pcc-loot-btn"><input type="checkbox" name="loot_<%= cid %>" value="ignore"<%= ' checked' if row[:npc] %>></label>
              <label class="pcc-btn pcc-del-btn"><input type="checkbox" name="delete_<%= cid %>" value="keep"<%= ' checked' if row[:npc] %>></label>
              <%# Promote a generated monster to a named NPC ally. Checking it
                  reveals a rename field; on Confirm the Creature is kept (not
                  looted or deleted) and its group becomes npc. Enemies only. %>
              <% unless row[:npc] %>
                <label class="pcc-btn pcc-npc-btn"><input type="checkbox" name="npc_<%= cid %>" value="1"></label>
                <input type="text" class="pcc-npc-name" name="npc_name_<%= cid %>" value="<%= esc.call(row[:name]) %>" placeholder="NPC name">
              <% end %>
            </li>
          <% end %>
        </ul>

        <aside class="pcc-loot" aria-live="polite">
          <ul class="pcc-loot-list">
            <% if combined[:items].empty? && !combined[:random] %>
              <li class="pcc-loot-none">Nothing</li>
            <% else %>
              <% combined[:items].each do |it| %>
                <li><%= it[:quantity] > 1 ? "#{it[:quantity]}× " : '' %><%= esc.call(it[:name]) %></li>
              <% end %>
              <% if combined[:random] %><li class="pcc-loot-random">+ random loot</li><% end %>
            <% end %>
          </ul>
        </aside>
      </div>
      <button type="submit" class="ce-btn ce-btn-primary pcc-confirm">Confirm</button>
    </form>
  <% end %>
</section>
