<div class="scene">
  <h1>Scene</h1>

  <% unless @show_initiative %>
    <details class="scene-reminder">
      <summary>Reminder</summary>
      <p>What you see here is what your characters believe — not necessarily what is true. Most of it is probably accurate, but assumptions your characters have made can color the details. Characters and items can hide their tiers, and any lies your characters believe will appear here as fact. When a character's tier is shown as unknown, they are concealing it during your interactions, and they are likely a higher tier than yours.</p>
    </details>
  <% end %>

  <div class="scene-datetime <%= @sun_moon['is_day'] ? 'scene-datetime-day' : 'scene-datetime-night' %>">
    <svg class="scene-sky" viewBox="0 0 200 80" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
      <rect width="200" height="80" fill="<%= @sun_moon['is_day'] ? '#bcdcff' : '#1c2240' %>"/>
      <% unless @sun_moon['is_day'] %>
        <circle cx="40"  cy="20" r="0.6" fill="#fff" opacity="0.8"/>
        <circle cx="80"  cy="14" r="0.5" fill="#fff" opacity="0.7"/>
        <circle cx="120" cy="22" r="0.6" fill="#fff" opacity="0.8"/>
        <circle cx="160" cy="16" r="0.5" fill="#fff" opacity="0.7"/>
      <% end %>
      <line x1="0" y1="70" x2="200" y2="70" stroke="<%= @sun_moon['is_day'] ? '#7a5b3c' : '#554840' %>" stroke-width="1"/>
      <% if @sun_moon['is_day'] %>
        <g transform="translate(<%= @sun_moon['cx'] %> <%= @sun_moon['cy'] %>)">
          <% 8.times do |i| %>
            <% angle = i * 45 %>
            <line x1="0" y1="0" x2="0" y2="-13" stroke="#fbc02d" stroke-width="1.2" transform="rotate(<%= angle %>)" opacity="0.7"/>
          <% end %>
          <circle r="7" fill="#fdd835" stroke="#fb8c00" stroke-width="1"/>
        </g>
      <% else %>
        <g transform="translate(<%= @sun_moon['cx'] %> <%= @sun_moon['cy'] %>)">
          <circle r="7" fill="#e8ecf5"/>
          <circle r="6" cx="2.2" fill="#1c2240"/>
        </g>
      <% end %>
    </svg>
    <span class="scene-datetime-value"><%= h GameDate.format_date(@datetime) %></span>
  </div>

  <% if @is_dm %>
    <div class="scene-datetime-controls">
      <span class="scene-datetime-controls-label">Advance Time (<%= h GameDate.format_time_12h(@datetime) %>)</span>
      <% [['minute', '+1 min'], ['ten_minutes', '+10 min'], ['hour', '+1 hr'], ['day', 'Next day (8 AM)']].each do |unit, label| %>
        <form method="post" action="/scene/datetime/advance" style="display:inline;">
          <input type="hidden" name="unit" value="<%= unit %>">
          <button type="submit"><%= label %></button>
        </form>
      <% end %>
    </div>
  <% end %>

  <% if @show_initiative %>
    <% if @combat.combat_turn_list.empty? %>
      <p class="dt-note">No combatants in the initiative track yet.</p>
    <% else %>
      <table class="scene-init">
        <thead>
          <tr>
            <th>Initiative</th>
            <th>Name</th>
            <th>HP</th>
          </tr>
        </thead>
        <tbody>
          <% @combat.combat_turn_list.each do |ct| %>
            <% is_pc = (ct.character.data['group'] || 'PC').to_s == 'PC' %>
            <% is_current = @combat.current_turn_character && @combat.current_turn_character.combat_id == ct.combat_id %>
            <tr class="<%= 'current-turn' if is_current %>">
              <td><%= h ct.initiative.to_s.empty? ? '—' : ct.initiative %></td>
              <td><%= is_pc ? h(@combat.display_name(ct)) : 'DM' %></td>
              <td>
                <% if is_pc %>
                  <%= ct.hp %>/<%= ct.character.hp_max %>
                <% else %>
                  <%
                    hp_max = ct.character.hp_max.to_i
                    hp_now = ct.hp.to_i
                    pct = hp_max > 0 ? (hp_now.to_f / hp_max * 100.0) : 0
                    if hp_now <= 0
                      hp_label = 'Down'; hp_class = 'scene-hp-down'
                    elsif pct >= 75
                      hp_label = nil; hp_class = 'scene-hp-good'
                    elsif pct >= 50
                      hp_label = nil; hp_class = 'scene-hp-warn'
                    elsif pct >= 25
                      hp_label = nil; hp_class = 'scene-hp-orange'
                    else
                      hp_label = nil; hp_class = 'scene-hp-bad'
                    end
                  %>
                  <% if hp_label %>
                    <span class="scene-hp-down-text"><%= hp_label %></span>
                  <% else %>
                    <span class="scene-hp-bar <%= hp_class %>"></span>
                  <% end %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>

  <% end %>

  <% if @visible_maps.any? %>
    <div class="scene-maps">
      <% @visible_maps.each do |m| %>
        <% rows = m['rows'].to_i %>
        <% cols = m['cols'].to_i %>
        <% cells = m['cells'].is_a?(Hash) ? m['cells'] : {} %>
        <% player_cells = m['player_cells'].is_a?(Hash) ? m['player_cells'] : {} %>
        <% player_arrows = Array(m['player_arrows']) %>
        <div class="scene-map">
          <% if m['title'] && !m['title'].to_s.empty? %>
            <h2><%= h(m['title']) %></h2>
          <% end %>
          <% if @is_dm %>
            <%# DM editor palette inline on /scene. Same brush set as
                /maps; the form wraps the grid below so the existing
                editor JS (data-editor="1") hooks into the cells. %>
            <form method="post" action="/scene/map/update" class="notes-form scene-map-editor" data-editor="1">
              <input type="hidden" name="id" value="<%= h(m['id']) %>">
              <input type="hidden" name="cells_json" value='<%= h(cells.to_json) %>'>
              <input type="hidden" name="title" value="<%= h(m['title']) %>">
              <input type="hidden" name="rows" value="<%= rows %>">
              <input type="hidden" name="cols" value="<%= cols %>">
              <% Array(m['visible_to']).each do |pid| %>
                <input type="hidden" name="visible_to[]" value="<%= pid %>">
              <% end %>
              <div class="scene-map-palette" data-palette="1">
                <div class="palette-group">
                  <span class="palette-label">Color:</span>
                  <button type="button" class="brush color-brush" data-brush-type="color" data-color="" title="Clear color">none</button>
                  <% [['#3a3a3a','Wall'],['#8a8a8a','Stone'],['#d7c79a','Floor'],['#f0f0f0','Web'],['#ffb74d','Hazard'],['#ef5350','Fire / danger'],['#4fc3f7','Water'],['#81c784','Poison / grass'],['#ba68c8','Magic']].each do |hex, name| %>
                    <button type="button" class="brush color-brush" data-brush-type="color" data-color="<%= hex %>" style="background:<%= hex %>;" title="<%= name %>"></button>
                  <% end %>
                  <input type="color" class="brush-color-picker" title="Pick a custom color">
                </div>
                <div class="palette-group">
                  <span class="palette-label">Icon:</span>
                  <button type="button" class="brush icon-brush" data-brush-type="icon" data-icon="" title="Clear icon">none</button>
                  <% [['🕸','Web'],['🔥','Fire'],['💧','Water'],['☠','Death / skull'],['🪤','Trap'],['🚪','Door'],['⛏','Rubble / mining'],['⭐','Objective / star'],['⬆','Up'],['⬇','Down'],['⬅','Left'],['➡','Right'],['❓','Unknown'],['❗','Alert']].each do |ic, name| %>
                    <button type="button" class="brush icon-brush" data-brush-type="icon" data-icon="<%= ic %>" title="<%= name %>"><%= ic %></button>
                  <% end %>
                  <input type="text" class="brush-icon-custom" maxlength="3" placeholder="?" title="Custom icon (1-3 chars)">
                </div>
                <% if (@map_image_library || []).any? %>
                  <div class="palette-group">
                    <span class="palette-label">Image:</span>
                    <button type="button" class="brush image-brush" data-brush-type="image" data-image="" title="Clear image">none</button>
                    <% @map_image_library.each do |row| %>
                      <button type="button" class="brush image-brush" data-brush-type="image" data-image="<%= h(row['src']) %>" title="<%= h(row['label']) %>"><img src="<%= h(row['src']) %>" alt="<%= h(row['label']) %>"></button>
                    <% end %>
                  </div>
                <% end %>
                <div class="palette-group">
                  <span class="palette-label">Tools:</span>
                  <button type="button" class="brush label-brush" data-brush-type="label" title="Prompt for a label">Label</button>
                  <button type="button" class="brush move-brush" data-brush-type="move" title="Drag a cell's contents to a new square">Move</button>
                  <button type="button" class="brush erase-brush" data-brush-type="erase" title="Clear cells (drag for a rectangle)">Clear cell</button>
                  <button type="submit" class="map-save-btn" title="Save the map edits">Save map</button>
                </div>
                <div class="palette-group palette-status">
                  <span class="palette-label">Brush:</span>
                  <span class="active-brush-desc">Pick a palette item</span>
                </div>
              </div>
            </form>
          <% end %>

          <div class="scene-map-player-palette" data-player-palette="1">
            <% unless @is_dm %>
              <span class="palette-label">Action:</span>
              <button type="button" class="brush player-brush spell-brush" data-player-brush="spell" title="Mark a square as the target of a Spell">● Spell</button>
              <button type="button" class="brush player-brush" data-player-brush="erase" title="Click a cell to clear your spell dot there">Erase</button>
              <button type="button" class="brush player-clear-mine" title="Remove all of your marks on this map">Clear mine</button>
            <% end %>
            <span class="palette-label" style="margin-left: 8px;">Arrows:</span>
            <% [['attack','Attack','#c62828'],['move-hurry','Hurry','#ef6c00'],['move-sneak','Sneak','#6a1b9a'],['move-carefully','Careful','#2e7d32']].each do |type, name, color| %>
              <button type="button" class="brush player-brush arrow-brush" data-player-brush="arrow" data-arrow-type="<%= type %>" title="<%= name %> arrow — click start cell, then end cell" style="--arrow-color: <%= color %>;">→ <%= name %></button>
            <% end %>
            <% if @is_dm %>
              <button type="button" class="brush player-clear-mine clear-player-actions-btn" data-clear-player-actions="<%= h(m['id']) %>" title="Remove every player arrow, mark, and spell dot on this map">Clear player actions</button>
            <% end %>
            <span class="palette-label" style="margin-left: 8px;">Zoom:</span>
            <button type="button" class="brush map-zoom-btn" data-map-zoom="out" title="Zoom out">−</button>
            <button type="button" class="brush map-zoom-btn" data-map-zoom="reset" title="Reset zoom">100%</button>
            <button type="button" class="brush map-zoom-btn" data-map-zoom="in" title="Zoom in">+</button>
            <span class="palette-status"><span class="active-brush-desc"><%= @is_dm ? 'Pick an arrow type to draw' : 'Pick an icon to place' %></span></span>
          </div>
          <div class="scene-map-viewport">
          <div class="scene-map-pan">
          <div class="scene-map-grid-wrap">
            <div class="scene-map-grid"
                 data-map-id="<%= h(m['id']) %>"
                 data-viewer-id="<%= @viewer_id %>"
                 data-rows="<%= rows %>"
                 data-cols="<%= cols %>"
                 <%= 'data-player-grid="1"' unless @is_dm %>
                 <%= 'data-dm-grid="1" data-grid="1"' if @is_dm %>
                 style="grid-template-columns: repeat(<%= cols %>, var(--scene-cell-size));">
              <% rows.times do |r| %>
                <% cols.times do |c| %>
                  <% cell = cells["#{r},#{c}"] || {} %>
                  <% pmark = player_cells["#{r},#{c}"] %>
                  <div class="scene-map-cell<%= ' editable player-editable' unless @is_dm %><%= ' editable' if @is_dm %>"
                       data-r="<%= r %>" data-c="<%= c %>"
                       style="<%= cell['color'] && !cell['color'].empty? ? "background:#{h cell['color']};" : '' %>">
                    <% if cell['image'] && !cell['image'].to_s.empty? %>
                      <img class="scene-map-cell-image" src="<%= h(cell['image']) %>" alt="">
                    <% end %>
                    <% if cell['icon'] && !cell['icon'].to_s.empty? %>
                      <span class="scene-map-icon"><%= h(cell['icon']) %></span>
                    <% end %>
                    <% if cell['label'] && !cell['label'].to_s.empty? %>
                      <span class="scene-map-label"><%= h(cell['label']) %></span>
                    <% end %>
                    <% if pmark.is_a?(Hash) %>
                      <% if pmark['kind'] == 'spell' %>
                        <span class="scene-map-spell-dot<%= ' mine' if pmark['by'] == @viewer_id %>" data-by="<%= pmark['by'] %>" title="Spell"></span>
                      <% elsif pmark['icon'] %>
                        <span class="scene-map-player-mark<%= ' mine' if pmark['by'] == @viewer_id %>" data-by="<%= pmark['by'] %>"><%= h(pmark['icon']) %></span>
                      <% end %>
                    <% end %>
                  </div>
                <% end %>
              <% end %>
            </div>
            <%# SVG arrow overlay. viewBox is in pixel units matching the
                grid (1px border + 1px padding + cellsize-px cells with 1px
                gaps). pointer-events: none so the SVG doesn't swallow cell
                clicks; the arrow-remove handles override pointer-events to
                receive their own click. JS repaints after each /arrow POST
                using the same coordinate math. %>
            <%
              cell_px = 32 # scene-cell-size
              stride = cell_px + 1
              total_w = 1 + 1 + cols * stride
              total_h = 1 + 1 + rows * stride
              center = ->(r, c) { [2 + c * stride + cell_px / 2.0, 2 + r * stride + cell_px / 2.0] }
            %>
            <svg class="scene-map-arrows"
                 viewBox="0 0 <%= total_w %> <%= total_h %>"
                 width="<%= total_w %>" height="<%= total_h %>"
                 preserveAspectRatio="xMidYMid meet"
                 xmlns="http://www.w3.org/2000/svg"
                 data-map-id="<%= h(m['id']) %>"
                 data-stride="<%= stride %>"
                 data-cell-size="<%= cell_px %>">
              <defs>
                <% SCENE_MAP_ARROW_STYLES.each do |type, style| %>
                  <marker id="arrowhead-<%= h(m['id']) %>-<%= type %>"
                          viewBox="0 0 10 10" refX="8" refY="5"
                          markerWidth="5" markerHeight="5"
                          orient="auto-start-reverse">
                    <path d="M 0 0 L 10 5 L 0 10 z" fill="<%= style[:color] %>"/>
                  </marker>
                <% end %>
              </defs>
              <% player_arrows.each do |a| %>
                <% style = SCENE_MAP_ARROW_STYLES[a['type']] %>
                <% next unless style %>
                <% fx, fy = center.call(a['from_r'].to_i, a['from_c'].to_i) %>
                <% tx, ty = center.call(a['to_r'].to_i, a['to_c'].to_i) %>
                <% own = !@is_dm && a['by'].to_i == @viewer_id %>
                <% can_remove = @is_dm || own %>
                <g class="scene-map-arrow-group" data-arrow-id="<%= h(a['id']) %>">
                  <line x1="<%= '%.1f' % fx %>" y1="<%= '%.1f' % fy %>"
                        x2="<%= '%.1f' % tx %>" y2="<%= '%.1f' % ty %>"
                        stroke="<%= style[:color] %>" stroke-width="<%= style[:width] %>"
                        <%= "stroke-dasharray=\"#{style[:dash]}\"" if style[:dash] %>
                        marker-end="url(#arrowhead-<%= h(m['id']) %>-<%= a['type'] %>)"/>
                  <% if can_remove %>
                    <% mid_x = (fx + tx) / 2.0; mid_y = (fy + ty) / 2.0 %>
                    <g class="scene-map-arrow-remove"
                       transform="translate(<%= '%.1f' % mid_x %>,<%= '%.1f' % mid_y %>)"
                       data-arrow-id="<%= h(a['id']) %>">
                      <circle r="6" fill="#fff" stroke="<%= style[:color] %>" stroke-width="1.5"/>
                      <text x="0" y="3" text-anchor="middle"
                            font-family="Arial,sans-serif" font-size="9"
                            fill="<%= style[:color] %>" pointer-events="none">&#x2715;</text>
                    </g>
                  <% end %>
                </g>
              <% end %>
            </svg>
          </div>
          </div>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>

  <% if @show_initiative %>
    <% if @character %>
      <h2 class="scene-current-name"><%= h @character.name %>'s Turn</h2>
      <%= erb :character_sheet, layout: false %>
    <% elsif @combat.current_turn_character %>
      <p class="dt-note">It's the DM's turn.</p>
    <% end %>
  <% end %>

  <%
    # Mixed grid: scene notes and in-scene CoI cells in a single ordered
    # list. The DM can drag to reorder; entries with an explicit
    # scene_order come first (sorted ascending), then anything new
    # falls in default order (notes newest-first, characters in
    # insertion order). Players see only the cells the DM has opted them
    # into via visible_to / scene_visible_to.
    raw_cells = []
    @visible_panels.each_with_index    { |p, i| raw_cells << { kind: :note,      data: p, default_pos: i } }
    @visible_characters_of_interest.each_with_index { |c, i| raw_cells << { kind: :character, data: c, default_pos: @visible_panels.length + i } }
    grid_cells = raw_cells.sort_by { |c| [c[:data]['scene_order'].nil? ? 1 : 0, c[:data]['scene_order'].to_i, c[:default_pos]] }
  %>
  <% if grid_cells.any? %>
    <div class="scene-grid"<%= ' data-dm="1"' if @is_dm %>>
      <% grid_cells.each do |cell| %>
        <% if cell[:kind] == :note %>
          <% panel = cell[:data] %>
          <% vt = Array(panel['visible_to']) %>
          <% any_visible = vt.any? %>
          <div class="scene-grid-cell scene-grid-note" data-grid-id="<%= h(panel['id']) %>"<%= ' draggable="true"' if @is_dm %>>
            <% if panel['title'] && !panel['title'].to_s.empty? %>
              <h3><%= h(panel['title']) %></h3>
            <% end %>
            <% if @is_dm %>
              <details class="scene-grid-vis-collapse">
                <summary class="scene-grid-vis-status <%= any_visible ? 'visible' : 'hidden' %>"><%= any_visible ? "Visible (#{vt.length})" : 'Hidden' %></summary>
                <div class="scene-grid-vis">
                  <span class="scene-grid-vis-label">Players see:</span>
                  <% @pc_characters.each do |pc| %>
                    <% on = vt.include?(pc['id']) %>
                    <form method="post" action="/scene/panel/toggle_visible_to" style="display:inline;">
                      <input type="hidden" name="id" value="<%= h(panel['id']) %>">
                      <input type="hidden" name="pc_id" value="<%= pc['id'] %>">
                      <button type="submit" class="scene-grid-vis-btn <%= on ? 'on' : 'off' %>" title="Click to <%= on ? 'hide from' : 'show to' %> <%= h(pc['name']) %>">
                        <%= on ? '✓' : '✗' %> <%= h(pc['name']) %>
                      </button>
                    </form>
                  <% end %>
                  <form method="post" action="/scene/panel/visible_to_all" style="display:inline;">
                    <input type="hidden" name="id" value="<%= h(panel['id']) %>">
                    <button type="submit" class="scene-grid-vis-btn bulk">Show to all</button>
                  </form>
                  <form method="post" action="/scene/panel/visible_to_none" style="display:inline;">
                    <input type="hidden" name="id" value="<%= h(panel['id']) %>">
                    <button type="submit" class="scene-grid-vis-btn bulk">Hide from all</button>
                  </form>
                </div>
              </details>
            <% end %>
            <p><%= truncated_note_html(panel['note']) %></p>
            <% if @is_dm %>
              <div class="scene-grid-actions">
                <form method="post" action="/scene/panel/promote" style="display:inline;" onsubmit="return confirm('Promote this scene note into the permanent Notes section?');">
                  <input type="hidden" name="id" value="<%= h(panel['id']) %>">
                  <button type="submit">Promote to Notes</button>
                </form>
              </div>
            <% end %>
          </div>
        <% else %>
          <% char = cell[:data] %>
          <% tier = char['tier'].to_i if char.key?('tier') %>
          <% tier_class = (tier && tier >= 0) ? "tier-#{tier}" : 'tier-unknown' %>
          <% svt = Array(char['scene_visible_to']) %>
          <% any_visible = svt.any? %>
          <div class="scene-grid-cell scene-grid-character" data-grid-id="<%= h(char['id']) %>"<%= ' draggable="true"' if @is_dm %>>
            <div class="scene-grid-character-header">
              <% if @is_dm %>
                <form method="post" action="/scene/character/remove_from_scene" style="display:inline;" onsubmit="return confirm('Remove this character from the scene?');">
                  <input type="hidden" name="id" value="<%= h(char['id']) %>">
                  <button type="submit" class="scene-grid-character-x" title="Remove from scene">×</button>
                </form>
              <% end %>
              <div class="scene-grid-character-name <%= tier_class %>">
                <%= h(char['title']) %>
              </div>
            </div>
            <% if @is_dm %>
              <details class="scene-grid-vis-collapse">
                <summary class="scene-grid-vis-status <%= any_visible ? 'visible' : 'hidden' %>"><%= any_visible ? "Visible (#{svt.length})" : 'Hidden' %></summary>
                <div class="scene-grid-vis">
                  <span class="scene-grid-vis-label">Players see:</span>
                  <% @pc_characters.each do |pc| %>
                    <% on = svt.include?(pc['id']) %>
                    <form method="post" action="/scene/character/toggle_scene_visible_to" style="display:inline;">
                      <input type="hidden" name="id" value="<%= h(char['id']) %>">
                      <input type="hidden" name="pc_id" value="<%= pc['id'] %>">
                      <button type="submit" class="scene-grid-vis-btn <%= on ? 'on' : 'off' %>" title="Click to <%= on ? 'hide from' : 'show to' %> <%= h(pc['name']) %>">
                        <%= on ? '✓' : '✗' %> <%= h(pc['name']) %>
                      </button>
                    </form>
                  <% end %>
                  <form method="post" action="/scene/character/scene_visible_all" style="display:inline;">
                    <input type="hidden" name="id" value="<%= h(char['id']) %>">
                    <button type="submit" class="scene-grid-vis-btn bulk">Show to all</button>
                  </form>
                  <form method="post" action="/scene/character/scene_visible_none" style="display:inline;">
                    <input type="hidden" name="id" value="<%= h(char['id']) %>">
                    <button type="submit" class="scene-grid-vis-btn bulk">Hide from all</button>
                  </form>
                </div>
                <div class="scene-grid-actions">
                  <form method="post" action="/scene/character/image" enctype="multipart/form-data" class="scene-grid-img-form">
                    <input type="hidden" name="id" value="<%= h(char['id']) %>">
                    <input type="file" name="image" accept="image/*" required>
                    <button type="submit"><%= char['image_path'] ? 'Replace image' : 'Attach image' %></button>
                  </form>
                  <% if char['image_path'] %>
                    <form method="post" action="/scene/character/image/clear">
                      <input type="hidden" name="id" value="<%= h(char['id']) %>">
                      <button type="submit">Remove image</button>
                    </form>
                  <% end %>
                </div>
              </details>
            <% end %>
            <% if char['image_path'] && !char['image_path'].to_s.empty? %>
              <img src="<%= h(char['image_path']) %>" alt="<%= h(char['title']) %>" class="scene-grid-character-img zoomable">
            <% else %>
              <div class="scene-grid-character-img scene-grid-character-img-placeholder" aria-hidden="true">
                <svg viewBox="0 0 64 64" width="64" height="64">
                  <circle cx="32" cy="22" r="11" fill="#bdbdbd"/>
                  <path d="M10 60 C 10 44, 54 44, 54 60 Z" fill="#bdbdbd"/>
                </svg>
              </div>
            <% end %>
            <% if char['note'] && !char['note'].to_s.empty? %>
              <p><%= truncated_note_html(char['note']) %></p>
            <% end %>
          </div>
        <% end %>
      <% end %>
    </div>
  <% end %>

  <% if @visible_images.any? %>
    <div class="scene-shared-images">
      <% @visible_images.each do |img| %>
        <figure class="scene-shared-image">
          <% if img['title'] && !img['title'].to_s.empty? %>
            <figcaption><%= h(img['title']) %></figcaption>
          <% end %>
          <img src="<%= h(img['image_path']) %>" alt="<%= h(img['title']) %>" class="zoomable">
        </figure>
      <% end %>
    </div>
  <% end %>

  <% if @is_dm %>
    <div class="dm-staging">
      <h2>DM Staging</h2>
      <p class="dt-note" style="color:#888;">Only visible to the DM. Scene Notes show on /scene per the visibility checkboxes; promote them to move into the permanent Notes section. Manage Characters of Interest from <a href="/notes/0">the Notes page</a>.</p>

      <div class="staging-toolbar">
        <form method="post" action="/scene/toggle_initiative" style="display:inline;">
          <button type="submit"><%= @hide_initiative ? 'Show initiative table' : 'Hide initiative table' %></button>
        </form>
        <small style="color:#666;">Initiative is <strong><%= @show_initiative ? 'showing' : 'hidden' %></strong> for everyone.</small>
      </div>

      <div class="section">
        <h3>Scene Notes</h3>
        <p class="dt-note" style="color:#888;">New notes appear at the top of the scene grid. Promote a note to move it into the permanent Notes section.</p>
        <form method="post" action="/scene/panel" class="notes-form scene-note-add">
          <h4>Add Scene Note</h4>
          <input type="text" name="title" placeholder="Title (optional)">
          <textarea name="note" rows="3" required></textarea>
          <div class="panel-visibility">
            <% @pc_characters.each do |pc| %>
              <label>
                <input type="checkbox" name="visible_to[]" value="<%= pc['id'] %>" checked>
                <%= h(pc['name']) %>
              </label>
            <% end %>
          </div>
          <button type="submit">Add Scene Note</button>
        </form>
        <% if @scene_notes.empty? %>
          <p class="dt-note">No scene notes yet.</p>
        <% else %>
          <div class="staging-note-grid">
            <% @scene_notes.each do |note| %>
              <div class="staging-panel">
                <form method="post" action="/scene/panel/update" class="notes-form">
                  <input type="hidden" name="id" value="<%= h(note['id']) %>">
                  <input type="text" name="title" value="<%= h(note['title']) %>" placeholder="Title (optional)">
                  <textarea name="note" rows="4" required><%= h(note['note']) %></textarea>
                  <div class="panel-visibility">
                    <% @pc_characters.each do |pc| %>
                      <label>
                        <input type="checkbox" name="visible_to[]" value="<%= pc['id'] %>" <%= 'checked' if Array(note['visible_to']).include?(pc['id']) %>>
                        <%= h(pc['name']) %>
                      </label>
                    <% end %>
                  </div>
                  <div class="form-row">
                    <button type="submit">Save</button>
                  </div>
                </form>
                <form method="post" action="/scene/panel/promote" style="display:inline;">
                  <input type="hidden" name="id" value="<%= h(note['id']) %>">
                  <button type="submit">Promote to Notes</button>
                </form>
                <form method="post" action="/scene/panel/delete" style="display:inline;">
                  <input type="hidden" name="id" value="<%= h(note['id']) %>">
                  <button type="submit" class="danger" onclick="return confirm('Delete this scene note?');">Delete</button>
                </form>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>

      <div class="section">
        <h3>Images</h3>
        <form method="post" action="/scene/image" class="notes-form" enctype="multipart/form-data">
          <h4>Upload Image</h4>
          <label>Title (optional):</label>
          <input type="text" name="title">
          <label>File (png/jpg/gif/webp, max 10 MB):</label>
          <input type="file" name="image" accept="image/*" required>
          <button type="submit">Upload</button>
        </form>
        <% if @draft_images.empty? %>
          <p class="dt-note">No images yet.</p>
        <% else %>
          <div class="staging-image-grid">
            <% @draft_images.each do |img| %>
              <div class="staging-image">
                <img src="<%= h(img['image_path']) %>" alt="<%= h(img['title']) %>" class="zoomable">
                <form method="post" action="/scene/image/update" class="notes-form">
                  <input type="hidden" name="id" value="<%= h(img['id']) %>">
                  <input type="text" name="title" value="<%= h(img['title']) %>" placeholder="Title">
                  <button type="submit">Save title</button>
                </form>
                <form method="post" action="/scene/image/share" style="display:inline;">
                  <input type="hidden" name="id" value="<%= h(img['id']) %>">
                  <button type="submit"><%= img['shared'] ? 'Unshare' : 'Share' %></button>
                </form>
                <form method="post" action="/scene/image/promote" style="display:inline;">
                  <input type="hidden" name="id" value="<%= h(img['id']) %>">
                  <button type="submit">Promote to Notes</button>
                </form>
                <form method="post" action="/scene/image/delete" style="display:inline;">
                  <input type="hidden" name="id" value="<%= h(img['id']) %>">
                  <button type="submit" class="danger" onclick="return confirm('Delete this image?');">Delete</button>
                </form>
                <small style="color:#666;"><%= img['shared'] ? 'Shared with all players' : 'Not shared' %></small>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>

      <div class="section">
        <h3>Names</h3>
        <p class="dt-note" style="color:#888;">Drop placeholder names in here as you make them up. Promote a name to turn it into a Character of Interest.</p>
        <% if @draft_names.empty? %>
          <p class="dt-note">No names yet.</p>
        <% else %>
          <ul class="staging-names">
            <% @draft_names.each do |n| %>
              <li>
                <details>
                  <summary>
                    <span class="staging-name-label"><%= h(n['title']) %></span>
                  </summary>
                  <form method="post" action="/scene/draft_name/update" class="notes-form">
                    <input type="hidden" name="id" value="<%= h(n['id']) %>">
                    <label>Rename:</label>
                    <input type="text" name="title" value="<%= h(n['title']) %>" required>
                    <button type="submit">Save name</button>
                  </form>
                  <form method="post" action="/scene/draft_name/promote" class="notes-form">
                    <input type="hidden" name="id" value="<%= h(n['id']) %>">
                    <label>Description:</label>
                    <textarea name="note" rows="2" required></textarea>
                    <div class="form-row">
                      <div>
                        <label>Tier:</label>
                        <select name="tier">
                          <option value="-1">Unknown</option>
                          <option value="0">0 - Red</option>
                          <option value="1">1 - Orange</option>
                          <option value="2">2 - Yellow</option>
                          <option value="3">3 - Green</option>
                          <option value="4">4 - Blue</option>
                        </select>
                      </div>
                      <div>
                        <label><input type="checkbox" name="public" value="true" checked> Visible to players on Notes page</label>
                      </div>
                    </div>
                    <button type="submit">Promote to Character of Interest</button>
                  </form>
                  <form method="post" action="/scene/draft_name/delete" style="display:inline;">
                    <input type="hidden" name="id" value="<%= h(n['id']) %>">
                    <button type="submit" class="danger" onclick="return confirm('Delete this name?');">Delete</button>
                  </form>
                </details>
              </li>
            <% end %>
          </ul>
        <% end %>
        <form method="post" action="/scene/draft_names_bulk" class="notes-form">
          <label>Add names (one per line):</label>
          <textarea name="titles" rows="4" placeholder="Bartender Greta&#10;Captain Harris&#10;Old Willem" required></textarea>
          <button type="submit">Add</button>
        </form>
      </div>
    </div>
  <% end %>
</div>

<% if @is_dm %>
<script>
// Scene-grid drag reorder. Whole cells are draggable; on drop the new
// DOM order is POSTed to /scene/reorder which stamps a scene_order
// integer on each entry. Buttons inside cells still receive their
// click first, so the drag only fires when the user actually drags.
(function() {
  var grid = document.querySelector('.scene-grid[data-dm]');
  if (!grid) return;
  var dragSrc = null;

  function postOrder() {
    var fd = new FormData();
    grid.querySelectorAll('.scene-grid-cell[data-grid-id]').forEach(function(cell) {
      fd.append('ids[]', cell.getAttribute('data-grid-id'));
    });
    fetch('/scene/reorder', { method: 'POST', body: fd });
  }

  grid.querySelectorAll('.scene-grid-cell[data-grid-id]').forEach(function(cell) {
    cell.addEventListener('dragstart', function(e) {
      // Don't start a drag from form controls — let buttons/inputs work normally.
      var t = e.target;
      if (t.closest('button, input, textarea, select, a, form, summary')) {
        e.preventDefault();
        return;
      }
      dragSrc = cell;
      cell.classList.add('scene-grid-dragging');
      e.dataTransfer.effectAllowed = 'move';
      try { e.dataTransfer.setData('text/plain', cell.getAttribute('data-grid-id')); } catch (_) {}
    });
    cell.addEventListener('dragend', function() {
      cell.classList.remove('scene-grid-dragging');
      grid.querySelectorAll('.scene-grid-drop-after, .scene-grid-drop-before').forEach(function(c) {
        c.classList.remove('scene-grid-drop-after', 'scene-grid-drop-before');
      });
      dragSrc = null;
    });
    cell.addEventListener('dragover', function(e) {
      if (!dragSrc || dragSrc === cell) return;
      e.preventDefault();
      var rect = cell.getBoundingClientRect();
      var before = (e.clientY - rect.top) < rect.height / 2;
      cell.classList.toggle('scene-grid-drop-before', before);
      cell.classList.toggle('scene-grid-drop-after', !before);
    });
    cell.addEventListener('dragleave', function() {
      cell.classList.remove('scene-grid-drop-after', 'scene-grid-drop-before');
    });
    cell.addEventListener('drop', function(e) {
      e.preventDefault();
      if (!dragSrc || dragSrc === cell) return;
      var rect = cell.getBoundingClientRect();
      var before = (e.clientY - rect.top) < rect.height / 2;
      grid.insertBefore(dragSrc, before ? cell : cell.nextSibling);
      cell.classList.remove('scene-grid-drop-after', 'scene-grid-drop-before');
      postOrder();
    });
  });
})();
</script>
<% end %>

<script>
(function() {
  // Player-side map interactions: pick a restricted icon, click a cell to
  // drop it. Backs /scene/map/player_mark; DM edits wipe these marks.
  // No-op for the DM (scoped to data-player-grid grids only).
  var grids = document.querySelectorAll('.scene-map-grid[data-player-grid="1"]');
  grids.forEach(function(grid) {
    var mapId = grid.getAttribute('data-map-id');
    var viewerId = grid.getAttribute('data-viewer-id');
    var mapEl = grid.closest('.scene-map');
    var panel = mapEl ? mapEl.querySelector('[data-player-palette="1"]') : null;
    if (!panel) return;
    var status = panel.querySelector('.active-brush-desc');
    var brush = null;

    function describe() {
      if (!brush) { status.textContent = 'Pick an icon to place'; return; }
      if (brush.kind === 'erase') status.textContent = 'Click a cell to clear its mark';
      else if (brush.kind === 'spell') status.textContent = 'Click a cell to mark it as a Spell target';
      else status.textContent = 'Click a cell to place ' + brush.icon;
    }

    function setActiveChip(btn) {
      panel.querySelectorAll('.player-brush.active').forEach(function(b) { b.classList.remove('active'); });
      if (btn) btn.classList.add('active');
    }

    panel.querySelectorAll('.player-brush').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var kind = btn.getAttribute('data-player-brush');
        if (kind === 'erase') brush = { kind: 'erase' };
        else if (kind === 'spell') brush = { kind: 'spell' };
        else if (kind === 'arrow') return; // arrows handled by their own script
        else brush = { kind: 'place', icon: btn.getAttribute('data-icon') };
        setActiveChip(btn);
        describe();
      });
    });

    function repaint(playerCells) {
      grid.querySelectorAll('.scene-map-player-mark, .scene-map-spell-dot').forEach(function(el) { el.remove(); });
      Object.keys(playerCells || {}).forEach(function(key) {
        var p = playerCells[key];
        if (!p) return;
        var parts = key.split(',');
        var cell = grid.querySelector('.scene-map-cell[data-r="' + parts[0] + '"][data-c="' + parts[1] + '"]');
        if (!cell) return;
        if (p.kind === 'spell') {
          var dot = document.createElement('span');
          dot.className = 'scene-map-spell-dot' + (String(p.by) === String(viewerId) ? ' mine' : '');
          dot.setAttribute('data-by', p.by || '');
          dot.title = 'Spell';
          cell.appendChild(dot);
        } else if (p.icon) {
          var span = document.createElement('span');
          span.className = 'scene-map-player-mark' + (String(p.by) === String(viewerId) ? ' mine' : '');
          span.setAttribute('data-by', p.by || '');
          span.textContent = p.icon;
          cell.appendChild(span);
        }
      });
    }

    function send(params) {
      params.set('id', mapId);
      params.set('viewer_id', viewerId);
      return fetch('/scene/map/player_mark', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: params.toString()
      }).then(function(r) { return r.ok ? r.json() : null; })
        .then(function(body) { if (body && body.player_cells) repaint(body.player_cells); });
    }

    grid.addEventListener('click', function(e) {
      var cell = e.target.closest('.scene-map-cell.player-editable');
      if (!cell || !grid.contains(cell)) return;
      if (!brush) return;
      var r = cell.getAttribute('data-r');
      var c = cell.getAttribute('data-c');
      var p = new URLSearchParams();
      if (brush.kind === 'erase') {
        p.set('action', 'clear');
        p.set('r', r); p.set('c', c);
      } else if (brush.kind === 'spell') {
        p.set('action', 'place');
        p.set('r', r); p.set('c', c);
        p.set('kind', 'spell');
      } else {
        p.set('action', 'place');
        p.set('r', r); p.set('c', c);
        p.set('icon', brush.icon);
      }
      send(p);
    });

    var clearMine = panel.querySelector('.player-clear-mine');
    if (clearMine) {
      clearMine.addEventListener('click', function() {
        var p = new URLSearchParams();
        p.set('action', 'clear_mine');
        send(p);
      });
    }
  });
})();
</script>

<script>
(function() {
  // Player + DM arrow drawing on the active map. Two-click flow:
  // pick an arrow type, click the start cell (gets a halo), click
  // the end cell to commit. Works on data-player-grid and
  // data-dm-grid. The X handle on each arrow removes it (owner or
  // DM); removal is owner-checked server-side.
  var grids = document.querySelectorAll('.scene-map-grid[data-map-id]');
  grids.forEach(function(grid) {
    var mapId = grid.getAttribute('data-map-id');
    var viewerId = grid.getAttribute('data-viewer-id');
    var mapEl = grid.closest('.scene-map');
    var panel = mapEl ? mapEl.querySelector('[data-player-palette="1"]') : null;
    if (!panel) return;
    var status = panel.querySelector('.active-brush-desc');
    var svg = grid.parentElement.querySelector('.scene-map-arrows');
    if (!svg) return;
    var stride = parseFloat(svg.getAttribute('data-stride')) || 33;
    var cellPx = parseFloat(svg.getAttribute('data-cell-size')) || 32;
    function center(r, c) { return [2 + c * stride + cellPx / 2, 2 + r * stride + cellPx / 2]; }

    var arrowBrush = null; // 'attack' | 'move-hurry' | ...
    var pendingFrom = null; // {r,c}

    function clearStartHalo() {
      grid.querySelectorAll('.arrow-start-halo').forEach(function(el) { el.classList.remove('arrow-start-halo'); });
    }
    function setBrushFromBtn(btn) {
      panel.querySelectorAll('.arrow-brush.active').forEach(function(b) { b.classList.remove('active'); });
      if (btn) btn.classList.add('active');
    }
    function describeArrow() {
      if (!arrowBrush) return;
      if (pendingFrom) status.textContent = 'Click the end cell for the ' + arrowBrush + ' arrow';
      else status.textContent = 'Click the start cell for the ' + arrowBrush + ' arrow';
    }

    panel.querySelectorAll('.arrow-brush').forEach(function(btn) {
      btn.addEventListener('click', function() {
        arrowBrush = btn.getAttribute('data-arrow-type');
        pendingFrom = null;
        clearStartHalo();
        setBrushFromBtn(btn);
        describeArrow();
      });
    });

    function send(params) {
      params.set('id', mapId);
      if (viewerId && viewerId !== '0') params.set('viewer_id', viewerId);
      return fetch('/scene/map/arrow', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: params.toString()
      }).then(function(r) { return r.ok ? r.json() : null; })
        .then(function(body) { if (body && body.player_arrows) repaint(body.player_arrows); });
    }

    var ARROW_STYLES = {
      'attack':         { color: '#c62828', dash: null,    width: 2.5 },
      'move-hurry':     { color: '#ef6c00', dash: '6 4',   width: 2 },
      'move-sneak':     { color: '#6a1b9a', dash: '2 3',   width: 1.5 },
      'move-carefully': { color: '#2e7d32', dash: null,    width: 2 }
    };
    var SVG_NS = 'http://www.w3.org/2000/svg';

    function repaint(arrows) {
      // Wipe every arrow group and rebuild from the server's payload.
      svg.querySelectorAll('.scene-map-arrow-group').forEach(function(g) { g.remove(); });
      arrows.forEach(function(a) {
        var style = ARROW_STYLES[a.type];
        if (!style) return;
        var f = center(a.from_r, a.from_c);
        var t = center(a.to_r, a.to_c);
        var g = document.createElementNS(SVG_NS, 'g');
        g.setAttribute('class', 'scene-map-arrow-group');
        g.setAttribute('data-arrow-id', a.id);
        var line = document.createElementNS(SVG_NS, 'line');
        line.setAttribute('x1', f[0].toFixed(1));
        line.setAttribute('y1', f[1].toFixed(1));
        line.setAttribute('x2', t[0].toFixed(1));
        line.setAttribute('y2', t[1].toFixed(1));
        line.setAttribute('stroke', style.color);
        line.setAttribute('stroke-width', style.width);
        if (style.dash) line.setAttribute('stroke-dasharray', style.dash);
        line.setAttribute('marker-end', 'url(#arrowhead-' + mapId + '-' + a.type + ')');
        g.appendChild(line);
        var isDM = grid.hasAttribute('data-dm-grid');
        var canRemove = isDM || String(a.by) === String(viewerId);
        if (canRemove) {
          var rg = document.createElementNS(SVG_NS, 'g');
          rg.setAttribute('class', 'scene-map-arrow-remove');
          rg.setAttribute('data-arrow-id', a.id);
          var mx = (f[0] + t[0]) / 2;
          var my = (f[1] + t[1]) / 2;
          rg.setAttribute('transform', 'translate(' + mx.toFixed(1) + ',' + my.toFixed(1) + ')');
          var circle = document.createElementNS(SVG_NS, 'circle');
          circle.setAttribute('r', '6');
          circle.setAttribute('fill', '#fff');
          circle.setAttribute('stroke', style.color);
          circle.setAttribute('stroke-width', '1.5');
          rg.appendChild(circle);
          var text = document.createElementNS(SVG_NS, 'text');
          text.setAttribute('x', '0');
          text.setAttribute('y', '3');
          text.setAttribute('text-anchor', 'middle');
          text.setAttribute('font-family', 'Arial,sans-serif');
          text.setAttribute('font-size', '9');
          text.setAttribute('fill', style.color);
          text.setAttribute('pointer-events', 'none');
          text.textContent = '✕';
          rg.appendChild(text);
          g.appendChild(rg);
        }
        svg.appendChild(g);
      });
    }

    grid.addEventListener('click', function(e) {
      if (!arrowBrush) return;
      var cell = e.target.closest('.scene-map-cell');
      if (!cell || !grid.contains(cell)) return;
      var r = parseInt(cell.getAttribute('data-r'), 10);
      var c = parseInt(cell.getAttribute('data-c'), 10);
      if (pendingFrom == null) {
        pendingFrom = { r: r, c: c };
        clearStartHalo();
        cell.classList.add('arrow-start-halo');
        describeArrow();
        return;
      }
      if (pendingFrom.r === r && pendingFrom.c === c) {
        // Same cell — cancel the pending start.
        pendingFrom = null;
        clearStartHalo();
        describeArrow();
        return;
      }
      var p = new URLSearchParams();
      p.set('action', 'place');
      p.set('type', arrowBrush);
      p.set('from_r', pendingFrom.r);
      p.set('from_c', pendingFrom.c);
      p.set('to_r', r);
      p.set('to_c', c);
      send(p);
      pendingFrom = null;
      clearStartHalo();
      describeArrow();
    });

    svg.addEventListener('click', function(e) {
      var rg = e.target.closest('.scene-map-arrow-remove');
      if (!rg) return;
      var arrowId = rg.getAttribute('data-arrow-id');
      if (!arrowId) return;
      var p = new URLSearchParams();
      p.set('action', 'delete');
      p.set('arrow_id', arrowId);
      send(p);
    });
  });
})();
</script>

<script>
(function() {
  // DM-side map editor: pick a brush, click cells to paint, drag for
  // rectangle selection on color/erase, or use Move to pick up a cell's
  // icon+label and drop it on another. Cells round-trip via a hidden
  // cells_json input on form submit.
  var editors = document.querySelectorAll('.scene-map-editor[data-editor="1"]');
  editors.forEach(function(form) {
    var hidden = form.querySelector('input[name="cells_json"]');
    // The grid may live INSIDE the form (maps.erb) or as a sibling
    // outside the form within the same .scene-map (scene.erb DM
    // view, where the grid is shared with the player view's
    // arrow-overlay and zoom wrap). Look in both places.
    var mapEl = form.closest('.scene-map');
    var grid = form.querySelector('[data-grid="1"]') ||
               (mapEl && mapEl.querySelector('[data-grid="1"]'));
    var palette = form.querySelector('[data-palette="1"]');
    if (!hidden || !grid || !palette) return;
    var status = palette.querySelector('.active-brush-desc');
    var colorPicker = palette.querySelector('.brush-color-picker');
    var iconCustom = palette.querySelector('.brush-icon-custom');

    var cells = {};
    try { cells = JSON.parse(hidden.value || '{}') || {}; }
    catch (e) { cells = {}; }

    var brush = null;

    function setActiveChip(btn) {
      palette.querySelectorAll('.brush.active').forEach(function(b) { b.classList.remove('active'); });
      if (btn) btn.classList.add('active');
    }

    function describe() {
      if (!status) return;
      if (!brush) { status.textContent = 'Pick a palette item'; return; }
      if (brush.type === 'color') status.textContent = brush.color ? ('Paint color ' + brush.color) : 'Clear color';
      else if (brush.type === 'icon') status.textContent = brush.icon ? ('Place icon ' + brush.icon) : 'Clear icon';
      else if (brush.type === 'image') status.textContent = brush.image ? 'Place image' : 'Clear image';
      else if (brush.type === 'label') status.textContent = 'Click a cell to type a label';
      else if (brush.type === 'move') status.textContent = 'Drag a cell with content to a new square';
      else if (brush.type === 'erase') status.textContent = 'Click or drag to clear cells';
    }

    palette.querySelectorAll('.color-brush').forEach(function(btn) {
      btn.addEventListener('click', function() {
        brush = { type: 'color', color: btn.getAttribute('data-color') || '' };
        setActiveChip(btn);
        describe();
      });
    });
    palette.querySelectorAll('.icon-brush').forEach(function(btn) {
      btn.addEventListener('click', function() {
        brush = { type: 'icon', icon: btn.getAttribute('data-icon') || '' };
        setActiveChip(btn);
        describe();
      });
    });
    palette.querySelectorAll('.image-brush').forEach(function(btn) {
      btn.addEventListener('click', function() {
        brush = { type: 'image', image: btn.getAttribute('data-image') || '' };
        setActiveChip(btn);
        describe();
      });
    });
    var labelBrush = palette.querySelector('.label-brush');
    if (labelBrush) labelBrush.addEventListener('click', function() {
      brush = { type: 'label' };
      setActiveChip(labelBrush);
      describe();
    });
    var moveBrush = palette.querySelector('.move-brush');
    if (moveBrush) moveBrush.addEventListener('click', function() {
      brush = { type: 'move' };
      setActiveChip(moveBrush);
      describe();
    });
    var eraseBrush = palette.querySelector('.erase-brush');
    if (eraseBrush) eraseBrush.addEventListener('click', function() {
      brush = { type: 'erase' };
      setActiveChip(eraseBrush);
      describe();
    });

    if (colorPicker) {
      colorPicker.addEventListener('change', function() {
        brush = { type: 'color', color: colorPicker.value };
        setActiveChip(null);
        describe();
      });
    }
    if (iconCustom) {
      iconCustom.addEventListener('change', function() {
        brush = { type: 'icon', icon: iconCustom.value };
        setActiveChip(null);
        describe();
      });
      iconCustom.addEventListener('keypress', function(e) {
        if (e.key === 'Enter') { e.preventDefault(); iconCustom.dispatchEvent(new Event('change')); }
      });
    }

    function applyToCell(cellEl, brushAtTime) {
      if (!cellEl || !brushAtTime) return;
      var r = cellEl.getAttribute('data-r');
      var c = cellEl.getAttribute('data-c');
      var key = r + ',' + c;
      var data = cells[key] || {};
      if (brushAtTime.type === 'color') {
        if (brushAtTime.color) { data.color = brushAtTime.color; cellEl.style.background = brushAtTime.color; }
        else { delete data.color; cellEl.style.background = ''; }
      } else if (brushAtTime.type === 'icon') {
        Array.prototype.slice.call(cellEl.querySelectorAll('.scene-map-icon, .scene-map-label')).forEach(function(n) {
          if (n.classList.contains('scene-map-icon')) n.remove();
        });
        if (brushAtTime.icon) {
          data.icon = brushAtTime.icon;
          var i = document.createElement('span');
          i.className = 'scene-map-icon';
          i.textContent = brushAtTime.icon;
          cellEl.insertBefore(i, cellEl.firstChild);
        } else {
          delete data.icon;
        }
      } else if (brushAtTime.type === 'image') {
        cellEl.querySelectorAll('.scene-map-cell-image').forEach(function(n) { n.remove(); });
        if (brushAtTime.image) {
          data.image = brushAtTime.image;
          var img = document.createElement('img');
          img.className = 'scene-map-cell-image';
          img.src = brushAtTime.image;
          img.alt = '';
          cellEl.insertBefore(img, cellEl.firstChild);
        } else {
          delete data.image;
        }
      } else if (brushAtTime.type === 'label') {
        var existing = data.label || '';
        var v = window.prompt('Label for this cell (blank to clear):', existing);
        if (v === null) return;
        cellEl.querySelectorAll('.scene-map-label').forEach(function(n) { n.remove(); });
        if (v) {
          data.label = v;
          var l = document.createElement('span');
          l.className = 'scene-map-label';
          l.textContent = v;
          cellEl.appendChild(l);
        } else {
          delete data.label;
        }
      } else if (brushAtTime.type === 'erase') {
        cellEl.style.background = '';
        cellEl.querySelectorAll('.scene-map-icon, .scene-map-label, .scene-map-cell-image').forEach(function(n) { n.remove(); });
        delete data.color; delete data.icon; delete data.label; delete data.image;
      }
      if (Object.keys(data).length === 0) { delete cells[key]; }
      else { cells[key] = data; }
    }

    function cellAt(r, c) {
      return grid.querySelector('.scene-map-cell.editable[data-r="' + r + '"][data-c="' + c + '"]');
    }

    var rectAnchor = null;
    var rectPreview = [];

    grid.addEventListener('mousedown', function(e) {
      if (!brush) return;
      if (brush.type === 'move') return;
      var cellEl = e.target.closest('.scene-map-cell.editable');
      if (!cellEl || !grid.contains(cellEl)) return;
      if (brush.type === 'color' || brush.type === 'erase') {
        e.preventDefault();
        rectAnchor = { r: parseInt(cellEl.getAttribute('data-r'), 10), c: parseInt(cellEl.getAttribute('data-c'), 10) };
        rectPreview = [cellEl];
        cellEl.classList.add('rect-preview');
      }
    });
    grid.addEventListener('mousemove', function(e) {
      if (!rectAnchor) return;
      var cellEl = e.target.closest('.scene-map-cell.editable');
      if (!cellEl || !grid.contains(cellEl)) return;
      var r2 = parseInt(cellEl.getAttribute('data-r'), 10);
      var c2 = parseInt(cellEl.getAttribute('data-c'), 10);
      var rmin = Math.min(rectAnchor.r, r2), rmax = Math.max(rectAnchor.r, r2);
      var cmin = Math.min(rectAnchor.c, c2), cmax = Math.max(rectAnchor.c, c2);
      rectPreview.forEach(function(el) { el.classList.remove('rect-preview'); });
      rectPreview = [];
      for (var rr = rmin; rr <= rmax; rr++) {
        for (var cc = cmin; cc <= cmax; cc++) {
          var el = cellAt(rr, cc);
          if (el) { el.classList.add('rect-preview'); rectPreview.push(el); }
        }
      }
    });
    function commitRect() {
      if (!rectAnchor) return;
      rectPreview.forEach(function(el) {
        el.classList.remove('rect-preview');
        applyToCell(el, brush);
      });
      rectAnchor = null;
      rectPreview = [];
    }
    grid.addEventListener('mouseup', commitRect);
    grid.addEventListener('mouseleave', commitRect);

    grid.addEventListener('click', function(e) {
      if (!brush) return;
      if (brush.type === 'color' || brush.type === 'erase') return;
      if (brush.type === 'move') return;
      var cellEl = e.target.closest('.scene-map-cell.editable');
      if (!cellEl || !grid.contains(cellEl)) return;
      applyToCell(cellEl, brush);
    });

    // Move brush: drag a cell's icon+label to another cell.
    var moveSrc = null;
    var ghost = null;
    function clearMoveTargets() {
      grid.querySelectorAll('.move-target').forEach(function(el) { el.classList.remove('move-target'); });
    }
    function moveGhost(e) {
      if (!ghost) return;
      ghost.style.left = e.clientX + 'px';
      ghost.style.top = e.clientY + 'px';
      var el = document.elementFromPoint(e.clientX, e.clientY);
      var target = el && el.closest ? el.closest('.scene-map-cell.editable') : null;
      clearMoveTargets();
      if (target && grid.contains(target) && target !== moveSrc) target.classList.add('move-target');
    }
    function drop(e) {
      window.removeEventListener('mousemove', moveGhost);
      window.removeEventListener('mouseup', drop);
      if (ghost) { ghost.remove(); ghost = null; }
      var el = document.elementFromPoint(e.clientX, e.clientY);
      var destCell = el && el.closest ? el.closest('.scene-map-cell.editable') : null;
      if (moveSrc && destCell && grid.contains(destCell) && destCell !== moveSrc) {
        var srcKey = moveSrc.getAttribute('data-r') + ',' + moveSrc.getAttribute('data-c');
        var dstKey = destCell.getAttribute('data-r') + ',' + destCell.getAttribute('data-c');
        var srcData = cells[srcKey] || {};
        var dstData = cells[dstKey] || {};
        if (srcData.icon)  { dstData.icon  = srcData.icon;  delete srcData.icon; }
        if (srcData.label) { dstData.label = srcData.label; delete srcData.label; }
        if (srcData.image) { dstData.image = srcData.image; delete srcData.image; }
        if (Object.keys(srcData).length === 0) { delete cells[srcKey]; } else { cells[srcKey] = srcData; }
        if (Object.keys(dstData).length === 0) { delete cells[dstKey]; } else { cells[dstKey] = dstData; }
        // Repaint both cells
        [moveSrc, destCell].forEach(function(cellEl) {
          cellEl.querySelectorAll('.scene-map-icon, .scene-map-label, .scene-map-cell-image').forEach(function(n) { n.remove(); });
          var key = cellEl.getAttribute('data-r') + ',' + cellEl.getAttribute('data-c');
          var data = cells[key] || {};
          if (data.image) {
            var im = document.createElement('img');
            im.className = 'scene-map-cell-image';
            im.src = data.image;
            im.alt = '';
            cellEl.insertBefore(im, cellEl.firstChild);
          }
          if (data.icon) {
            var ic = document.createElement('span');
            ic.className = 'scene-map-icon';
            ic.textContent = data.icon;
            cellEl.appendChild(ic);
          }
          if (data.label) {
            var lb = document.createElement('span');
            lb.className = 'scene-map-label';
            lb.textContent = data.label;
            cellEl.appendChild(lb);
          }
        });
      }
      if (moveSrc) moveSrc.classList.remove('move-source');
      moveSrc = null;
      clearMoveTargets();
    }
    grid.addEventListener('mousedown', function(e) {
      if (!brush || brush.type !== 'move') return;
      var cellEl = e.target.closest('.scene-map-cell.editable');
      if (!cellEl) return;
      var key = cellEl.getAttribute('data-r') + ',' + cellEl.getAttribute('data-c');
      var data = cells[key];
      if (!data || (!data.icon && !data.label && !data.image)) return;
      e.preventDefault();
      moveSrc = cellEl;
      cellEl.classList.add('move-source');
      ghost = document.createElement('div');
      ghost.className = 'scene-map-ghost';
      ghost.style.left = e.clientX + 'px';
      ghost.style.top = e.clientY + 'px';
      if (data.image) {
        var gim = document.createElement('img');
        gim.className = 'scene-map-cell-image';
        gim.src = data.image;
        gim.alt = '';
        ghost.appendChild(gim);
      }
      if (data.icon) {
        var gi = document.createElement('span');
        gi.className = 'scene-map-icon';
        gi.textContent = data.icon;
        ghost.appendChild(gi);
      }
      if (data.label) {
        var gl = document.createElement('span');
        gl.className = 'scene-map-label';
        gl.textContent = data.label;
        ghost.appendChild(gl);
      }
      document.body.appendChild(ghost);
      window.addEventListener('mousemove', moveGhost);
      window.addEventListener('mouseup', drop);
    });

    form.addEventListener('submit', function() {
      hidden.value = JSON.stringify(cells);
    });
  });
})();
</script>

<script>
(function() {
  // Pan-and-zoom on a fixed-size viewport. .scene-map-pan carries
  // transform: translate(tx, ty) scale(s); .scene-map-viewport clips
  // it. Mouse drag on empty grid space pans; wheel zooms toward the
  // cursor. The +/-/100% buttons still work (zoom around viewport
  // center). State (scale + pan) persists per map id in localStorage.
  // Drag-vs-click discrimination: a click that moved >4px is treated
  // as a pan and the post-up click is suppressed so cell brush
  // handlers don't fire.
  var STORAGE_KEY = 'sceneMapView';
  function readState() {
    try { return JSON.parse(localStorage.getItem(STORAGE_KEY) || '{}') || {}; }
    catch (e) { return {}; }
  }
  function writeState(state) {
    try { localStorage.setItem(STORAGE_KEY, JSON.stringify(state)); }
    catch (e) {}
  }
  var state = readState();

  document.querySelectorAll('.scene-map').forEach(function(mapEl) {
    var grid = mapEl.querySelector('.scene-map-grid');
    if (!grid) return;
    var mapId = grid.getAttribute('data-map-id');
    var pan = mapEl.querySelector('.scene-map-pan');
    var viewport = mapEl.querySelector('.scene-map-viewport');
    var palette = mapEl.querySelector('[data-player-palette="1"]');
    if (!pan || !viewport || !palette) return;

    var saved = state[mapId] || {};
    var tx = parseFloat(saved.tx) || 0;
    var ty = parseFloat(saved.ty) || 0;
    var scale = parseFloat(saved.scale) || 1.0;

    function clamp(s) { return Math.max(0.25, Math.min(4.0, s)); }
    function apply() {
      pan.style.transform = 'translate(' + tx + 'px, ' + ty + 'px) scale(' + scale + ')';
      state[mapId] = { tx: tx, ty: ty, scale: scale };
      writeState(state);
    }
    apply();

    palette.querySelectorAll('.map-zoom-btn').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var act = btn.getAttribute('data-map-zoom');
        var rect = viewport.getBoundingClientRect();
        var px = rect.width / 2, py = rect.height / 2;
        var newScale = scale;
        if (act === 'in')       newScale = clamp(scale * 1.25);
        else if (act === 'out') newScale = clamp(scale * 0.8);
        else { tx = 0; ty = 0; scale = 1.0; apply(); return; }
        tx = px - (px - tx) * (newScale / scale);
        ty = py - (py - ty) * (newScale / scale);
        scale = newScale;
        apply();
      });
    });

    // Wheel zoom toward cursor. preventDefault so the page itself
    // doesn't scroll while the cursor is over the map.
    viewport.addEventListener('wheel', function(e) {
      e.preventDefault();
      var rect = viewport.getBoundingClientRect();
      var px = e.clientX - rect.left;
      var py = e.clientY - rect.top;
      var factor = e.deltaY < 0 ? 1.1 : 0.9;
      var newScale = clamp(scale * factor);
      if (newScale === scale) return;
      tx = px - (px - tx) * (newScale / scale);
      ty = py - (py - ty) * (newScale / scale);
      scale = newScale;
      apply();
    }, { passive: false });

    // Mouse drag pan. Only kick off when the press lands on empty
    // viewport background — never on a cell, button, arrow handle,
    // form control, etc. That way left-click on cells goes straight
    // to the brush / arrow / spell handlers without any pan
    // tracking interfering.
    var dragging = false, didPan = false;
    var startX, startY, startTx, startTy;
    viewport.addEventListener('mousedown', function(e) {
      if (e.target.closest('.scene-map-cell, button, input, select, textarea, a, label, .scene-map-arrow-remove, svg')) return;
      if (e.button !== 0) return;
      e.preventDefault();
      dragging = true; didPan = false;
      startX = e.clientX; startY = e.clientY;
      startTx = tx; startTy = ty;
    });
    document.addEventListener('mousemove', function(e) {
      if (!dragging) return;
      var dx = e.clientX - startX, dy = e.clientY - startY;
      if (!didPan && (Math.abs(dx) > 4 || Math.abs(dy) > 4)) didPan = true;
      if (didPan) {
        tx = startTx + dx;
        ty = startTy + dy;
        apply();
      }
    });
    document.addEventListener('mouseup', function() { dragging = false; });
    // Suppress the click event that follows a real drag so cell
    // handlers (brush paint, arrow start, spell drop) don't see it.
    viewport.addEventListener('click', function(e) {
      if (didPan) {
        e.stopPropagation();
        e.preventDefault();
        didPan = false;
      }
    }, true);
  });

  // AJAX "Clear player actions" — wipes server-side player_arrows +
  // player_cells without reloading the page, so unsaved DM cell
  // edits don't get reset.
  document.querySelectorAll('.clear-player-actions-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var mapId = btn.getAttribute('data-clear-player-actions');
      if (!mapId) return;
      var fd = new FormData();
      fd.append('id', mapId);
      fetch('/scene/map/player_actions/clear?ajax=1', { method: 'POST', body: fd })
        .then(function() {
          // Strip arrows + player marks from this map's DOM.
          var mapEl = btn.closest('.scene-map');
          if (!mapEl) return;
          mapEl.querySelectorAll('.scene-map-arrows .scene-map-arrow-group').forEach(function(g) { g.remove(); });
          mapEl.querySelectorAll('.scene-map-player-mark, .scene-map-spell-dot').forEach(function(el) { el.remove(); });
        });
    });
  });
})();
</script>
