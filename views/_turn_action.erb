<%#
  Turn Action Stub — docs/common/ui/turn_action_stub.md
  The Acting Combatant's turn panel, rendered below the Combat Tracker
  on the Encounter page. DM-only.

  Locals:
    acting          — the Acting Combatant's tracker row (see build_tracker_row):
                      { combatant_id, name, can_act, mana:{remaining,max}|nil,
                        combat_pool:{remaining,max}|nil, ... }.
    dead            — boolean (Conditions' Dead?).
    saves           — one Conditions Save Resolution Stub `save` blob per
                      Affliction due this Round for the Acting Combatant
                      (see start_of_turn_saves). Defaults to [].
    main_actions    — Main Actions the Combatant has left this turn (-1 before
                      the turn begins). Tracked, not enforced.
    special_options — usable non-Spell, non-Reaction Abilities, each carrying
                      its action `activation` (free/bonus/main). Defaults to [].

  Layout (the refactored stub): the turn opens with any Afflictions due this
  Round (one Save Resolution Stub each). The Combat Pool and Main Actions
  refill automatically when the turn begins (server-side), so there is no
  manual Start-of-Turn step. Below the afflictions the actions are grouped
  under Main / Bonus / Free Action headers (styled like the Cast builder's
  Tier headers): the generic actions (Attack, Move, Cast, Item, End Turn) plus
  one button per usable Special Ability under its own category. A generic
  button opens that action's pane below; a Special Ability button is handled
  by TurnSpecial.
%>
<% saves ||= [] %>
<% special_options ||= [] %>
<% main_actions ||= -1 %>
<% has_spells = false unless defined?(has_spells) %>
<% has_items = false unless defined?(has_items) %>
<% has_active_spells = false unless defined?(has_active_spells) %>
<% active_spells ||= [] %>
<% roster ||= [] %>
<%# out_of_combat: the DM Page reuses this panel to run a Character's actions
    outside of Combat (drink a Potion, use an Item, cast a utility Spell). In
    that mode the Combat-only actions — Attack, Move, End Turn — are dropped. %>
<% out_of_combat = false unless defined?(out_of_combat) %>
<%
  incapacitated = !acting[:can_act]
  state_suffix  = dead ? 'Dead' : (incapacitated ? 'Incapacitated' : nil)

  move_cost = Encounter::Config.move_cost
  mana = acting[:mana]
  pool = acting[:combat_pool]
  dash = '—'

  # Generic Main-Action buttons. An incapacitated Combatant can only end its
  # turn, so it is offered no Main Actions. Cast is offered only when the
  # Combatant knows a spell (has_spells). Out of Combat, Attack and Move are
  # dropped (Combat-only) — only Cast / Active Spells / Item remain.
  main_generic = if incapacitated
                   []
                 else
                   (out_of_combat ? [] : [{ key: 'attack', label: 'Attack' },
                                          { key: 'move',   label: 'Move' }]) +
                     (has_spells ? [{ key: 'cast', label: 'Cast' }] : []) +
                     active_spells.map { |sw| { key: "active_spell:#{sw[:index]}", label: "#{sw[:spell_name]} (conc)" } } +
                     (has_items ? [{ key: 'item', label: 'Item' }] : []) +
                     (out_of_combat ? [{ key: 'skill', label: 'Skill' }] : [])
                 end
  free_generic = out_of_combat ? [] : [{ key: 'end_turn', label: 'End Turn' }]

  # Special Abilities grouped by their action category (skipped when
  # incapacitated, since none can be used).
  specials = incapacitated ? [] : special_options
  special_by_cat = Hash.new { |h, k| h[k] = [] }
  specials.each { |o| special_by_cat[o[:activation].to_s] << o }

  categories = [
    ['main',  'Main Action',  main_generic, special_by_cat['main']],
    ['bonus', 'Bonus Action', [],           special_by_cat['bonus']],
    ['free',  'Free Action',  free_generic, special_by_cat['free']]
  ]

  ma_label = main_actions.to_i.negative? ? dash : main_actions.to_i.to_s
%>
<section class="turn-action" data-combatant-id="<%= acting[:combatant_id] %>">
  <header class="ta-header">
    <h3 class="ta-title">
      <%= acting[:name] %>&rsquo;s Turn<% if state_suffix %> <span class="ta-state ta-state-<%= state_suffix.downcase %>">(<%= state_suffix %>)</span><% end %>
    </h3>
    <div class="ta-resources">
      <span class="ta-res"><span class="ta-res-label">Mana</span> <%= mana ? "#{mana[:remaining]}/#{mana[:max]}" : dash %></span>
      <span class="ta-res"><span class="ta-res-label">Combat Pool</span> <%= pool ? "#{pool[:remaining]}/#{pool[:max]}" : dash %></span>
      <span class="ta-res"><span class="ta-res-label">Main Actions</span> <%= ma_label %></span>
    </div>
  </header>

  <%# Afflictions due this Round: one Conditions Save Resolution Stub each. The
      DM rolls + Confirms each (POSTs to /encounter/resolve_affliction). The
      Combat Pool was already refilled automatically when the turn began. %>
  <% if saves.any? %>
    <div class="ta-sot-section ta-afflictions">
      <h5 class="ta-sot-h">Afflictions due this Round</h5>
      <% saves.each do |s| %>
        <%= erb :_conditions_save_resolution, locals: { save: s } %>
      <% end %>
    </div>
  <% end %>

  <%# Action menu: buttons grouped under their action-economy category
      (Main / Bonus / Free), the headers styled like the Cast builder's Tier
      headers. Generic actions switch to their pane below (handled by app.js);
      each Special Ability button is handled by TurnSpecial. The wrapping
      .ta-special is what TurnSpecial delegates its clicks from. %>
  <div class="ta-special ta-actions-menu" data-combatant-id="<%= acting[:combatant_id] %>">
    <%# Once an action is picked the category groups collapse (ta-has-selection)
        and the chosen action is folded into the builder as its first step row
        (mountActionRow) — an "Action" row with a Change button (re-opens the
        menu) and the confirm slot the Commit proxy lands in — so it reads in
        the same pattern as Target / Weapon / Defense. %>
    <% categories.each do |cat, heading, generics, specials_in_cat| %>
      <% next if generics.empty? && specials_in_cat.empty? %>
      <div class="ta-cat-group">
        <div class="cb-tier-head ta-action-cat"><%= heading %></div>
        <div class="cb-line">
          <% generics.each do |a| %>
            <button type="button" class="cr-mod-btn cb-opt ta-menu-btn" data-ta-action="<%= a[:key] %>"><%= a[:label] %></button>
          <% end %>
          <% specials_in_cat.each do |opt| %>
            <button type="button" class="cr-mod-btn cb-opt ta-special-opt"
                    data-ability="<%= opt[:name] %>"
                    data-performance="<%= opt[:performance] ? '1' : '' %>"
                    data-summary="<%= opt[:summary] %>"<%= ' disabled' if opt[:disabled] %>><%= opt[:label] %></button>
          <% end %>
        </div>
      </div>
    <% end %>
    <div class="ta-special-result" hidden></div>
  </div>

  <%# Action panes: a generic action's content, shown when its button is
      clicked (app.js toggles .ta-pane-active). All hidden until selected. %>
  <div class="ta-panes">
    <% unless incapacitated %>
      <% unless out_of_combat %>
        <div class="ta-pane" data-ta-pane="attack">
          <div class="ta-attack" data-attacker-id="<%= acting[:combatant_id] %>"
               data-pool-remaining="<%= pool ? pool[:remaining] : 0 %>">
            <p class="ta-attack-loading">Loading attack options…</p>
          </div>
        </div>
      <% end %>

      <%# Active Spells (turn_action_stub.md → Active Spells): one pane per
          active concentration Spell the Combatant channels — each opened by its
          own Main-Action button (<spell> (conc)). Opening the pane presents the
          Spell's concentration options as a first step: every active Spell can
          be **ended**, and an auto-channel strike Spell (Spiritual Weapon)
          additionally offers **Attack** — the strike flow. Attack reuses the
          Attack host — same Target / Defense / Ally Defense / Luck — pointed at
          /encounter/active_spells_builder for that Spell (data-strike-spell);
          the strike rolls its full Reservoir, so the Weapon & dice step is
          auto-applied and never asks for a count, and it resolves through the
          same /encounter/resolve_attack. End posts to
          /encounter/end_active_spell (confirm-guarded). %>
      <% retarget_cost = Encounter::Config.retarget_cost %>
      <% active_spells.each do |sw| %>
        <div class="ta-pane" data-ta-pane="active_spell:<%= sw[:index] %>">
          <div class="ta-conc" data-spell-name="<%= sw[:spell_name] %>">
            <% verb = sw[:can_strike] ? 'striking' : 'protecting' %>
            <p class="ta-pane-lead">Concentrating on <strong><%= sw[:spell_name] %></strong><% if sw[:current_target] %> — <%= verb %> <strong><%= sw[:current_target] %></strong><% end %>.</p>
            <div class="cb-line ta-conc-options">
              <% if sw[:can_strike] %>
                <button type="button" class="cr-mod-btn cb-opt ta-conc-attack">Attack</button>
              <% end %>
              <% if sw[:can_refill] %>
                <%# Refill (turn_action_stub.md → Active Spells → Refill): channel
                    Combat Pool dice into the Reservoir (1:1) as a Main Action. %>
                <form method="post" action="/encounter/refill_active_spell" class="ta-conc-refill-form">
                  <input type="hidden" name="combatant_id" value="<%= acting[:combatant_id] %>">
                  <input type="hidden" name="spell_name" value="<%= sw[:spell_name] %>">
                  <input type="number" name="dice" class="ta-conc-dice" min="1" value="<%= retarget_cost %>">
                  <button type="submit" class="cr-mod-btn cb-opt ta-conc-refill"
                          data-confirm="Refill <%= sw[:spell_name] %> — channel that many Combat Pool dice into its Reservoir (Main Action)?">Refill</button>
                </form>
              <% end %>
              <% if sw[:can_retarget] %>
                <%# Retarget (turn_action_stub.md → Active Spells → Retarget): a
                    Main Action costing a flat Combat Pool amount that redirects
                    the Spell to any Combatant. %>
                <form method="post" action="/encounter/retarget_active_spell" class="ta-conc-retarget-form">
                  <input type="hidden" name="combatant_id" value="<%= acting[:combatant_id] %>">
                  <input type="hidden" name="spell_name" value="<%= sw[:spell_name] %>">
                  <select name="target_id" class="ta-conc-target">
                    <% roster.each do |r| %>
                      <option value="<%= r[:id] %>"<%= ' selected' if sw[:current_target] == r[:name] %>><%= r[:name] %></option>
                    <% end %>
                  </select>
                  <button type="submit" class="cr-mod-btn cb-opt ta-conc-retarget"
                          data-confirm="Retarget <%= sw[:spell_name] %> — spend <%= retarget_cost %> Combat Pool dice and a Main Action?">Retarget (<%= retarget_cost %> dice)</button>
                </form>
              <% end %>
              <form method="post" action="/encounter/end_active_spell" class="ta-conc-end-form">
                <input type="hidden" name="combatant_id" value="<%= acting[:combatant_id] %>">
                <input type="hidden" name="spell_name" value="<%= sw[:spell_name] %>">
                <button type="submit" class="cr-mod-btn cb-opt ta-conc-end"
                        data-confirm="End <%= sw[:spell_name] %>?">End</button>
              </form>
            </div>
            <% if sw[:can_strike] %>
              <div class="ta-attack ta-active-spells" data-attacker-id="<%= acting[:combatant_id] %>"
                   data-builder-url="/encounter/active_spells_builder"
                   data-strike-spell="<%= sw[:spell_name] %>"
                   data-pool-remaining="<%= pool ? pool[:remaining] : 0 %>" hidden>
                <p class="ta-attack-loading">Loading <%= sw[:spell_name] %>…</p>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>

      <% unless out_of_combat %>
        <div class="ta-pane" data-ta-pane="move">
          <%# Move (turn_action_stub.md → Move): a Main Action that spends a flat
              Move Cost in Combat Pool dice. Rendered through the shared Action
              Result block (TurnMove) so the spent dice are an editable field and
              it confirms exactly like Attack / Cast. %>
          <div class="ta-move" data-combatant-id="<%= acting[:combatant_id] %>"
               data-move-cost="<%= move_cost %>"
               data-pool-remaining="<%= pool ? pool[:remaining] : 0 %>"></div>
        </div>
      <% end %>

      <div class="ta-pane" data-ta-pane="cast">
        <div class="ta-cast" data-caster-id="<%= acting[:combatant_id] %>"
             data-pool-remaining="<%= pool ? pool[:remaining] : 0 %>">
          <p class="ta-attack-loading">Loading spells…</p>
        </div>
      </div>

      <div class="ta-pane" data-ta-pane="item">
        <%# Item use (turn_action_stub.md → Item): a thin host for the shared
            Action Builder, exactly like Cast. The server precomputes the
            builder blob (GET /encounter/item_builder) listing the actor's
            Potions / Scrolls; TurnItem mounts it and, on confirm, POSTs to
            /encounter/resolve_cast with the chosen Item so the cast resolves,
            imposes Item-Form Toxicity (Potions), and decrements the charge. %>
        <div class="ta-item" data-actor-id="<%= acting[:combatant_id] %>"
             data-pool-remaining="<%= pool ? pool[:remaining] : 0 %>">
          <p class="ta-attack-loading">Loading items…</p>
        </div>
      </div>

      <% if out_of_combat %>
        <%# Skill (out-of-combat only): a thin host for the shared Action Builder,
            exactly like Cast. The server precomputes the builder blob
            (GET /dm/skill_builder): a Skill step (each Skill rolled at max dice)
            then, for an opposed Skill only, a Target step. TurnSkill mounts it;
            the builder's roll table rolls both sides and shows the net. %>
        <div class="ta-pane" data-ta-pane="skill">
          <div class="ta-skill" data-actor-id="<%= acting[:combatant_id] %>">
            <p class="ta-attack-loading">Loading skills…</p>
          </div>
        </div>
      <% end %>
    <% end %>

    <% unless out_of_combat %>
      <div class="ta-pane" data-ta-pane="end_turn">
        <%= erb :_ta_action_row, locals: { label: 'End Turn' } %>
        <p class="ta-pane-lead">Advance to the next Combatant in initiative order. Clears this Combatant&rsquo;s luck points; a Round wrap advances the Timestamp. The next Combatant&rsquo;s Combat Pool and Main Actions refresh automatically.</p>
        <form method="post" action="/encounter/advance_turn">
          <button type="submit" class="ce-btn ta-confirm">End Turn</button>
        </form>
      </div>
    <% end %>
  </div>
</section>
