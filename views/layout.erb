<!DOCTYPE html>
<html>
<head>
  <title>Crimson Steel</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="menu">
    <a href="/character/0">Character Sheets</a>
    <a href="/store">Store</a>
    <a href="/spells">Magic</a>
    <a href="/notes/<%= @viewer_id || 0 %>">Notes</a>
    <a href="/downtime">Downtime</a>
    <a href="/scene/<%= @viewer_id || 0 %>">Scene</a>
    <% if @is_local %>
      <a href="/enemies/0">Enemies</a>
      <a href="/combat">Combat</a>
    <% end %>
    <% if @is_local || @view_as_player %>
      <% if @view_as_player %>
        <form method="post" action="/view_mode" style="display: inline;">
          <input type="hidden" name="mode" value="dm">
          <button type="submit" class="menu-view-btn">View as DM</button>
        </form>
      <% else %>
        <form method="post" action="/view_mode" style="display: inline;">
          <input type="hidden" name="mode" value="player">
          <button type="submit" class="menu-view-btn">View as Player</button>
        </form>
      <% end %>
    <% end %>
  </div>
  <%= yield %>
<div id="lightbox" class="lightbox" role="dialog" aria-hidden="true">
  <div class="lightbox-bg"></div>
  <button type="button" class="lightbox-close" aria-label="Close">&times;</button>
  <div class="lightbox-controls">
    <button type="button" data-zoom="out" aria-label="Zoom out">&minus;</button>
    <button type="button" data-zoom="reset" aria-label="Reset zoom">1:1</button>
    <button type="button" data-zoom="in" aria-label="Zoom in">+</button>
  </div>
  <div class="lightbox-stage"><img alt=""></div>
</div>
<script>
history.pushState(null, '', location.href);
window.addEventListener('popstate', function() {
  history.pushState(null, '', location.href);
});

function toggleNote(btn) {
  var text = btn.previousElementSibling;
  if (text.classList.contains('collapsed')) {
    text.classList.remove('collapsed');
    btn.textContent = 'Show less';
  } else {
    text.classList.add('collapsed');
    btn.textContent = 'Show more';
  }
}

// Inline character-based truncation toggle for /scene cells. The
// helper renders the first 200 chars + an ellipsis + a hidden span
// with the rest. Click flips both the rest span's visibility and
// the button's label.
function toggleSceneNote(btn) {
  var p = btn.parentElement;
  if (!p) return;
  var rest = p.querySelector('.note-rest');
  var ellipsis = p.querySelector('.note-ellipsis');
  if (!rest) return;
  var hidden = rest.hasAttribute('hidden');
  if (hidden) {
    rest.removeAttribute('hidden');
    if (ellipsis) ellipsis.style.display = 'none';
    btn.textContent = 'Show less';
  } else {
    rest.setAttribute('hidden', '');
    if (ellipsis) ellipsis.style.display = '';
    btn.textContent = 'Show more';
  }
}

(function() {
  var lb = document.getElementById('lightbox');
  if (!lb) return;
  var stage = lb.querySelector('.lightbox-stage');
  var img = lb.querySelector('img');
  var scale = 1;
  var pan = { x: 0, y: 0 };
  var dragging = null;
  function apply() {
    img.style.transform = 'translate(' + pan.x + 'px,' + pan.y + 'px) scale(' + scale + ')';
  }
  function reset() { scale = 1; pan = { x: 0, y: 0 }; apply(); }
  function open(src, alt) {
    img.src = src;
    img.alt = alt || '';
    reset();
    lb.classList.add('open');
    lb.setAttribute('aria-hidden', 'false');
  }
  function close() {
    lb.classList.remove('open');
    lb.setAttribute('aria-hidden', 'true');
    img.src = '';
  }
  function zoom(factor) {
    scale = Math.min(8, Math.max(0.2, scale * factor));
    apply();
  }
  document.addEventListener('click', function(e) {
    var t = e.target.closest('img.zoomable');
    if (!t) return;
    e.preventDefault();
    open(t.getAttribute('data-full') || t.src, t.alt);
  });
  lb.querySelector('.lightbox-bg').addEventListener('click', close);
  lb.querySelector('.lightbox-close').addEventListener('click', close);
  lb.querySelectorAll('.lightbox-controls button').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var act = btn.getAttribute('data-zoom');
      if (act === 'in') zoom(1.25);
      else if (act === 'out') zoom(0.8);
      else reset();
    });
  });
  stage.addEventListener('wheel', function(e) {
    if (!lb.classList.contains('open')) return;
    e.preventDefault();
    zoom(e.deltaY < 0 ? 1.1 : 0.9);
  }, { passive: false });
  stage.addEventListener('mousedown', function(e) {
    if (e.target !== img) return;
    dragging = { x: e.clientX - pan.x, y: e.clientY - pan.y };
  });
  window.addEventListener('mousemove', function(e) {
    if (!dragging) return;
    pan.x = e.clientX - dragging.x;
    pan.y = e.clientY - dragging.y;
    apply();
  });
  window.addEventListener('mouseup', function() { dragging = null; });
  document.addEventListener('keydown', function(e) {
    if (!lb.classList.contains('open')) return;
    if (e.key === 'Escape') close();
    else if (e.key === '+' || e.key === '=') zoom(1.25);
    else if (e.key === '-' || e.key === '_') zoom(0.8);
    else if (e.key === '0') reset();
  });
})();
</script>
</body>
</html>
