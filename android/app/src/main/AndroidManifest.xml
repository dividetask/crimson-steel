<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Talks to the Crimson Steel server on the local Wi-Fi network. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Detect a VPN / firewall app, to explain a failed connection. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Settings → App updates: install the newer version the server offers
         (Android asks the player to allow it once, and to confirm each install). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Android 14+: be told when the player takes a screenshot of the app, to
         send a copy to the server's device-logs/ folder (granted at install). -->
    <uses-permission android:name="android.permission.DETECT_SCREEN_CAPTURE" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.CrimsonSteel"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:label="Settings" />

    </application>
</manifest>
